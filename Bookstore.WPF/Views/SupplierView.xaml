<UserControl x:Class="Bookstore.WPF.Views.SupplierView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 mc:Ignorable="d">

	<Grid>
		<Grid x:Name="MainSupplierView"
			  Margin="{StaticResource MainViewMargin}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<components:PageHeaderControl Title="NHÀ CUNG CẤP"
										  HeaderIcon="TruckDelivery"
										  AddCommand="{Binding OpenAddPopupCommand}"
										  AddCommandParameter="{Binding}" />

			<Border Grid.Row="1"
					Style="{StaticResource FilterCardStyle}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<components:FilterInputControl Grid.Column="0"
												   Margin="0,0,8,0"
												   IconKind="Magnify"
												   HintText="Tìm nhà cung cấp..."
												   TextValue="{Binding SearchKeyword}" />

					<components:FilterComboBoxControl Grid.Column="1"
													  Margin="0,0,8,0"
													  IconKind="QuestionMark"
													  HintText="Tìm theo"
													  ItemsSource="{Binding SearchTypes}"
													  SelectedItem="{Binding SelectedSearchType}" />

					<components:FilterComboBoxControl Grid.Column="2"
													  Margin="0,0,8,0"
													  IconKind="ListStatus"
													  HintText="Lọc trạng thái"
													  ItemsSource="{Binding SearchStatus}"
													  SelectedItem="{Binding SelectedSearchStatus}" />

					<components:FilterActionPanel Grid.Column="3"
												  ClearCommand="{Binding ClearFilterCommand}"
												  RefreshCommand="{Binding RefreshCommand}"
												  ShowRefreshButton="True" />
				</Grid>
			</Border>

			<Border Grid.Row="2"
					Style="{StaticResource DataGridCardStyle}">
				<DataGrid ItemsSource="{Binding PagedSuppliers}"
						  Style="{StaticResource CleanDataGrid}">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Mã NCC"
											Width="120"
											HeaderStyle="{StaticResource CenterHeaderStyle}"
											ElementStyle="{StaticResource CellCode}"
											SortMemberPath="MaNhaCungCap">
							<DataGridTextColumn.Binding>
								<MultiBinding StringFormat="NCC{0:D3}">
									<Binding Path="MaNhaCungCap" />
								</MultiBinding>
							</DataGridTextColumn.Binding>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Tên nhà cung cấp"
											Binding="{Binding TenNhaCungCap}"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellName}"
											Width="200" />

						<DataGridTextColumn Header="Người đại diện"
											Binding="{Binding NguoiDaiDien}"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}"
											Width="150" />

						<DataGridTextColumn Header="Số điện thoại"
											Binding="{Binding SoDienThoai}"
											Width="120"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}" />

						<DataGridTextColumn Header="Email"
											Binding="{Binding Email}"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}"
											Width="*" />

						<DataGridTextColumn Header="Mã số thuế"
											Binding="{Binding MaSoThue}"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}"
											Width="120" />

						<DataGridTemplateColumn Header="Thao tác"
												Width="100"
												HeaderStyle="{StaticResource CenterHeaderStyle}">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<components:DataGridActionPanel RowItem="{Binding}"
																	ShowEdit="True"
																	EditCommand="{Binding DataContext.OpenEditPopupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	ShowDelete="True"
																	DeleteCommand="{Binding DataContext.DeleteSupplierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</Border>

			<components:PaginationControl Grid.Row="3"
										  CurrentPage="{Binding TrangHienTai}"
										  TotalPages="{Binding TongSoTrang}"
										  TotalRecords="{Binding TongBanGhi}"
										  PaginationCommand="{Binding PhanTrangCommand}" />
		</Grid>

		<!-- POP UP -->
		<Grid Style="{StaticResource PopupOverlayStyle}"
			  Visibility="{Binding IsPopupVisible, Converter={StaticResource BoolToVis}}">

			<Border Background="Transparent">
				<Border.InputBindings>
					<MouseBinding MouseAction="LeftClick"
								  Command="{Binding ClosePopupCommand}" />
				</Border.InputBindings>
			</Border>

			<Border Style="{StaticResource PopupCardStyle}"
					Height="600"
					Width="600">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<components:PopupHeaderControl Title="{Binding PopupTitle}"
												   IconKind="TruckPlus" />
					<ScrollViewer Grid.Row="1">

						<StackPanel>
							<components:FormInputControl Title="Mã nhà cung cấp"
														 IsEnabled="False"
														 IconKind="Barcode"
														 TextValue="{Binding EditingSupplier.MaNhaCungCap, UpdateSourceTrigger=PropertyChanged, StringFormat='NCC{0:d3}'}">
								<components:FormInputControl.Style>
									<Style TargetType="components:FormInputControl">
										<Setter Property="Visibility"
												Value="Visible" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsAddMode}"
														 Value="True">
												<Setter Property="Visibility"
														Value="Collapsed" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</components:FormInputControl.Style>
							</components:FormInputControl>

							<components:FormInputControl Title="Tên nhà cung cấp"
														 IconKind="RenameBoxOutline"
														 IsRequired="True"
														 TextValue="{Binding EditingSupplier.TenNhaCungCap, UpdateSourceTrigger=PropertyChanged}" />


							<Grid Grid.Row="1">
								<Grid.ColumnDefinitions>
									<ColumnDefinition></ColumnDefinition>
									<ColumnDefinition Width="10"></ColumnDefinition>
									<ColumnDefinition></ColumnDefinition>
								</Grid.ColumnDefinitions>

								<StackPanel Grid.Column="0">
									<components:FormInputControl Title="Số điện thoại"
																 IconKind="Phone"
																 IsRequired="True"
																 TextValue="{Binding EditingSupplier.SoDienThoai, UpdateSourceTrigger=PropertyChanged}" />

									<components:FormInputControl Title="Tên ngân hàng"
																 IconKind="Bank"
																 TextValue="{Binding EditingSupplier.TenNganHang, UpdateSourceTrigger=PropertyChanged}" />
									<components:FormInputControl Title="Người đại diện"
																 IconKind="Person"
																 TextValue="{Binding EditingSupplier.NguoiDaiDien, UpdateSourceTrigger=PropertyChanged}" />

								</StackPanel>

								<StackPanel Grid.Column="2">
									<components:FormInputControl Title="Email"
																 IconKind="Email"
																 IsRequired="True"
																 TextValue="{Binding EditingSupplier.Email, UpdateSourceTrigger=PropertyChanged}" />

									<components:FormInputControl Title="Số tài khoản"
																 IconKind="Numeric"
																 TextValue="{Binding EditingSupplier.SoTaiKhoan, UpdateSourceTrigger=PropertyChanged}" />
									<components:FormInputControl Title="Mã số thuế"
																 IconKind="Tag"
																 TextValue="{Binding EditingSupplier.MaSoThue, UpdateSourceTrigger=PropertyChanged}" />

								</StackPanel>
							</Grid>
							<components:FormInputControl Title="Địa chỉ"
														 IconKind="AddressMarker"
														 Grid.Row="2"
														 TextValue="{Binding EditingSupplier.DiaChi, UpdateSourceTrigger=PropertyChanged}" />
							<Grid>
								<Grid.Style>
									<Style TargetType="Grid">
										<Setter Property="Visibility"
												Value="Visible" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsAddMode}"
														 Value="True">
												<Setter Property="Visibility"
														Value="Collapsed" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Grid.Style>
								<StackPanel Orientation="Horizontal"
											VerticalAlignment="Bottom"
											Margin="10,0,10,8"
											HorizontalAlignment="Left">
									<TextBlock Text="Trạng thái: "
											   FontSize="13"
											   FontWeight="Bold"
											   Foreground="{StaticResource PrimaryDarkColor}"
											   VerticalAlignment="Center"
											   Margin="0 0 10 0" />

									<ToggleButton IsChecked="{Binding EditingSupplier.ConHoatDong}"
												  ToolTip="Gạt để bật/tắt trạng thái giao dịch"
												  Cursor="Hand" />

									<TextBlock VerticalAlignment="Center"
											   Margin="10,0,0,0"
											   FontSize="13"
											   FontWeight="Bold">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Setter Property="Text"
														Value="Ngừng giao dịch" />
												<Setter Property="Foreground"
														Value="#EF4444" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding EditingSupplier.ConHoatDong}"
																 Value="True">
														<Setter Property="Text"
																Value="Đang giao dịch" />
														<Setter Property="Foreground"
																Value="#10B981" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
								</StackPanel>
							</Grid>

						</StackPanel>
					</ScrollViewer>
					<StackPanel Grid.Row="2"
								Orientation="Horizontal"
								HorizontalAlignment="Right"
								Margin="0,0,0,0">
						<Button Content="HỦY BỎ"
								Width="120"
								Height="40"
								Margin="0,0,15,0"
								Style="{StaticResource OutlineButtonStyle}"
								Command="{Binding ClosePopupCommand}"
								CommandParameter="{Binding}" />
						<Button Content="LƯU THÔNG TIN"
								Width="150"
								Height="40"
								Style="{StaticResource MainGradientButton}"
								Command="{Binding SaveSupplierCommand}"
								CommandParameter="{Binding}" />
					</StackPanel>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</UserControl>