<UserControl x:Class="Bookstore.WPF.Views.SupplierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 mc:Ignorable="d" 
             Background="{StaticResource BackgroundColor}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Ellipse Width="400" Height="400" Fill="#4318FF" Opacity="0.03" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="-150,-150,0,0" IsHitTestVisible="False"/>
        <Ellipse Width="300" Height="300" Fill="#2B3674" Opacity="0.03" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,-100,-100" IsHitTestVisible="False"/>

        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

			<components:PageHeaderControl Title="NHÀ CUNG CẤP"
										  HeaderIcon="TruckDelivery"
										  AddCommand="{Binding OpenAddPopupCommand}"
										  AddCommandParameter="{Binding}" />

			<Border Grid.Row="1" Margin="0,0,0,12" Padding="20" CornerRadius="16" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="100"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource FilterBorderStyle}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="13" 
                                     Foreground="#2B3674" materialDesign:HintAssist.Hint="Tìm..." Margin="0,0,5,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource FilterBorderStyle}" Margin="0,0,10,0">
                        <ComboBox ItemsSource="{Binding SearchTypes}" SelectedItem="{Binding SelectedSearchType}"
                                  Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="13" 
                                  materialDesign:HintAssist.Hint="Tìm theo" Margin="5 0 5 0"/>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource FilterBorderStyle}" Margin="0,0,10,0">
                        <ComboBox ItemsSource="{Binding SearchStatus}" SelectedItem="{Binding SelectedSearchStatus}"
                                  Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="13" 
                                  materialDesign:HintAssist.Hint="Lọc trạng thái" Margin="5 0 5 0"/>
                    </Border>

                    <Border Grid.Column="4" Background="#F4F7FE" CornerRadius="10" Padding="15,0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Tổng:" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalRecords}" FontWeight="Bold" Foreground="#4318FF" FontSize="15" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="5" Width="42" Height="42" 
                        ToolTip="Xóa tất cả bộ lọc"
                        Command="{Binding ClearFilterCommand}" CommandParameter="{Binding}"
                        BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FECACA"/>
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                    </Trigger>

                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#FCA5A5"/>
                                        <Setter Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <materialDesign:PackIcon Kind="FilterOff" Width="20" Height="20" 
                                                         Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="7" Width="42" Height="42" 
                            ToolTip="Làm mới"
                            Command="{Binding RefreshCommand}" CommandParameter="{Binding}"
                            BorderThickness="0" Cursor="Hand" 
                            Margin="10 0 0 0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#E0E7FF"/>
                                <Setter Property="Foreground" Value="#4318FF"/>

                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#C7D2FE"/>
                                        <Setter Property="Foreground" Value="#250AA0"/>
                                    </Trigger>

                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#A5B4FC"/>
                                        <Setter Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" 
                                                             Foreground="#4318FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="2" CornerRadius="16" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                <DataGrid ItemsSource="{Binding PagedSuppliers}" Style="{StaticResource CleanDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="45" HeaderStyle="{StaticResource CenterHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#A3AED0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}"
                                                                Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Mã NCC" Binding="{Binding DisplayID}" Width="100" HeaderStyle="{StaticResource CenterHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellCenter}">
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Tên nhà cung cấp" Binding="{Binding TenNhaCungCap}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellLeft}">
                                    <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                    <Setter Property="FontWeight" Value="Bold"></Setter>
                                    <Setter Property="TextWrapping" Value="Wrap"></Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Người đại diện" Binding="{Binding NguoiDaiDien}" Width="150">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellLeft}">
                                    <Setter Property="HorizontalAlignment" Value="Left"></Setter>
                                    <Setter Property="FontWeight" Value="SemiBold"></Setter>
                                    <Setter Property="TextWrapping" Value="Wrap"></Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Số điện thoại" Binding="{Binding SoDienThoai}" Width="120" HeaderStyle="{StaticResource CenterHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellCenter}">
                                    <Setter Property="FontWeight" Value="SemiBold"></Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellCenter}">
                                    <Setter Property="FontWeight" Value="SemiBold"></Setter>
                                    <Setter Property="TextWrapping" Value="Wrap"></Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Mã số thuế" Binding="{Binding MaSoThue}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}">
                                    <Setter Property="FontWeight" Value="SemiBold"></Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Thao tác" Width="120" HeaderStyle="{StaticResource CenterHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Width="32" Height="32" BorderThickness="0" Cursor="Hand" ToolTip="Sửa"
                                                Command="{Binding DataContext.OpenEditPopupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#E0E7FF"/>
                                                    <Setter Property="Foreground" Value="#4318FF"/>

                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#C7D2FE"/>
                                                            <Setter Property="Foreground" Value="#250AA0"/>
                                                        </Trigger>

                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter Property="Background" Value="#A5B4FC"/>
                                                            <Setter Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <materialDesign:PackIcon Kind="Edit" Width="15" Height="15" Foreground="#4318FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button Width="32" Height="32" BorderThickness="0" ToolTip="Xóa" Margin="8,0,0,0"
                                                Command="{Binding DataContext.DeleteSupplierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FECACA"/>
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </Trigger>

                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter Property="Background" Value="#FCA5A5"/>
                                                            <Setter Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <materialDesign:PackIcon Kind="Delete" Width="15" Height="15" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Row="3" Margin="0,12,0,0" Padding="12,8" CornerRadius="12" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource PaginationButtonStyle}" Command="{Binding FirstPageCommand}">
                        <materialDesign:PackIcon Kind="ChevronDoubleLeft" Width="16" Height="16" Foreground="#A3AED0"/>
                    </Button>
                    <Button Style="{StaticResource PaginationButtonStyle}" Command="{Binding PrevPageCommand}" Margin="5,0">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16" Foreground="#A3AED0"/>
                    </Button>

                    <ItemsControl ItemsSource="{Binding PageNumbers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Margin="2,0" Style="{StaticResource PaginationButtonStyle}"
                                        Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{StaticResource PaginationButtonStyle}" Command="{Binding NextPageCommand}" Margin="5,0">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" Foreground="#A3AED0"/>
                    </Button>
                    <Button Style="{StaticResource PaginationButtonStyle}" Command="{Binding LastPageCommand}">
                        <materialDesign:PackIcon Kind="ChevronDoubleRight" Width="16" Height="16" Foreground="#A3AED0"/>
                    </Button>
                    <TextBlock FontSize="12" Foreground="#A3AED0" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Run Text="Trang "/>
                        <Run Text="{Binding CurrentPage}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Background="#80000000" Panel.ZIndex="1000" 
      Visibility="{Binding IsPopupVisible, Converter={StaticResource BoolToVis}}">

            <Border Background="Transparent">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ClosePopupCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border Width="680" Background="White" CornerRadius="20" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
                        <materialDesign:PackIcon Kind="{Binding PopUpIcon}" d:Kind="TruckPlus"  Width="26" Height="26" Foreground="#4318FF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PopupTitle}" FontSize="20" FontWeight="Bold" Foreground="#2B3674" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,15">
                                <Grid>
                                    <TextBlock Text="Tên nhà cung cấp *" FontSize="10" Margin="12,4,0,0" VerticalAlignment="Top">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#A3AED0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EditingSupplier.TenNhaCungCap, TargetNullValue=''}" Value="">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Text="{Binding EditingSupplier.TenNhaCungCap, UpdateSourceTrigger=PropertyChanged}" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition Width="10"></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,15">
                                    <Grid>
                                        <TextBlock Text="Số điện thoại *" FontSize="10" Margin="12,4,0,0" VerticalAlignment="Top">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#A3AED0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EditingSupplier.SoDienThoai, TargetNullValue=''}" Value="">
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding EditingSupplier.SoDienThoai, UpdateSourceTrigger=PropertyChanged}" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                    </Grid>
                                </Border>
                                <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,15">
                                    <Grid>
                                        <TextBlock Text="Tên ngân hàng" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                        <TextBox Text="{Binding EditingSupplier.TenNganHang}" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                    </Grid>
                                </Border>
                                <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,15">
                                    <Grid>
                                        <TextBlock Text="Người đại diện" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                        <TextBox Text="{Binding EditingSupplier.NguoiDaiDien}" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,15">
                                    <Grid>
                                        <TextBlock Text="Email" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                        <TextBox Text="{Binding EditingSupplier.Email}" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                    </Grid>
                                </Border>

                                <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,15">
                                    <Grid>
                                        <TextBlock Text="Số tài khoản" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                        <TextBox Text="{Binding EditingSupplier.SoTaiKhoan}" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                    </Grid>
                                </Border>

                                <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,15">
                                    <Grid>
                                        <TextBlock Text="Mã số thuế" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                        <TextBox Text="{Binding EditingSupplier.MaSoThue}" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,15">
                            <Grid>
                                <TextBlock Text="Địa chỉ" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                <TextBox Text="{Binding EditingSupplier.DiaChi}" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,15" >
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAddMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,10,8" HorizontalAlignment="Right">
                                    <TextBlock Text="Trạng thái: " VerticalAlignment="Center" Margin="0 0 10 0"></TextBlock>
                                    
                                    <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}" 
                                      IsChecked="{Binding EditingSupplier.ConHoatDong}" 
                                      ToolTip="Gạt để bật/tắt trạng thái giao dịch"
                                      Cursor="Hand"/>

                                    <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" FontSize="13" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Ngừng giao dịch"/>
                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EditingSupplier.ConHoatDong}" Value="True">
                                                        <Setter Property="Text" Value="Đang giao dịch"/>
                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="HỦY BỎ" Width="120" Height="40" Margin="0,0,15,0" Style="{StaticResource OutlineButtonStyle}" Command="{Binding ClosePopupCommand}" CommandParameter="{Binding}"/>
                            <Button Content="LƯU THÔNG TIN" Width="150" Height="40" Style="{StaticResource MainGradientButton}" Command="{Binding SaveSupplierCommand}" CommandParameter="{Binding}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>