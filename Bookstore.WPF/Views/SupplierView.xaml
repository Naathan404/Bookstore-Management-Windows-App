<UserControl x:Class="Bookstore.WPF.Views.SupplierView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 mc:Ignorable="d">

	<Grid>
		<Grid x:Name="MainSupplierView">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<components:PageHeaderControl Title="NHÀ CUNG CẤP"
										  HeaderIcon="TruckDelivery"
										  AddCommand="{Binding OpenAddPopupCommand}"
										  AddCommandParameter="{Binding}" />

			<Border Grid.Row="1"
					Style="{StaticResource FilterCardStyle}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					
					<components:FilterInputControl Grid.Column="0"
												   Margin="0,0,8,0"
												   IconKind="Magnify"
												   HintText="Tìm nhà cung cấp..."
												   TextValue="{Binding SearchKeyword}" />

					<components:FilterComboBoxControl Grid.Column="1"
													  Margin="0,0,8,0"
													  IconKind="QuestionMark"
													  HintText="Tìm theo"
													  ItemsSource="{Binding SearchTypes}"
													  SelectedItem="{Binding SelectedSearchType}" />

					<components:FilterComboBoxControl Grid.Column="2"
													  Margin="0,0,8,0"
													  IconKind="ListStatus"
													  HintText="Lọc trạng thái"
													  ItemsSource="{Binding SearchStatus}"
													  SelectedItem="{Binding SelectedSearchStatus}" />

					<components:FilterActionPanel Grid.Column="3"
												  ClearCommand="{Binding ClearFilterCommand}"
												  RefreshCommand="{Binding RefreshCommand}"
												  ShowRefreshButton="True" />
				</Grid>
			</Border>

			<Border Grid.Row="2"
					CornerRadius="16"
					Background="White"
					BorderBrush="#E2E8F0"
					BorderThickness="1"
					Padding="20">
				<DataGrid ItemsSource="{Binding PagedSuppliers}"
						  Style="{StaticResource CleanDataGrid}">
					<DataGrid.Columns>
						<DataGridTextColumn Header="STT"
											Binding="{Binding STT}"
											Width="45"
											HeaderStyle="{StaticResource CenterHeaderStyle}">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="HorizontalAlignment"
											Value="Center" />
									<Setter Property="VerticalAlignment"
											Value="Center" />
									<Setter Property="FontWeight"
											Value="SemiBold" />
									<Setter Property="Foreground"
											Value="#A3AED0" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}"
													 Value="True">
											<Setter Property="Foreground"
													Value="White" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>
						<DataGridTextColumn Header="Mã NCC"
											Binding="{Binding DisplayID}"
											Width="100"
											HeaderStyle="{StaticResource CenterHeaderStyle}">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock"
									   BasedOn="{StaticResource CellCenter}">
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Tên nhà cung cấp"
											Binding="{Binding TenNhaCungCap}"
											Width="*">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock"
									   BasedOn="{StaticResource CellLeft}">
									<Setter Property="HorizontalAlignment"
											Value="Left"></Setter>
									<Setter Property="FontWeight"
											Value="Bold"></Setter>
									<Setter Property="TextWrapping"
											Value="Wrap"></Setter>
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Người đại diện"
											Binding="{Binding NguoiDaiDien}"
											Width="150">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock"
									   BasedOn="{StaticResource CellLeft}">
									<Setter Property="HorizontalAlignment"
											Value="Left"></Setter>
									<Setter Property="FontWeight"
											Value="SemiBold"></Setter>
									<Setter Property="TextWrapping"
											Value="Wrap"></Setter>
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Số điện thoại"
											Binding="{Binding SoDienThoai}"
											Width="120"
											HeaderStyle="{StaticResource CenterHeaderStyle}">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock"
									   BasedOn="{StaticResource CellCenter}">
									<Setter Property="FontWeight"
											Value="SemiBold"></Setter>
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Email"
											Binding="{Binding Email}"
											Width="200">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock"
									   BasedOn="{StaticResource CellCenter}">
									<Setter Property="FontWeight"
											Value="SemiBold"></Setter>
									<Setter Property="TextWrapping"
											Value="Wrap"></Setter>
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Mã số thuế"
											Binding="{Binding MaSoThue}"
											Width="120">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock"
									   BasedOn="{StaticResource CellRight}">
									<Setter Property="FontWeight"
											Value="SemiBold"></Setter>
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTemplateColumn Header="Thao tác"
												Width="120"
												HeaderStyle="{StaticResource CenterHeaderStyle}">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal"
												HorizontalAlignment="Center">
										<Button Width="32"
												Height="32"
												BorderThickness="0"
												Cursor="Hand"
												ToolTip="Sửa"
												Command="{Binding DataContext.OpenEditPopupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
												CommandParameter="{Binding}">
											<Button.Style>
												<Style TargetType="Button">
													<Setter Property="Background"
															Value="#E0E7FF" />
													<Setter Property="Foreground"
															Value="#4318FF" />

													<Style.Triggers>
														<Trigger Property="IsMouseOver"
																 Value="True">
															<Setter Property="Background"
																	Value="#C7D2FE" />
															<Setter Property="Foreground"
																	Value="#250AA0" />
														</Trigger>

														<Trigger Property="IsPressed"
																 Value="True">
															<Setter Property="Background"
																	Value="#A5B4FC" />
															<Setter Property="Opacity"
																	Value="0.8" />
														</Trigger>
													</Style.Triggers>
												</Style>
											</Button.Style>
											<Button.Template>
												<ControlTemplate TargetType="Button">
													<Border x:Name="border"
															Background="{TemplateBinding Background}"
															CornerRadius="6">
														<materialDesign:PackIcon Kind="Edit"
																				 Width="15"
																				 Height="15"
																				 Foreground="#4318FF"
																				 HorizontalAlignment="Center"
																				 VerticalAlignment="Center" />
													</Border>
												</ControlTemplate>
											</Button.Template>
										</Button>

										<Button Width="32"
												Height="32"
												BorderThickness="0"
												ToolTip="Xóa"
												Margin="8,0,0,0"
												Command="{Binding DataContext.DeleteSupplierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
												CommandParameter="{Binding}">
											<Button.Style>
												<Style TargetType="Button">
													<Setter Property="Background"
															Value="#FEE2E2" />
													<Setter Property="Foreground"
															Value="#EF4444" />
													<Style.Triggers>
														<Trigger Property="IsMouseOver"
																 Value="True">
															<Setter Property="Background"
																	Value="#FECACA" />
															<Setter Property="Foreground"
																	Value="#DC2626" />
														</Trigger>

														<Trigger Property="IsPressed"
																 Value="True">
															<Setter Property="Background"
																	Value="#FCA5A5" />
															<Setter Property="Opacity"
																	Value="0.8" />
														</Trigger>
													</Style.Triggers>
												</Style>
											</Button.Style>
											<Button.Template>
												<ControlTemplate TargetType="Button">
													<Border x:Name="border"
															Background="{TemplateBinding Background}"
															CornerRadius="6">
														<materialDesign:PackIcon Kind="Delete"
																				 Width="15"
																				 Height="15"
																				 Foreground="#EF4444"
																				 HorizontalAlignment="Center"
																				 VerticalAlignment="Center" />
													</Border>
												</ControlTemplate>
											</Button.Template>
										</Button>
									</StackPanel>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</Border>

			<components:PaginationControl Grid.Row="3"
										  CurrentPage="{Binding TrangHienTai}"
										  TotalPages="{Binding TongSoTrang}"
										  TotalRecords="{Binding TongBanGhi}"
										  PaginationCommand="{Binding PhanTrangCommand}" />
		</Grid>

		<Grid Background="#80000000"
			  Panel.ZIndex="1000"
			  Visibility="{Binding IsPopupVisible, Converter={StaticResource BoolToVis}}">

			<Border Background="Transparent">
				<Border.InputBindings>
					<MouseBinding MouseAction="LeftClick"
								  Command="{Binding ClosePopupCommand}" />
				</Border.InputBindings>
			</Border>

			<Border Width="680"
					Background="White"
					CornerRadius="20"
					Padding="30"
					HorizontalAlignment="Center"
					VerticalAlignment="Center">
				<StackPanel>
					<StackPanel Orientation="Horizontal"
								HorizontalAlignment="Center"
								Margin="0,0,0,25">
						<materialDesign:PackIcon Kind="{Binding PopUpIcon}"
												 d:Kind="TruckPlus"
												 Width="26"
												 Height="26"
												 Foreground="#4318FF"
												 Margin="0,0,10,0"
												 VerticalAlignment="Center" />
						<TextBlock Text="{Binding PopupTitle}"
								   FontSize="20"
								   FontWeight="Bold"
								   Foreground="#2B3674"
								   VerticalAlignment="Center" />
					</StackPanel>

					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"></RowDefinition>
							<RowDefinition Height="Auto"></RowDefinition>
							<RowDefinition Height="Auto"></RowDefinition>
							<RowDefinition Height="Auto"></RowDefinition>
							<RowDefinition Height="Auto"></RowDefinition>
						</Grid.RowDefinitions>

						<StackPanel Grid.Row="0">
							<Border CornerRadius="10"
									Background="White"
									BorderBrush="#E2E8F0"
									BorderThickness="1.5"
									Height="50"
									Margin="0,0,0,15">
								<Grid>
									<TextBlock Text="Tên nhà cung cấp *"
											   FontSize="10"
											   Margin="12,4,0,0"
											   VerticalAlignment="Top">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Setter Property="Foreground"
														Value="#A3AED0" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding EditingSupplier.TenNhaCungCap, TargetNullValue=''}"
																 Value="">
														<Setter Property="Foreground"
																Value="#EF4444" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
									<TextBox Text="{Binding EditingSupplier.TenNhaCungCap, UpdateSourceTrigger=PropertyChanged}"
											 FontSize="13"
											 FontWeight="SemiBold"
											 Foreground="#2B3674"
											 BorderThickness="0"
											 Background="Transparent"
											 VerticalAlignment="Bottom"
											 Margin="10,0,10,6"
											 Padding="0" />
								</Grid>
							</Border>
						</StackPanel>

						<Grid Grid.Row="1">
							<Grid.ColumnDefinitions>
								<ColumnDefinition></ColumnDefinition>
								<ColumnDefinition Width="10"></ColumnDefinition>
								<ColumnDefinition></ColumnDefinition>
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0">
								<Border CornerRadius="10"
										Background="White"
										BorderBrush="#E2E8F0"
										BorderThickness="1.5"
										Height="50"
										Margin="0,0,0,15">
									<Grid>
										<TextBlock Text="Số điện thoại *"
												   FontSize="10"
												   Margin="12,4,0,0"
												   VerticalAlignment="Top">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Foreground"
															Value="#A3AED0" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding EditingSupplier.SoDienThoai, TargetNullValue=''}"
																	 Value="">
															<Setter Property="Foreground"
																	Value="#EF4444" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
										<TextBox Text="{Binding EditingSupplier.SoDienThoai, UpdateSourceTrigger=PropertyChanged}"
												 FontSize="13"
												 FontWeight="SemiBold"
												 Foreground="#2B3674"
												 BorderThickness="0"
												 Background="Transparent"
												 VerticalAlignment="Bottom"
												 Margin="10,0,10,6"
												 Padding="0" />
									</Grid>
								</Border>
								<Border CornerRadius="10"
										Background="White"
										BorderBrush="#E2E8F0"
										BorderThickness="1.5"
										Height="50"
										Margin="0,0,0,15">
									<Grid>
										<TextBlock Text="Tên ngân hàng"
												   FontSize="10"
												   Foreground="#A3AED0"
												   Margin="12,4,0,0"
												   VerticalAlignment="Top" />
										<TextBox Text="{Binding EditingSupplier.TenNganHang}"
												 FontSize="13"
												 FontWeight="SemiBold"
												 Foreground="#2B3674"
												 BorderThickness="0"
												 Background="Transparent"
												 VerticalAlignment="Bottom"
												 Margin="10,0,10,6"
												 Padding="0" />
									</Grid>
								</Border>
								<Border CornerRadius="10"
										Background="White"
										BorderBrush="#E2E8F0"
										BorderThickness="1.5"
										Height="50"
										Margin="0,0,0,15">
									<Grid>
										<TextBlock Text="Người đại diện"
												   FontSize="10"
												   Foreground="#A3AED0"
												   Margin="12,4,0,0"
												   VerticalAlignment="Top" />
										<TextBox Text="{Binding EditingSupplier.NguoiDaiDien}"
												 FontSize="13"
												 FontWeight="SemiBold"
												 Foreground="#2B3674"
												 BorderThickness="0"
												 Background="Transparent"
												 VerticalAlignment="Bottom"
												 Margin="10,0,10,6"
												 Padding="0" />
									</Grid>
								</Border>
							</StackPanel>

							<StackPanel Grid.Column="2">
								<Border CornerRadius="10"
										Background="White"
										BorderBrush="#E2E8F0"
										BorderThickness="1.5"
										Height="50"
										Margin="0,0,0,15">
									<Grid>
										<TextBlock Text="Email"
												   FontSize="10"
												   Foreground="#A3AED0"
												   Margin="12,4,0,0"
												   VerticalAlignment="Top" />
										<TextBox Text="{Binding EditingSupplier.Email}"
												 FontSize="13"
												 FontWeight="SemiBold"
												 Foreground="#2B3674"
												 BorderThickness="0"
												 Background="Transparent"
												 VerticalAlignment="Bottom"
												 Margin="10,0,10,6"
												 Padding="0" />
									</Grid>
								</Border>

								<Border CornerRadius="10"
										Background="White"
										BorderBrush="#E2E8F0"
										BorderThickness="1.5"
										Height="50"
										Margin="0,0,0,15">
									<Grid>
										<TextBlock Text="Số tài khoản"
												   FontSize="10"
												   Foreground="#A3AED0"
												   Margin="12,4,0,0"
												   VerticalAlignment="Top" />
										<TextBox Text="{Binding EditingSupplier.SoTaiKhoan}"
												 FontSize="13"
												 FontWeight="SemiBold"
												 Foreground="#2B3674"
												 BorderThickness="0"
												 Background="Transparent"
												 VerticalAlignment="Bottom"
												 Margin="10,0,10,6"
												 Padding="0" />
									</Grid>
								</Border>

								<Border CornerRadius="10"
										Background="White"
										BorderBrush="#E2E8F0"
										BorderThickness="1.5"
										Height="50"
										Margin="0,0,0,15">
									<Grid>
										<TextBlock Text="Mã số thuế"
												   FontSize="10"
												   Foreground="#A3AED0"
												   Margin="12,4,0,0"
												   VerticalAlignment="Top" />
										<TextBox Text="{Binding EditingSupplier.MaSoThue}"
												 FontSize="13"
												 FontWeight="SemiBold"
												 Foreground="#2B3674"
												 BorderThickness="0"
												 Background="Transparent"
												 VerticalAlignment="Bottom"
												 Margin="10,0,10,6"
												 Padding="0" />
									</Grid>
								</Border>
							</StackPanel>
						</Grid>

						<Border Grid.Row="2"
								CornerRadius="10"
								Background="White"
								BorderBrush="#E2E8F0"
								BorderThickness="1.5"
								Height="50"
								Margin="0,0,0,15">
							<Grid>
								<TextBlock Text="Địa chỉ"
										   FontSize="10"
										   Foreground="#A3AED0"
										   Margin="12,4,0,0"
										   VerticalAlignment="Top" />
								<TextBox Text="{Binding EditingSupplier.DiaChi}"
										 FontSize="13"
										 FontWeight="SemiBold"
										 Foreground="#2B3674"
										 BorderThickness="0"
										 Background="Transparent"
										 VerticalAlignment="Bottom"
										 Margin="10,0,10,6"
										 Padding="0" />
							</Grid>
						</Border>

						<Border Grid.Row="3"
								CornerRadius="10"
								Background="White"
								BorderBrush="#E2E8F0"
								BorderThickness="1.5"
								Height="50"
								Margin="0,0,0,15">
							<Border.Style>
								<Style TargetType="Border">
									<Setter Property="Visibility"
											Value="Visible" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsAddMode}"
													 Value="True">
											<Setter Property="Visibility"
													Value="Collapsed" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<Grid>
								<StackPanel Orientation="Horizontal"
											VerticalAlignment="Bottom"
											Margin="10,0,10,8"
											HorizontalAlignment="Right">
									<TextBlock Text="Trạng thái: "
											   VerticalAlignment="Center"
											   Margin="0 0 10 0"></TextBlock>

									<ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
												  IsChecked="{Binding EditingSupplier.ConHoatDong}"
												  ToolTip="Gạt để bật/tắt trạng thái giao dịch"
												  Cursor="Hand" />

									<TextBlock VerticalAlignment="Center"
											   Margin="10,0,0,0"
											   FontSize="13"
											   FontWeight="Bold">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Setter Property="Text"
														Value="Ngừng giao dịch" />
												<Setter Property="Foreground"
														Value="#EF4444" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding EditingSupplier.ConHoatDong}"
																 Value="True">
														<Setter Property="Text"
																Value="Đang giao dịch" />
														<Setter Property="Foreground"
																Value="#10B981" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
								</StackPanel>
							</Grid>
						</Border>

						<StackPanel Grid.Row="4"
									Orientation="Horizontal"
									HorizontalAlignment="Right"
									Margin="0,10,0,0">
							<Button Content="HỦY BỎ"
									Width="120"
									Height="40"
									Margin="0,0,15,0"
									Style="{StaticResource OutlineButtonStyle}"
									Command="{Binding ClosePopupCommand}"
									CommandParameter="{Binding}" />
							<Button Content="LƯU THÔNG TIN"
									Width="150"
									Height="40"
									Style="{StaticResource MainGradientButton}"
									Command="{Binding SaveSupplierCommand}"
									CommandParameter="{Binding}" />
						</StackPanel>
					</Grid>
				</StackPanel>
			</Border>
		</Grid>
	</Grid>
</UserControl>