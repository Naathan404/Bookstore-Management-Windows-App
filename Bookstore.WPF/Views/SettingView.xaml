<UserControl x:Class="Bookstore.WPF.Views.SettingView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 mc:Ignorable="d">

	<UserControl.Resources>
		<SolidColorBrush x:Key="BackgroundColor"
						 Color="#F4F7FE" />
		<SolidColorBrush x:Key="PrimaryDarkColor"
						 Color="#2B3674" />
		<SolidColorBrush x:Key="PrimaryColor"
						 Color="#4318FF" />
		<SolidColorBrush x:Key="TextLightColor"
						 Color="#A3AED0" />
		<SolidColorBrush x:Key="WhiteColor"
						 Color="White" />
		<SolidColorBrush x:Key="DangerColor"
						 Color="#EF4444" />
		<SolidColorBrush x:Key="SuccessColor"
						 Color="#10B981" />
		<SolidColorBrush x:Key="WarningColor"
						 Color="#F59E0B" />
		<LinearGradientBrush x:Key="GradientButtonBrush"
							 StartPoint="0,0"
							 EndPoint="1,0">
			<GradientStop Color="#4318FF"
						  Offset="0" />
			<GradientStop Color="#5B3CFF"
						  Offset="1" />
		</LinearGradientBrush>

		<Style x:Key="SettingCard"
			   TargetType="Border">
			<Setter Property="Background"
					Value="White" />
			<Setter Property="CornerRadius"
					Value="16" />
			<Setter Property="BorderBrush"
					Value="#E2E8F0" />
			<Setter Property="BorderThickness"
					Value="1" />
			<Setter Property="Padding"
					Value="24" />
			<Setter Property="Margin"
					Value="0,0,0,20" />
		</Style>

		<Style x:Key="SettingTitle"
			   TargetType="TextBlock">
			<Setter Property="FontSize"
					Value="16" />
			<Setter Property="FontWeight"
					Value="Bold" />
			<Setter Property="Foreground"
					Value="#2B3674" />
			<Setter Property="Margin"
					Value="0,0,0,16" />
		</Style>

		<Style x:Key="InputBox"
			   TargetType="Border">
			<Setter Property="Background"
					Value="#F8FAFC" />
			<Setter Property="CornerRadius"
					Value="8" />
			<Setter Property="BorderBrush"
					Value="#E2E8F0" />
			<Setter Property="BorderThickness"
					Value="1" />
			<Setter Property="Padding"
					Value="12, 8" />
			<Setter Property="Margin"
					Value="0,0,0,12" />
		</Style>

		<Style x:Key="CustomSwitchStyle"
			   TargetType="ToggleButton"
			   BasedOn="{StaticResource MaterialDesignSwitchToggleButton}">
			<Setter Property="Background"
					Value="{StaticResource BackgroundColor}" />

			<Setter Property="materialDesign:ToggleButtonAssist.SwitchTrackOnBackground"
					Value="{StaticResource PrimaryColor}" />
		</Style>
	</UserControl.Resources>

	<Grid>
		<Grid x:Name="MainSettingView">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<components:PageHeaderControl Title="CÀI ĐẶT HỆ THỐNG"
										  HeaderIcon="Cog"
										  ShowAddButton="{Binding HasChanges}"
										  AddTitle="LƯU LẠI"
										  AddIcon="ContentSave"
										  AddCommand="{Binding LuuCaiDatCommand}"
										  AddCommandParameter="{Binding}"
										  ShowReloadButton="True"
										  ReloadCommand="{Binding TaiLaiCommand}" />

			<Grid Grid.Row="1"
				  Margin="0,0,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="1*" />
					<ColumnDefinition Width="20" />
					<ColumnDefinition Width="1*" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0">
					<Border Style="{StaticResource SettingCard}">
						<StackPanel>
							<TextBlock Text="NHẬP - XUẤT KHO"
									   Style="{StaticResource SettingTitle}" />

							<TextBlock Text="Số lượng nhập tối thiểu"
									   Foreground="#A3AED0"
									   Margin="0,0,0,4" />
							<Border Style="{StaticResource InputBox}">
								<DockPanel>
									<TextBlock Text="quyển"
											   DockPanel.Dock="Right"
											   Foreground="{StaticResource PrimaryColor}"
											   FontWeight="SemiBold"
											   VerticalAlignment="Center" />
									<TextBox Text="{Binding SoLuongNhapToiThieu, UpdateSourceTrigger=PropertyChanged}"
											 BorderThickness="0"
											 Background="Transparent"
											 Foreground="#2B3674"
											 FontWeight="Bold" />
								</DockPanel>
							</Border>

							<TextBlock Text="Số lượng tồn tối đa trước khi nhập"
									   Foreground="#A3AED0"
									   Margin="0,0,0,4" />
							<Border Style="{StaticResource InputBox}">
								<DockPanel>
									<TextBlock Text="quyển"
											   DockPanel.Dock="Right"
											   Foreground="#4318FF"
											   FontWeight="SemiBold"
											   VerticalAlignment="Center" />
									<TextBox Text="{Binding SoLuongTonToiDaCoTheNhap, UpdateSourceTrigger=PropertyChanged}"
											 BorderThickness="0"
											 Background="Transparent"
											 Foreground="#2B3674"
											 FontWeight="Bold" />
								</DockPanel>
							</Border>

							<TextBlock Text="Số lượng tồn kho tối thiểu"
									   Foreground="#A3AED0"
									   Margin="0,0,0,4" />
							<Border Style="{StaticResource InputBox}"
									Margin="0">
								<DockPanel>
									<TextBlock Text="quyển"
											   DockPanel.Dock="Right"
											   Foreground="#4318FF"
											   FontWeight="SemiBold"
											   VerticalAlignment="Center" />
									<TextBox Text="{Binding SoLuongTonToiThieu, UpdateSourceTrigger=PropertyChanged}"
											 BorderThickness="0"
											 Background="Transparent"
											 Foreground="#2B3674"
											 FontWeight="Bold" />
								</DockPanel>
							</Border>
						</StackPanel>
					</Border>

					<Border Style="{StaticResource SettingCard}">
						<StackPanel>
							<TextBlock Text="TÀI CHÍNH"
									   Style="{StaticResource SettingTitle}" />

							<TextBlock Text="Tỉ lệ đơn giá bán (Biên độ lợi nhuận)"
									   Foreground="#A3AED0"
									   Margin="0,0,0,4" />
							<Border Style="{StaticResource InputBox}">
								<DockPanel>
									<TextBlock Text="%"
											   DockPanel.Dock="Right"
											   Foreground="#4318FF"
											   FontWeight="SemiBold"
											   VerticalAlignment="Center" />
									<TextBox Text="{Binding TiLeDonGiaBan, UpdateSourceTrigger=PropertyChanged}"
											 BorderThickness="0"
											 Background="Transparent"
											 Foreground="#2B3674"
											 FontWeight="Bold" />
								</DockPanel>
							</Border>

							<TextBlock Text="Thuế giá trị gia tăng (VAT)"
									   Foreground="#A3AED0"
									   Margin="0,0,0,4" />
							<Border Style="{StaticResource InputBox}">
								<DockPanel>
									<TextBlock Text="%"
											   DockPanel.Dock="Right"
											   Foreground="#4318FF"
											   FontWeight="SemiBold"
											   VerticalAlignment="Center" />
									<TextBox Text="{Binding ThueVAT, UpdateSourceTrigger=PropertyChanged}"
											 BorderThickness="0"
											 Background="Transparent"
											 Foreground="#2B3674"
											 FontWeight="Bold" />
								</DockPanel>
							</Border>

							<Border Background="#EEF2FF"
									CornerRadius="8"
									Padding="12"
									Margin="0, 12, 0, 0">
								<DockPanel>
									<ToggleButton DockPanel.Dock="Right"
												  IsChecked="{Binding TienThuLonHonNo}"
												  Style="{StaticResource CustomSwitchStyle}" />
									<TextBlock Text="Cho phép thu tiền vượt số tiền nợ"
											   Foreground="#2B3674"
											   FontWeight="SemiBold"
											   VerticalAlignment="Center" />
								</DockPanel>
							</Border>
						</StackPanel>
					</Border>
				</StackPanel>

				<StackPanel Grid.Column="2">
					<Border Style="{StaticResource SettingCard}">
						<StackPanel>
							<TextBlock Text="ƯU ĐÃI"
									   Style="{StaticResource SettingTitle}" />

							<Border Background="#EEF2FF"
									CornerRadius="8"
									Padding="12"
									Margin="0,0,0,12">
								<DockPanel>
									<ToggleButton DockPanel.Dock="Right"
												  IsChecked="{Binding ChoPhepKetThucUuDai}"
												  Style="{StaticResource CustomSwitchStyle}" />
									<TextBlock Text="Cho phép tự động kết thúc ưu đãi"
											   Foreground="#2B3674"
											   FontWeight="SemiBold"
											   VerticalAlignment="Center" />
								</DockPanel>
							</Border>

							<Border Background="#EEF2FF"
									CornerRadius="8"
									Padding="12"
									Margin="0,0,0,24">
								<DockPanel>
									<ToggleButton DockPanel.Dock="Right"
												  IsChecked="{Binding CoKhoangCachCacKhoangGia}"
												  Style="{StaticResource CustomSwitchStyle}" />
									<TextBlock Text="Áp dụng khoảng cách các khoảng giá"
											   Foreground="#2B3674"
											   FontWeight="SemiBold"
											   VerticalAlignment="Center" />
								</DockPanel>
							</Border>

							<TextBlock Text="Số lượng ưu đãi tối thiểu để kích hoạt"
									   Foreground="#A3AED0"
									   Margin="0,0,0,4" />
							<Border Style="{StaticResource InputBox}">
								<DockPanel>
									<TextBlock Text="sản phẩm"
											   DockPanel.Dock="Right"
											   Foreground="#4318FF"
											   FontWeight="SemiBold"
											   VerticalAlignment="Center" />
									<TextBox Text="{Binding SoLuongUuDaiToiThieu, UpdateSourceTrigger=PropertyChanged}"
											 BorderThickness="0"
											 Background="Transparent"
											 Foreground="#2B3674"
											 FontWeight="Bold" />
								</DockPanel>
							</Border>

							<TextBlock Text="Số lượng ưu đãi tối đa"
									   Foreground="#A3AED0"
									   Margin="0,0,0,4" />
							<Border Style="{StaticResource InputBox}"
									Margin="0">
								<DockPanel>
									<TextBlock Text="sản phẩm"
											   DockPanel.Dock="Right"
											   Foreground="#4318FF"
											   FontWeight="SemiBold"
											   VerticalAlignment="Center" />
									<TextBox Text="{Binding SoLuongUuDaiToiDa, UpdateSourceTrigger=PropertyChanged}"
											 BorderThickness="0"
											 Background="Transparent"
											 Foreground="#2B3674"
											 FontWeight="Bold" />
								</DockPanel>
							</Border>
						</StackPanel>
					</Border>
				</StackPanel>
			</Grid>
		</Grid>
	</Grid>
</UserControl>