<UserControl x:Class="Bookstore.WPF.Views.SettingView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 mc:Ignorable="d">

	<UserControl.Resources>
		<Style x:Key="SettingCard"
			   TargetType="Border">
			<Setter Property="Background"
					Value="White" />
			<Setter Property="CornerRadius"
					Value="16" />
			<Setter Property="BorderBrush"
					Value="#E2E8F0" />
			<Setter Property="BorderThickness"
					Value="1" />
			<Setter Property="Padding"
					Value="24" />
			<Setter Property="Margin"
					Value="0,0,0,20" />
		</Style>

		<Style x:Key="SettingTitle"
			   TargetType="TextBlock">
			<Setter Property="FontSize"
					Value="16" />
			<Setter Property="FontWeight"
					Value="Bold" />
			<Setter Property="Foreground"
					Value="#2B3674" />
			<Setter Property="Margin"
					Value="0,0,0,16" />
		</Style>

		<Style x:Key="InputBox"
			   TargetType="Border">
			<Setter Property="Background"
					Value="#F8FAFC" />
			<Setter Property="CornerRadius"
					Value="8" />
			<Setter Property="BorderBrush"
					Value="#E2E8F0" />
			<Setter Property="BorderThickness"
					Value="1" />
			<Setter Property="Padding"
					Value="12, 8" />
			<Setter Property="Margin"
					Value="0,0,0,12" />
		</Style>
	</UserControl.Resources>

	<Grid>
		<Grid x:Name="MainSettingView"
			  Margin="{StaticResource MainViewMargin}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<components:PageHeaderControl Title="CÀI ĐẶT THAM SỐ HỆ THỐNG"
										  HeaderIcon="Cog"
										  ShowAddButton="{Binding HasChanges}"
										  AddTitle="LƯU LẠI"
										  AddIcon="ContentSave"
										  AddCommand="{Binding LuuCaiDatCommand}"
										  AddCommandParameter="{Binding}"
										  ShowReloadButton="True"
										  ReloadCommand="{Binding TaiLaiCommand}" />

			<Grid Grid.Row="1"
				  Margin="0,0,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="1*" />
					<ColumnDefinition Width="20" />
					<ColumnDefinition Width="1*" />
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0">
					<Border Style="{StaticResource SettingCard}"
							Height="330">
						<StackPanel>
							<TextBlock Text="NHẬP - XUẤT KHO"
									   Style="{StaticResource SettingTitle}" />

							<components:FormInputControl Title="Số lượng nhập tối thiểu cho 1 sách"
														 IconKind="TruckAdd"
														 UnitText="quyển"
														 TextValue="{Binding SoLuongNhapToiThieu, UpdateSourceTrigger=PropertyChanged}" />

							<components:FormInputControl Title="Số lượng tồn tối đa trước khi nhập cho 1 sách"
														 IconKind="BookAdd"
														 UnitText="quyển"
														 TextValue="{Binding SoLuongTonToiDaCoTheNhap, UpdateSourceTrigger=PropertyChanged}" />

							<components:FormInputControl Title="Số lượng tồn kho tối thiểu"
														 IconKind="BookMinus"
														 UnitText="quyển"
														 TextValue="{Binding SoLuongTonToiThieu, UpdateSourceTrigger=PropertyChanged}" />
						</StackPanel>
					</Border>

					<Border Style="{StaticResource SettingCard}">
						<StackPanel>
							<TextBlock Text="TÀI CHÍNH"
									   Style="{StaticResource SettingTitle}" />

							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="20" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

							<components:FormInputControl Title="Tỉ lệ đơn giá bán"
														 Grid.Column="0"
														 IconKind="Percent"
														 UnitText="%"
														 TextValue="{Binding TiLeDonGiaBan, UpdateSourceTrigger=PropertyChanged}" />

							<components:FormInputControl Title="Thuế giá trị gia tăng (VAT)"
														 Grid.Column="2"
														 IconKind="Money"
														 UnitText="%"
														 TextValue="{Binding ThueVAT, UpdateSourceTrigger=PropertyChanged}" />
							</Grid>

							<Border Margin="4, 0, 0, 0">
								<DockPanel>
									<ToggleButton DockPanel.Dock="Right"
												  IsChecked="{Binding TienThuLonHonNo}" />
									<TextBlock Text="Cho phép thu tiền vượt số tiền nợ"
											   Foreground="#2B3674"
											   FontWeight="SemiBold"
											   FontSize="13"
											   VerticalAlignment="Center" />
								</DockPanel>
							</Border>
						</StackPanel>
					</Border>
				</StackPanel>

				<StackPanel Grid.Column="2">
					<Border Style="{StaticResource SettingCard}">
						<StackPanel>
							<TextBlock Text="ƯU ĐÃI"
									   Style="{StaticResource SettingTitle}" />

							
							<components:FormInputControl Title="Số lượng ưu đãi tối thiểu để kích hoạt"
														 IconKind="Sale"
														 UnitText="ưu đãi"
														 TextValue="{Binding SoLuongUuDaiToiThieu, UpdateSourceTrigger=PropertyChanged}" />

							<components:FormInputControl Title="Số lượng ưu đãi tối đa"
														 IconKind="Sale"
														 UnitText="ưu đãi"
														 TextValue="{Binding SoLuongUuDaiToiDa, UpdateSourceTrigger=PropertyChanged}" />
							<Border Margin="4, 0, 0, 0">
								<DockPanel>
									<ToggleButton DockPanel.Dock="Right"
												  IsChecked="{Binding ChoPhepKetThucUuDai}" />
									<TextBlock Text="Cho phép tự động kết thúc ưu đãi"
											   Foreground="#2B3674"
											   FontWeight="SemiBold"
											   FontSize="13"
											   VerticalAlignment="Center" />
								</DockPanel>
							</Border>

						</StackPanel>
					</Border>

					<Border Style="{StaticResource SettingCard}">
						<StackPanel>
							<TextBlock Text="BẢO MẬT"
									   Style="{StaticResource SettingTitle}" />

							<components:FormInputControl Title="Mật khẩu mặc định"
														 IconKind="Key"
														 TextValue="{Binding MatKhauMacDinh, UpdateSourceTrigger=PropertyChanged}" />
						</StackPanel>
					</Border>
				</StackPanel>
			</Grid>
		</Grid>
	</Grid>
</UserControl>