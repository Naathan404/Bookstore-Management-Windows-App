                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=CbbLoaiUuDai}" Value="2">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=CbbLoaiUuDai}" Value="3">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Điều kiện Sách áp dụng:" FontSize="12" FontWeight="SemiBold" Foreground="#2B3674" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Style="{StaticResource BaseInputBorder}" Height="50" Margin="0">
                                                <Grid>
                                                    <TextBlock Text="Chọn Sách bắt buộc mua *" FontSize="10" Margin="12,4,0,0" VerticalAlignment="Top">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#A3AED0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=cbbSachDieuKien}" Value="">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=cbbSachDieuKien}" Value="{x:Null}">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ComboBox x:Name="cbbSachDieuKien" ItemsSource="{Binding ListSach}" SelectedValue="{Binding EditingPromotion.ISBNDieuKien, UpdateSourceTrigger=PropertyChanged}" 
