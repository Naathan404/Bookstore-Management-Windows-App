                                        <ComboBoxItem Content="1. Giảm giá dựa trên Tổng hóa đơn"/>
                                        <ComboBoxItem Content="2. Tặng quà dựa trên Tổng hóa đơn"/>
                                        <ComboBoxItem Content="3. Giảm giá khi mua Sách cụ thể"/>
                                        <ComboBoxItem Content="4. Tặng quà khi mua Sách cụ thể"/>
