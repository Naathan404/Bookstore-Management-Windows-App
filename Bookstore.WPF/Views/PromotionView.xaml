                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#A3AED0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=txtSoLuongMua}" Value="">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
