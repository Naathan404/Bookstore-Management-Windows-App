                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=txtGiamToiDa}" Value="">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=txtGiamToiDa}" Value="{x:Null}">
