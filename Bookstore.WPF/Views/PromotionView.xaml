                                            </Border>

                                            <Border Grid.Column="2" Style="{StaticResource BaseInputBorder}" Height="50" Margin="0">
                                                <Grid>
                                                    <TextBlock Text="Số tiền tối đa (VNĐ)" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                                    <TextBox Text="{Binding EditingPromotion.SoTienToiDa}" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" BorderThickness="0" Background="Transparent" 
                                                             VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                             Margin="10,0,10,6" Padding="0"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
