                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBox x:Name="txtTiLeGiam" Text="{Binding EditingPromotion.TiLeGiam, UpdateSourceTrigger=PropertyChanged}" FontSize="13" FontWeight="Bold" Foreground="#10B981" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Column="2" Style="{StaticResource BaseInputBorder}" Height="50" Margin="0"
                                                        IsEnabled="{Binding IsChecked, ElementName=radGiamPhanTram}">
