                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBox x:Name="txtSoTienGiam" Text="{Binding EditingPromotion.SoTienGiam, UpdateSourceTrigger=PropertyChanged}" FontSize="13" FontWeight="Bold" Foreground="#10B981" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <RadioButton x:Name="radGiamPhanTram" GroupName="HinhThucGiam" Content="Giảm theo tỉ lệ % và Giới hạn mức giảm" IsChecked="{Binding IsGiamPhanTramMode}" Foreground="#2B3674" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,5">
