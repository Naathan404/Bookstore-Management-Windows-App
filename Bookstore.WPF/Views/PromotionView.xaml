                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=CbbLoaiUuDai}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=CbbLoaiUuDai}" Value="2">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <TextBlock Text="Cấu hình Mức giảm giá:" FontSize="12" FontWeight="SemiBold" Foreground="#10B981" Margin="0,0,0,12"/>

                                        <RadioButton x:Name="radGiamTien" GroupName="HinhThucGiam" Content="Giảm theo số tiền trực tiếp" IsChecked="{Binding IsGiamTienMode}" Foreground="#2B3674" FontWeight="Bold" Margin="0,0,0,8"/>
