                                            <Border Style="{StaticResource BaseInputBorder}" Height="50" Margin="0" Width="350" HorizontalAlignment="Left"
                IsEnabled="{Binding IsChecked, ElementName=radGiamTien}">
                                                <Grid>
                                                    <TextBlock Text="Số tiền giảm (VNĐ) *" FontSize="10" Margin="12,4,0,0" VerticalAlignment="Top">
