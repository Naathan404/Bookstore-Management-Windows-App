                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource BaseInputBorder}" Height="50" Margin="0,0,0,12">
                                        <Grid>
                                            <TextBlock Text="Ngày hết hạn *" FontSize="10" Margin="12,4,0,0" VerticalAlignment="Top">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#A3AED0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedDate, ElementName=dpNgayKetThuc}" Value="{x:Null}">
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
