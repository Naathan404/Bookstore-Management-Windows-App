                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBox x:Name="txtSoLuongMua" Text="{Binding EditingPromotion.SoLuongMua, UpdateSourceTrigger=PropertyChanged}" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </StackPanel>

