<UserControl x:Class="Bookstore.WPF.Views.PromotionView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 xmlns:enums="clr-namespace:Bookstore.Share.Enums;assembly=Bookstore.Share"
			 mc:Ignorable="d">

	<Grid>
		<Grid x:Name="MainPromotionView"
			  Margin="{StaticResource MainViewMargin}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- Card 1: Header -->
			<components:PageHeaderControl Title="QUẢN LÝ ƯU ĐÃI"
										  HeaderIcon="Sale"
										  AddTitle="TẠO ƯU ĐÃI"
										  AddIcon="Plus"
										  AddCommand="{Binding OpenAddPopupCommand}"
										  AddCommandParameter="{Binding}"
										   />

			<!-- Card 2: Search Filters -->
			<Border Grid.Row="1"
					Style="{StaticResource FilterCardStyle}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<components:FilterInputControl Grid.Column="0"
												   Margin="0,0,8,0"
												   IconKind="Magnify"
												   HintText="Tìm ưu đãi"
												   TextValue="{Binding SearchTenKM}" />


					<components:FilterComboBoxControl Grid.Column="1"
													  Margin="0,0,8,0"
													  IconKind="QuestionMark"
													  HintText="Tìm theo"
													  ItemsSource="{Binding ListTieuChiTimKiem}"
													  SelectedItem="{Binding SelectedTieuChiTimKiem}" />

					<components:FilterComboBoxControl Grid.Column="2"
													  Margin="0,0,8,0"
													  IconKind="Shape"
													  HintText="Loại ưu đãi"
													  ItemsSource="{Binding ListLoaiUuDai}"
													  SelectedItem="{Binding SelectedLoaiUuDaiFilter}" />

					<components:FilterComboBoxControl Grid.Column="3"
													  Margin="0,0,8,0"
													  IconKind="CheckCircle"
													  HintText="Trạng thái"
													  ItemsSource="{Binding ListTrangThai}"
													  SelectedItem="{Binding SelectedTrangThai}" />

					<components:FilterDatePickerControl Grid.Column="4"
														Margin="0,0,8,0"
														IconKind="CalendarStart"
														HintText="Từ ngày"
														SelectedDate="{Binding SearchTuNgay}" />

					<components:FilterDatePickerControl Grid.Column="5"
														Margin="0,0,8,0"
														IconKind="CalendarEnd"
														HintText="Đến ngày"
														SelectedDate="{Binding SearchDenNgay}" />

					<components:FilterActionPanel Grid.Column="6"
												  ClearCommand="{Binding ClearFilterCommand}"
												  RefreshCommand="{Binding RefreshCommand}"
												  ShowRefreshButton="True" />
				</Grid>
			</Border>

			<!-- Card 3: Danh sách ưu đãi -->
			<Border Grid.Row="2"
					Style="{StaticResource DataGridCardStyle}">
				<DataGrid x:Name="PromotionDataGrid"
						  ItemsSource="{Binding PagedPromotions}"
						  Style="{StaticResource CleanDataGrid}">
					<DataGrid.Columns>
						<DataGridTextColumn Header="STT"
											Binding="{Binding STT}"
											Width="46"
											HeaderStyle="{StaticResource CenterHeaderStyle}"
											ElementStyle="{StaticResource CellText}">
						</DataGridTextColumn>

						<DataGridTextColumn Header="Code"
											Binding="{Binding Code}"
											Width="Auto"
											HeaderStyle="{StaticResource CenterHeaderStyle}"
											ElementStyle="{StaticResource CellCode}" />

						<DataGridTextColumn Header="Chương trình"
											Binding="{Binding TenChuongTrinh}"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellName}"
											Width="*" />

						<DataGridTextColumn Header="Loại"
											Binding="{Binding LoaiUuDai}"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}"
											Width="150" />

						<DataGridTextColumn Header="Đối tượng"
											Binding="{Binding LoaiKhachHangApDung}"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}"
											Width="100" />

						<DataGridTemplateColumn Header="Thời gian áp dụng"
												Width="150"
												HeaderStyle="{StaticResource LeftHeaderStyle}">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<TextBlock Style="{StaticResource CellLeft}">
				<Run Text="Từ: " />
				<Run Text="{Binding ThoiGianBatDau, StringFormat={}{0:dd/MM/yyyy}, Mode=OneWay}" />
				
				<LineBreak />
				
				<Run Text="Đến: "
										FontWeight="SemiBold" />
				<Run Text="{Binding ThoiGianKetThuc, StringFormat={}{0:dd/MM/yyyy}, Mode=OneWay}"
										FontWeight="SemiBold" />
									</TextBlock>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

						<DataGridTemplateColumn Header="Số lượng"
												Width="100"
												HeaderStyle="{StaticResource CenterHeaderStyle}">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<TextBlock Style="{StaticResource CellCenter}"
											   FontWeight="SemiBold">
				<Run Text="{Binding SoLuongDaDung, Mode=OneWay}"
										Foreground="#10B981" />
				
				<Run Text=" / "
										Foreground="#A3AED0" />
				
				<Run Text="{Binding SoLuongToiDaDisplay, Mode=OneWay}" />
									</TextBlock>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

						<DataGridTemplateColumn Header="Trạng thái"
												Width="120"
												HeaderStyle="{StaticResource CenterHeaderStyle}">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Border CornerRadius="12"
											Padding="10,3"
											HorizontalAlignment="Center"
											VerticalAlignment="Center"
											Background="{Binding TrangThaiBackground}">
										<TextBlock Text="{Binding TrangThai}"
												   FontSize="11"
												   FontWeight="SemiBold"
												   Foreground="{Binding TrangThaiForeground}"
												   HorizontalAlignment="Center" />
									</Border>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

						<DataGridTemplateColumn Header="Thao tác"
												Width="100"
												HeaderStyle="{StaticResource CenterHeaderStyle}">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal"
												HorizontalAlignment="Center"
												VerticalAlignment="Center">

										<Button Style="{StaticResource MiniActionButtonBase}"
												Background="{Binding ToggleButtonBackground}"
												Foreground="{Binding ToggleButtonForeground}"
												ToolTip="Đổi trạng thái"
												Margin="0,0,8,0"
												Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
												CommandParameter="{Binding}">

											<materialDesign:PackIcon Kind="{Binding ToggleButtonIcon}"
																	 Width="15"
																	 Height="15" />
										</Button>

										<components:DataGridActionPanel RowItem="{Binding}"
																		ShowEdit="True"
																		EditCommand="{Binding DataContext.OpenEditPopupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																		ShowDelete="False"
																		DeleteCommand="{Binding DataContext.DeletePromotionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />

									</StackPanel>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</Border>

			<!-- Card 4: Pagination -->

			<components:PaginationControl Grid.Row="3"
										  CurrentPage="{Binding TrangHienTai}"
										  TotalPages="{Binding TongSoTrang}"
										  TotalRecords="{Binding TongBanGhi}"
										  PaginationCommand="{Binding PhanTrangCommand}" />
		</Grid>

		<!-- Pop up -->
		<components:FormPopupControl Title="{Binding PopupTitle, FallbackValue='LẬP PHIẾU THÔNG TIN ƯU ĐÃI'}"
									 IconKind="TicketPercent"
									 IsOpen="{Binding IsPopupVisible}"
									 CloseCommand="{Binding ClosePopupCommand}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>


				<ScrollViewer Grid.Row="0"
							  VerticalScrollBarVisibility="Auto"
							  Margin="0,0,0,15"
							  Padding="0,0,10,0">
					<StackPanel>
						<TextBlock Text="1. THÔNG TIN CHUNG"
								   FontSize="16"
								   FontWeight="Bold"
								   Foreground="{StaticResource PrimaryColor}"
								   Margin="0,8,0,8" />
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="20" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0">
								<components:FormInputControl Title="Tên chương trình"
															 TextValue="{Binding EditingPromotion.TenChuongTrinh, UpdateSourceTrigger=PropertyChanged}"
															 IsRequired="True" />

								<components:FormInputControl Title="Mã ưu đãi"
															 IconKind="MusicAccidentalSharp"
															 IsEnabled="{Binding IsCoreEditingAllowed}"
															 TextValue="{Binding EditingPromotion.Code, UpdateSourceTrigger=PropertyChanged}"
															 IsRequired="True"
															 Foreground="{StaticResource PrimaryColor}"
															 FontWeight="Bold" />

								<components:FormComboBoxControl Title="Loại khách hàng áp dụng"
																IsRequired="True"
																IsEnabled="{Binding IsCoreEditingAllowed}"
																ItemsSource="{Binding ListLoaiKhachHang}"
																SelectedValue="{Binding EditingPromotion.MaLoaiKhachHang, UpdateSourceTrigger=PropertyChanged}"
																DisplayMemberPath="TenLoaiKhachHang"
																SelectedValuePath="Id"
																IconKind="People" />
							</StackPanel>

							<StackPanel Grid.Column="2">
								<components:FormDatePickerControl Title="Ngày có hiệu lực"
																  IsRequired="True"
																  HintText="Chọn ngày..."
																  IconKind="CalendarStart"
																  IsEnabled="{Binding IsCoreEditingAllowed}"
																  SelectedDate="{Binding EditingPromotion.NgayBatDau, UpdateSourceTrigger=PropertyChanged}" />

								<components:FormDatePickerControl Title="Ngày hết hạn"
																  IsRequired="True"
																  IconKind="CalendarEnd"
																  HintText="Chọn ngày..."
																  SelectedDate="{Binding EditingPromotion.NgayKetThuc, UpdateSourceTrigger=PropertyChanged}" />

								<components:FormInputControl Title="Số lượng phát hành tối đa"
															 TextValue="{Binding EditingPromotion.SoLuongToiDa, UpdateSourceTrigger=PropertyChanged}"
															 IsRequired="True"
															 IconKind="Counter" />
							</StackPanel>
						</Grid>

						<components:FormInputControl Title="Mô tả chương trình"
													 TextValue="{Binding EditingPromotion.MoTa, UpdateSourceTrigger=PropertyChanged}"
													 InputHeight="84"
													 IsMultiLine="True"
													 ShowIcon="False" />


						<TextBlock Text="2. CẤU HÌNH LOẠI ƯU ĐÃI"
								   FontSize="16"
								   FontWeight="Bold"
								   Foreground="{StaticResource PrimaryColor}"
								   Margin="0,8,0,8" />

						<components:FormComboBoxControl Title="Loại ưu đãi"
														IsRequired="True"
														IconKind="TagOutline"
														ItemsSource="{Binding AvailablePromotionTypes}"
														SelectedValue="{Binding SelectedMaLoaiUuDai, UpdateSourceTrigger=PropertyChanged}"
														SelectedValuePath="MaLoaiUuDai"
														DisplayMemberPath="TenLoaiUuDai"
														IsEnabled="{Binding IsCoreEditingAllowed}" />

						<StackPanel>
							<StackPanel>
								<StackPanel.Style>
									<Style TargetType="StackPanel">
										<Setter Property="Visibility"
												Value="Collapsed" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding SelectedMaLoaiUuDai}"
														 Value="{x:Static enums:PromotionType.HoaDonQua}">
												<Setter Property="Visibility"
														Value="Visible" />
											</DataTrigger>
											<DataTrigger Binding="{Binding SelectedMaLoaiUuDai}"
														 Value="{x:Static enums:PromotionType.HoaDonGiam}">
												<Setter Property="Visibility"
														Value="Visible" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</StackPanel.Style>

								<TextBlock Text="ĐIỀU KIỆN ÁP DỤNG CHO HÓA ĐƠN"
										   FontWeight="Bold"
										   Foreground="{StaticResource DangerColor}"
										   Margin="4,0,0,8" />

								<Grid >
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="20" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>

									<components:FormInputControl Grid.Column="0"
																 Title="Số tiền tối thiểu"
																 TextValue="{Binding EditingPromotion.SoTienToiThieu, UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:N0}, ConverterCulture=en-US}"
																 IsRequired="True"
																 IsCurrencyMode="True"
																 IconKind="Download" 
                                                                 IsEnabled="{Binding IsCoreEditingAllowed}"/>

									<components:FormInputControl Grid.Column="2"
																 Title="Số tiền tối đa"
																 IsCurrencyMode="True"
																 TextValue="{Binding EditingPromotion.SoTienToiDa, UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:N0}, ConverterCulture=en-US}"
																 IsRequired="True"
																 IconKind="Upload" 
                                                                 IsEnabled="{Binding IsCoreEditingAllowed}"/>
								</Grid>
							</StackPanel>

							<StackPanel>
								<StackPanel.Style>
									<Style TargetType="StackPanel">
										<Setter Property="Visibility"
												Value="Collapsed" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding SelectedMaLoaiUuDai}"
														 Value="{x:Static enums:PromotionType.SachQua}">
												<Setter Property="Visibility"
														Value="Visible" />
											</DataTrigger>
											<DataTrigger Binding="{Binding SelectedMaLoaiUuDai}"
														 Value="{x:Static enums:PromotionType.SachGiam}">
												<Setter Property="Visibility"
														Value="Visible" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</StackPanel.Style>

								<TextBlock Text="ĐIỀU KIỆN ÁP DỤNG KHI MUA SÁCH"
										   FontWeight="Bold"
										   Foreground="{StaticResource DangerColor}"
										   Margin="4,0,0,8" />
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="2*" />
										<ColumnDefinition Width="20" />
										<ColumnDefinition Width="1*" />
									</Grid.ColumnDefinitions>

									<components:FormComboBoxControl ItemsSource="{Binding ListSach}"
																	SelectedValue="{Binding EditingPromotion.ISBNDieuKien, UpdateSourceTrigger=PropertyChanged}"
																	DisplayMemberPath="TenSach"
																	SelectedValuePath="ISBN"
																	Title="Tên sách bắt buộc mua"
																	IconKind="Book"
																	IsRequired="True"
																	IsEditable="True" 
                                                                    IsEnabled="{Binding IsCoreEditingAllowed}"/>
									<components:FormInputControl TextValue="{Binding EditingPromotion.SoLuongMua, UpdateSourceTrigger=PropertyChanged}"
																 Grid.Column="2"
																 IsRequired="True"
																 IconKind="Counting4"
																 UnitText="quyển"
																 Title="Số lượng mua tối thiểu"
                                                                 IsEnabled="{Binding IsCoreEditingAllowed}"/>

								</Grid>
							</StackPanel>

							<StackPanel>
								<StackPanel.Style>
									<Style TargetType="StackPanel">
										<Setter Property="Visibility"
												Value="Collapsed" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding SelectedMaLoaiUuDai}"
														 Value="{x:Static enums:PromotionType.HoaDonGiam}">
												<Setter Property="Visibility"
														Value="Visible" />
											</DataTrigger>
											<DataTrigger Binding="{Binding SelectedMaLoaiUuDai}"
														 Value="{x:Static enums:PromotionType.SachGiam}">
												<Setter Property="Visibility"
														Value="Visible" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</StackPanel.Style>


								<TabControl Style="{StaticResource TabControlStyle}"
											SelectedIndex="{Binding DiscountTabIndex, UpdateSourceTrigger=PropertyChanged}">

									<TabItem Header="GIẢM TIỀN TRỰC TIẾP">
										<Grid Margin="0,15,0,0">
											<components:FormInputControl Title="Số tiền giảm"
																		 IsRequired="True"
																		 IconKind="Cash"
																		 IsCurrencyMode="True"
																		 UnitText="đ"
																		 TextValue="{Binding EditingPromotion.SoTienGiam, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}, ConverterCulture=en-US}"
                                                                         IsEnabled="{Binding IsCoreEditingAllowed}"/>
										</Grid>
									</TabItem>

									<TabItem Header="GIẢM THEO TỈ LỆ (%)">
										<Grid Margin="0,15,0,0">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="20" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>

											<components:FormInputControl Grid.Column="0"
																		 Title="Tỉ lệ giảm"
																		 UnitText="%"
																		 IconKind="Discount"
																		 IsRequired="True"
																		 TextValue="{Binding EditingPromotion.TiLeGiam, UpdateSourceTrigger=PropertyChanged}"
                                                                         IsEnabled="{Binding IsCoreEditingAllowed}"/>

											<components:FormInputControl Grid.Column="2"
																		 Title="Giảm tối đa"
																		 IsCurrencyMode="True"
																		 IsRequired="True"
																		 IconKind="Cash"
																		 UnitText="đ"
																		 TextValue="{Binding EditingPromotion.GiamToiDa, UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:N0}, ConverterCulture=en-US }" 
                                                                         IsEnabled="{Binding IsCoreEditingAllowed}"/>
										</Grid>
									</TabItem>
								</TabControl>
							</StackPanel>


							<StackPanel>
								<StackPanel.Style>
									<Style TargetType="StackPanel">
										<Setter Property="Visibility"
												Value="Collapsed" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding SelectedMaLoaiUuDai}"
														 Value="{x:Static enums:PromotionType.HoaDonQua}">
												<Setter Property="Visibility"
														Value="Visible" />
											</DataTrigger>
											<DataTrigger Binding="{Binding SelectedMaLoaiUuDai}"
														 Value="{x:Static enums:PromotionType.SachQua}">
												<Setter Property="Visibility"
														Value="Visible" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</StackPanel.Style>

								<TextBlock Text="QUÀ TẶNG"
										   FontWeight="Bold"
										   Foreground="{StaticResource DangerColor}"
										   Margin="4,0,0,8" />

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="2*" />
										<ColumnDefinition Width="20" />
										<ColumnDefinition Width="1*" />
									</Grid.ColumnDefinitions>

									<components:FormComboBoxControl ItemsSource="{Binding ListSach}"
																	SelectedValue="{Binding EditingPromotion.ISBNTang, UpdateSourceTrigger=PropertyChanged}"
																	DisplayMemberPath="TenSach"
																	SelectedValuePath="ISBN"
																	Title="Tên sách tặng"
																	IconKind="Book"
																	IsRequired="True"
																	IsEditable="True" 
                                                                    IsEnabled="{Binding IsCoreEditingAllowed}"/>

									<components:FormInputControl TextValue="{Binding EditingPromotion.SoLuongTang, UpdateSourceTrigger=PropertyChanged}"
																 Grid.Column="2"
																 IsRequired="True"
																 IconKind="Counting4"
																 UnitText="quyển"
																 Title="Số lượng tặng" 
                                                                 IsEnabled="{Binding IsCoreEditingAllowed}"/>
								</Grid>
							</StackPanel>
						</StackPanel>
					</StackPanel>
				</ScrollViewer>

				<Grid Grid.Row="1"
					  Margin="0,0,0,0">
					<StackPanel Orientation="Horizontal"
								HorizontalAlignment="Right">
						<Button Content="HỦY BỎ"
								Command="{Binding ClosePopupCommand}"
								CommandParameter="{Binding}"
								Width="80"
								Margin="0,0,12,0"
								Style="{StaticResource OutlineButtonStyle}" />
						<Button Content="{Binding SaveButtonText, FallbackValue='LƯU ƯU ĐÃI'}"
								Command="{Binding SavePromotionCommand}"
								CommandParameter="{Binding}"
								Style="{StaticResource MainGradientButton}"
								Width="150"
								FontSize="13"
								FontWeight="SemiBold"
								Foreground="White"
								Cursor="Hand">
						</Button>
					</StackPanel>
				</Grid>

			</Grid>

		</components:FormPopupControl>
	</Grid>
</UserControl>