															<DataTrigger Binding="{Binding SelectedDate, ElementName=dpNgayBatDau}"
																		 Value="{x:Null}">
																<Setter Property="Foreground"
																		Value="#EF4444" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</TextBlock.Style>
											</TextBlock>
											<DatePicker x:Name="dpNgayBatDau"
														SelectedDate="{Binding EditingPromotion.NgayBatDau, UpdateSourceTrigger=PropertyChanged}"
														BorderThickness="0"
														Background="Transparent"
														VerticalAlignment="Bottom"
														Margin="10,0,10,4"
														Padding="0" />
										</Grid>
									</Border>-->

									<components:FormDatePickerControl x:Name="dpNgayKetThuc"
																	  Title="Ngày hết hạn"
																	  IsRequired="True"
																	  IconKind="CalendarEnd"
																	  HintText="Chọn ngày..."
																	  SelectedDate="{Binding EditingPromotion.NgayKetThuc, UpdateSourceTrigger=PropertyChanged}" />

									<!--<Border Style="{StaticResource BaseInputBorder}"
											Height="50"
											Margin="0,0,0,12">
										<Grid>
											<TextBlock Text="Ngày hết hạn *"
													   FontSize="10"
													   Margin="12,4,0,0"
													   VerticalAlignment="Top">
												<TextBlock.Style>
													<Style TargetType="TextBlock">
														<Setter Property="Foreground"
																Value="#A3AED0" />
														<Style.Triggers>
															<DataTrigger Binding="{Binding SelectedDate, ElementName=dpNgayKetThuc}"
																		 Value="{x:Null}">
																<Setter Property="Foreground"
																		Value="#EF4444" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</TextBlock.Style>
											</TextBlock>
											<DatePicker x:Name="dpNgayKetThuc"
														SelectedDate="{Binding EditingPromotion.NgayKetThuc, UpdateSourceTrigger=PropertyChanged}"
														BorderThickness="0"
														Background="Transparent"
														VerticalAlignment="Bottom"
														Margin="10,0,10,4"
														Padding="0" />
										</Grid>
									</Border>-->

									<components:FormInputControl x:Name="txtSoLuongToiDa"
																 Title="Số lượng phát hành tối đa"
																 TextValue="{Binding EditingPromotion.SoLuongToiDa, UpdateSourceTrigger=PropertyChanged}"
																 IsRequired="True"
																 IconKind="Counter" />

									<!--<Border Style="{StaticResource BaseInputBorder}"
											Height="50"
											Margin="0,0,0,12"
											IsEnabled="{Binding IsCoreEditingAllowed}">
										<Grid>
											<TextBlock Text="Số lượng phát hành tối đa *"
													   FontSize="10"
													   Margin="12,4,0,0"
													   VerticalAlignment="Top">
												<TextBlock.Style>
													<Style TargetType="TextBlock">
														<Setter Property="Foreground"
																Value="#A3AED0" />
														<Style.Triggers>
															<DataTrigger Binding="{Binding Text, ElementName=txtSoLuongToiDa}"
																		 Value="">
																<Setter Property="Foreground"
																		Value="#EF4444" />
															</DataTrigger>
															<DataTrigger Binding="{Binding Text, ElementName=txtSoLuongToiDa}"
																		 Value="{x:Null}">
																<Setter Property="Foreground"
																		Value="#EF4444" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</TextBlock.Style>
											</TextBlock>
											<TextBox 
													 Text="{Binding EditingPromotion.SoLuongToiDa, UpdateSourceTrigger=PropertyChanged}"
													 FontSize="13"
													 FontWeight="SemiBold"
													 Foreground="#2B3674"
													 BorderThickness="0"
													 Background="Transparent"
													 VerticalAlignment="Bottom"
													 Margin="10,0,10,6"
													 Padding="0" />
										</Grid>
									</Border>-->
								</StackPanel>
							</Grid>

							<components:FormInputControl x:Name="txtMoTa"
														 Title="Mô tả chương trình"
														 TextValue="{Binding EditingPromotion.MoTa, UpdateSourceTrigger=PropertyChanged}"
														 InputHeight="84"
														 IsMultiLine="True"
														 ShowIcon="False" />


							<TextBlock Text="2. CẤU HÌNH LOẠI ƯU ĐÃI"
									   FontSize="16"
									   FontWeight="Bold"
									   Foreground="{StaticResource PrimaryColor}"
									   Margin="0,8,0,8" />

							<components:FormComboBoxControl x:Name="CbbLoaiUuDai"
															Title="Loại ưu đãi"
															IsRequired="True"
															IconKind="TagOutline"
															HintText="Chọn loại ưu đãi để tiếp tục..."
															ItemsSource="{Binding AvailablePromotionTypes}"
															SelectedValue="{Binding EditingPromotion.MaLoaiUuDai, UpdateSourceTrigger=PropertyChanged}"
															SelectedValuePath="MaLoaiUuDai"
															DisplayMemberPath="TenLoaiUuDai"
															IsEnabled="{Binding IsCoreEditingAllowed}" />


							<StackPanel>
								<StackPanel x:Name="DieuKienHoaDon">
									<StackPanel.Style>
										<Style TargetType="StackPanel">
											<Setter Property="Visibility"
													Value="Collapsed" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding SelectedValue, ElementName=CbbLoaiUuDai}"
															 Value="{x:Static enums:PromotionType.HoaDonQua}">
													<Setter Property="Visibility"
															Value="Visible" />
												</DataTrigger>

												<DataTrigger Binding="{Binding SelectedValue, ElementName=CbbLoaiUuDai}"
															 Value="{x:Static enums:PromotionType.HoaDonGiam}">
													<Setter Property="Visibility"
															Value="Visible" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</StackPanel.Style>

									<TextBlock Text="ĐIỀU KIỆN ÁP DỤNG CHO HÓA ĐƠN"
											   FontWeight="Bold"
											   Foreground="{StaticResource DangerColor}"
											   Margin="4,0,0,8" />

									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="20" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>

										<components:FormInputControl x:Name="txtSoTienToiThieu"
																	 Grid.Column="0"
																	 Title="Số tiền tối thiểu"
																	 TextValue="{Binding EditingPromotion.SoTienToiThieu, UpdateSourceTrigger=PropertyChanged}"
																	 IsRequired="True"
																	 IconKind="Download" />

										<components:FormInputControl x:Name="txtSoTienToiDa"
																	 Grid.Column="2"
																	 Title="Số tiền tối đa"
																	 TextValue="{Binding EditingPromotion.SoTienToiDa, UpdateSourceTrigger=PropertyChanged}"
																	 IsRequired="True"
																	 IconKind="Upload" />
									</Grid>
								</StackPanel>

								<StackPanel x:Name="DieuKienSach">
									<StackPanel.Style>
										<Style TargetType="StackPanel">
											<Setter Property="Visibility"
													Value="Collapsed" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding SelectedValue, ElementName=CbbLoaiUuDai}"
															 Value="{x:Static enums:PromotionType.SachQua}">
													<Setter Property="Visibility"
															Value="Visible" />
												</DataTrigger>

												<DataTrigger Binding="{Binding SelectedValue, ElementName=CbbLoaiUuDai}"
															 Value="{x:Static enums:PromotionType.SachGiam}">
													<Setter Property="Visibility"
															Value="Visible" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</StackPanel.Style>

									<TextBlock Text="ĐIỀU KIỆN ÁP DỤNG KHI MUA SÁCH"
											   FontWeight="Bold"
											   Foreground="{StaticResource DangerColor}"
											   Margin="4,0,0,8" />
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="2*" />
											<ColumnDefinition Width="20" />
											<ColumnDefinition Width="1*" />
										</Grid.ColumnDefinitions>

										<components:FormComboBoxControl x:Name="cbbSachDieuKien"
																		ItemsSource="{Binding ListSach}"
																		SelectedValue="{Binding EditingPromotion.ISBNDieuKien, UpdateSourceTrigger=PropertyChanged}"
																		DisplayMemberPath="TenSach"
																		SelectedValuePath="ISBN"
																		Title="Tên sách bắt buộc mua"
																		IconKind="Book"
																		IsRequired="True"
																		IsEditable="True" />
										<components:FormInputControl x:Name="txtSoLuongMua"
																	 TextValue="{Binding EditingPromotion.SoLuongMua, UpdateSourceTrigger=PropertyChanged}"
																	 Grid.Column="2"
																	 IsRequired="True"
																	 IconKind="Counting4"
																	 UnitText="quyển"
																	 Title="Số lượng mua tối thiểu" />

									</Grid>
								</StackPanel>

								<StackPanel x:Name="GiamGia">
									<StackPanel.Style>
										<Style TargetType="StackPanel">
											<Setter Property="Visibility"
													Value="Collapsed" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding SelectedValue, ElementName=CbbLoaiUuDai}"
															 Value="{x:Static enums:PromotionType.HoaDonGiam}">
													<Setter Property="Visibility"
															Value="Visible" />
												</DataTrigger>
												<DataTrigger Binding="{Binding SelectedValue, ElementName=CbbLoaiUuDai}"
															 Value="{x:Static enums:PromotionType.SachGiam}">
													<Setter Property="Visibility"
															Value="Visible" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</StackPanel.Style>


									<TabControl Style="{StaticResource TabControlStyle}"
												SelectedIndex="{Binding DiscountTabIndex, UpdateSourceTrigger=PropertyChanged}">

										<TabItem Header="GIẢM TIỀN TRỰC TIẾP">
											<Grid Margin="0,15,0,0">
												<components:FormInputControl x:Name="txtSoTienGiam"
																			 Title="Số tiền giảm"
																			 IsRequired="True"
																			 IconKind="Cash"
																			 UnitText="đ"
																			 TextValue="{Binding EditingPromotion.SoTienGiam, UpdateSourceTrigger=PropertyChanged}" />
											</Grid>
										</TabItem>

										<TabItem Header="GIẢM THEO TỈ LỆ (%)">
											<Grid Margin="0,15,0,0">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="20" />
													<ColumnDefinition Width="*" />
												</Grid.ColumnDefinitions>

												<components:FormInputControl x:Name="txtTiLeGiam"
																			 Grid.Column="0"
																			 Title="Tỉ lệ giảm"
																			 UnitText="%"
																			 IconKind="Discount"
																			 IsRequired="True"
																			 TextValue="{Binding EditingPromotion.TiLeGiam, UpdateSourceTrigger=PropertyChanged}" />

												<components:FormInputControl x:Name="txtGiamToiDa"
																			 Grid.Column="2"
																			 Title="Giảm tối đa"
																			 IsRequired="True"
																			 IconKind="Cash"
																			 UnitText="đ"
																			 TextValue="{Binding EditingPromotion.GiamToiDa, UpdateSourceTrigger=PropertyChanged}" />
											</Grid>
										</TabItem>
									</TabControl>
								</StackPanel>


								<StackPanel x:Name="QuaTang">
									<StackPanel.Style>
										<Style TargetType="StackPanel">
											<Setter Property="Visibility"
													Value="Collapsed" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding SelectedValue, ElementName=CbbLoaiUuDai}"
															 Value="{x:Static enums:PromotionType.HoaDonQua}">
													<Setter Property="Visibility"
															Value="Visible" />
												</DataTrigger>

												<DataTrigger Binding="{Binding SelectedValue, ElementName=CbbLoaiUuDai}"
															 Value="{x:Static enums:PromotionType.SachQua}">
													<Setter Property="Visibility"
															Value="Visible" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</StackPanel.Style>

									<TextBlock Text="QUÀ TẶNG"
											   FontWeight="Bold"
											   Foreground="{StaticResource DangerColor}"
											   Margin="4,0,0,8" />

									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="2*" />
											<ColumnDefinition Width="20" />
											<ColumnDefinition Width="1*" />
										</Grid.ColumnDefinitions>

										<components:FormComboBoxControl x:Name="cbbSachTang"
																		ItemsSource="{Binding ListSach}"
																		SelectedValue="{Binding EditingPromotion.ISBNTang, UpdateSourceTrigger=PropertyChanged}"
																		DisplayMemberPath="TenSach"
																		SelectedValuePath="ISBN"
																		Title="Tên sách tặng"
																		IconKind="Book"
																		IsRequired="True"
																		IsEditable="True" />

										<components:FormInputControl x:Name="txtSoLuongTang"
																	 TextValue="{Binding EditingPromotion.SoLuongTang, UpdateSourceTrigger=PropertyChanged}"
																	 Grid.Column="2"
																	 IsRequired="True"
																	 IconKind="Counting4"
																	 UnitText="quyển"
																	 Title="Số lượng tặng" />
									</Grid>
								</StackPanel>
							</StackPanel>
						</StackPanel>
					</ScrollViewer>

					<Grid Grid.Row="2"
						  Margin="0,0,0,0">
						<StackPanel Orientation="Horizontal"
									HorizontalAlignment="Right">
							<Button Content="HỦY BỎ"
									Command="{Binding ClosePopupCommand}"
									CommandParameter="{Binding}"
									Width="80"
									Margin="0,0,12,0"
									Style="{StaticResource OutlineButtonStyle}" />
							<Button Content="{Binding SaveButtonText, FallbackValue='LƯU ƯU ĐÃI'}"
									Command="{Binding SavePromotionCommand}"
									CommandParameter="{Binding}"
									Style="{StaticResource MainGradientButton}"
									Width="150"
									FontSize="13"
									FontWeight="SemiBold"
									Foreground="White"
									Cursor="Hand">
							</Button>
						</StackPanel>
					</Grid>

				</Grid>
			</Border>
		</Grid>
	</Grid>
</UserControl>