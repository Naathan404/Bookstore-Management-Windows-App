                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=CbbLoaiUuDai}" Value="1">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=CbbLoaiUuDai}" Value="3">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Cấu hình Quà tặng:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#10B981"/>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Style="{StaticResource BaseInputBorder}" Height="50" Margin="0">
                                                <Grid>
                                                    <TextBlock Text="Chọn Sách tặng (ISBN) *" FontSize="10" Margin="12,4,0,0" VerticalAlignment="Top">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#A3AED0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=cbbSachTang}" Value="">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=cbbSachTang}" Value="{x:Null}">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ComboBox x:Name="cbbSachTang" 
                                                          ItemsSource="{Binding ListSach}" 
                                                          SelectedValue="{Binding EditingPromotion.ISBNTang, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                          DisplayMemberPath="TenSach" 
                                                          SelectedValuePath="ISBN" 
                                                          TextSearch.TextPath="TenSach"
                                                          BorderThickness="0" Background="Transparent" 
                                                          VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"
                                                          IsEditable="True"
                                                          IsTextSearchEnabled="True"/>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Column="2" Style="{StaticResource BaseInputBorder}" Height="50" Margin="0">
                                                <Grid>
                                                    <TextBlock Text="Số lượng tặng *" FontSize="10" Margin="12,4,0,0" VerticalAlignment="Top">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#A3AED0"/>
                                                                <Style.Triggers>
