                                                                    <DataTrigger Binding="{Binding Text, ElementName=txtSoLuongTang}" Value="0">
                                                                        <Setter Property="Foreground" Value="#EF4444"></Setter>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=txtSoLuongTang}" Value="{x:Null}">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBox x:Name="txtSoLuongTang" Text="{Binding EditingPromotion.SoLuongTang, UpdateSourceTrigger=PropertyChanged}" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </StackPanel>

                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,15,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="HỦY BỎ" Command="{Binding ClosePopupCommand}" CommandParameter="{Binding}"
                        Width="120" Height="40" Margin="0,0,12,0" Style="{StaticResource OutlineButtonStyle}"/>
                            <Button Content="{Binding SaveButtonText, FallbackValue='LƯU ƯU ĐÃI'}" 
                        Command="{Binding SavePromotionCommand}" CommandParameter="{Binding}"
                        Style="{StaticResource MainGradientButton}"
                        Width="160" Height="40" FontSize="13" FontWeight="SemiBold" Foreground="White" Cursor="Hand">
                            </Button>
                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>