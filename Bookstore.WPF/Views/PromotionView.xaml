                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#A3AED0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=txtSoTienGiam}" Value="">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=txtSoTienGiam}" Value="{x:Null}">
