<UserControl x:Class="Bookstore.WPF.Views.PromotionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Background="#F4F7FE"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <Grid Background="{StaticResource BackgroundColor}">
        <Ellipse Width="400" Height="400" Fill="#F59E0B" Opacity="0.03"
                 VerticalAlignment="Top" HorizontalAlignment="Left" Margin="-150,-150,0,0" IsHitTestVisible="False"/>
        <Ellipse Width="300" Height="300" Fill="#EF4444" Opacity="0.03"
                 VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,-100,-100" IsHitTestVisible="False"/>

        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Card 1: Header -->
            <Border Grid.Row="0" Margin="0,0,0,12" Padding="20" CornerRadius="16"
                    Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Sale" Width="28" Height="28"
                                                 Foreground="#4318FF" Margin="0,0,10,0"/>
                        <TextBlock Text="ƯU ĐÃI" FontSize="24" FontWeight="Bold"
                                   Foreground="#2B3674" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource MainGradientButton}" 
                                Command="{Binding OpenAddPopupCommand}" Width="130" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Foreground="White" Margin="0,0,6,0"/>
                                <TextBlock Text="TẠO ƯU ĐÃI"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlineButtonStyle}" 
                                Command="{Binding ExportExcelCommand}" Width="120">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExcel" Width="16" Height="16" Foreground="#4318FF" Margin="0,0,6,0"/>
                                <TextBlock Text="XUẤT EXCEL"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 2: Search Filters -->
            <Border Grid.Row="1" Margin="0,0,0,12" Padding="20" CornerRadius="16"
                    Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource FilterBorderStyle}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Tag" Width="16" Height="16" Foreground="#A3AED0" 
                                                     VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchTenKM, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0 0 5 0" Background="Transparent" BorderThickness="0"
                                     VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                     FontSize="13" Foreground="#2B3674"
                                     materialDesign:HintAssist.Hint="Tên chương trình..."/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource FilterBorderStyle}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Shape" Width="16" Height="16" Foreground="#A3AED0" 
                                                     VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Background="Transparent" BorderThickness="0"
                                      Margin="0 0 5 0" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                      FontSize="13" Foreground="#2B3674"
                                      materialDesign:HintAssist.Hint="Loại ưu đãi"
                                      ItemsSource="{Binding ListLoaiUuDai}" 
                                      SelectedItem="{Binding SelectedLoaiUuDaiFilter}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource FilterBorderStyle}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16" Foreground="#A3AED0" 
                                                     VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Background="Transparent" BorderThickness="0"
                                      Margin="0 0 5 0" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                      FontSize="13" Foreground="#2B3674"
                                      materialDesign:HintAssist.Hint="Trạng thái"
                                      ItemsSource="{Binding ListTrangThai}" 
                                      SelectedItem="{Binding SelectedTrangThai}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource FilterBorderStyle}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Calendar" Width="16" Height="16" Foreground="#A3AED0" 
                                                     VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <DatePicker Grid.Column="1" 
                                        SelectedDate="{Binding SearchNgayApDung}"
                                        BorderThickness="0" Background="Transparent"
                                        VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                        FontSize="13" Foreground="#2B3674"
                                        materialDesign:HintAssist.Hint="Ngày áp dụng..."/>
                        </Grid>
                    </Border>

                    <Button Grid.Column="4" Width="42" Height="42" 
                            ToolTip="Xóa tất cả bộ lọc"
                            Command="{Binding ClearFilterCommand}"
                            Background="#FEE2E2" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <materialDesign:PackIcon Kind="FilterOff" Width="20" Height="20" 
                                                             Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="5" Width="42" Height="42" 
                            ToolTip="Làm mới"
                            Command="{Binding RefreshCommand}"
                            Background="#E0E7FF" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" 
                                                             Foreground="#4318FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Card 3: Danh sách ưu đãi -->
            <Border Grid.Row="2" CornerRadius="20" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                <DataGrid x:Name="PromotionDataGrid"
                          CanUserSortColumns="False" 
                          AutoGenerateColumns="False" 
                          ItemsSource="{Binding PagedPromotions}" 
                          SelectionMode="Extended" 
                          SelectionUnit="FullRow" 
                          IsReadOnly="True"
                          HeadersVisibility="Column" 
                          BorderThickness="0" 
                          MinRowHeight="52"
                          FontSize="13" 
                          AlternatingRowBackground="#F8FAFC" 
                          RowBackground="White"
                          Foreground="#2B3674" 
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0" 
                          VerticalGridLinesBrush="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False"
                          CanUserResizeColumns="False"
                          CanUserResizeRows="False" 
                          CanUserReorderColumns="False"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.IsDeferredScrollingEnabled="True"
                          SelectionChanged="PromotionDataGrid_SelectionChanged">

                    <DataGrid.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                            <Style.Triggers>
                                <Trigger Property="Orientation" Value="Vertical">
                                    <Setter Property="LayoutTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.4"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Margin" Value="0,0,2,0"/>
                                </Trigger>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="LayoutTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleY="0.4"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Margin" Value="0,0,0,2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Ưu Đãi" Binding="{Binding MaUuDai}" Width="110"
                                            HeaderStyle="{StaticResource CenterHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#4318FF"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Tên chương trình" Binding="{Binding TenChuongTrinh}" Width="220">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Loại ưu đãi" Binding="{Binding LoaiUuDai}" Width="210">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Đối tượng KH" Binding="{Binding LoaiKhachHangApDung}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Thời gian áp dụng" Width="190" HeaderStyle="{StaticResource CenterHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#2B3674">
                                            <Run Text="Từ: "/>
                                            <Run Text="{Binding ThoiGianBatDau, StringFormat='dd/MM/yyyy'}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="#A3AED0">
                                            <Run Text="Đến: "/>
                                            <Run Text="{Binding ThoiGianKetThuc, StringFormat='dd/MM/yyyy'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Số lượng" Width="110" HeaderStyle="{StaticResource CenterHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding SoLuongDaDung}" FontWeight="SemiBold" Foreground="#10B981"/>
                                        <TextBlock Text=" / " Foreground="#A3AED0"/>
                                        <TextBlock Text="{Binding SoLuongToiDaDisplay}" Foreground="#A3AED0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Trạng thái" Width="130" HeaderStyle="{StaticResource CenterHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Background="{Binding TrangThaiBackground}">
                                        <TextBlock Text="{Binding TrangThai}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding TrangThaiForeground}" HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Thao tác" Width="170" HeaderStyle="{StaticResource CenterHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Width="32" Height="32" BorderThickness="0" Cursor="Hand" Margin="0,0,4,0"
                                                Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" CornerRadius="6" Background="{Binding ToggleButtonBackground}">
                                                        <materialDesign:PackIcon Kind="{Binding ToggleButtonIcon}" Width="15" Height="15"
                                                                                 Foreground="{Binding ToggleButtonForeground}"
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button Width="32" Height="32" Background="#E0E7FF" BorderThickness="0" Cursor="Hand" 
                                                ToolTip="Sửa" Margin="0,0,4,0"
                                                Command="{Binding DataContext.OpenEditPopupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <materialDesign:PackIcon Kind="Edit" Width="15" Height="15" Foreground="#4318FF" 
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button Width="32" Height="32" Background="#FEE2E2" BorderThickness="0" Cursor="Hand" 
                                                ToolTip="Xóa"
                                                Command="{Binding DataContext.DeletePromotionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <materialDesign:PackIcon Kind="Delete" Width="15" Height="15" Foreground="#EF4444" 
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="*" HeaderStyle="{StaticResource CenterHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Card 4: Pagination -->
            <Border Grid.Row="3" Margin="0,12,0,0" Padding="12,8" CornerRadius="12" 
                    Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource PaginationButtonStyle}" Command="{Binding FirstPageCommand}" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="ChevronDoubleLeft" Width="16" Height="16" Foreground="#A3AED0"/>
                    </Button>
                    <Button Style="{StaticResource PaginationButtonStyle}" Command="{Binding PrevPageCommand}" Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16" Foreground="#A3AED0"/>
                    </Button>
                    <ItemsControl ItemsSource="{Binding PageNumbers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Margin="0,0,4,0" Style="{StaticResource PaginationButtonStyle}"
                                        Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource PaginationButtonStyle}" Command="{Binding NextPageCommand}" Margin="8,0,0,0">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" Foreground="#A3AED0"/>
                    </Button>
                    <Button Style="{StaticResource PaginationButtonStyle}" Command="{Binding LastPageCommand}" Margin="4,0,0,0">
                        <materialDesign:PackIcon Kind="ChevronDoubleRight" Width="16" Height="16" Foreground="#A3AED0"/>
                    </Button>
                    <TextBlock FontSize="12" Foreground="#A3AED0" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Run Text="Trang "/>
                        <Run Text="{Binding CurrentPage}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Pop up -->
        <Grid Background="Transparent" 
              VerticalAlignment="Stretch" 
              HorizontalAlignment="Stretch" 
              Panel.ZIndex="1000"
              Visibility="{Binding IsPopupVisible, Converter={StaticResource BoolToVis}}">

            <Border Background="#80000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ClosePopupCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border Width="820" MaxHeight="680" Background="White" CornerRadius="20" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="TicketPercent" Width="26" Height="26" Foreground="#4318FF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PopupTitle, FallbackValue='THIẾT LẬP CHIẾN LƯỢC ƯU ĐÃI SEMANTIC'}" FontSize="20" FontWeight="Bold" Foreground="#2B3674" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15" Padding="0,0,10,0">
                        <StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,12">
                                        <Grid>
                                            <TextBlock Text="Tên chương trình ưu đãi *" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                            <TextBox Text="{Binding EditingPromotion.TenChuongTrinh, UpdateSourceTrigger=PropertyChanged}" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                        </Grid>
                                    </Border>

                                    <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,12">
                                        <Grid>
                                            <TextBlock Text="Mã Code Voucher (VD: HALLOWEEN2026) *" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                            <TextBox Text="{Binding EditingPromotion.MaCode, UpdateSourceTrigger=PropertyChanged}" FontSize="13" FontWeight="SemiBold" Foreground="#4318FF" CharacterCasing="Upper" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                        </Grid>
                                    </Border>

                                    <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,12">
                                        <Grid>
                                            <TextBlock Text="Số lượng phát hành tối đa *" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                            <TextBox Text="{Binding EditingPromotion.SoLuongToiDa}" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                        </Grid>
                                    </Border>

                                    <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,12">
                                        <Grid>
                                            <TextBlock Text="Số điểm tích lũy cần đổi (Nhập 0 nếu miễn phí)" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                            <TextBox Text="{Binding EditingPromotion.DiemQuyDoi}" FontSize="13" FontWeight="Bold" Foreground="#F59E0B" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,12">
                                        <Grid>
                                            <TextBlock Text="Ngày có hiệu lực *" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                            <DatePicker SelectedDate="{Binding EditingPromotion.NgayBatDau}" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,4" Padding="0"/>
                                        </Grid>
                                    </Border>

                                    <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,12">
                                        <Grid>
                                            <TextBlock Text="Ngày hết hạn *" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                            <DatePicker SelectedDate="{Binding EditingPromotion.NgayKetThuc}" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,4" Padding="0"/>
                                        </Grid>
                                    </Border>

                                    <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,12">
                                        <Grid>
                                            <TextBlock Text="Giá trị đơn hàng tối thiểu bắt buộc (VNĐ)" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                            <TextBox Text="{Binding EditingPromotion.GiaTriToiThieuDonHang}" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                        </Grid>
                                    </Border>

                                    <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,12">
                                        <Grid>
                                            <TextBlock Text="Liên kết chiến dịch / Sự kiện (Tùy chọn)" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                            <ComboBox ItemsSource="{Binding MarketingEvents}" SelectedValue="{Binding EditingPromotion.MaSuKien}" DisplayMemberPath="TenSuKien" SelectedValuePath="MaSuKien" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Đối tượng khách hàng áp dụng (Ontology Target Roles) *" FontSize="11" FontWeight="Bold" Foreground="#2B3674" Margin="5,8,0,4"/>
                            <Border CornerRadius="10" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" Padding="12,10" Margin="0,0,0,15">
                                <WrapPanel>
                                    <CheckBox IsChecked="{Binding EditingPromotion.IsTargetMember}" Content="Member (Khách tích điểm)" Style="{StaticResource MaterialDesignFilterChipCheckBox}" Margin="0,0,10,8" Background="#4318FF"/>
                                    <CheckBox IsChecked="{Binding EditingPromotion.IsTargetVIP}" Content="VIP_Member (Khách VIP đặc quyền)" Style="{StaticResource MaterialDesignFilterChipCheckBox}" Margin="0,0,10,8" Background="#F59E0B"/>
                                    <CheckBox IsChecked="{Binding EditingPromotion.IsTargetLost}" Content="LostCustomer (Khách đã lâu chưa ghé)" Style="{StaticResource MaterialDesignFilterChipCheckBox}" Margin="0,0,10,8" Background="#EF4444"/>
                                    <CheckBox IsChecked="{Binding EditingPromotion.IsTargetRetention}" Content="Retention (Khách hàng thân thiết duy trì)" Style="{StaticResource MaterialDesignFilterChipCheckBox}" Margin="0,0,0,8" Background="#10B981"/>
                                </WrapPanel>
                            </Border>

                            <TextBlock Text="Cấu hình luật hình thức giảm giá (Ontology Reasoning Rules)" FontSize="11" FontWeight="Bold" Foreground="#2B3674" Margin="5,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,12">
                                    <Grid>
                                        <TextBlock Text="Hình thức ưu đãi *" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                        <ComboBox x:Name="TypeComboBox" SelectedIndex="{Binding EditingPromotion.LoaiUuDai}" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0">
                                            <ComboBoxItem Content="Giảm giá theo % hóa đơn"/>
                                            <ComboBoxItem Content="Giảm tiền mặt trực tiếp trên hóa đơn"/>
                                            <ComboBoxItem Content="Giảm giá sản phẩm (Sách) cụ thể"/>
                                            <ComboBoxItem Content="Tặng kèm sản phẩm khi mua hàng"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,12">
                                    <Grid>
                                        <TextBlock Text="Phạm vi áp dụng *" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                        <ComboBox x:Name="ScopeComboBox" SelectedIndex="{Binding EditingPromotion.PhamViApDung}" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0">
                                            <ComboBoxItem Content="Áp dụng cho toàn bộ cửa hàng"/>
                                            <ComboBoxItem Content="Áp dụng theo Thể loại danh mục (Ontology SubClass)"/>
                                            <ComboBoxItem Content="Áp dụng cho từng sản phẩm (Individual SKU) cụ thể"/>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=ScopeComboBox}" Value="1">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <TextBlock Text="Chọn thể loại sách áp dụng (Ontology SubClass) *" FontSize="10" Foreground="#4318FF" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                    <ComboBox ItemsSource="{Binding CategoriesList}" SelectedValue="{Binding EditingPromotion.MaTheLoai}" DisplayMemberPath="TenTheLoai" SelectedValuePath="MaTheLoai" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                </Grid>
                            </Border>

                            <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=ScopeComboBox}" Value="2">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <TextBlock Text="Tìm kiếm &amp; Chọn sách áp dụng định danh (Individual SKU) *" FontSize="10" Foreground="#4318FF" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                    <ComboBox ItemsSource="{Binding ListSach}" SelectedValue="{Binding EditingPromotion.MaSachApDung}" DisplayMemberPath="TenSach" SelectedValuePath="MaSach" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                </Grid>
                            </Border>

                            <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=TypeComboBox}" Value="3">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <TextBlock FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Mức ưu đãi giảm giá *"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=TypeComboBox}" Value="0">
                                                        <Setter Property="Text" Value="Phần trăm giảm giá hóa đơn (%) *"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=TypeComboBox}" Value="1">
                                                        <Setter Property="Text" Value="Số tiền giảm trực tiếp trên hóa đơn (VNĐ) *"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedIndex, ElementName=TypeComboBox}" Value="2">
                                                        <Setter Property="Text" Value="Phần trăm giảm giá riêng cho sản phẩm (%) *"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Text="{Binding EditingPromotion.GiaTriUuDai, UpdateSourceTrigger=PropertyChanged}" FontSize="13" FontWeight="Bold" Foreground="#10B981" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                </Grid>
                            </Border>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=TypeComboBox}" Value="3">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,12">
                                        <Grid>
                                            <TextBlock Text="Chọn sản phẩm quà tặng đi kèm (Gift SKU) *" FontSize="10" Foreground="#FF5B3C" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                            <ComboBox ItemsSource="{Binding ListSach}" SelectedValue="{Binding EditingPromotion.MaSachTang}" DisplayMemberPath="TenSach" SelectedValuePath="MaSach" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" Margin="0,0,0,12">
                                        <Grid>
                                            <TextBlock Text="Số lượng tặng *" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                            <TextBox Text="{Binding EditingPromotion.SoLuongTang}" FontSize="13" FontWeight="Bold" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Information" Foreground="#A3AED0" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Vui lòng kiểm tra kỹ các ràng buộc Ontology trước khi lưu cấu hình." FontSize="11" Foreground="#A3AED0" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="HỦY BỎ" Command="{Binding ClosePopupCommand}" Width="120" Height="40" Margin="0,0,12,0" Style="{StaticResource OutlineButtonStyle}"/>
                            <Button Style="{StaticResource MainGradientButton}"
                                Content="{Binding SaveButtonText, FallbackValue='LƯU CHIẾN LƯỢC'}" Command="{Binding SavePromotionCommand}" Width="160" Height="40" FontSize="13" FontWeight="SemiBold" Foreground="White" Cursor="Hand">
                            </Button>
                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>