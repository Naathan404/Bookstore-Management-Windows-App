                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#A3AED0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=txtSoLuongToiDa}" Value="">
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Text, ElementName=txtSoLuongToiDa}" Value="{x:Null}">
                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox x:Name="txtSoLuongToiDa" Text="{Binding EditingPromotion.SoLuongToiDa, UpdateSourceTrigger=PropertyChanged}" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource BaseInputBorder}" Height="70" Margin="0,0,0,20">
                                <Grid>
                                    <TextBlock Text="Mô tả chương trình" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
