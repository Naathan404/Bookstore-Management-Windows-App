<Window x:Class="Bookstore.WPF.Views.MainView"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:views="clr-namespace:Bookstore.WPF.Views"
		xmlns:viewmodels="clr-namespace:Bookstore.WPF.ViewModels"
		xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
		mc:Ignorable="d"
		Title="Sahara Bookstore - Quản lý Nhà Sách"
		Height="768"
		Width="1366"
		WindowStartupLocation="CenterScreen"
		Background="#F4F7FE">

	<Window.Resources>
		<DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
			<views:DashboardView />
		</DataTemplate>

		<DataTemplate DataType="{x:Type viewmodels:SaleViewModel}">
			<views:SaleView />
		</DataTemplate>

		<DataTemplate DataType="{x:Type viewmodels:InvoiceViewModel}">
			<views:InvoiceView />
		</DataTemplate>

		<DataTemplate DataType="{x:Type viewmodels:SupplierViewModel}">
			<views:SupplierView />
		</DataTemplate>

		<DataTemplate DataType="{x:Type viewmodels:ProductViewModel}">
			<views:ProductView />
		</DataTemplate>

		<DataTemplate DataType="{x:Type viewmodels:CustomerViewModel}">
			<views:CustomerView />
		</DataTemplate>

		<DataTemplate DataType="{x:Type viewmodels:ImportViewModel}">
			<views:ImportView />
		</DataTemplate>

		<DataTemplate DataType="{x:Type viewmodels:PromotionViewModel}">
			<views:PromotionView />
		</DataTemplate>

		<DataTemplate DataType="{x:Type viewmodels:CategoryViewModel}">
			<views:CategoryView />
		</DataTemplate>

		<DataTemplate DataType="{x:Type viewmodels:ReportViewModel }">
			<views:ReportView />
		</DataTemplate>

		<DataTemplate DataType="{x:Type viewmodels:AccountViewModel}">
			<views:AccountView />
		</DataTemplate>

		<DataTemplate DataType="{x:Type viewmodels:SettingViewModel}">
			<views:SettingView />
		</DataTemplate>

		<DataTemplate DataType="{x:Type viewmodels:ReceiptViewModel}">
			<views:ReceiptView />
		</DataTemplate>

	</Window.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<Border Grid.Column="0"
				Panel.ZIndex="1">
			<Border.Effect>
				<DropShadowEffect BlurRadius="30"
								  Color="Black"
								  Opacity="0.5"
								  ShadowDepth="0" />
			</Border.Effect>
			<views:SidebarView DataContext="{Binding SidebarVM}"
							   Loaded="SidebarView_Loaded" />
		</Border>

		<Grid Grid.Column="1"
			  Background="{StaticResource BackgroundColor}">

			<Ellipse Width="400"
					 Height="400"
					 Fill="#4318FF"
					 Opacity="0.08"
					 VerticalAlignment="Top"
					 HorizontalAlignment="Left"
					 Margin="-150,-150,0,0"
					 IsHitTestVisible="False" />
			<Ellipse Width="300"
					 Height="300"
					 Fill="#2B3674"
					 Opacity="0.05"
					 VerticalAlignment="Bottom"
					 HorizontalAlignment="Right"
					 Margin="0,0,-100,-100"
					 IsHitTestVisible="False" />

			<ContentControl Content="{Binding CurrentView}"
							Margin="10" />

		</Grid>
	</Grid>
</Window>