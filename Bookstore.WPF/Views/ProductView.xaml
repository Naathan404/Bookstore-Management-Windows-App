<UserControl x:Class="Bookstore.WPF.Views.ProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Background="#F4F7FE"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Màu sắc -->
        <SolidColorBrush x:Key="PrimaryDarkColor" Color="#2B3674"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#4318FF"/>
        <SolidColorBrush x:Key="TextLightColor" Color="#A3AED0"/>
        <SolidColorBrush x:Key="BackgroundColor" Color="#F4F7FE"/>

        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="GradientButtonBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4318FF" Offset="0"/>
            <GradientStop Color="#5B3CFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Styles -->
        <Style x:Key="MainGradientButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource GradientButtonBrush}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>

                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#4318FF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" BorderBrush="#4318FF" BorderThickness="1.5" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>

                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OutlineExcelButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="Green"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" BorderBrush="Green" BorderThickness="1.5" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniAddButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#E0E7FF"/>
            <Setter Property="Foreground" Value="#4318FF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C7D2FE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#A5B4FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaginationButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2B3674"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F4F7FE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
        </Style>

        <Style x:Key="MaterialDesignFloatingHintTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,8,0,0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundColor}">
        <!-- Decorative Circles -->
        <Ellipse Width="400" Height="400" Fill="#4318FF" Opacity="0.03"
                 VerticalAlignment="Top" HorizontalAlignment="Left" Margin="-150,-150,0,0" IsHitTestVisible="False"/>
        <Ellipse Width="300" Height="300" Fill="#2B3674" Opacity="0.03"
                 VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,-100,-100" IsHitTestVisible="False"/>

        <!-- NỘI DUNG CHÍNH -->
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Card 1: Header -->
            <Border Grid.Row="0" Margin="0,0,0,12" Padding="20" CornerRadius="16"
                    Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="BookSearch" Width="28" Height="28"
                                                 Foreground="#4318FF" Margin="0,0,10,0"/>
                        <TextBlock Text="TRA CỨU SÁCH" FontSize="24" FontWeight="Bold"
                                   Foreground="#2B3674" VerticalAlignment="Center"/>
                    </StackPanel>


                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource MainGradientButton}" CommandParameter="{Binding}" Width="100" Margin="0,0,10,0" Command="{Binding OpenAddPopupCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Foreground="White" Margin="0,0,6,0"/>
                                <TextBlock Text="THÊM"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlineExcelButtonStyle}" CommandParameter="{Binding}" Width="120" Command="{Binding ExportExcelCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExcel" Width="16" Height="16" Foreground="Green" Margin="0,0,6,0"/>
                                <TextBlock Text="XUẤT EXCEL"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 2: Search Filters -->
            <Border Grid.Row="1" Margin="0,0,0,12" Padding="20" CornerRadius="16"
                Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource FilterBorderStyle}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Book" Width="16" Height="16" Foreground="#A3AED0" 
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchTenSach, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0 0 5 0"
                                 Background="Transparent" BorderThickness="0"
                                 VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                 FontSize="13" Foreground="#2B3674"
                                 materialDesign:HintAssist.Hint="Tên sách..."/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource FilterBorderStyle}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Account" Width="16" Height="16" Foreground="#A3AED0" 
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchTacGia, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0 0 5 0"
                                 Background="Transparent" BorderThickness="0"
                                 VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                 FontSize="13" Foreground="#2B3674"
                                 materialDesign:HintAssist.Hint="Tác giả..."/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource FilterBorderStyle}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Tag" Width="16" Height="16" Foreground="#A3AED0" 
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Background="Transparent" BorderThickness="0"
                                      Margin="0 0 5 0"
                                  VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                  FontSize="13" Foreground="#2B3674"
                                  materialDesign:HintAssist.Hint="Thể loại"
                                  ItemsSource="{Binding ListTheLoai}" SelectedItem="{Binding SelectedTheLoai}">
                                <ComboBox.Resources>
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                                        <Setter Property="MinWidth" Value="0"/>
                                        <Setter Property="MinHeight" Value="0"/>

                                        <Style.Triggers>
                                            <Trigger Property="Orientation" Value="Vertical">
                                                <Setter Property="Width" Value="6"/>
                                                <Setter Property="MaxWidth" Value="6"/>
                                                <Setter Property="Margin" Value="0,0,2,0"/>
                                            </Trigger>

                                            <Trigger Property="Orientation" Value="Horizontal">
                                                <Setter Property="Height" Value="6"/>
                                                <Setter Property="MaxHeight" Value="6"/>
                                                <Setter Property="Margin" Value="0,0,0,2"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Resources>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource FilterBorderStyle}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="CashSync" Width="18" Height="18" Foreground="#A3AED0" 
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Background="Transparent" BorderThickness="0" 
                                  VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                  FontSize="13" Foreground="#2B3674"
                                  materialDesign:HintAssist.Hint="Khoảng giá"
                                  SelectedIndex="{Binding SelectedPriceRangeIndex}"
                                      Margin="0 0 5 0">
                                <ComboBoxItem Content="Tất cả mức giá"/>
                                <ComboBoxItem Content="Dưới 50.000đ"/>
                                <ComboBoxItem Content="50.000đ - 100.000đ"/>
                                <ComboBoxItem Content="100.000đ - 200.000đ"/>
                                <ComboBoxItem Content="Trên 200.000đ"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource FilterBorderStyle}" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="PackageVariant" Width="16" Height="16" Foreground="#A3AED0" 
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchTonKho, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0 0 5 0"
                                 Background="Transparent" BorderThickness="0" 
                                 VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                 FontSize="13" Foreground="#2B3674" 
                                 materialDesign:HintAssist.Hint="Tồn kho..."/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="5" Background="#F4F7FE" CornerRadius="10" Padding="15,0" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Tổng:" Foreground="#A3AED0" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalRecords}" FontWeight="Bold" Foreground="#4318FF" FontSize="15" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="6" Width="42" Height="42" 
                        ToolTip="Xóa tất cả bộ lọc"
                        Command="{Binding ClearFilterCommand}" CommandParameter="{Binding}"
                        Background="#FEE2E2" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <materialDesign:PackIcon Kind="FilterOff" Width="20" Height="20" 
                                                         Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Card 3: Danh sách sách -->
            <Border Grid.Row="2" CornerRadius="20" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                <DataGrid Grid.Row="1" CanUserSortColumns="False" AutoGenerateColumns="False" ItemsSource="{Binding PagedBooks}" 
                              SelectionMode="Single" SelectionUnit="FullRow" IsReadOnly="True"
                              HeadersVisibility="Column" BorderThickness="0" MinRowHeight="52"
                              FontSize="13" AlternatingRowBackground="#F8FAFC" RowBackground="White"
                              Foreground="#2B3674" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeColumns="False"
                              CanUserResizeRows="False" CanUserReorderColumns="False"
                                VirtualizingStackPanel.IsVirtualizing="True"
                                VirtualizingStackPanel.VirtualizationMode="Recycling"
                                ScrollViewer.IsDeferredScrollingEnabled="True">

                    <DataGrid.Resources>
                        <!-- Style Mặc định cho Header-->
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                            <Style.Triggers>
                                <Trigger Property="Orientation" Value="Vertical">
                                    <Setter Property="LayoutTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.4"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Margin" Value="0,0,2,0"/>
                                </Trigger>

                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="LayoutTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleY="0.4"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Margin" Value="0,0,0,2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#2B3674"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Height" Value="44"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>

                        <!-- Style Header-->
                        <Style x:Key="CenterHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>

                        <!-- Style Header -->
                        <Style x:Key="RightHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <!-- Đệm lề-->
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E0E7FF"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F3F4F6"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- Cột STT-->
                        <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="45" HeaderStyle="{StaticResource CenterHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#A3AED0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}"
                                                                Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Cột Tên Sách-->
                        <DataGridTextColumn Header="Tên sách" Binding="{Binding TenSach}" Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Cột Tác Giả -->
                        <DataGridTemplateColumn Header="Tác giả" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding DanhSachTacGia}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#EEF2FF" CornerRadius="6" Padding="6,2" Margin="0,2,4,2">
                                                    <TextBlock Text="{Binding TenTacGia}" Foreground="#4318FF" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Cột Thể Loại -->
                        <DataGridTemplateColumn Header="Thể loại" Width="150" HeaderStyle="{StaticResource CenterHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- Màu Nền Mặc định (Nếu thể loại không nằm trong danh sách dưới) -->
                                                <Setter Property="Background" Value="#F3F4F6"/>

                                                <Style.Triggers>
                                                    <!-- Công nghệ thông tin: Tone Xanh dương -->
                                                    <DataTrigger Binding="{Binding TheLoai}" Value="Công nghệ thông tin">
                                                        <Setter Property="Background" Value="#DBEAFE"/>
                                                    </DataTrigger>
                                                    <!-- Văn học nghệ thuật: Tone Hồng -->
                                                    <DataTrigger Binding="{Binding TheLoai}" Value="Văn học nghệ thuật">
                                                        <Setter Property="Background" Value="#FCE7F3"/>
                                                    </DataTrigger>
                                                    <!-- Kinh tế - Quản trị: Tone Xanh ngọc -->
                                                    <DataTrigger Binding="{Binding TheLoai}" Value="Kinh tế - Quản trị">
                                                        <Setter Property="Background" Value="#D1FAE5"/>
                                                    </DataTrigger>
                                                    <!-- Tâm lý - Kỹ năng sống: Tone Tím -->
                                                    <DataTrigger Binding="{Binding TheLoai}" Value="Tâm lý - Kỹ năng sống">
                                                        <Setter Property="Background" Value="#EDE9FE"/>
                                                    </DataTrigger>
                                                    <!-- Truyện tranh: Tone Cam/Vàng -->
                                                    <DataTrigger Binding="{Binding TheLoai}" Value="Truyện tranh">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                    <!-- Thiếu nhi: Tone Xanh lá nhạt -->
                                                    <DataTrigger Binding="{Binding TheLoai}" Value="Thiếu nhi">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <!-- ĐỊNH DẠNG MÀU CHỮ BÊN TRONG -->
                                        <TextBlock FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <!-- Chữ Mặc định (Xám đậm) -->
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Setter Property="Text" Value="{Binding TheLoai}"/>
                                                    <Style.Triggers>
                                                        <!-- Công nghệ thông tin -->
                                                        <DataTrigger Binding="{Binding TheLoai}" Value="Công nghệ thông tin">
                                                            <Setter Property="Foreground" Value="#1D4ED8"/>
                                                        </DataTrigger>
                                                        <!-- Văn học nghệ thuật -->
                                                        <DataTrigger Binding="{Binding TheLoai}" Value="Văn học nghệ thuật">
                                                            <Setter Property="Foreground" Value="#BE185D"/>
                                                        </DataTrigger>
                                                        <!-- Kinh tế - Quản trị -->
                                                        <DataTrigger Binding="{Binding TheLoai}" Value="Kinh tế - Quản trị">
                                                            <Setter Property="Foreground" Value="#047857"/>
                                                        </DataTrigger>
                                                        <!-- Tâm lý - Kỹ năng sống -->
                                                        <DataTrigger Binding="{Binding TheLoai}" Value="Tâm lý - Kỹ năng sống">
                                                            <Setter Property="Foreground" Value="#6D28D9"/>
                                                        </DataTrigger>
                                                        <!-- Truyện tranh -->
                                                        <DataTrigger Binding="{Binding TheLoai}" Value="Truyện tranh">
                                                            <Setter Property="Foreground" Value="#B45309"/>
                                                        </DataTrigger>
                                                        <!-- Thiếu nhi -->
                                                        <DataTrigger Binding="{Binding TheLoai}" Value="Thiếu nhi">
                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Cột Tồn Kho  -->
                        <DataGridTextColumn Header="Tồn kho" Binding="{Binding SoLuongTonKho}" Width="80" 
                    HeaderStyle="{StaticResource CenterHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"></Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SoLuongTonKho}" Value="0">
                                            <Setter Property="Foreground" Value="#EF4444"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Cột Đã Bán  -->
                        <DataGridTextColumn Header="Đã bán" Binding="{Binding TongDaBan}" Width="80" 
                    HeaderStyle="{StaticResource CenterHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Cột Giá Niêm Yết -->
                        <DataGridTextColumn Header="Giá Niêm Yết" Binding="{Binding GiaNiemYet, StringFormat={}{0:N0} đ}" Width="100" 
                    HeaderStyle="{StaticResource RightHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"></Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Cột Đơn Giá -->
                        <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGiaBan, StringFormat={}{0:N0} đ}" Width="100" 
                    HeaderStyle="{StaticResource RightHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Cột Nút Hành Động -->
                        <DataGridTemplateColumn Header="Thao tác" Width="120" HeaderStyle="{StaticResource CenterHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Nút Sửa -->
                                        <Button Width="32" Height="32" Background="#E0E7FF" BorderThickness="0" Cursor="Hand" ToolTip="Sửa"
                                                    Command="{Binding DataContext.OpenEditPopupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <materialDesign:PackIcon Kind="Edit" Width="15" Height="15" Foreground="#4318FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Nút Xóa -->
                                        <Button Width="32" Height="32" Background="#FEE2E2" BorderThickness="0" Cursor="Hand" ToolTip="Xóa" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <materialDesign:PackIcon Kind="Delete" Width="15" Height="15" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Card 4: Pagination -->
            <Border Grid.Row="3" Margin="0,12,0,0" Padding="12,8" CornerRadius="12" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource PaginationButtonStyle}" Command="{Binding FirstPageCommand}" CommandParameter="{Binding}" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="ChevronDoubleLeft" Width="16" Height="16" Foreground="#A3AED0"/>
                    </Button>
                    <Button Style="{StaticResource PaginationButtonStyle}" Command="{Binding PrevPageCommand}" CommandParameter="{Binding}" Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16" Foreground="#A3AED0"/>
                    </Button>

                    <ItemsControl ItemsSource="{Binding PageNumbers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Margin="0,0,4,0" Style="{StaticResource PaginationButtonStyle}"
                                        Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{StaticResource PaginationButtonStyle}" Command="{Binding NextPageCommand}" CommandParameter="{Binding}" Margin="8,0,0,0">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" Foreground="#A3AED0"/>
                    </Button>
                    <Button Style="{StaticResource PaginationButtonStyle}" Command="{Binding LastPageCommand}" CommandParameter="{Binding}" Margin="4,0,0,0">
                        <materialDesign:PackIcon Kind="ChevronDoubleRight" Width="16" Height="16" Foreground="#A3AED0"/>
                    </Button>

                    <TextBlock Text="{Binding CurrentPage, StringFormat='Trang {0}'}" FontSize="12" Foreground="#A3AED0" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== POPUP THÊM SÁCH ==================== -->
        <Grid Background="#80000000" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="1000"
              Visibility="{Binding IsAddPopupVisible}">

            <Border Background="#80000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ClosePopupCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border Width="680" Height="520" Background="White" CornerRadius="20" BorderBrush="#E2E8F0" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="{Binding PopupIcon}" Width="26" Height="26" Foreground="#4318FF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PopupTitle}" FontSize="20" FontWeight="Bold" Foreground="#2B3674" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- KHU VỰC CHIA TAB -->
                    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,0,0,20">
                        <TabControl.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                                <Style.Triggers>
                                    <Trigger Property="Orientation" Value="Vertical">
                                        <Setter Property="LayoutTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.4"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Margin" Value="0,0,2,0"/>
                                    </Trigger>

                                    <Trigger Property="Orientation" Value="Horizontal">
                                        <Setter Property="LayoutTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleY="0.4"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Margin" Value="0,0,0,2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <!-- Style cực xịn cho Nút chuyển Tab -->
                            <Style TargetType="TabItem">
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#A3AED0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,0,15,15"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="#4318FF"/>
                                        <Setter Property="BorderBrush" Value="#4318FF"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#4318FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TabControl.Resources>

                        <!-- ================= TAB 1: THÔNG TIN TÁC PHẨM ================= -->
                        <TabItem Header="1. THÔNG TIN ĐẦU SÁCH">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <Grid Margin="0,0,15,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5,0,20" HorizontalAlignment="Center">
                                        <RadioButton IsChecked="{Binding IsNewProduct}"/>
                                        <TextBlock Text="Đầu sách mới" FontSize="15" VerticalAlignment="Center" FontWeight="Bold" Cursor="Hand" Foreground="#2B3674"
                                                   Margin="0 0 30 0"></TextBlock>
                                        <RadioButton IsChecked="{Binding IsOldProduct}"/>
                                        <TextBlock Text="Đầu sách cũ" FontSize="15" VerticalAlignment="Center" FontWeight="Bold" Cursor="Hand" Foreground="#2B3674"></TextBlock>
                                    </StackPanel>

                                    <Border Grid.Row="1" Margin="0,0,0,20" CornerRadius="10" Background="#F8FAFC" BorderBrush="#4318FF" BorderThickness="1.5" Padding="15">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOldProduct}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <TextBlock Text="Tìm đầu sách gốc để thêm phiên bản mới *" FontSize="11" Foreground="#4318FF" FontWeight="Bold" Margin="4,-8,0,0" VerticalAlignment="Top"/>
                                            <ComboBox ItemsSource="{Binding ListTacPhamGoc}" 
                                              SelectedItem="{Binding SelectedTacPhamGoc}"
                                              DisplayMemberPath="TenSach" 
                                              IsEditable="True"
                                              materialDesign:HintAssist.Hint="Nhập tên sách để tìm nhanh..."
                                              FontSize="14" Foreground="#2B3674" Background="Transparent" BorderThickness="0"
                                              Margin="0,10,0,0"/>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="2" IsEnabled="{Binding IsNewProduct}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="180" Height="200" CornerRadius="14" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="2" ClipToBounds="True" Cursor="Hand" VerticalAlignment="Top">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding ChangeImageCommand}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Image Source="{Binding EditingBook.HinhAnh}" Stretch="UniformToFill" HorizontalAlignment="Center"/>
                                                <Border Background="#99000000" VerticalAlignment="Bottom" Height="30">
                                                    <TextBlock Text="Đổi ảnh" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="2">
                                            <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="55" Margin="0,0,0,15">
                                                <Grid>
                                                    <TextBlock Text="Tên đầu sách *" FontSize="10" Margin="12,4,0,0" VerticalAlignment="Top">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#A3AED0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EditingBook.TenSach, TargetNullValue=''}" Value="">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBox Text="{Binding EditingBook.TenSach}" FontSize="14" FontWeight="Bold" Foreground="#2B3674" BorderThickness="0" Margin="10,0,10,5" VerticalAlignment="Bottom"/>
                                                </Grid>
                                            </Border>
                                            <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" MinHeight="46" Margin="0,0,0,15">
                                                <Grid Margin="10,4,10,6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Tác giả *" FontSize="10" VerticalAlignment="Top">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#A3AED0"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EditingBook.DanhSachTacGia.Count, TargetNullValue=0}" Value="0">
                                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <ComboBox x:Name="cbbTacGia_Add" Grid.Column="0" ItemsSource="{Binding ListTatCaTacGia}" 
                                                                  SelectedItem="{Binding SelectedTacGiaToAdd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  DisplayMemberPath="TenTacGia" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False"
                                                                  Text="{Binding InputTacGiaText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                  materialDesign:HintAssist.Hint="Tìm tác giả"
                                                                  FontSize="13" Foreground="#2B3674" BorderThickness="0" Background="Transparent" Margin="-4,14,0,0" Padding="4"/>

                                                        <Button Grid.Column="1" Style="{StaticResource MiniAddButtonStyle}" 
                                                            Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Thêm tác giả mới"
                                                            Command="{Binding AddNewTacGiaCommand}" 
                                                            CommandParameter="{Binding Text, ElementName=cbbTacGia_Add}">
                                                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Foreground="#4318FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </Grid>

                                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding EditingBook.DanhSachTacGia}" Margin="0,5,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>

                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <materialDesign:Chip Content="{Binding TenTacGia}" 
                                                                 IsDeletable="True" 
                                                                 DeleteCommand="{Binding DataContext.RemoveTacGiaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  
                                                                 DeleteCommandParameter="{Binding}"
                                                                 Background="#EEF2FF" Foreground="#4318FF" 
                                                                 Height="26" FontSize="12" Margin="0,0,6,6"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                            <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="55">
                                                <Grid Margin="10,4,10,0" >
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Thể loại *" FontSize="10" Margin="0,4,0,2" VerticalAlignment="Top">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#A3AED0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EditingBook.TheLoai, TargetNullValue=''}" Value="">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <ComboBox x:Name="cbbTheLoai_Add" Grid.Column="0" ItemsSource="{Binding ListTheLoaiTaoSach}" SelectedItem="{Binding EditingBook.TheLoai}" 
                                                          IsEditable="True" StaysOpenOnEdit="True" Height="28"
                                                          FontSize="13" Foreground="#2B3674" BorderThickness="0" Margin="0,0,6,2" VerticalAlignment="Bottom"/>
                                                    <Button Grid.Column="1" Style="{StaticResource MiniAddButtonStyle}" 
                                                            Margin="6,0,0,2" VerticalAlignment="Center" ToolTip="Thêm thể loại mới"
                                                            Command="{Binding AddNewTheLoaiCommand}" 
                                                            CommandParameter="{Binding Text, ElementName=cbbTheLoai_Add}"
                                                            >
                                                        <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Foreground="#4318FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="3" Margin="0,15,0,0" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" MinHeight="100" IsEnabled="{Binding IsNewProduct}">
                                        <Grid>
                                            <TextBlock Text="Mô tả nội dung" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                            <TextBox Text="{Binding EditingBook.MoTa}" FontSize="13" Foreground="#4B5563" BorderThickness="0" 
                                                    Margin="10,22,10,10" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ================= TAB 2: CẤU HÌNH BÁN HÀNG ================= -->
                        <TabItem Header="2. CHI TIẾT SÁCH PHIÊN BẢN SÁCH">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <StackPanel Margin="0,10,0,0">

                                        <!-- Dòng 1: ISBN + Năm XB -->
                                        <!-- Dòng 1: ISBN + Năm XB -->
                                        <Grid Margin="0,0,0,15">
                                            <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="46">
                                                <Grid>
                                                    <TextBlock Text="Mã ISBN *" FontSize="10" Margin="12,4,0,0" VerticalAlignment="Top">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#A3AED0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EditingBook.ISBN, TargetNullValue=''}" Value="">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBox Text="{Binding EditingBook.ISBN}" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="46">
                                                <Grid>
                                                    <TextBlock Text="Năm xuất bản" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                                    <TextBox Text="{Binding EditingBook.NamXuatBan}" FontSize="13" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Column="2" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="46">
                                                <Grid>
                                                    <TextBlock Text="Lần tái bản" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                                    <TextBox Text="{Binding EditingBook.LanTaiBan}" FontSize="13" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- Dòng 2: Nhà xuất bản + Hình thức bìa -->
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="55">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Nhà xuất bản *" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Top">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#A3AED0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EditingBook.NhaXuatBan, TargetNullValue=''}" Value="">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <ComboBox x:Name="cbbNXB_Add" Grid.Column="0" ItemsSource="{Binding ListNhaXuatBan}" SelectedItem="{Binding EditingBook.NhaXuatBan}" 
                                                  IsEditable="True" StaysOpenOnEdit="True" materialDesign:HintAssist.IsFloating="False" Height="28"
                                                  FontSize="13" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,6,2"/>

                                                    <Button Grid.Column="1" Style="{StaticResource MiniAddButtonStyle}" 
                                                    Margin="6,0,5,2" VerticalAlignment="Center" ToolTip="Thêm nhà XB mới"
                                                    Command="{Binding AddNewNXBCommand}" 
                                                    CommandParameter="{Binding Text, ElementName=cbbNXB_Add}">
                                                        <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Foreground="#4318FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Column="2" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="55">
                                                <Grid>
                                                    <TextBlock Text="Hình thức bìa" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                                    <ComboBox ItemsSource="{Binding ListHinhThucBia}" 
                                                  SelectedItem="{Binding EditingBook.HinhThucBia}" 
                                                  FontSize="13" Foreground="#2B3674" 
                                                  BorderThickness="0" Background="Transparent" 
                                                  VerticalAlignment="Bottom" Margin="10,0,6,2" Height="28"/>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- Dòng 3: Giá bán -->
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="15"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="46">
                                                <Grid>
                                                    <TextBlock Text="Giá Niêm Yết (VNĐ)" FontSize="10" Foreground="#A3AED0"
                                                         Margin="12,4,0,0" VerticalAlignment="Top"/>
                                                    <TextBox Text="{Binding EditingBook.GiaNiemYet, Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="14" FontWeight="SemiBold" Foreground="#4318FF"
                                                         BorderThickness="0" Background="Transparent"
                                                         VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"
                                                         HorizontalContentAlignment="Right"/>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Column="2" CornerRadius="10" Background="White" BorderBrush="#E2E8F0"
                                                    BorderThickness="1.5" Height="46">
                                                <Grid>
                                                    <TextBlock Text="Đơn giá bán (VNĐ)" FontSize="10" Foreground="#A3AED0"
                                                        Margin="12,4,0,0" VerticalAlignment="Top"/>
                                                    <TextBox Text="{Binding EditingBook.DonGiaBan, Mode=TwoWay,
                                                                    UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="14" FontWeight="SemiBold" Foreground="#10B981"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"
                                                     HorizontalContentAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- Dòng 4: Tồn kho & Đã bán -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="10" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Height="46">
                                                <Grid>
                                                    <TextBlock Text="Số lượng tồn" FontSize="10" Foreground="#9CA3AF" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                                    <TextBox Text="{Binding EditingBook.SoLuongTonKho}" FontSize="13" FontWeight="Bold" Foreground="#9CA3AF" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0" HorizontalContentAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="HỦY BỎ" Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding ClosePopupCommand}" CommandParameter="{Binding}" Width="120" Height="40" Margin="0,0,10,0" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                        </Button>
                        <Button Content="THÊM SÁCH" Command="{Binding SaveNewBookCommand}" CommandParameter="{Binding}"
                                Style="{StaticResource MainGradientButton}"
                                Width="140" Height="40" FontSize="13" FontWeight="SemiBold" Foreground="White" Cursor="Hand">
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>


        <!-- ==================== POPUP SỬA SÁCH ==================== -->
        <Grid Background="#80000000" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="1000"
      Visibility="{Binding IsEditPopupVisible}">

            <Border Background="#80000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ClosePopupCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border Width="680" Height="520" Background="White" CornerRadius="20" BorderBrush="#E2E8F0" BorderThickness="1"
            HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <materialDesign:PackIcon Kind="{Binding PopupIcon}" Width="26" Height="26" Foreground="#4318FF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PopupTitle}" FontSize="20" FontWeight="Bold" Foreground="#2B3674" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- KHU VỰC CHIA TAB -->
                    <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,0,0,20">
                        <TabControl.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                                <Style.Triggers>
                                    <Trigger Property="Orientation" Value="Vertical">
                                        <Setter Property="LayoutTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.4"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Margin" Value="0,0,2,0"/>
                                    </Trigger>

                                    <Trigger Property="Orientation" Value="Horizontal">
                                        <Setter Property="LayoutTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleY="0.4"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Margin" Value="0,0,0,2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                            <!-- Style cực xịn cho Nút chuyển Tab -->
                            <Style TargetType="TabItem">
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#A3AED0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Padding" Value="10,8"/>
                                <Setter Property="Margin" Value="0,0,15,15"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="#4318FF"/>
                                        <Setter Property="BorderBrush" Value="#4318FF"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#4318FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TabControl.Resources>

                        <!-- ================= TAB 1: THÔNG TIN TÁC PHẨM ================= -->
                        <TabItem Header="1. THÔNG TIN ĐẦU SÁCH">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <Grid Margin="0,0,15,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="12,2" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#EF4444" Width="20" Height="20" VerticalAlignment="Center"/>

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Chỉnh sửa ở đây sẽ áp dụng cho tất cả phiên bản sách của đầu sách này!" TextWrapping="Wrap" FontWeight="Bold" Foreground="#991B1B" FontSize="12"/>
                                                <TextBlock Text="" 
                                                    Foreground="#B91C1C" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                
                                                <ToggleButton IsChecked="{Binding IsEditMasterEnabled}" Cursor="Hand">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="border" Width="40" Height="22" CornerRadius="11" Background="#FCA5A5">
                                                                <Ellipse x:Name="knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#EF4444"/>
                                                                    <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1" IsEnabled="{Binding IsEditMasterEnabled}">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Opacity" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditMasterEnabled}" Value="False">
                                                        <Setter Property="Opacity" Value="0.6"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="180" Height="220" CornerRadius="14" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="2" ClipToBounds="True" Cursor="Hand" VerticalAlignment="Top">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding ChangeImageCommand}" CommandParameter="SelectImage"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Image Source="{Binding EditingBook.HinhAnh}" Stretch="UniformToFill" HorizontalAlignment="Center"/>
                                                <Border Background="#99000000" VerticalAlignment="Bottom" Height="30">
                                                    <TextBlock Text="Đổi ảnh" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="2">
                                            <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="46" Margin="0,0,0,15">
                                                <Grid>
                                                    <TextBlock Text="Tên đầu sách *" FontSize="10" Margin="12,4,0,0" VerticalAlignment="Top">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#A3AED0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EditingBook.TenSach, TargetNullValue=''}" Value="">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBox Text="{Binding EditingBook.TenSach}" FontSize="14" FontWeight="Bold" Foreground="#2B3674" BorderThickness="0" Margin="10,0,10,6" VerticalAlignment="Bottom"/>
                                                </Grid>
                                            </Border>
                                            <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" MinHeight="46" Margin="0,0,0,15">
                                                <Grid Margin="10,4,10,6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <!-- nút thêm tác giả mới-->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Tác giả *" FontSize="10" VerticalAlignment="Top">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#A3AED0"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EditingBook.DanhSachTacGia.Count, TargetNullValue=0}" Value="0">
                                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <ComboBox x:Name="cbbTacGia_Add1" Grid.Column="0" ItemsSource="{Binding ListTatCaTacGia}" 
                                                                      SelectedItem="{Binding SelectedTacGiaToAdd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      DisplayMemberPath="TenTacGia" IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False"
                                                                      Text="{Binding InputTacGiaText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      materialDesign:HintAssist.Hint="Tìm tác giả"
                                                                      FontSize="13" Foreground="#2B3674" BorderThickness="0" Background="Transparent" Margin="-4,14,0,0" Padding="4"/>

                                                        <Button Grid.Column="1" Style="{StaticResource MiniAddButtonStyle}" 
                                                                Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Thêm tác giả mới"
                                                                Command="{Binding AddNewTacGiaCommand}" 
                                                                CommandParameter="{Binding Text, ElementName=cbbTacGia_Add1}">
                                                            <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Foreground="#4318FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                    </Grid>

                                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding EditingBook.DanhSachTacGia}" Margin="0,5,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>

                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <materialDesign:Chip Content="{Binding TenTacGia}" 
                                                         IsDeletable="True" 
                                                         DeleteCommand="{Binding DataContext.RemoveTacGiaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         DeleteCommandParameter="{Binding}"
                                                         Background="#EEF2FF" Foreground="#4318FF" 
                                                         Height="26" FontSize="12" Margin="0,0,6,6"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                            <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="55">
                                                <Grid Margin="10,4,10,5" >
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Thể loại *" FontSize="10" Margin="0,4,0,2" VerticalAlignment="Top">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#A3AED0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EditingBook.TheLoai, TargetNullValue=''}" Value="">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <ComboBox x:Name="cbbTheLoai_Add1" Grid.Column="0" ItemsSource="{Binding ListTheLoaiTaoSach}" SelectedItem="{Binding EditingBook.TheLoai}" 
                                                          IsEditable="True" StaysOpenOnEdit="True"
                                                          FontSize="13" Foreground="#2B3674" BorderThickness="0" Margin="0,0,6,2" VerticalAlignment="Bottom"/>
                                                    <Button Grid.Column="1" Style="{StaticResource MiniAddButtonStyle}" 
                                                            Margin="6,0,0,2" VerticalAlignment="Bottom" ToolTip="Thêm thể loại mới"
                                                            Command="{Binding AddNewTheLoaiCommand}" 
                                                            CommandParameter="{Binding Text, ElementName=cbbTheLoai_Add1}">
                                                        <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Foreground="#4318FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <Border Grid.Row="2" Margin="0,15,0,0" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" MinHeight="100" IsEnabled="{Binding IsEditMasterEnabled}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditMasterEnabled}" Value="False">
                                                        <Setter Property="Opacity" Value="0.6"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid >
                                            <TextBlock Text="Mô tả nội dung" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                            <TextBox Text="{Binding EditingBook.MoTa}" FontSize="13" Foreground="#4B5563" BorderThickness="0" 
                     Margin="10,22,10,10" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ================= TAB 2: CẤU HÌNH BÁN HÀNG ================= -->
                        <TabItem Header="2. CHI TIẾT BẢN SÁCH">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <StackPanel Margin="0,10,0,0">

                                <!-- Dòng 1: ISBN + Năm XB -->
                                <Grid Margin="0,0,0,15">
                                    <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="50" IsEnabled="False">
                                        <Grid>
                                                    <TextBlock Text="Mã ISBN *" FontSize="10" Margin="12,4,0,0" VerticalAlignment="Top">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#A3AED0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EditingBook.ISBN, TargetNullValue=''}" Value="">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBox Text="{Binding EditingBook.ISBN}" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="46">
                                        <Grid>
                                            <TextBlock Text="Năm xuất bản" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                            <TextBox Text="{Binding EditingBook.NamXuatBan}" FontSize="13" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="46">
                                        <Grid>
                                            <TextBlock Text="Lần tái bản" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                            <TextBox Text="{Binding EditingBook.LanTaiBan}" FontSize="13" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Dòng 2: Nhà xuất bản + Hình thức bìa -->
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="55">
                                        <Grid Margin="0 5 5 0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="49*"/>
                                                <ColumnDefinition Width="216*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Nhà xuất bản *" FontSize="10" Margin="12,0,0,0" VerticalAlignment="Top">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#A3AED0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EditingBook.NhaXuatBan, TargetNullValue=''}" Value="">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <ComboBox x:Name="cbbNXB_Add1" Grid.Column="0" ItemsSource="{Binding ListNhaXuatBan}" SelectedItem="{Binding EditingBook.NhaXuatBan}" 
                                                  IsEditable="True" StaysOpenOnEdit="True" materialDesign:HintAssist.IsFloating="False" Height="28"
                                                  FontSize="13" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="12,15,6,5" Grid.ColumnSpan="2"/>

                                            <Button Grid.Column="2" Style="{StaticResource MiniAddButtonStyle}" 
                                                    Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Thêm nhà XB mới"
                                                    Command="{Binding AddNewNXBCommand}" 
                                                    CommandParameter="{Binding Text, ElementName=cbbNXB_Add1}">
                                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Foreground="#4318FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="55">
                                        <Grid>
                                            <TextBlock Text="Hình thức bìa" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                            <ComboBox ItemsSource="{Binding ListHinhThucBia}" 
                                          SelectedItem="{Binding EditingBook.HinhThucBia}" 
                                          FontSize="13" Foreground="#2B3674" 
                                          BorderThickness="0" Background="Transparent" 
                                          VerticalAlignment="Bottom" Margin="12,0,6,5" Height="28"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Dòng 3: Giá bán -->
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                            <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="46">
                                                <Grid>
                                                    <TextBlock Text="Giá Niêm Yết (VNĐ)" FontSize="10" Foreground="#A3AED0"
                                                         Margin="12,4,0,0" VerticalAlignment="Top"/>
                                                    <TextBox Text="{Binding EditingBook.GiaNiemYet, Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                                         FontSize="14" FontWeight="SemiBold" Foreground="#4318FF"
                                                         BorderThickness="0" Background="Transparent"
                                                         VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"
                                                         HorizontalContentAlignment="Right"/>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Column="2" CornerRadius="10" Background="White" BorderBrush="#E2E8F0"
                                                    BorderThickness="1.5" Height="46">
                                                <Grid>
                                                    <TextBlock Text="Đơn giá bán (VNĐ)" FontSize="10" Foreground="#A3AED0"
                                                        Margin="12,4,0,0" VerticalAlignment="Top"/>
                                                    <TextBox Text="{Binding EditingBook.DonGiaBan, Mode=TwoWay,
                                                                    UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="14" FontWeight="SemiBold" Foreground="#10B981"
                                                     BorderThickness="0" Background="Transparent"
                                                     VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"
                                                     HorizontalContentAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                <!-- Dòng 4: Tồn kho & Đã bán -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="15"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="10" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" Height="46">
                                        <Grid>
                                            <TextBlock Text="Số lượng tồn" FontSize="10" Foreground="#9CA3AF" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                            <TextBox Text="{Binding EditingBook.SoLuongTonKho}" IsReadOnly="True" FontSize="13" FontWeight="Bold" Foreground="#9CA3AF" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0" HorizontalContentAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="2" CornerRadius="10" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" Height="46">
                                        <Grid>
                                            <TextBlock Text="Đã bán" FontSize="10" Foreground="#9CA3AF" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                            <TextBox Text="{Binding EditingBook.TongDaBan}" IsReadOnly="True" FontSize="13" FontWeight="Bold" Foreground="#9CA3AF" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0" HorizontalContentAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                                </Grid>
                            </ScrollViewer> 
                        </TabItem>
                    </TabControl>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="HỦY BỎ" Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding ClosePopupCommand}" CommandParameter="Close" Width="120" Height="40" Margin="0,0,10,0" FontSize="13" FontWeight="SemiBold"  Cursor="Hand">
                        </Button>
                        <Button Content="LƯU THÔNG TIN" Style="{StaticResource MainGradientButton}"
                                Command="{Binding SaveEditBookCommand}" CommandParameter="Save" Width="140" Height="40" FontSize="13" FontWeight="SemiBold" Foreground="White" Cursor="Hand">
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>