<UserControl x:Class="Bookstore.WPF.Views.ProductView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 xmlns:popup="clr-namespace:Bookstore.WPF.Views.Popup"
			 mc:Ignorable="d">

	<Grid>
		<!-- NỘI DUNG CHÍNH -->
		<Grid x:Name="MainProductView"
			  Margin="{StaticResource MainViewMargin}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<components:PageHeaderControl Title="TRA CỨU SÁCH"
										  HeaderIcon="BookSearch"
										  AddTitle="THÊM SÁCH"
										  AddIcon="Plus"
										  AddCommand="{Binding OpenAddPopupCommand}"
										  AddCommandParameter="{Binding}"
										  ShowExportExcel="True"
										  ExportExcelCommand="{Binding ExportExcelCommand}"
										  ExportExcelCommandParameter="{Binding}" />

			<!-- Card 2: Search Filters -->
			<Border Grid.Row="1"
					Style="{StaticResource FilterCardStyle}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<components:FilterInputControl Grid.Column="0"
												   Margin="0,0,8,0"
												   IconKind="Book"
												   HintText="Tên sách..."
												   TextValue="{Binding SearchTenSach}" />

					<components:FilterInputControl Grid.Column="1"
												   Margin="0,0,8,0"
												   IconKind="Account"
												   HintText="Tác giả..."
												   TextValue="{Binding SearchTacGia}" />

					<components:FilterComboBoxControl Grid.Column="2"
													  Margin="0,0,8,0"
													  IconKind="Tag"
													  HintText="Thể loại"
													  ItemsSource="{Binding ListTheLoai}"
													  SelectedItem="{Binding SelectedTheLoai}" />

					<components:FilterComboBoxControl Grid.Column="3"
													  Margin="0,0,8,0"
													  IconKind="CashSync"
													  HintText="Khoảng giá"
													  ItemsSource="{Binding ListPriceRangeIndex}"
													  SelectedIndex="{Binding SelectedPriceRangeIndex}" />

					<components:FilterInputControl Grid.Column="4"
												   Margin="0,0,8,0"
												   IconKind="PackageVariant"
												   HintText="Tồn kho..."
												   TextValue="{Binding SearchTonKho}" />

					<components:FilterActionPanel Grid.Column="5"
												  ClearCommand="{Binding ClearFilterCommand}"
												  RefreshCommand="{Binding RefreshCommand}"
												  ShowRefreshButton="True" />
				</Grid>
			</Border>

			<!-- Card 3: Danh sách sách -->
			<Border x:Name="DataGrid"
					Grid.Row="2"
					Style="{StaticResource DataGridCardStyle}">
				<DataGrid ItemsSource="{Binding PagedBooks}"
						  Style="{StaticResource CleanDataGrid}">
					<DataGrid.Columns>
						<!-- Cột STT-->
						<DataGridTextColumn Header="STT"
											Binding="{Binding STT}"
											Width="50"
											HeaderStyle="{StaticResource CenterHeaderStyle}"
											ElementStyle="{StaticResource CellCode}" />

						<!-- Cột Tên Sách-->
						<DataGridTextColumn Header="Tên sách"
											Binding="{Binding TenSach}"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellName}"
											Width="200">
						</DataGridTextColumn>

						<!-- Cột Tác Giả -->
						<DataGridTemplateColumn Header="Tác giả"
												Width="150">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<ItemsControl ItemsSource="{Binding DanhSachTacGia}"
												  VerticalAlignment="Center">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<WrapPanel Orientation="Horizontal"
														   VerticalAlignment="Center" />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border Background="#EEF2FF"
														CornerRadius="6"
														Padding="6,2"
														Margin="0,2,4,2">
													<TextBlock Text="{Binding TenTacGia}"
															   Foreground="#4318FF"
															   FontSize="11"
															   FontWeight="SemiBold" />
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

						<!-- Cột Thể Loại -->
						<DataGridTemplateColumn Header="Thể loại"
												Width="165"
												HeaderStyle="{StaticResource CenterHeaderStyle}">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Border CornerRadius="8"
											Padding="10,4"
											HorizontalAlignment="Center"
											VerticalAlignment="Center">
										<Border.Style>
											<Style TargetType="Border">
												<!-- Màu Nền Mặc định (Nếu thể loại không nằm trong danh sách dưới) -->
												<Setter Property="Background"
														Value="#F3F4F6" />

												<Style.Triggers>
													<!-- Công nghệ thông tin: Tone Xanh dương -->
													<DataTrigger Binding="{Binding TheLoai}"
																 Value="Công nghệ thông tin">
														<Setter Property="Background"
																Value="#DBEAFE" />
													</DataTrigger>
													<!-- Văn học nghệ thuật: Tone Hồng -->
													<DataTrigger Binding="{Binding TheLoai}"
																 Value="Văn học nghệ thuật">
														<Setter Property="Background"
																Value="#FCE7F3" />
													</DataTrigger>
													<!-- Kinh tế - Quản trị: Tone Xanh ngọc -->
													<DataTrigger Binding="{Binding TheLoai}"
																 Value="Kinh tế - Quản trị">
														<Setter Property="Background"
																Value="#D1FAE5" />
													</DataTrigger>
													<!-- Tâm lý - Kỹ năng sống: Tone Tím -->
													<DataTrigger Binding="{Binding TheLoai}"
																 Value="Tâm lý - Kỹ năng sống">
														<Setter Property="Background"
																Value="#EDE9FE" />
													</DataTrigger>
													<!-- Truyện tranh: Tone Cam/Vàng -->
													<DataTrigger Binding="{Binding TheLoai}"
																 Value="Truyện tranh">
														<Setter Property="Background"
																Value="#FEF3C7" />
													</DataTrigger>
													<!-- Thiếu nhi: Tone Xanh lá nhạt -->
													<DataTrigger Binding="{Binding TheLoai}"
																 Value="Thiếu nhi">
														<Setter Property="Background"
																Value="#DCFCE7" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>

										<!-- ĐỊNH DẠNG MÀU CHỮ BÊN TRONG -->
										<TextBlock FontSize="12"
												   FontWeight="SemiBold"
												   HorizontalAlignment="Center">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<!-- Chữ Mặc định (Xám đậm) -->
													<Setter Property="Foreground"
															Value="#4B5563" />
													<Setter Property="Text"
															Value="{Binding TheLoai}" />
													<Style.Triggers>
														<!-- Công nghệ thông tin -->
														<DataTrigger Binding="{Binding TheLoai}"
																	 Value="Công nghệ thông tin">
															<Setter Property="Foreground"
																	Value="#1D4ED8" />
														</DataTrigger>
														<!-- Văn học nghệ thuật -->
														<DataTrigger Binding="{Binding TheLoai}"
																	 Value="Văn học nghệ thuật">
															<Setter Property="Foreground"
																	Value="#BE185D" />
														</DataTrigger>
														<!-- Kinh tế - Quản trị -->
														<DataTrigger Binding="{Binding TheLoai}"
																	 Value="Kinh tế - Quản trị">
															<Setter Property="Foreground"
																	Value="#047857" />
														</DataTrigger>
														<!-- Tâm lý - Kỹ năng sống -->
														<DataTrigger Binding="{Binding TheLoai}"
																	 Value="Tâm lý - Kỹ năng sống">
															<Setter Property="Foreground"
																	Value="#6D28D9" />
														</DataTrigger>
														<!-- Truyện tranh -->
														<DataTrigger Binding="{Binding TheLoai}"
																	 Value="Truyện tranh">
															<Setter Property="Foreground"
																	Value="#B45309" />
														</DataTrigger>
														<!-- Thiếu nhi -->
														<DataTrigger Binding="{Binding TheLoai}"
																	 Value="Thiếu nhi">
															<Setter Property="Foreground"
																	Value="#15803D" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</Border>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

						<!-- Cột Tồn Kho  -->
						<DataGridTextColumn Header="Tồn kho"
											Binding="{Binding SoLuongTonKho}"
											Width="80"
											HeaderStyle="{StaticResource CenterHeaderStyle}">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock"
									   BasedOn="{StaticResource CellCenter}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsCanhBaoTonKho}"
													 Value="True">
											<Setter Property="Foreground"
													Value="#EF4444" />
											<Setter Property="FontWeight"
													Value="Bold" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<!-- Cột Đã Bán  -->
						<DataGridTextColumn Header="Đã bán"
											Binding="{Binding TongDaBan}"
											Width="70"
											HeaderStyle="{StaticResource CenterHeaderStyle}"
											ElementStyle="{StaticResource CellCenter}" />

						<!-- Cột Giá Niêm Yết -->
						<DataGridTextColumn Header="Giá Niêm Yết"
											Binding="{Binding GiaNiemYet, StringFormat={}{0:N0} đ}"
											Width="105"
											HeaderStyle="{StaticResource RightHeaderStyle}"
											ElementStyle="{StaticResource CellMoney}" />

						<!-- Cột Đơn Giá -->
						<DataGridTextColumn Header="Đơn giá"
											Binding="{Binding DonGiaBan, StringFormat={}{0:N0} đ}"
											Width="*"
											HeaderStyle="{StaticResource RightHeaderStyle}"
											ElementStyle="{StaticResource CellProfit}" />

						<!-- Cột Nút Hành Động -->
						<DataGridTemplateColumn Header="Thao tác"
												Width="200"
												HeaderStyle="{StaticResource CenterHeaderStyle}">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<components:DataGridActionPanel RowItem="{Binding}"
																	ShowView="{Binding DataContext.CanView, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	ShowEdit="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	ShowDelete="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	EditCommand="{Binding DataContext.OpenEditPopupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	DeleteCommand="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	ShowAction="True"
																	ActionIcon="CartAdd"
																	ActionCommand="{Binding DataContext.OpenViewPopupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	ActionText="Xem" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</Border>

			<!-- Card 4: Pagination -->
			<components:PaginationControl Grid.Row="3"
										  CurrentPage="{Binding TrangHienTai}"
										  TotalPages="{Binding TongSoTrang}"
										  TotalRecords="{Binding TongBanGhi}"
										  PaginationCommand="{Binding PhanTrangCommand}" />
		</Grid>

		<!--==================== POPUP THÊM SÁCH ====================-->
		<Grid Style="{StaticResource PopupOverlayStyle}"
			  Visibility="{Binding IsAddPopupVisible}">

			<Border Background="Transparent">
				<Border.InputBindings>
					<MouseBinding MouseAction="LeftClick"
								  CommandParameter="Close"
								  Command="{Binding ClosePopupCommand}" />
				</Border.InputBindings>
			</Border>

			<Border Width="700"
					Height="600"
					Style="{StaticResource PopupCardStyle}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!--Header-->
					<components:PopupHeaderControl Grid.Row="0"
												   Title="{Binding PopupTitle}"
												   IconKind="{Binding PopupIcon}"
												   Margin="0,0,0,16" />



					<!--KHU VỰC CHIA TAB-->
					<TabControl Grid.Row="1"
								Style="{StaticResource TabControlStyle}">
						<!--================= TAB 1: THÔNG TIN TÁC PHẨM =================-->
						<TabItem Header="1. THÔNG TIN ĐẦU SÁCH">
							<ScrollViewer VerticalScrollBarVisibility="Auto"
										  Margin="0,10,0,0">
								<Grid Margin="0,0,15,10">
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>

									<StackPanel Grid.Row="0"
												Orientation="Horizontal"
												Margin="0,5,0,12"
												HorizontalAlignment="Center">
										<RadioButton IsChecked="{Binding IsNewProduct}" />
										<TextBlock Text="Đầu sách mới"
												   FontSize="15"
												   VerticalAlignment="Center"
												   FontWeight="Bold"
												   Cursor="Hand"
												   Foreground="#2B3674"
												   Margin="0 0 30 0"></TextBlock>
										<RadioButton IsChecked="{Binding IsOldProduct}" />
										<TextBlock Text="Đầu sách cũ"
												   FontSize="15"
												   VerticalAlignment="Center"
												   FontWeight="Bold"
												   Cursor="Hand"
												   Foreground="#2B3674"></TextBlock>
									</StackPanel>

									<components:FormComboBoxControl Title="Tìm đầu sách gốc để thêm phiên bản mới"
																	Grid.Row="1"
																	IsRequired="True"
																	IsEditable="True"
																	IconKind="Search"
																	ItemsSource="{Binding ListTacPhamGoc}"
																	SelectedItem="{Binding SelectedTacPhamGoc}"
																	DisplayMemberPath="TenSach">
										<components:FormComboBoxControl.Style>
											<Style TargetType="components:FormComboBoxControl">
												<Setter Property="Visibility"
														Value="Collapsed" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding IsOldProduct}"
																 Value="True">
														<Setter Property="Visibility"
																Value="Visible" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</components:FormComboBoxControl.Style>
									</components:FormComboBoxControl>


									<Grid Grid.Row="2"
										  IsEnabled="{Binding IsNewProduct}">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="180" />
											<ColumnDefinition Width="20" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>

										<Border Grid.Column="0"
												Width="180"
												Height="200"
												Margin="0,22,0,0"
												CornerRadius="14"
												Background="#F8FAFC"
												BorderBrush="#E2E8F0"
												BorderThickness="2"
												ClipToBounds="True"
												Cursor="Hand"
												VerticalAlignment="Top">
											<Border.InputBindings>
												<MouseBinding MouseAction="LeftClick"
															  Command="{Binding ChangeImageCommand}" />
											</Border.InputBindings>
											<Grid>
												<Image Source="{Binding EditingBook.HinhAnh}"
													   Stretch="UniformToFill"
													   HorizontalAlignment="Center" />
												<Border Background="#99000000"
														VerticalAlignment="Bottom"
														Height="30">
													<TextBlock Text="Đổi ảnh"
															   Foreground="White"
															   FontSize="11"
															   HorizontalAlignment="Center"
															   VerticalAlignment="Center"
															   FontWeight="SemiBold" />
												</Border>
											</Grid>
										</Border>

										<StackPanel Grid.Column="2">

											<components:FormInputControl Title="Tên đầu sách"
																		 IsRequired="True"
																		 TextValue="{Binding EditingBook.TenSach}" />

											<Border>
												<Grid>
													<Grid.RowDefinitions>
														<RowDefinition Height="Auto" />
														<RowDefinition Height="Auto" />
													</Grid.RowDefinitions>

													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="*" />
															<ColumnDefinition Width="Auto" />
														</Grid.ColumnDefinitions>

														<components:FormComboBoxControl Grid.Column="0"
																						x:Name="cbbTacGia_Add"
																						Title="Tác giả"
																						IsRequired="True"
																						IconKind="AccountEdit"
																						IsEditable="True"
																						IsTextSearchEnabled="False"
																						StaysOpenOnEdit="True"
																						ItemsSource="{Binding ListTatCaTacGia}"
																						SelectedItem="{Binding SelectedTacGiaToAdd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
																						DisplayMemberPath="TenTacGia"
																						TextValue="{Binding InputTacGiaText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
														</components:FormComboBoxControl>

														<Button Grid.Column="1"
																Style="{StaticResource MiniAddButtonStyle}"
																Margin="6,0,0,0"
																VerticalAlignment="Center"
																ToolTip="Thêm tác giả mới"
																Command="{Binding AddNewTacGiaCommand}"
																CommandParameter="{Binding TextValue, ElementName=cbbTacGia_Add}">
															<materialDesign:PackIcon Kind="Plus"
																					 Width="18"
																					 Height="18"
																					 Foreground="{StaticResource PrimaryColor}"
																					 HorizontalAlignment="Center"
																					 VerticalAlignment="Center" />
														</Button>


													</Grid>

													<ItemsControl Grid.Row="1"
																  ItemsSource="{Binding EditingBook.DanhSachTacGia}"
																  Margin="0,-8,0,12">
														<ItemsControl.ItemsPanel>
															<ItemsPanelTemplate>
																<WrapPanel Orientation="Horizontal" />
															</ItemsPanelTemplate>
														</ItemsControl.ItemsPanel>

														<ItemsControl.ItemTemplate>
															<DataTemplate>
																<materialDesign:Chip Content="{Binding TenTacGia}"
																					 IsDeletable="True"
																					 DeleteCommand="{Binding DataContext.RemoveTacGiaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																					 DeleteCommandParameter="{Binding}"
																					 Background="#EEF2FF"
																					 Foreground="#4318FF"
																					 Height="26"
																					 FontSize="12"
																					 Margin="0,0,6,6" />
															</DataTemplate>
														</ItemsControl.ItemTemplate>
													</ItemsControl>
												</Grid>
											</Border>
											<Border>
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="Auto" />
													</Grid.ColumnDefinitions>

													<components:FormComboBoxControl Grid.Column="0"
																					x:Name="cbbTheLoai_Add"
																					Title="Thể loại"
																					IsRequired="True"
																					IconKind="Tag"
																					IsEditable="True"
																					IsTextSearchEnabled="False"
																					StaysOpenOnEdit="True"
																					ItemsSource="{Binding ListTheLoaiTaoSach}"
																					SelectedItem="{Binding EditingBook.TheLoai, UpdateSourceTrigger=PropertyChanged}"
																					TextValue="{Binding InputTheLoaiText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
													</components:FormComboBoxControl>

													<Button Grid.Column="1"
															Style="{StaticResource MiniAddButtonStyle}"
															Margin="6,0,0,0"
															VerticalAlignment="Center"
															ToolTip="Thêm thể loại mới"
															Command="{Binding AddNewTheLoaiCommand}"
															CommandParameter="{Binding TextValue, ElementName=cbbTheLoai_Add}">
														<materialDesign:PackIcon Kind="Plus"
																				 Width="18"
																				 Height="18"
																				 Foreground="{StaticResource PrimaryColor}"
																				 HorizontalAlignment="Center"
																				 VerticalAlignment="Center" />
													</Button>



												</Grid>
											</Border>
										</StackPanel>
									</Grid>

									<components:FormInputControl Title="Mô tả nội dung"
																 Grid.Row="3"
																 IsMultiLine="True"
																 IsEnabled="{Binding IsNewProduct}"
																 InputHeight="100"
																 ShowIcon="False" />

								</Grid>
							</ScrollViewer>
						</TabItem>

						<!--================= TAB 2: CẤU HÌNH BÁN HÀNG =================-->
						<TabItem Header="2. CHI TIẾT SÁCH PHIÊN BẢN SÁCH">
							<ScrollViewer VerticalScrollBarVisibility="Auto">
								<Grid>
									<StackPanel Margin="0,0,0,12">

										<!--Dòng 1: ISBN + Năm XB-->
										<components:FormInputControl Title="Mã ISBN"
																	 IsRequired="True"
																	 IconKind="Barcode"
																	 TextValue="{Binding EditingBook.ISBN, UpdateSourceTrigger=PropertyChanged}" />


										<Grid Margin="0,0,0,0">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="15" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<components:FormInputControl Title="Năm xuất bản"
																		 Grid.Column="0"
																		 IconKind="Calendar"
																		 TextValue="{Binding EditingBook.NamXuatBan, UpdateSourceTrigger=PropertyChanged}" />

											<components:FormInputControl Title="Lần tái bản"
																		 Grid.Column="2"
																		 IconKind="CircleArrows"
																		 TextValue="{Binding EditingBook.LanTaiBan, UpdateSourceTrigger=PropertyChanged}" />


										</Grid>

										<!--Dòng 2: Nhà xuất bản + Hình thức bìa-->
										<Grid Margin="0,0,0,0">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="15" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>

											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="Auto" />
												</Grid.ColumnDefinitions>
												<components:FormComboBoxControl Grid.Column="0"
																				x:Name="cbbNXB_Add"
																				Title="Nhà xuất bản"
																				IsRequired="True"
																				IconKind="Domain"
																				IsEditable="True"
																				IsTextSearchEnabled="False"
																				StaysOpenOnEdit="True"
																				ItemsSource="{Binding ListNhaXuatBan}"
																				SelectedItem="{Binding EditingBook.NhaXuatBan, UpdateSourceTrigger=PropertyChanged}"
																				TextValue="{Binding InputNXBText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

													<components:FormComboBoxControl.Style>
														<Style TargetType="components:FormComboBoxControl">
															<Setter Property="State"
																	Value="Normal" />
															<Style.Triggers>
																<DataTrigger Binding="{Binding EditingBook.NhaXuatBan, TargetNullValue=''}"
																			 Value="">
																	<Setter Property="State"
																			Value="Error" />
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</components:FormComboBoxControl.Style>
												</components:FormComboBoxControl>

												<Button Grid.Column="1"
														Style="{StaticResource MiniAddButtonStyle}"
														Margin="8,0,0,0"
														VerticalAlignment="Center"
														ToolTip="Thêm nhà xuất bản mới"
														Command="{Binding AddNewNXBCommand}"
														CommandParameter="{Binding InputNXBText}">

													<materialDesign:PackIcon Kind="Plus"
																			 Width="18"
																			 Height="18"
																			 Foreground="{StaticResource PrimaryColor}"
																			 HorizontalAlignment="Center"
																			 VerticalAlignment="Center" />
												</Button>

											</Grid>


											<components:FormComboBoxControl Grid.Column="2"
																			Title="Hình thức bìa"
																			IconKind="BookCog"
																			ItemsSource="{Binding ListHinhThucBia}"
																			SelectedItem="{Binding EditingBook.HinhThucBia, UpdateSourceTrigger=PropertyChanged}" />


										</Grid>

										<!--Dòng 3: Giá bán-->
										<Grid Margin="0,0,0,0">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="15" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<components:FormInputControl Title="Giá niêm yết"
																		 Grid.Column="0"
																		 IsCurrencyMode="True"
																		 UnitText="đ"
																		 IconKind="AttachMoney"
																		 FontWeight="Bold"
																		 Foreground="{StaticResource PrimaryColor}"
																		 TextValue="{Binding EditingBook.GiaNiemYet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}, ConverterCulture=en-US}" />

											<components:FormInputControl Title="Đơn giá bán"
																		 Grid.Column="2"
																		 IsCurrencyMode="True"
																		 UnitText="đ"
																		 IconKind="AttachMoney"
																		 FontWeight="Bold"
																		 Foreground="{StaticResource SuccessColor}"
																		 TextValue="{Binding EditingBook.DonGiaBan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}, ConverterCulture=en-US}" />


										</Grid>

										<!--Dòng 4: Tồn kho & Đã bán-->
										<components:FormInputControl Title="Số lượng tồn"
																	 UnitText="quyển"
																	 IsEnabled="False"
																	 IconKind="Numeric"
																	 TextValue="{Binding EditingBook.LanTaiBan, UpdateSourceTrigger=PropertyChanged}" />

									</StackPanel>
								</Grid>
							</ScrollViewer>
						</TabItem>
					</TabControl>

					<!--Buttons-->
					<StackPanel Grid.Row="2"
								Orientation="Horizontal"
								HorizontalAlignment="Right"
								Margin="0,10,0,0">
						<Button Content="HỦY BỎ"
								Style="{StaticResource OutlineButtonStyle}"
								Command="{Binding ClosePopupCommand}"
								CommandParameter="{Binding}"
								Width="120"
								Height="40"
								Margin="0,0,10,0"
								FontSize="13"
								FontWeight="SemiBold"
								Cursor="Hand">
						</Button>
						<Button Content="THÊM SÁCH"
								Command="{Binding SaveNewBookCommand}"
								CommandParameter="{Binding}"
								Style="{StaticResource MainGradientButton}"
								Width="140"
								Height="40"
								FontSize="13"
								FontWeight="SemiBold"
								Foreground="White"
								Cursor="Hand">
						</Button>
					</StackPanel>
				</Grid>
			</Border>
		</Grid>

		<!--==================== POPUP SỬA SÁCH ====================-->
		<Grid Style="{StaticResource PopupOverlayStyle}"
			  Visibility="{Binding IsEditPopupVisible}">

			<Border Background="Transparent">
				<Border.InputBindings>
					<MouseBinding MouseAction="LeftClick"
								  Command="{Binding ClosePopupCommand}" />
				</Border.InputBindings>
			</Border>

			<Border Width="700"
					Height="650"
					Style="{StaticResource PopupCardStyle}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<components:PopupHeaderControl Grid.Row="0"
												   Title="{Binding PopupTitle}"
												   IconKind="{Binding PopupIcon}"
												   Margin="0,0,0,16" />

					<TabControl Grid.Row="1"
								Style="{StaticResource TabControlStyle}">

						<TabItem Header="1. THÔNG TIN ĐẦU SÁCH">
							<ScrollViewer VerticalScrollBarVisibility="Auto"
										  Margin="0,10,0,0">
								<Grid Margin="0,0,15,10">
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>

									<Border Grid.Row="0"
											Background="#FEF2F2"
											BorderBrush="#FCA5A5"
											BorderThickness="1"
											CornerRadius="8"
											Padding="12,8"
											Margin="0,0,0,15">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto" />
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>

											<materialDesign:PackIcon Kind="AlertCircleOutline"
																	 Foreground="#EF4444"
																	 Width="20"
																	 Height="20"
																	 VerticalAlignment="Center" />

											<TextBlock Grid.Column="1"
													   Margin="10,0,0,0"
													   VerticalAlignment="Center"
													   Text="Chỉnh sửa ở đây sẽ áp dụng cho tất cả phiên bản sách của đầu sách này!"
													   TextWrapping="Wrap"
													   FontWeight="Bold"
													   Foreground="#991B1B"
													   FontSize="12" />

											<ToggleButton DockPanel.Dock="Right"
														  Grid.Column="2"
														  materialDesign:ToggleButtonAssist.SwitchTrackOnBackground="#EF4444"
														  IsChecked="{Binding IsEditMasterEnabled}" />


										</Grid>
									</Border>

									<Grid Grid.Row="1"
										  IsEnabled="{Binding IsEditMasterEnabled}">
										<Grid.Style>
											<Style TargetType="Grid">
												<Setter Property="Opacity"
														Value="1" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding IsEditMasterEnabled}"
																 Value="False">
														<Setter Property="Opacity"
																Value="0.6" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Grid.Style>

										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="180" />
											<ColumnDefinition Width="20" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>

										<Border Grid.Column="0"
												Width="180"
												Height="220"
												Margin="0,22,0,0"
												CornerRadius="14"
												Background="#F8FAFC"
												BorderBrush="#E2E8F0"
												BorderThickness="2"
												ClipToBounds="True"
												Cursor="Hand"
												VerticalAlignment="Top">
											<Border.InputBindings>
												<MouseBinding MouseAction="LeftClick"
															  Command="{Binding ChangeImageCommand}"
															  CommandParameter="SelectImage" />
											</Border.InputBindings>
											<Grid>
												<Image Source="{Binding EditingBook.HinhAnh}"
													   Stretch="UniformToFill"
													   HorizontalAlignment="Center" />
												<Border Background="#99000000"
														VerticalAlignment="Bottom"
														Height="30">
													<TextBlock Text="Đổi ảnh"
															   Foreground="White"
															   FontSize="11"
															   HorizontalAlignment="Center"
															   VerticalAlignment="Center"
															   FontWeight="SemiBold" />
												</Border>
											</Grid>
										</Border>

										<StackPanel Grid.Column="2">
											<components:FormInputControl Title="Tên đầu sách"
																		 IsRequired="True"
																		 IconKind="Book"
																		 Margin="0,0,0,15"
																		 TextValue="{Binding EditingBook.TenSach, UpdateSourceTrigger=PropertyChanged}" />

											<Border Margin="0,0,0,15">
												<Grid>
													<Grid.RowDefinitions>
														<RowDefinition Height="Auto" />
														<RowDefinition Height="Auto" />
													</Grid.RowDefinitions>
													<Grid Grid.Row="0">
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="*" />
															<ColumnDefinition Width="Auto" />
														</Grid.ColumnDefinitions>

														<components:FormComboBoxControl Grid.Column="0"
																						Title="Tác giả"
																						IsRequired="True"
																						IconKind="AccountEdit"
																						IsEditable="True"
																						IsTextSearchEnabled="False"
																						StaysOpenOnEdit="True"
																						ItemsSource="{Binding ListTatCaTacGia}"
																						SelectedItem="{Binding SelectedTacGiaToAdd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
																						DisplayMemberPath="TenTacGia"
																						TextValue="{Binding InputTacGiaText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
															<components:FormComboBoxControl.Style>
																<Style TargetType="components:FormComboBoxControl">
																	<Setter Property="State"
																			Value="Normal" />
																	<Style.Triggers>
																		<DataTrigger Binding="{Binding EditingBook.DanhSachTacGia.Count, TargetNullValue=0}"
																					 Value="0">
																			<Setter Property="State"
																					Value="Error" />
																		</DataTrigger>
																	</Style.Triggers>
																</Style>
															</components:FormComboBoxControl.Style>
														</components:FormComboBoxControl>

														<Button Grid.Column="1"
																Style="{StaticResource MiniAddButtonStyle}"
																Margin="8,0,0,0"
																VerticalAlignment="Center"
																ToolTip="Thêm tác giả mới"
																Command="{Binding AddNewTacGiaCommand}"
																CommandParameter="{Binding InputTacGiaText}">
															<materialDesign:PackIcon Kind="Plus"
																					 Width="18"
																					 Height="18"
																					 Foreground="{StaticResource PrimaryColor}"
																					 HorizontalAlignment="Center"
																					 VerticalAlignment="Center" />
														</Button>
													</Grid>

													<ItemsControl Grid.Row="1"
																  ItemsSource="{Binding EditingBook.DanhSachTacGia}"
																  Margin="0,-8,0,0">
														<ItemsControl.ItemsPanel>
															<ItemsPanelTemplate>
																<WrapPanel Orientation="Horizontal" />
															</ItemsPanelTemplate>
														</ItemsControl.ItemsPanel>
														<ItemsControl.ItemTemplate>
															<DataTemplate>
																<materialDesign:Chip Content="{Binding TenTacGia}"
																					 IsDeletable="True"
																					 DeleteCommand="{Binding DataContext.RemoveTacGiaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																					 DeleteCommandParameter="{Binding}"
																					 Background="#EEF2FF"
																					 Foreground="#4318FF"
																					 Height="26"
																					 FontSize="12"
																					 Margin="0,0,6,6" />
															</DataTemplate>
														</ItemsControl.ItemTemplate>
													</ItemsControl>
												</Grid>
											</Border>

											<Border Margin="0,0,0,15">
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="Auto" />
													</Grid.ColumnDefinitions>

													<components:FormComboBoxControl Grid.Column="0"
																					Title="Thể loại"
																					IsRequired="True"
																					IconKind="Tag"
																					IsEditable="True"
																					IsTextSearchEnabled="False"
																					StaysOpenOnEdit="True"
																					ItemsSource="{Binding ListTheLoaiTaoSach}"
																					SelectedItem="{Binding EditingBook.TheLoai, UpdateSourceTrigger=PropertyChanged}"
																					TextValue="{Binding InputTheLoaiText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
														<components:FormComboBoxControl.Style>
															<Style TargetType="components:FormComboBoxControl">
																<Setter Property="State"
																		Value="Normal" />
																<Style.Triggers>
																	<DataTrigger Binding="{Binding EditingBook.TheLoai, TargetNullValue=''}"
																				 Value="">
																		<Setter Property="State"
																				Value="Error" />
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</components:FormComboBoxControl.Style>
													</components:FormComboBoxControl>

													<Button Grid.Column="1"
															Style="{StaticResource MiniAddButtonStyle}"
															Margin="8,0,0,0"
															VerticalAlignment="Center"
															ToolTip="Thêm thể loại mới"
															Command="{Binding AddNewTheLoaiCommand}"
															CommandParameter="{Binding InputTheLoaiText}">
														<materialDesign:PackIcon Kind="Plus"
																				 Width="18"
																				 Height="18"
																				 Foreground="{StaticResource PrimaryColor}"
																				 HorizontalAlignment="Center"
																				 VerticalAlignment="Center" />
													</Button>
												</Grid>
											</Border>

											<components:FormInputControl Title="Mô tả nội dung"
																		 IsMultiLine="True"
																		 InputHeight="100"
																		 ShowIcon="False"
																		 TextValue="{Binding EditingBook.MoTa, UpdateSourceTrigger=PropertyChanged}" />
										</StackPanel>
									</Grid>
								</Grid>
							</ScrollViewer>
						</TabItem>

						<TabItem Header="2. CHI TIẾT BẢN SÁCH">
							<ScrollViewer VerticalScrollBarVisibility="Auto">
								<StackPanel Margin="0,10,0,0">

									<components:FormInputControl Title="Mã ISBN (Không thể sửa)"
																 IconKind="Barcode"
																 IsEnabled="False"
																 Margin="0,0,0,15"
																 TextValue="{Binding EditingBook.ISBN}" />

									<Grid Margin="0,0,0,15">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="15" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<components:FormInputControl Grid.Column="0"
																	 Title="Năm xuất bản"
																	 IconKind="Calendar"
																	 TextValue="{Binding EditingBook.NamXuatBan, UpdateSourceTrigger=PropertyChanged}" />
										<components:FormInputControl Grid.Column="2"
																	 Title="Lần tái bản"
																	 IconKind="CircleArrows"
																	 TextValue="{Binding EditingBook.LanTaiBan, UpdateSourceTrigger=PropertyChanged}" />
									</Grid>

									<Grid Margin="0,0,0,15">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="15" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>

										<Grid Grid.Column="0">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>
											<components:FormComboBoxControl Grid.Column="0"
																			Title="Nhà xuất bản"
																			IsRequired="True"
																			IconKind="Domain"
																			IsEditable="True"
																			IsTextSearchEnabled="False"
																			StaysOpenOnEdit="True"
																			ItemsSource="{Binding ListNhaXuatBan}"
																			SelectedItem="{Binding EditingBook.NhaXuatBan, UpdateSourceTrigger=PropertyChanged}"
																			TextValue="{Binding InputNXBText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
												<components:FormComboBoxControl.Style>
													<Style TargetType="components:FormComboBoxControl">
														<Setter Property="State"
																Value="Normal" />
														<Style.Triggers>
															<DataTrigger Binding="{Binding EditingBook.NhaXuatBan, TargetNullValue=''}"
																		 Value="">
																<Setter Property="State"
																		Value="Error" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</components:FormComboBoxControl.Style>
											</components:FormComboBoxControl>
											<Button Grid.Column="1"
													Style="{StaticResource MiniAddButtonStyle}"
													Margin="8,0,0,0"
													VerticalAlignment="Center"
													ToolTip="Thêm nhà xuất bản mới"
													Command="{Binding AddNewNXBCommand}"
													CommandParameter="{Binding InputNXBText}">
												<materialDesign:PackIcon Kind="Plus"
																		 Width="18"
																		 Height="18"
																		 Foreground="{StaticResource PrimaryColor}"
																		 HorizontalAlignment="Center"
																		 VerticalAlignment="Center" />
											</Button>
										</Grid>

										<components:FormComboBoxControl Grid.Column="2"
																		Title="Hình thức bìa"
																		IconKind="BookCog"
																		ItemsSource="{Binding ListHinhThucBia}"
																		SelectedItem="{Binding EditingBook.HinhThucBia, UpdateSourceTrigger=PropertyChanged}" />
									</Grid>

									<Grid Margin="0,0,0,15">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="15" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<components:FormInputControl Grid.Column="0"
																	 Title="Giá niêm yết"
																	 IsCurrencyMode="True"
																	 UnitText="đ"
																	 IconKind="AttachMoney"
																	 FontWeight="Bold"
																	 Foreground="{StaticResource PrimaryColor}"
																	 TextValue="{Binding EditingBook.GiaNiemYet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:N0}, ConverterCulture=en-US}" />
										<components:FormInputControl Grid.Column="2"
																	 Title="Đơn giá bán"
																	 IsCurrencyMode="True"
																	 UnitText="đ"
																	 IconKind="AttachMoney"
																	 FontWeight="Bold"
																	 Foreground="{StaticResource SuccessColor}"
																	 TextValue="{Binding EditingBook.DonGiaBan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:N0}, ConverterCulture=en-US}" />
									</Grid>

									<Grid Margin="0,0,0,15">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="15" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<components:FormInputControl Grid.Column="0"
																	 Title="Số lượng tồn"
																	 UnitText="quyển"
																	 IconKind="PackageVariant"
																	 IsEnabled="False"
																	 TextValue="{Binding EditingBook.SoLuongTonKho}" />
										<components:FormInputControl Grid.Column="2"
																	 Title="Đã bán"
																	 UnitText="quyển"
																	 IconKind="CartCheck"
																	 IsEnabled="False"
																	 TextValue="{Binding EditingBook.TongDaBan}" />
									</Grid>

								</StackPanel>
							</ScrollViewer>
						</TabItem>
					</TabControl>

					<StackPanel Grid.Row="2"
								Orientation="Horizontal"
								HorizontalAlignment="Right"
								Margin="0,10,0,0">
						<Button Content="HỦY BỎ"
								Style="{StaticResource OutlineButtonStyle}"
								Command="{Binding ClosePopupCommand}"
								CommandParameter="Close"
								Width="120"
								Height="40"
								Margin="0,0,10,0"
								FontSize="13"
								FontWeight="SemiBold"
								Cursor="Hand">
						</Button>
						<Button Content="LƯU THÔNG TIN"
								Style="{StaticResource MainGradientButton}"
								Command="{Binding SaveEditBookCommand}"
								CommandParameter="Save"
								Width="140"
								Height="40"
								FontSize="13"
								FontWeight="SemiBold"
								Foreground="White"
								Cursor="Hand">
						</Button>
					</StackPanel>
				</Grid>
			</Border>
		</Grid>
		
		<popup:BookDetailPopup DataContext="{Binding BookDetailPopupVM}" />
	</Grid>
</UserControl>