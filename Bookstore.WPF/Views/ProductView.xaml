<UserControl x:Class="Bookstore.WPF.Views.ProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Background="#F4F7FE"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <!-- Màu sắc -->
        <SolidColorBrush x:Key="PrimaryDarkColor" Color="#2B3674"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#4318FF"/>
        <SolidColorBrush x:Key="TextLightColor" Color="#A3AED0"/>
        <SolidColorBrush x:Key="BackgroundColor" Color="#F4F7FE"/>

        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="GradientButtonBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4318FF" Offset="0"/>
            <GradientStop Color="#5B3CFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Đã xóa các DropShadowEffect ở đây để chống lag -->

        <!-- Styles -->
        <Style x:Key="MainGradientButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- Đã xóa Effect -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource GradientButtonBrush}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#4318FF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" BorderBrush="#4318FF" BorderThickness="1.5" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaginationButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2B3674"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F4F7FE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="42"/>
        </Style>

        <Style x:Key="MaterialDesignFloatingHintTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,8,0,0"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundColor}">
        <!-- Decorative Circles -->
        <Ellipse Width="400" Height="400" Fill="#4318FF" Opacity="0.03"
                 VerticalAlignment="Top" HorizontalAlignment="Left" Margin="-150,-150,0,0" IsHitTestVisible="False"/>
        <Ellipse Width="300" Height="300" Fill="#2B3674" Opacity="0.03"
                 VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,-100,-100" IsHitTestVisible="False"/>

        <!-- NỘI DUNG CHÍNH -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Card 1: Header -->
            <Border Grid.Row="0" Margin="0,0,0,12" Padding="20" CornerRadius="16"
                    Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="BookSearch" Width="28" Height="28"
                                                 Foreground="#4318FF" Margin="0,0,10,0"/>
                        <TextBlock Text="TRA CỨU SÁCH" FontSize="24" FontWeight="Bold"
                                   Foreground="#2B3674" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Đã Bind Command OpenAddPopupCommand -->
                        <Button Style="{StaticResource MainGradientButton}"
                                Width="100" Margin="0,0,10,0" Command="{Binding OpenAddPopupCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16"
                                                         Foreground="White" Margin="0,0,6,0"/>
                                <TextBlock Text="THÊM"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlineButtonStyle}" Width="120">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExcel" Width="16" Height="16"
                                                         Foreground="#4318FF" Margin="0,0,6,0"/>
                                <TextBlock Text="XUẤT EXCEL"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 2: Search Filters -->
            <Border Grid.Row="1" Margin="0,0,0,12" Padding="20" CornerRadius="16"
                    Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource FilterBorderStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Book" Width="16" Height="16" Foreground="#A3AED0" Margin="10,0,6,0"/>
                            <TextBox Text="{Binding SearchTenSach, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     VerticalAlignment="Center" FontSize="13" Foreground="#2B3674"
                                     materialDesign:HintAssist.Hint="Tên sách..." Width="Auto"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource FilterBorderStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Account" Width="16" Height="16" Foreground="#A3AED0" Margin="10,0,6,0"/>
                            <TextBox Text="{Binding SearchTacGia, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                     VerticalAlignment="Center" FontSize="13" Foreground="#2B3674"
                                     materialDesign:HintAssist.Hint="Tác giả..." Width="Auto"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource FilterBorderStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Tag" Width="16" Height="16" Foreground="#A3AED0" Margin="10,0,6,0"/>
                            <!-- Đã Bind ItemsSource và SelectedItem -->
                            <ComboBox Background="Transparent" BorderThickness="0"
                                      VerticalAlignment="Center" FontSize="13" Foreground="#2B3674"
                                      materialDesign:HintAssist.Hint="Thể loại" Width="Auto"
                                      ItemsSource="{Binding ListTheLoai}" SelectedItem="{Binding SelectedTheLoai}"/>
                        </StackPanel>
                    </Border>

                    <!-- Giữ lại giao diện các TextBox lộc khác (Chưa cần bind logic phức tạp lúc này) -->
                    <Border Grid.Column="3" Style="{StaticResource FilterBorderStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CurrencyUsd" Width="16" Height="16" Foreground="#A3AED0" Margin="10,0,6,0"/>
                            <TextBox Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="13" Foreground="#2B3674" materialDesign:HintAssist.Hint="Giá niêm yết..." Width="Auto"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource FilterBorderStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Cash" Width="16" Height="16" Foreground="#A3AED0" Margin="10,0,6,0"/>
                            <TextBox Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="13" Foreground="#2B3674" materialDesign:HintAssist.Hint="Đơn giá bán..." Width="Auto"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="5" Style="{StaticResource FilterBorderStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="PackageVariant" Width="16" Height="16" Foreground="#A3AED0" Margin="10,0,6,0"/>
                            <TextBox Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="13" Foreground="#2B3674" materialDesign:HintAssist.Hint="Số lượng tồn..." Width="Auto"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="6" Style="{StaticResource MainGradientButton}" Width="110">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify" Width="16" Height="16" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="TÌM KIẾM"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Card 3: Danh sách sách -->
            <Border Grid.Row="2" CornerRadius="20" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20">
                <DataGrid Grid.Row="1" AutoGenerateColumns="False" ItemsSource="{Binding PagedBooks}"
                              SelectionMode="Single" SelectionUnit="FullRow" IsReadOnly="True"
                              HeadersVisibility="Column" BorderThickness="0" RowHeight="52"
                              FontSize="13" AlternatingRowBackground="#F8FAFC" RowBackground="White"
                              Foreground="#2B3674" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserResizeRows="False" CanUserReorderColumns="False">

                    <DataGrid.Resources>
                        <!-- Style Mặc định cho Header-->
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#2B3674"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Height" Value="44"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>

                        <!-- Style Header-->
                        <Style x:Key="CenterHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>

                        <!-- Style Header -->
                        <Style x:Key="RightHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <!-- Đệm lề-->
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E0E7FF"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F3F4F6"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- Cột STT (Căn giữa) -->
                        <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="50" HeaderStyle="{StaticResource CenterHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#A3AED0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Cột Tên Sách (Width="*" để lấp đầy khoảng trống) -->
                        <DataGridTextColumn Header="Tên sách" Binding="{Binding TenSach}" Width="Auto">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Cột Tác Giả -->
                        <DataGridTextColumn Header="Tác giả" Binding="{Binding TacGia}" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Cột Thể Loại -->
                        <DataGridTemplateColumn Header="Thể loại" Width="150" HeaderStyle="{StaticResource CenterHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- Màu Nền Mặc định (Nếu thể loại không nằm trong danh sách dưới) -->
                                                <Setter Property="Background" Value="#F3F4F6"/>

                                                <Style.Triggers>
                                                    <!-- Công nghệ thông tin: Tone Xanh dương -->
                                                    <DataTrigger Binding="{Binding TheLoai}" Value="Công nghệ thông tin">
                                                        <Setter Property="Background" Value="#DBEAFE"/>
                                                    </DataTrigger>
                                                    <!-- Văn học nghệ thuật: Tone Hồng -->
                                                    <DataTrigger Binding="{Binding TheLoai}" Value="Văn học nghệ thuật">
                                                        <Setter Property="Background" Value="#FCE7F3"/>
                                                    </DataTrigger>
                                                    <!-- Kinh tế - Quản trị: Tone Xanh ngọc -->
                                                    <DataTrigger Binding="{Binding TheLoai}" Value="Kinh tế - Quản trị">
                                                        <Setter Property="Background" Value="#D1FAE5"/>
                                                    </DataTrigger>
                                                    <!-- Tâm lý - Kỹ năng sống: Tone Tím -->
                                                    <DataTrigger Binding="{Binding TheLoai}" Value="Tâm lý - Kỹ năng sống">
                                                        <Setter Property="Background" Value="#EDE9FE"/>
                                                    </DataTrigger>
                                                    <!-- Truyện tranh: Tone Cam/Vàng -->
                                                    <DataTrigger Binding="{Binding TheLoai}" Value="Truyện tranh">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                    <!-- Thiếu nhi: Tone Xanh lá nhạt -->
                                                    <DataTrigger Binding="{Binding TheLoai}" Value="Thiếu nhi">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <!-- ĐỊNH DẠNG MÀU CHỮ BÊN TRONG -->
                                        <TextBlock FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <!-- Chữ Mặc định (Xám đậm) -->
                                                    <Setter Property="Foreground" Value="#4B5563"/>
                                                    <Setter Property="Text" Value="{Binding TheLoai}"/>
                                                    <Style.Triggers>
                                                        <!-- Công nghệ thông tin -->
                                                        <DataTrigger Binding="{Binding TheLoai}" Value="Công nghệ thông tin">
                                                            <Setter Property="Foreground" Value="#1D4ED8"/>
                                                        </DataTrigger>
                                                        <!-- Văn học nghệ thuật -->
                                                        <DataTrigger Binding="{Binding TheLoai}" Value="Văn học nghệ thuật">
                                                            <Setter Property="Foreground" Value="#BE185D"/>
                                                        </DataTrigger>
                                                        <!-- Kinh tế - Quản trị -->
                                                        <DataTrigger Binding="{Binding TheLoai}" Value="Kinh tế - Quản trị">
                                                            <Setter Property="Foreground" Value="#047857"/>
                                                        </DataTrigger>
                                                        <!-- Tâm lý - Kỹ năng sống -->
                                                        <DataTrigger Binding="{Binding TheLoai}" Value="Tâm lý - Kỹ năng sống">
                                                            <Setter Property="Foreground" Value="#6D28D9"/>
                                                        </DataTrigger>
                                                        <!-- Truyện tranh -->
                                                        <DataTrigger Binding="{Binding TheLoai}" Value="Truyện tranh">
                                                            <Setter Property="Foreground" Value="#B45309"/>
                                                        </DataTrigger>
                                                        <!-- Thiếu nhi -->
                                                        <DataTrigger Binding="{Binding TheLoai}" Value="Thiếu nhi">
                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Cột Tồn Kho (Căn giữa) -->
                        <DataGridTextColumn Header="Tồn kho" Binding="{Binding SoLuongTonKho}" Width="80" HeaderStyle="{StaticResource CenterHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SoLuongTonKho}" Value="0">
                                            <Setter Property="Foreground" Value="#EF4444"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Cột Đã Bán (Căn giữa) -->
                        <DataGridTextColumn Header="Đã bán" Binding="{Binding TongDaBan}" Width="80" HeaderStyle="{StaticResource CenterHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#10B981"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Cột Giá Niêm Yết (Căn phải) -->
                        <DataGridTextColumn Header="Giá Niêm Yết" Binding="{Binding GiaNiemYet, StringFormat={}{0:N0} đ}" Width="100" HeaderStyle="{StaticResource RightHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Cột Đơn Giá (Căn phải) -->
                        <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGiaBan, StringFormat={}{0:N0} đ}" Width="90" HeaderStyle="{StaticResource RightHeaderStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#4318FF"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Cột Nút Hành Động (Căn giữa) -->
                        <DataGridTemplateColumn Header="Thao tác" Width="100" HeaderStyle="{StaticResource CenterHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Nút Sửa -->
                                        <Button Width="32" Height="32" Background="#E0E7FF" BorderThickness="0" Cursor="Hand" ToolTip="Sửa"
                                                    Command="{Binding DataContext.OpenEditPopupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <materialDesign:PackIcon Kind="Edit" Width="15" Height="15" Foreground="#4318FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Nút Xóa -->
                                        <Button Width="32" Height="32" Background="#FEE2E2" BorderThickness="0" Cursor="Hand" ToolTip="Xóa" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                                        <materialDesign:PackIcon Kind="Delete" Width="15" Height="15" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Card 4: Pagination (Đã Bind MVVM toàn bộ) -->
            <Border Grid.Row="3" Margin="0,12,0,0" Padding="12,8" CornerRadius="12" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource PaginationButtonStyle}" Command="{Binding FirstPageCommand}" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="ChevronDoubleLeft" Width="16" Height="16" Foreground="#A3AED0"/>
                    </Button>
                    <Button Style="{StaticResource PaginationButtonStyle}" Command="{Binding PrevPageCommand}" Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16" Foreground="#A3AED0"/>
                    </Button>

                    <ItemsControl ItemsSource="{Binding PageNumbers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Margin="0,0,4,0" Style="{StaticResource PaginationButtonStyle}"
                                        Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{StaticResource PaginationButtonStyle}" Command="{Binding NextPageCommand}" Margin="8,0,0,0">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" Foreground="#A3AED0"/>
                    </Button>
                    <Button Style="{StaticResource PaginationButtonStyle}" Command="{Binding LastPageCommand}" Margin="4,0,0,0">
                        <materialDesign:PackIcon Kind="ChevronDoubleRight" Width="16" Height="16" Foreground="#A3AED0"/>
                    </Button>

                    <TextBlock Text="{Binding CurrentPage, StringFormat='Trang {0}'}" FontSize="12" Foreground="#A3AED0" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== POPUP THÊM/SỬA SÁCH ==================== -->
        <Grid Background="#80000000" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="1000"
              Visibility="{Binding IsPopupVisible}">

            <Border Background="#80000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ClosePopupCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border Width="620" Background="White" CornerRadius="20" BorderBrush="#E2E8F0" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <materialDesign:PackIcon Kind="{Binding PopupIcon}" Width="24" Height="24" Foreground="#4318FF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PopupTitle}" FontSize="18" FontWeight="Bold" Foreground="#2B3674" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Hình ảnh -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Border Width="140" Height="180" CornerRadius="14" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="2" ClipToBounds="True" Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding ChangeImageCommand}"/>
                            </Border.InputBindings>
                            <Grid>
                                <Image Source="{Binding EditingBook.HinhAnh}" Stretch="UniformToFill" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Tên sách + Tác giả -->
                    <Grid Grid.Row="3" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="44">
                            <Grid>
                                <TextBlock Text="Tên sách *" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                <TextBox Text="{Binding EditingBook.TenSach}" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="44">
                            <Grid>
                                <TextBlock Text="Tác giả" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                <TextBox Text="{Binding EditingBook.TacGia}" FontSize="13" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Thể loại -->
                    <Border Grid.Row="4" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="44" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="Thể loại" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                            <ComboBox ItemsSource="{Binding ListTheLoai}" SelectedItem="{Binding EditingBook.TheLoai}" FontSize="13" Foreground="#2B3674" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="6,0,6,2" Height="28"/>
                        </Grid>
                    </Border>

                    <!-- Mô tả -->
                    <Border Grid.Row="5" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="56" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="Mô tả" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                            <TextBox Text="{Binding EditingBook.MoTa}" FontSize="13" Foreground="#2B3674" BorderThickness="0" Background="Transparent" Margin="10,18,10,6" Padding="0" TextWrapping="Wrap" AcceptsReturn="True" VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>

                    <!-- KHÓA Số lượng tồn + Đã bán -->
                    <Grid Grid.Row="6" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="44">
                            <Grid>
                                <TextBlock Text="Số lượng tồn" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                <TextBox Text="{Binding EditingBook.SoLuongTonKho}" IsReadOnly="True" FontSize="13" FontWeight="SemiBold" Foreground="#A3AED0" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0" HorizontalContentAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="44">
                            <Grid>
                                <TextBlock Text="Đã bán" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                <TextBox Text="{Binding EditingBook.TongDaBan}" IsReadOnly="True" FontSize="13" FontWeight="SemiBold" Foreground="#A3AED0" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0" HorizontalContentAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Giá Niêm Yết + Đơn giá bán -->
                    <Grid Grid.Row="7" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="44">
                            <Grid>
                                <TextBlock Text="Giá Niêm Yết (VNĐ) *" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                <TextBox Text="{Binding EditingBook.GiaNiemYet}" FontSize="13" FontWeight="SemiBold" Foreground="#4318FF" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0" HorizontalContentAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" Height="44">
                            <Grid>
                                <TextBlock Text="Đơn giá bán (VNĐ)" FontSize="10" Foreground="#A3AED0" Margin="12,4,0,0" VerticalAlignment="Top"/>
                                <TextBox Text="{Binding EditingBook.DonGiaBan}" FontSize="13" FontWeight="SemiBold" Foreground="#10B981" BorderThickness="0" Background="Transparent" VerticalAlignment="Bottom" Margin="10,0,10,6" Padding="0" HorizontalContentAlignment="Right"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="QUAY LẠI" Command="{Binding ClosePopupCommand}" Width="120" Height="40" Margin="0,0,10,0" FontSize="13" FontWeight="SemiBold" Foreground="#A3AED0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="2" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="LƯU" Command="{Binding SaveBookCommand}" Width="120" Height="40" FontSize="13" FontWeight="SemiBold" Foreground="White" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#10B981" CornerRadius="10">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>