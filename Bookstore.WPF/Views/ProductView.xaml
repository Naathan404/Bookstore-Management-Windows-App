<UserControl x:Class="Bookstore.WPF.Views.ProductView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 mc:Ignorable="d">

	<Grid>
		<!-- NỘI DUNG CHÍNH -->
		<Grid x:Name="MainProductView"
			  Margin="{StaticResource MainViewMargin}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<components:PageHeaderControl Title="TRA CỨU SÁCH"
										  HeaderIcon="BookSearch"
										  AddTitle="THÊM SÁCH"
										  AddIcon="Plus"
										  AddCommand="{Binding OpenAddPopupCommand}"
										  AddCommandParameter="{Binding}"
										  ShowExportExcel="True"
										  ExportExcelCommand="{Binding ExportExcelCommand}"
										  ExportExcelCommandParameter="{Binding}" />

			<!-- Card 2: Search Filters -->
			<Border Grid.Row="1"
					Style="{StaticResource FilterCardStyle}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<components:FilterInputControl Grid.Column="0"
												   Margin="0,0,8,0"
												   IconKind="Book"
												   HintText="Tên sách..."
												   TextValue="{Binding SearchTenSach}" />

					<components:FilterInputControl Grid.Column="1"
												   Margin="0,0,8,0"
												   IconKind="Account"
												   HintText="Tác giả..."
												   TextValue="{Binding SearchTacGia}" />

					<components:FilterComboBoxControl Grid.Column="2"
													  Margin="0,0,8,0"
													  IconKind="Tag"
													  HintText="Thể loại"
													  ItemsSource="{Binding ListTheLoai}"
													  SelectedItem="{Binding SelectedTheLoai}" />

					<components:FilterComboBoxControl Grid.Column="3"
													  Margin="0,0,8,0"
													  IconKind="CashSync"
													  HintText="Khoảng giá"
													  ItemsSource="{Binding ListPriceRangeIndex}"
													  SelectedIndex="{Binding SelectedPriceRangeIndex}" />

					<components:FilterInputControl Grid.Column="4"
												   Margin="0,0,8,0"
												   IconKind="PackageVariant"
												   HintText="Tồn kho..."
												   TextValue="{Binding SearchTonKho}" />

					<components:FilterActionPanel Grid.Column="5"
												  ClearCommand="{Binding ClearFilterCommand}"
												  RefreshCommand="{Binding RefreshCommand}"
												  ShowRefreshButton="True" />
				</Grid>
			</Border>

			<!-- Card 3: Danh sách sách -->
			<Border x:Name="DataGrid"
					Grid.Row="2"
					Style="{StaticResource DataGridCardStyle}">
				<DataGrid ItemsSource="{Binding PagedBooks}"
						  Style="{StaticResource CleanDataGrid}">
					<DataGrid.Columns>
						<!-- Cột STT-->
						<DataGridTextColumn Header="STT"
											Binding="{Binding STT}"
											Width="50"
											HeaderStyle="{StaticResource CenterHeaderStyle}"
											ElementStyle="{StaticResource CellCode}"/>
						
						<!-- Cột Tên Sách-->
						<DataGridTextColumn Header="Tên sách"
											Binding="{Binding TenSach}"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellName}"
											Width="200" />

						<!-- Cột Tác Giả -->
						<DataGridTemplateColumn Header="Tác giả"
												Width="150">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<ItemsControl ItemsSource="{Binding DanhSachTacGia}"
												  VerticalAlignment="Center">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<WrapPanel Orientation="Horizontal"
														   VerticalAlignment="Center" />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border Background="#EEF2FF"
														CornerRadius="6"
														Padding="6,2"
														Margin="0,2,4,2">
													<TextBlock Text="{Binding TenTacGia}"
															   Foreground="#4318FF"
															   FontSize="11"
															   FontWeight="SemiBold" />
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

						<!-- Cột Thể Loại -->
						<DataGridTemplateColumn Header="Thể loại"
												Width="150"
												HeaderStyle="{StaticResource CenterHeaderStyle}">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Border CornerRadius="8"
											Padding="10,4"
											HorizontalAlignment="Center"
											VerticalAlignment="Center">
										<Border.Style>
											<Style TargetType="Border">
												<!-- Màu Nền Mặc định (Nếu thể loại không nằm trong danh sách dưới) -->
												<Setter Property="Background"
														Value="#F3F4F6" />

												<Style.Triggers>
													<!-- Công nghệ thông tin: Tone Xanh dương -->
													<DataTrigger Binding="{Binding TheLoai}"
																 Value="Công nghệ thông tin">
														<Setter Property="Background"
																Value="#DBEAFE" />
													</DataTrigger>
													<!-- Văn học nghệ thuật: Tone Hồng -->
													<DataTrigger Binding="{Binding TheLoai}"
																 Value="Văn học nghệ thuật">
														<Setter Property="Background"
																Value="#FCE7F3" />
													</DataTrigger>
													<!-- Kinh tế - Quản trị: Tone Xanh ngọc -->
													<DataTrigger Binding="{Binding TheLoai}"
																 Value="Kinh tế - Quản trị">
														<Setter Property="Background"
																Value="#D1FAE5" />
													</DataTrigger>
													<!-- Tâm lý - Kỹ năng sống: Tone Tím -->
													<DataTrigger Binding="{Binding TheLoai}"
																 Value="Tâm lý - Kỹ năng sống">
														<Setter Property="Background"
																Value="#EDE9FE" />
													</DataTrigger>
													<!-- Truyện tranh: Tone Cam/Vàng -->
													<DataTrigger Binding="{Binding TheLoai}"
																 Value="Truyện tranh">
														<Setter Property="Background"
																Value="#FEF3C7" />
													</DataTrigger>
													<!-- Thiếu nhi: Tone Xanh lá nhạt -->
													<DataTrigger Binding="{Binding TheLoai}"
																 Value="Thiếu nhi">
														<Setter Property="Background"
																Value="#DCFCE7" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>

										<!-- ĐỊNH DẠNG MÀU CHỮ BÊN TRONG -->
										<TextBlock FontSize="12"
												   FontWeight="SemiBold"
												   HorizontalAlignment="Center">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<!-- Chữ Mặc định (Xám đậm) -->
													<Setter Property="Foreground"
															Value="#4B5563" />
													<Setter Property="Text"
															Value="{Binding TheLoai}" />
													<Style.Triggers>
														<!-- Công nghệ thông tin -->
														<DataTrigger Binding="{Binding TheLoai}"
																	 Value="Công nghệ thông tin">
															<Setter Property="Foreground"
																	Value="#1D4ED8" />
														</DataTrigger>
														<!-- Văn học nghệ thuật -->
														<DataTrigger Binding="{Binding TheLoai}"
																	 Value="Văn học nghệ thuật">
															<Setter Property="Foreground"
																	Value="#BE185D" />
														</DataTrigger>
														<!-- Kinh tế - Quản trị -->
														<DataTrigger Binding="{Binding TheLoai}"
																	 Value="Kinh tế - Quản trị">
															<Setter Property="Foreground"
																	Value="#047857" />
														</DataTrigger>
														<!-- Tâm lý - Kỹ năng sống -->
														<DataTrigger Binding="{Binding TheLoai}"
																	 Value="Tâm lý - Kỹ năng sống">
															<Setter Property="Foreground"
																	Value="#6D28D9" />
														</DataTrigger>
														<!-- Truyện tranh -->
														<DataTrigger Binding="{Binding TheLoai}"
																	 Value="Truyện tranh">
															<Setter Property="Foreground"
																	Value="#B45309" />
														</DataTrigger>
														<!-- Thiếu nhi -->
														<DataTrigger Binding="{Binding TheLoai}"
																	 Value="Thiếu nhi">
															<Setter Property="Foreground"
																	Value="#15803D" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</Border>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

						<!-- Cột Tồn Kho  -->
						<DataGridTextColumn Header="Tồn kho"
											Binding="{Binding SoLuongTonKho}"
											Width="*"
											HeaderStyle="{StaticResource CenterHeaderStyle}">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock"
									   BasedOn="{StaticResource CellCenter}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsCanhBaoTonKho}"
													 Value="True">
											<Setter Property="Foreground"
													Value="#EF4444" />
											<Setter Property="FontWeight"
													Value="Bold" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<!-- Cột Đã Bán  -->
						<DataGridTextColumn Header="Đã bán"
											Binding="{Binding TongDaBan}"
											Width="*"
											HeaderStyle="{StaticResource CenterHeaderStyle}"
											ElementStyle="{StaticResource CellCenter}" />

						<!-- Cột Giá Niêm Yết -->
						<DataGridTextColumn Header="Giá Niêm Yết"
											Binding="{Binding GiaNiemYet, StringFormat={}{0:N0} đ}"
											Width="*"
											HeaderStyle="{StaticResource RightHeaderStyle}"
											ElementStyle="{StaticResource CellMoney}" />

						<!-- Cột Đơn Giá -->
						<DataGridTextColumn Header="Đơn giá"
											Binding="{Binding DonGiaBan, StringFormat={}{0:N0} đ}"
											Width="*"
											HeaderStyle="{StaticResource RightHeaderStyle}"
											ElementStyle="{StaticResource CellProfit}" />

						<!-- Cột Nút Hành Động -->
						<DataGridTemplateColumn Header="Thao tác"
												Width="100"
												HeaderStyle="{StaticResource CenterHeaderStyle}">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<components:DataGridActionPanel RowItem="{Binding}"
																	ShowEdit="True"
																	EditCommand="{Binding DataContext.OpenEditPopupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	ShowDelete="True"
																	DeleteCommand="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</Border>

			<!-- Card 4: Pagination -->
			<components:PaginationControl Grid.Row="3"
										  CurrentPage="{Binding TrangHienTai}"
										  TotalPages="{Binding TongSoTrang}"
										  TotalRecords="{Binding TongBanGhi}"
										  PaginationCommand="{Binding PhanTrangCommand}" />
		</Grid>

		<!--==================== POPUP THÊM SÁCH ====================-->
		<Grid Background="#80000000"
			  VerticalAlignment="Stretch"
			  HorizontalAlignment="Stretch"
			  Panel.ZIndex="1000"
			  Visibility="{Binding IsAddPopupVisible}">

			<Border Background="#80000000">
				<Border.InputBindings>
					<MouseBinding MouseAction="LeftClick"
								  Command="{Binding ClosePopupCommand}" />
				</Border.InputBindings>
			</Border>

			<Border Width="680"
					Height="520"
					Background="White"
					CornerRadius="20"
					BorderBrush="#E2E8F0"
					BorderThickness="1"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Padding="25">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!--Header-->
					<StackPanel Grid.Row="0"
								Orientation="Horizontal"
								HorizontalAlignment="Center"
								Margin="0,0,0,20">
						<materialDesign:PackIcon Kind="{Binding PopupIcon}"
												 Width="26"
												 Height="26"
												 Foreground="#4318FF"
												 Margin="0,0,10,0"
												 VerticalAlignment="Center" />
						<TextBlock Text="{Binding PopupTitle}"
								   FontSize="20"
								   FontWeight="Bold"
								   Foreground="#2B3674"
								   VerticalAlignment="Center" />
					</StackPanel>

					<!--KHU VỰC CHIA TAB-->
					<TabControl Grid.Row="1"
								Style="{StaticResource TabControlStyle}">
						<!--================= TAB 1: THÔNG TIN TÁC PHẨM =================-->
						<TabItem Header="1. THÔNG TIN ĐẦU SÁCH">
							<ScrollViewer VerticalScrollBarVisibility="Auto"
										  Margin="0,10,0,0">
								<Grid Margin="0,0,15,10">
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>

									<StackPanel Grid.Row="0"
												Orientation="Horizontal"
												Margin="0,5,0,20"
												HorizontalAlignment="Center">
										<RadioButton IsChecked="{Binding IsNewProduct}" />
										<TextBlock Text="Đầu sách mới"
												   FontSize="15"
												   VerticalAlignment="Center"
												   FontWeight="Bold"
												   Cursor="Hand"
												   Foreground="#2B3674"
												   Margin="0 0 30 0"></TextBlock>
										<RadioButton IsChecked="{Binding IsOldProduct}" />
										<TextBlock Text="Đầu sách cũ"
												   FontSize="15"
												   VerticalAlignment="Center"
												   FontWeight="Bold"
												   Cursor="Hand"
												   Foreground="#2B3674"></TextBlock>
									</StackPanel>

									<Border Grid.Row="1"
											Margin="0,0,0,20"
											CornerRadius="10"
											Background="#F8FAFC"
											BorderBrush="#4318FF"
											BorderThickness="1.5"
											Padding="15">
										<Border.Style>
											<Style TargetType="Border">
												<Setter Property="Visibility"
														Value="Collapsed" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding IsOldProduct}"
																 Value="True">
														<Setter Property="Visibility"
																Value="Visible" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<Grid>
											<TextBlock Text="Tìm đầu sách gốc để thêm phiên bản mới *"
													   FontSize="11"
													   Foreground="#4318FF"
													   FontWeight="Bold"
													   Margin="4,-8,0,0"
													   VerticalAlignment="Top" />
											<ComboBox ItemsSource="{Binding ListTacPhamGoc}"
													  SelectedItem="{Binding SelectedTacPhamGoc}"
													  DisplayMemberPath="TenSach"
													  IsEditable="True"
													  materialDesign:HintAssist.Hint="Nhập tên sách để tìm nhanh..."
													  FontSize="14"
													  Foreground="#2B3674"
													  Background="Transparent"
													  BorderThickness="0"
													  Margin="0,10,0,0" />
										</Grid>
									</Border>

									<Grid Grid.Row="2"
										  IsEnabled="{Binding IsNewProduct}">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="180" />
											<ColumnDefinition Width="20" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>

										<Border Grid.Column="0"
												Width="180"
												Height="200"
												CornerRadius="14"
												Background="#F8FAFC"
												BorderBrush="#E2E8F0"
												BorderThickness="2"
												ClipToBounds="True"
												Cursor="Hand"
												VerticalAlignment="Top">
											<Border.InputBindings>
												<MouseBinding MouseAction="LeftClick"
															  Command="{Binding ChangeImageCommand}" />
											</Border.InputBindings>
											<Grid>
												<Image Source="{Binding EditingBook.HinhAnh}"
													   Stretch="UniformToFill"
													   HorizontalAlignment="Center" />
												<Border Background="#99000000"
														VerticalAlignment="Bottom"
														Height="30">
													<TextBlock Text="Đổi ảnh"
															   Foreground="White"
															   FontSize="11"
															   HorizontalAlignment="Center"
															   VerticalAlignment="Center"
															   FontWeight="SemiBold" />
												</Border>
											</Grid>
										</Border>

										<StackPanel Grid.Column="2">
											<Border CornerRadius="10"
													Background="White"
													BorderBrush="#E2E8F0"
													BorderThickness="1.5"
													Height="55"
													Margin="0,0,0,15">
												<Grid>
													<TextBlock Text="Tên đầu sách *"
															   FontSize="10"
															   Margin="12,4,0,0"
															   VerticalAlignment="Top">
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Setter Property="Foreground"
																		Value="#A3AED0" />
																<Style.Triggers>
																	<DataTrigger Binding="{Binding EditingBook.TenSach, TargetNullValue=''}"
																				 Value="">
																		<Setter Property="Foreground"
																				Value="#EF4444" />
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>
													<TextBox Text="{Binding EditingBook.TenSach}"
															 FontSize="14"
															 FontWeight="Bold"
															 Foreground="#2B3674"
															 BorderThickness="0"
															 Margin="10,0,10,5"
															 VerticalAlignment="Bottom" />
												</Grid>
											</Border>
											<Border CornerRadius="10"
													Background="White"
													BorderBrush="#E2E8F0"
													BorderThickness="1.5"
													MinHeight="46"
													Margin="0,0,0,15">
												<Grid Margin="10,4,10,6">
													<Grid.RowDefinitions>
														<RowDefinition Height="Auto" />
														<RowDefinition Height="Auto" />
													</Grid.RowDefinitions>

													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="*" />
															<ColumnDefinition Width="Auto" />
														</Grid.ColumnDefinitions>
														<TextBlock Text="Tác giả *"
																   FontSize="10"
																   VerticalAlignment="Top">
															<TextBlock.Style>
																<Style TargetType="TextBlock">
																	<Setter Property="Foreground"
																			Value="#A3AED0" />
																	<Style.Triggers>
																		<DataTrigger Binding="{Binding EditingBook.DanhSachTacGia.Count, TargetNullValue=0}"
																					 Value="0">
																			<Setter Property="Foreground"
																					Value="#EF4444" />
																		</DataTrigger>
																	</Style.Triggers>
																</Style>
															</TextBlock.Style>
														</TextBlock>

														<ComboBox x:Name="cbbTacGia_Add"
																  Grid.Column="0"
																  ItemsSource="{Binding ListTatCaTacGia}"
																  SelectedItem="{Binding SelectedTacGiaToAdd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
																  DisplayMemberPath="TenTacGia"
																  IsEditable="True"
																  StaysOpenOnEdit="True"
																  IsTextSearchEnabled="False"
																  Text="{Binding InputTacGiaText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
																  materialDesign:HintAssist.Hint="Tìm tác giả"
																  FontSize="13"
																  Foreground="#2B3674"
																  BorderThickness="0"
																  Background="Transparent"
																  Margin="-4,14,0,0"
																  Padding="4" />

														<Button Grid.Column="1"
																Style="{StaticResource MiniAddButtonStyle}"
																Margin="6,0,0,0"
																VerticalAlignment="Center"
																ToolTip="Thêm tác giả mới"
																Command="{Binding AddNewTacGiaCommand}"
																CommandParameter="{Binding Text, ElementName=cbbTacGia_Add}">
															<materialDesign:PackIcon Kind="Plus"
																					 Width="18"
																					 Height="18"
																					 Foreground="#4318FF"
																					 HorizontalAlignment="Center"
																					 VerticalAlignment="Center" />
														</Button>
													</Grid>

													<ItemsControl Grid.Row="1"
																  ItemsSource="{Binding EditingBook.DanhSachTacGia}"
																  Margin="0,5,0,0">
														<ItemsControl.ItemsPanel>
															<ItemsPanelTemplate>
																<WrapPanel Orientation="Horizontal" />
															</ItemsPanelTemplate>
														</ItemsControl.ItemsPanel>

														<ItemsControl.ItemTemplate>
															<DataTemplate>
																<materialDesign:Chip Content="{Binding TenTacGia}"
																					 IsDeletable="True"
																					 DeleteCommand="{Binding DataContext.RemoveTacGiaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																					 DeleteCommandParameter="{Binding}"
																					 Background="#EEF2FF"
																					 Foreground="#4318FF"
																					 Height="26"
																					 FontSize="12"
																					 Margin="0,0,6,6" />
															</DataTemplate>
														</ItemsControl.ItemTemplate>
													</ItemsControl>
												</Grid>
											</Border>
											<Border CornerRadius="10"
													Background="White"
													BorderBrush="#E2E8F0"
													BorderThickness="1.5"
													Height="55">
												<Grid Margin="10,4,10,0">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="Auto" />
													</Grid.ColumnDefinitions>
													<TextBlock Text="Thể loại *"
															   FontSize="10"
															   Margin="0,4,0,2"
															   VerticalAlignment="Top">
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Setter Property="Foreground"
																		Value="#A3AED0" />
																<Style.Triggers>
																	<DataTrigger Binding="{Binding EditingBook.TheLoai, TargetNullValue=''}"
																				 Value="">
																		<Setter Property="Foreground"
																				Value="#EF4444" />
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>

													<ComboBox x:Name="cbbTheLoai_Add"
															  Grid.Column="0"
															  ItemsSource="{Binding ListTheLoaiTaoSach}"
															  SelectedItem="{Binding EditingBook.TheLoai}"
															  IsEditable="True"
															  StaysOpenOnEdit="True"
															  Height="28"
															  FontSize="13"
															  Foreground="#2B3674"
															  BorderThickness="0"
															  Margin="0,0,6,2"
															  VerticalAlignment="Bottom" />
													<Button Grid.Column="1"
															Style="{StaticResource MiniAddButtonStyle}"
															Margin="6,0,0,2"
															VerticalAlignment="Center"
															ToolTip="Thêm thể loại mới"
															Command="{Binding AddNewTheLoaiCommand}"
															CommandParameter="{Binding Text, ElementName=cbbTheLoai_Add}">
														<materialDesign:PackIcon Kind="Plus"
																				 Width="18"
