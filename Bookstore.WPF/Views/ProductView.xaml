															<Style TargetType="TextBlock">
																<Setter Property="Foreground"
																		Value="#A3AED0" />
																<Style.Triggers>
																	<DataTrigger Binding="{Binding EditingBook.TheLoai, TargetNullValue=''}"
																				 Value="">
																		<Setter Property="Foreground"
																				Value="#EF4444" />
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>

													<ComboBox x:Name="cbbTheLoai_Add1"
															  Grid.Column="0"
															  ItemsSource="{Binding ListTheLoaiTaoSach}"
															  SelectedItem="{Binding EditingBook.TheLoai}"
															  IsEditable="True"
															  StaysOpenOnEdit="True"
															  FontSize="13"
															  Foreground="#2B3674"
															  BorderThickness="0"
															  Margin="0,0,6,2"
															  VerticalAlignment="Bottom" />
													<Button Grid.Column="1"
															Style="{StaticResource MiniAddButtonStyle}"
															Margin="6,0,0,2"
															VerticalAlignment="Bottom"
															ToolTip="Thêm thể loại mới"
															Command="{Binding AddNewTheLoaiCommand}"
															CommandParameter="{Binding Text, ElementName=cbbTheLoai_Add1}">
														<materialDesign:PackIcon Kind="Plus"
																				 Width="18"
																				 Height="18"
																				 Foreground="#4318FF"
																				 HorizontalAlignment="Center"
																				 VerticalAlignment="Center" />
													</Button>
												</Grid>
											</Border>
										</StackPanel>
									</Grid>

									<Border Grid.Row="2"
											Margin="0,15,0,0"
											CornerRadius="10"
											Background="White"
											BorderBrush="#E2E8F0"
											BorderThickness="1.5"
											MinHeight="100"
											IsEnabled="{Binding IsEditMasterEnabled}">
										<Border.Style>
											<Style TargetType="Border">
												<Setter Property="Opacity"
														Value="1" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding IsEditMasterEnabled}"
																 Value="False">
														<Setter Property="Opacity"
																Value="0.6" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<Grid>
											<TextBlock Text="Mô tả nội dung"
													   FontSize="10"
													   Foreground="#A3AED0"
													   Margin="12,4,0,0"
													   VerticalAlignment="Top" />
											<TextBox Text="{Binding EditingBook.MoTa}"
													 FontSize="13"
													 Foreground="#4B5563"
													 BorderThickness="0"
													 Margin="10,22,10,10"
													 TextWrapping="Wrap"
													 AcceptsReturn="True"
													 VerticalContentAlignment="Top" />
										</Grid>
									</Border>
								</Grid>
							</ScrollViewer>
						</TabItem>

						<!--================= TAB 2: CẤU HÌNH BÁN HÀNG =================-->
						<TabItem Header="2. CHI TIẾT BẢN SÁCH">
							<ScrollViewer VerticalScrollBarVisibility="Auto">
								<Grid>
									<StackPanel Margin="0,10,0,0">

										<!--Dòng 1: ISBN + Năm XB-->
										<Grid Margin="0,0,0,15">
											<Border CornerRadius="10"
													Background="White"
													BorderBrush="#E2E8F0"
													BorderThickness="1.5"
													Height="50"
													IsEnabled="False">
												<Grid>
													<TextBlock Text="Mã ISBN *"
															   FontSize="10"
															   Margin="12,4,0,0"
															   VerticalAlignment="Top">
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Setter Property="Foreground"
																		Value="#A3AED0" />
																<Style.Triggers>
																	<DataTrigger Binding="{Binding EditingBook.ISBN, TargetNullValue=''}"
																				 Value="">
																		<Setter Property="Foreground"
																				Value="#EF4444" />
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>
													<TextBox Text="{Binding EditingBook.ISBN}"
															 FontSize="13"
															 FontWeight="SemiBold"
															 Foreground="#2B3674"
															 BorderThickness="0"
															 Background="Transparent"
															 VerticalAlignment="Bottom"
															 Margin="10,0,10,6"
															 Padding="0" />
												</Grid>
											</Border>
										</Grid>

										<Grid Margin="0,0,0,15">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="15" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>

											<Border Grid.Column="0"
													CornerRadius="10"
													Background="White"
													BorderBrush="#E2E8F0"
													BorderThickness="1.5"
													Height="46">
												<Grid>
													<TextBlock Text="Năm xuất bản"
															   FontSize="10"
															   Foreground="#A3AED0"
															   Margin="12,4,0,0"
															   VerticalAlignment="Top" />
													<TextBox Text="{Binding EditingBook.NamXuatBan}"
															 FontSize="13"
															 Foreground="#2B3674"
															 BorderThickness="0"
															 Background="Transparent"
															 VerticalAlignment="Bottom"
															 Margin="10,0,10,6"
															 Padding="0" />
												</Grid>
											</Border>

											<Border Grid.Column="2"
													CornerRadius="10"
													Background="White"
													BorderBrush="#E2E8F0"
													BorderThickness="1.5"
													Height="46">
												<Grid>
													<TextBlock Text="Lần tái bản"
															   FontSize="10"
															   Foreground="#A3AED0"
															   Margin="12,4,0,0"
															   VerticalAlignment="Top" />
													<TextBox Text="{Binding EditingBook.LanTaiBan}"
															 FontSize="13"
															 Foreground="#2B3674"
															 BorderThickness="0"
															 Background="Transparent"
															 VerticalAlignment="Bottom"
															 Margin="10,0,10,6"
															 Padding="0" />
												</Grid>
											</Border>
										</Grid>

										<!--Dòng 2: Nhà xuất bản + Hình thức bìa-->
										<Grid Margin="0,0,0,15">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="15" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<Border Grid.Column="0"
													CornerRadius="10"
													Background="White"
													BorderBrush="#E2E8F0"
													BorderThickness="1.5"
													Height="55">
												<Grid Margin="0 5 5 0">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="49*" />
														<ColumnDefinition Width="216*" />
														<ColumnDefinition Width="Auto" />
													</Grid.ColumnDefinitions>
													<TextBlock Text="Nhà xuất bản *"
															   FontSize="10"
															   Margin="12,0,0,0"
															   VerticalAlignment="Top">
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Setter Property="Foreground"
																		Value="#A3AED0" />
																<Style.Triggers>
																	<DataTrigger Binding="{Binding EditingBook.NhaXuatBan, TargetNullValue=''}"
																				 Value="">
																		<Setter Property="Foreground"
																				Value="#EF4444" />
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>

													<ComboBox x:Name="cbbNXB_Add1"
															  Grid.Column="0"
															  ItemsSource="{Binding ListNhaXuatBan}"
															  SelectedItem="{Binding EditingBook.NhaXuatBan}"
															  IsEditable="True"
															  StaysOpenOnEdit="True"
															  materialDesign:HintAssist.IsFloating="False"
															  Height="28"
															  FontSize="13"
															  Foreground="#2B3674"
															  BorderThickness="0"
															  Background="Transparent"
															  VerticalAlignment="Bottom"
															  Margin="12,15,6,5"
															  Grid.ColumnSpan="2" />

													<Button Grid.Column="2"
															Style="{StaticResource MiniAddButtonStyle}"
															Margin="6,0,0,0"
															VerticalAlignment="Center"
															ToolTip="Thêm nhà XB mới"
															Command="{Binding AddNewNXBCommand}"
															CommandParameter="{Binding Text, ElementName=cbbNXB_Add1}">
														<materialDesign:PackIcon Kind="Plus"
																				 Width="18"
																				 Height="18"
																				 Foreground="#4318FF"
																				 HorizontalAlignment="Center"
																				 VerticalAlignment="Center" />
													</Button>
												</Grid>
											</Border>

											<Border Grid.Column="2"
													CornerRadius="10"
													Background="White"
													BorderBrush="#E2E8F0"
													BorderThickness="1.5"
													Height="55">
												<Grid>
													<TextBlock Text="Hình thức bìa"
															   FontSize="10"
															   Foreground="#A3AED0"
															   Margin="12,4,0,0"
															   VerticalAlignment="Top" />
													<ComboBox ItemsSource="{Binding ListHinhThucBia}"
															  SelectedItem="{Binding EditingBook.HinhThucBia}"
															  FontSize="13"
															  Foreground="#2B3674"
															  BorderThickness="0"
															  Background="Transparent"
															  VerticalAlignment="Bottom"
															  Margin="12,0,6,5"
															  Height="28" />
												</Grid>
											</Border>
										</Grid>

										<!--Dòng 3: Giá bán-->
										<Grid Margin="0,0,0,15">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="15" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<Border CornerRadius="10"
													Background="White"
													BorderBrush="#E2E8F0"
													BorderThickness="1.5"
													Height="46">
												<Grid>
													<TextBlock Text="Giá Niêm Yết (VNĐ)"
															   FontSize="10"
															   Foreground="#A3AED0"
															   Margin="12,4,0,0"
															   VerticalAlignment="Top" />
													<TextBox Text="{Binding EditingBook.GiaNiemYet, Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
															 FontSize="14"
															 FontWeight="SemiBold"
															 Foreground="#4318FF"
															 BorderThickness="0"
															 Background="Transparent"
															 VerticalAlignment="Bottom"
															 Margin="10,0,10,6"
															 Padding="0"
															 HorizontalContentAlignment="Right" />
												</Grid>
											</Border>

											<Border Grid.Column="2"
													CornerRadius="10"
													Background="White"
													BorderBrush="#E2E8F0"
													BorderThickness="1.5"
													Height="46">
												<Grid>
													<TextBlock Text="Đơn giá bán (VNĐ)"
															   FontSize="10"
															   Foreground="#A3AED0"
															   Margin="12,4,0,0"
															   VerticalAlignment="Top" />
													<TextBox Text="{Binding EditingBook.DonGiaBan, Mode=TwoWay,
                                                                    UpdateSourceTrigger=PropertyChanged}"
															 FontSize="14"
															 FontWeight="SemiBold"
															 Foreground="#10B981"
															 BorderThickness="0"
															 Background="Transparent"
															 VerticalAlignment="Bottom"
															 Margin="10,0,10,6"
															 Padding="0"
															 HorizontalContentAlignment="Right" />
												</Grid>
											</Border>
										</Grid>

										<!--Dòng 4: Tồn kho & Đã bán-->
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="15" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<Border CornerRadius="10"
													Background="#F3F4F6"
													BorderBrush="#E5E7EB"
													BorderThickness="1"
													Height="46">
												<Grid>
													<TextBlock Text="Số lượng tồn"
															   FontSize="10"
															   Foreground="#9CA3AF"
															   Margin="12,4,0,0"
															   VerticalAlignment="Top" />
													<TextBox Text="{Binding EditingBook.SoLuongTonKho}"
															 IsReadOnly="True"
															 FontSize="13"
															 FontWeight="Bold"
															 Foreground="#9CA3AF"
															 BorderThickness="0"
															 Background="Transparent"
															 VerticalAlignment="Bottom"
															 Margin="10,0,10,6"
															 Padding="0"
															 HorizontalContentAlignment="Center" />
												</Grid>
											</Border>
											<Border Grid.Column="2"
													CornerRadius="10"
													Background="#F3F4F6"
													BorderBrush="#E5E7EB"
													BorderThickness="1"
													Height="46">
												<Grid>
													<TextBlock Text="Đã bán"
															   FontSize="10"
															   Foreground="#9CA3AF"
															   Margin="12,4,0,0"
															   VerticalAlignment="Top" />
													<TextBox Text="{Binding EditingBook.TongDaBan}"
															 IsReadOnly="True"
															 FontSize="13"
															 FontWeight="Bold"
															 Foreground="#9CA3AF"
															 BorderThickness="0"
															 Background="Transparent"
															 VerticalAlignment="Bottom"
															 Margin="10,0,10,6"
															 Padding="0"
															 HorizontalContentAlignment="Center" />
												</Grid>
											</Border>
										</Grid>
									</StackPanel>
								</Grid>
							</ScrollViewer>
						</TabItem>
					</TabControl>

					<!--Buttons-->
					<StackPanel Grid.Row="2"
								Orientation="Horizontal"
								HorizontalAlignment="Right"
								Margin="0,10,0,0">
						<Button Content="HỦY BỎ"
								Style="{StaticResource OutlineButtonStyle}"
								Command="{Binding ClosePopupCommand}"
								CommandParameter="Close"
								Width="120"
								Height="40"
								Margin="0,0,10,0"
								FontSize="13"
								FontWeight="SemiBold"
								Cursor="Hand">
						</Button>
						<Button Content="LƯU THÔNG TIN"
								Style="{StaticResource MainGradientButton}"
								Command="{Binding SaveEditBookCommand}"
								CommandParameter="Save"
								Width="140"
								Height="40"
								FontSize="13"
								FontWeight="SemiBold"
								Foreground="White"
								Cursor="Hand">
						</Button>
					</StackPanel>
				</Grid>
			</Border>
		</Grid>

	</Grid>
</UserControl>