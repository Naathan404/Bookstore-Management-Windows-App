<UserControl x:Class="Bookstore.WPF.Views.Components.FormComboBoxControl"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:local="clr-namespace:Bookstore.WPF.Views.Components"
			 x:Name="Root">

	<StackPanel>
		<StackPanel Orientation="Horizontal"
					Margin="4,0,0,6">
			<StackPanel.Style>
				<Style TargetType="StackPanel">
					<Setter Property="Visibility"
							Value="Visible" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding Title, ElementName=Root}"
									 Value="{x:Null}">
							<Setter Property="Visibility"
									Value="Collapsed" />
						</DataTrigger>
						<DataTrigger Binding="{Binding Title, ElementName=Root}"
									 Value="">
							<Setter Property="Visibility"
									Value="Collapsed" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</StackPanel.Style>

			<TextBlock Text="{Binding Title, ElementName=Root}"
					   FontSize="13"
					   FontWeight="SemiBold"
					   Foreground="#2B3674"
					   VerticalAlignment="Center" />

			<TextBlock Text=" *"
					   FontSize="13"
					   FontWeight="SemiBold"
					   Foreground="{StaticResource DangerColor}"
					   VerticalAlignment="Top">
				<TextBlock.Style>
					<Style TargetType="TextBlock">
						<Setter Property="Visibility"
								Value="Collapsed" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsRequired, ElementName=Root}"
										 Value="True">
								<Setter Property="Visibility"
										Value="Visible" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>
			</TextBlock>
		</StackPanel>

		<Border x:Name="ContainerBorder"
				Height="42"
				CornerRadius="10"
				Background="{StaticResource BackgroundColor}"
				BorderBrush="#E2E8F0"
				BorderThickness="1.5">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<materialDesign:PackIcon x:Name="Icon"
										 Grid.Column="0"
										 Kind="{Binding IconKind, ElementName=Root}"
										 Width="18"
										 Height="18"
										 Margin="12,0,4,0"
										 Foreground="#A3AED0"
										 VerticalAlignment="Center"
										 Visibility="{Binding ShowIcon, ElementName=Root, Converter={StaticResource BoolToVis}}" />

				<ComboBox x:Name="ComboElement"
						  Grid.Column="1"
						  ItemsSource="{Binding ItemsSource, ElementName=Root}"
						  SelectedItem="{Binding SelectedItem, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
						  DisplayMemberPath="{Binding DisplayMemberPath, ElementName=Root}"
						  IsEditable="{Binding IsEditable, ElementName=Root}"
						  IsReadOnly="{Binding IsReadOnly, ElementName=Root}"
						  IsEnabled="{Binding IsReadOnly, ElementName=Root, Converter={StaticResource InverseBoolConverter}}"
						  Background="Transparent"
						  BorderThickness="0"
						  VerticalAlignment="Center"
						  FontSize="14"
						  Foreground="{StaticResource PrimaryDarkColor}"
						  materialDesign:HintAssist.Hint="{Binding HintText, ElementName=Root}"
						  materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
						  Margin="8,0,12,0" />
			</Grid>

			<Border.Style>
				<Style TargetType="Border">
					<Style.Triggers>
						<DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=ComboElement}"
									 Value="True">
							<Setter Property="BorderBrush"
									Value="{StaticResource PrimaryColor}" />
							<Setter Property="Background"
									Value="White" />
							<Setter Property="Effect">
								<Setter.Value>
									<DropShadowEffect BlurRadius="10"
													  Color="#4318FF"
													  Opacity="0.1"
													  ShadowDepth="0" />
								</Setter.Value>
							</Setter>
						</DataTrigger>

						<DataTrigger Binding="{Binding State, ElementName=Root}"
									 Value="{x:Static local:FieldState.Error}">
							<Setter Property="BorderBrush"
									Value="{StaticResource DangerColor}" />
							<Setter Property="Background"
									Value="#FEF2F2" />
						</DataTrigger>

						<DataTrigger Binding="{Binding State, ElementName=Root}"
									 Value="{x:Static local:FieldState.Success}">
							<Setter Property="BorderBrush"
									Value="{StaticResource SuccessColor}" />
						</DataTrigger>

						<DataTrigger Binding="{Binding State, ElementName=Root}"
									 Value="{x:Static local:FieldState.Warning}">
							<Setter Property="BorderBrush"
									Value="{StaticResource WarningColor}" />
						</DataTrigger>

						<DataTrigger Binding="{Binding IsReadOnly, ElementName=Root}"
									 Value="True">
							<Setter Property="Background"
									Value="#F1F5F9" />
							<Setter Property="BorderBrush"
									Value="#E2E8F0" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Border.Style>
		</Border>

		<TextBlock Text="{Binding HelperText, ElementName=Root}"
				   FontSize="11"
				   Margin="4,4,0,0"
				   MinHeight="16">
			<TextBlock.Style>
				<Style TargetType="TextBlock">
					<Setter Property="Visibility"
							Value="Hidden" />

					<Style.Triggers>
						<DataTrigger Binding="{Binding State, ElementName=Root}"
									 Value="{x:Static local:FieldState.Error}">
							<Setter Property="Visibility"
									Value="Visible" />
							<Setter Property="Foreground"
									Value="{StaticResource DangerColor}" />
						</DataTrigger>

						<DataTrigger Binding="{Binding State, ElementName=Root}"
									 Value="{x:Static local:FieldState.Warning}">
							<Setter Property="Visibility"
									Value="Visible" />
							<Setter Property="Foreground"
									Value="{StaticResource WarningColor}" />
						</DataTrigger>

						<DataTrigger Binding="{Binding State, ElementName=Root}"
									 Value="{x:Static local:FieldState.Success}">
							<Setter Property="Visibility"
									Value="Visible" />
							<Setter Property="Foreground"
									Value="{StaticResource SuccessColor}" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</TextBlock.Style>
		</TextBlock>
	</StackPanel>
</UserControl>