<ContentControl x:Class="Bookstore.WPF.Views.Components.FormPopupControl"
				xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
				xmlns:local="clr-namespace:Bookstore.WPF.Views.Components">

	<ContentControl.Template>
		<ControlTemplate TargetType="local:FormPopupControl">
			<Grid Background="Transparent"
				  VerticalAlignment="Stretch"
				  HorizontalAlignment="Stretch"
				  Panel.ZIndex="1000"
				  Visibility="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}}">

				<Border Background="#80000000">
					<Border.InputBindings>
						<MouseBinding MouseAction="LeftClick"
									  CommandParameter="{Binding}"
									  Command="{Binding CloseCommand, RelativeSource={RelativeSource TemplatedParent}}" />
					</Border.InputBindings>
				</Border>

				<Border Width="{Binding PopupWidth, RelativeSource={RelativeSource TemplatedParent}}"
						Height="{Binding PopupHeight, RelativeSource={RelativeSource TemplatedParent}}"
						Background="White"
						CornerRadius="20"
						Padding="30"
						HorizontalAlignment="Center"
						VerticalAlignment="Center">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<StackPanel Grid.Row="0"
									Orientation="Horizontal"
									HorizontalAlignment="Center"
									Margin="0,0,0,20">
							<materialDesign:PackIcon Kind="{Binding IconKind, RelativeSource={RelativeSource TemplatedParent}}"
													 Width="26"
													 Height="26"
													 Foreground="#4318FF"
													 Margin="0,0,10,0"
													 VerticalAlignment="Center" />
							<TextBlock Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}"
									   FontSize="20"
									   FontWeight="Bold"
									   Foreground="#2B3674"
									   VerticalAlignment="Center" />
						</StackPanel>

						<ContentPresenter Grid.Row="1" />
					</Grid>
				</Border>
			</Grid>
		</ControlTemplate>
	</ContentControl.Template>
</ContentControl>