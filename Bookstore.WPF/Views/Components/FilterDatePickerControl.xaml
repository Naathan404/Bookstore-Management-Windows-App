<UserControl x:Class="Bookstore.WPF.Views.Components.FilterDatePickerControl"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 x:Name="Root">

	<Border x:Name="ContainerBorder"
			Height="42"
			CornerRadius="10"
			Background="{StaticResource BackgroundColor}"
			BorderBrush="#E2E8F0"
			BorderThickness="1.5">

		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="38" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<materialDesign:PackIcon x:Name="Icon"
									 Kind="{Binding IconKind, ElementName=Root}"
									 Width="18"
									 Height="18"
									 Foreground="{StaticResource TextLightColor}"
									 VerticalAlignment="Center"
									 HorizontalAlignment="Center" />

			<DatePicker x:Name="DateElement"
						Grid.Column="1"
						SelectedDate="{Binding SelectedDate, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
						Background="Transparent"
						BorderThickness="0"
						VerticalAlignment="Center"
						HorizontalAlignment="Stretch"
						FontSize="13"
						Foreground="{StaticResource PrimaryDarkColor}"
						materialDesign:HintAssist.Hint="{Binding HintText, ElementName=Root}"
						materialDesign:HintAssist.Foreground="{StaticResource TextLightColor}"
						materialDesign:TextFieldAssist.UnderlineBrush="{StaticResource PrimaryColor}"
						Margin="0,0,10,0">

				<DatePicker.Resources>
					<SolidColorBrush x:Key="PrimaryHueMidBrush"
									 Color="#4318FF" />
					<SolidColorBrush x:Key="PrimaryHueLightBrush"
									 Color="#5B3CFF" />
					<SolidColorBrush x:Key="PrimaryHueDarkBrush"
									 Color="#250AA0" />
					<SolidColorBrush x:Key="SecondaryHueMidBrush"
									 Color="#4318FF" />

					<SolidColorBrush x:Key="MaterialDesignSelection"
									 Color="#4318FF" />
					<SolidColorBrush x:Key="MaterialDesignActionForeground"
									 Color="White" />

					<Style TargetType="DatePickerTextBox"
						   BasedOn="{StaticResource {x:Type DatePickerTextBox}}">
						<Setter Property="SelectionBrush"
								Value="{StaticResource PrimaryColor}" />
						<Setter Property="CaretBrush"
								Value="{StaticResource PrimaryColor}" />
						<Setter Property="IsReadOnly"
								Value="True" />
						<Setter Property="Cursor"
								Value="Hand" />
						<Setter Property="FocusVisualStyle"
								Value="{x:Null}" />
					</Style>
				</DatePicker.Resources>
			</DatePicker>
		</Grid>

		<Border.Style>
			<Style TargetType="Border">
				<Style.Triggers>
					<DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=DateElement}"
								 Value="True">
						<Setter Property="BorderBrush"
								Value="{StaticResource PrimaryColor}" />
						<Setter Property="Background"
								Value="{StaticResource WhiteColor}" />
						<Setter Property="Effect">
							<Setter.Value>
								<DropShadowEffect BlurRadius="10"
												  Color="#4318FF"
												  Opacity="0.15"
												  ShadowDepth="0" />
							</Setter.Value>
						</Setter>
					</DataTrigger>
				</Style.Triggers>
			</Style>
		</Border.Style>
	</Border>

	<UserControl.Triggers>
		<EventTrigger RoutedEvent="GotKeyboardFocus">
			<BeginStoryboard>
				<Storyboard>
					<ColorAnimation Storyboard.TargetName="Icon"
									Storyboard.TargetProperty="(materialDesign:PackIcon.Foreground).(SolidColorBrush.Color)"
									To="#4318FF"
									Duration="0:0:0.15" />
				</Storyboard>
			</BeginStoryboard>
		</EventTrigger>
		<EventTrigger RoutedEvent="LostKeyboardFocus">
			<BeginStoryboard>
				<Storyboard>
					<ColorAnimation Storyboard.TargetName="Icon"
									Storyboard.TargetProperty="(materialDesign:PackIcon.Foreground).(SolidColorBrush.Color)"
									To="#A3AED0"
									Duration="0:0:0.15" />
				</Storyboard>
			</BeginStoryboard>
		</EventTrigger>
	</UserControl.Triggers>
</UserControl>