<UserControl x:Class="Bookstore.WPF.Views.Components.ReceiptPopupControl"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 xmlns:vm="clr-namespace:Bookstore.WPF.ViewModels"
			 mc:Ignorable="d"
			 d:DesignHeight="600"
			 d:DesignWidth="800"
			 d:DataContext="{d:DesignInstance Type=vm:ReceiptViewModel}">
	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
		<DropShadowEffect x:Key="PopupShadowEffect"
						  BlurRadius="20"
						  Color="Black"
						  Opacity="0.1"
						  ShadowDepth="5" />

		<SolidColorBrush x:Key="BackgroundColor"
						 Color="#F4F7FE" />

		<Style x:Key="FilterBorderStyle"
			   TargetType="Border">
			<Setter Property="CornerRadius"
					Value="8" />
			<Setter Property="Background"
					Value="White" />
			<Setter Property="BorderBrush"
					Value="#E2E8F0" />
			<Setter Property="BorderThickness"
					Value="1" />
			<Setter Property="Height"
					Value="42" />
		</Style>

		<Style x:Key="OutlineButtonStyle"
			   TargetType="Button">
			<Setter Property="Height"
					Value="36" />
			<Setter Property="FontSize"
					Value="13" />
			<Setter Property="FontWeight"
					Value="Medium" />
			<Setter Property="Foreground"
					Value="#A3AED0" />
			<Setter Property="Cursor"
					Value="Hand" />
			<Setter Property="Background"
					Value="Transparent" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="Transparent"
								BorderBrush="#E2E8F0"
								BorderThickness="1.5"
								CornerRadius="10">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="MainGradientButton"
			   TargetType="Button">
			<Setter Property="Height"
					Value="40" />
			<Setter Property="FontSize"
					Value="13" />
			<Setter Property="FontWeight"
					Value="SemiBold" />
			<Setter Property="Foreground"
					Value="White" />
			<Setter Property="Cursor"
					Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="#10B981"
								CornerRadius="10">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<Grid x:Name="popupThuTien"
		  Background="#80000000"
		  Visibility="{Binding IsThuTienPopupOpen, Converter={StaticResource BoolToVis}}"
		  VerticalAlignment="Stretch"
		  HorizontalAlignment="Stretch"
		  Panel.ZIndex="1000">
		<Grid.RowDefinitions>
			<RowDefinition Height="571*" />
			<RowDefinition Height="29*" />
		</Grid.RowDefinitions>

		<Border Background="Transparent"
				Grid.RowSpan="2">
			<Border.InputBindings>
				<MouseBinding MouseAction="LeftClick"
							  Command="{Binding DongPopupThuTienCommand}" />
			</Border.InputBindings>
		</Border>

		<Border Width="500"
				Background="White"
				CornerRadius="16"
				Effect="{StaticResource PopupShadowEffect}"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"
				Margin="0,77,0,0">
			<Grid Margin="28">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Grid Grid.Row="0"
					  Margin="0,0,0,20">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="40" />
					</Grid.ColumnDefinitions>
					<StackPanel Orientation="Horizontal"
								VerticalAlignment="Center">
						<materialDesign:PackIcon Kind="Cash"
												 Width="22"
												 Height="22"
												 Foreground="#4318FF"
												 Margin="0,0,8,0" />
						<TextBlock Text="{Binding PopupTitle, TargetNullValue='PHIẾU THU TIỀN'}"
								   FontSize="18"
								   FontWeight="Bold"
								   Foreground="#2B3674"
								   VerticalAlignment="Center" />
					</StackPanel>
					<Button Grid.Column="1"
							Content="✕"
							Width="30"
							Height="30"
							HorizontalAlignment="Right"
							VerticalAlignment="Top"
							Background="Transparent"
							BorderThickness="0"
							Foreground="#A3AED0"
							Command="{Binding DongPopupThuTienCommand}" />
				</Grid>

				<Border Grid.Row="1"
						Style="{StaticResource FilterBorderStyle}"
						Margin="0,0,0,12"
						Background="#F8FAFC">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="36" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<materialDesign:PackIcon Kind="Barcode"
												 Width="18"
												 Height="18"
												 Foreground="#A3AED0"
												 VerticalAlignment="Center"
												 HorizontalAlignment="Center" />
						<TextBlock Grid.Column="1"
								   Text="{Binding MaPhieuThu}"
								   Margin="0 0 5 0"
								   Background="Transparent"
								   VerticalAlignment="Center"
								   HorizontalAlignment="Stretch"
								   FontSize="13"
								   Foreground="#9CA3AF" />
					</Grid>
				</Border>

				<Grid Grid.Row="2"
					  Margin="0,0,0,12">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="12" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<Border Grid.Column="0"
							Style="{StaticResource FilterBorderStyle}"
							Background="#F8FAFC">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="36" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<materialDesign:PackIcon Kind="CalendarClock"
													 Width="18"
													 Height="18"
													 Foreground="#A3AED0"
													 VerticalAlignment="Center"
													 HorizontalAlignment="Center" />
							<DatePicker Grid.Column="1"
										SelectedDate="{x:Static sys:DateTime.Now}"
										IsEnabled="False"
										Margin="0 0 5 0"
										Background="Transparent"
										BorderThickness="0"
										VerticalAlignment="Center"
										HorizontalAlignment="Stretch"
										FontSize="13"
										Foreground="#9CA3AF" />
						</Grid>
					</Border>

					<Border Grid.Column="2"
							Style="{StaticResource FilterBorderStyle}"
							Background="#F8FAFC">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="36" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<materialDesign:PackIcon Kind="AccountTie"
													 Width="18"
													 Height="18"
													 Foreground="#A3AED0"
													 VerticalAlignment="Center"
													 HorizontalAlignment="Center" />
							<TextBox Grid.Column="1"
									 Text="{Binding PhieuThuForm.TenNguoiTao, UpdateSourceTrigger=PropertyChanged}"
									 IsReadOnly="True"
									 Margin="0 0 5 0"
									 Background="Transparent"
									 BorderThickness="0"
									 VerticalAlignment="Center"
									 HorizontalAlignment="Stretch"
									 FontSize="13"
									 Foreground="#9CA3AF"
									 materialDesign:HintAssist.Hint="Người lập" />
						</Grid>
					</Border>
				</Grid>

				<Border Grid.Row="3"
						Style="{StaticResource FilterBorderStyle}"
						Margin="0,0,0,12"
						Background="#F8FAFC">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="36" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<materialDesign:PackIcon Kind="Account"
												 Width="18"
												 Height="18"
												 Foreground="#A3AED0"
												 VerticalAlignment="Center"
												 HorizontalAlignment="Center" />
						<ComboBox Grid.Column="1"
								  ItemsSource="{Binding DanhSachKhachHangCombobox}"
								  SelectedItem="{Binding SelectedKhachHangForm, UpdateSourceTrigger=PropertyChanged}"
								  DisplayMemberPath="TenKhachHang"
								  IsHitTestVisible="{Binding IsKhachHangEnable}"
								  Margin="0 0 5 0"
								  Background="Transparent"
								  BorderThickness="0"
								  VerticalAlignment="Center"
								  HorizontalAlignment="Stretch"
								  FontSize="13"
								  Foreground="#2B3674"
								  materialDesign:HintAssist.Hint="Chọn khách hàng *" />
					</Grid>
				</Border>

				<Border Grid.Row="4"
						Style="{StaticResource FilterBorderStyle}"
						Margin="0,0,0,12"
						BorderBrush="#4318FF"
						BorderThickness="2">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="36" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<materialDesign:PackIcon Kind="CashMultiple"
												 Width="20"
												 Height="20"
												 Foreground="#4318FF"
												 VerticalAlignment="Center"
												 HorizontalAlignment="Center" />
						<TextBox Grid.Column="1"
								 Text="{Binding FormSoTienThu, UpdateSourceTrigger=PropertyChanged}"
								 Margin="0 0 5 0"
								 Background="Transparent"
								 BorderThickness="0"
								 VerticalAlignment="Center"
								 HorizontalAlignment="Stretch"
								 FontSize="16"
								 FontWeight="Bold"
								 Foreground="#4318FF"
								 materialDesign:HintAssist.Hint="Số tiền thu (VNĐ)" />
					</Grid>
				</Border>

				<Border Grid.Row="5"
						Style="{StaticResource FilterBorderStyle}"
						Margin="0,0,0,12">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="36" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<materialDesign:PackIcon Kind="Pencil"
												 Width="18"
												 Height="18"
												 Foreground="#A3AED0"
												 VerticalAlignment="Center"
												 HorizontalAlignment="Center" />
						<TextBox Grid.Column="1"
								 Text="{Binding PhieuThuForm.LyDoThu, UpdateSourceTrigger=PropertyChanged}"
								 Margin="0 0 5 0"
								 Background="Transparent"
								 BorderThickness="0"
								 VerticalAlignment="Center"
								 HorizontalAlignment="Stretch"
								 FontSize="13"
								 Foreground="#2B3674"
								 materialDesign:HintAssist.Hint="Lý do thu (VD: Thu nợ tháng 5)" />
					</Grid>
				</Border>

				<Border Grid.Row="6"
						CornerRadius="8"
						Background="#DCFCE7"
						Padding="14"
						Margin="0,0,0,20">
					<Grid>
						<TextBlock Text="Công nợ sau khi thu:"
								   Foreground="#166534"
								   FontWeight="SemiBold" />
						<TextBlock Text="{Binding ConNoSauKhiThu, StringFormat={}{0:N0} VNĐ}"
								   HorizontalAlignment="Right"
								   Foreground="#EF4444"
								   FontWeight="Bold"
								   FontSize="16" />
					</Grid>
				</Border>

				<StackPanel Grid.Row="7"
							Orientation="Horizontal"
							HorizontalAlignment="Right">
					<Button Content="HỦY"
							Width="100"
							Height="40"
							Margin="0,0,10,0"
							Style="{StaticResource OutlineButtonStyle}"
							Command="{Binding DongPopupThuTienCommand}"
							CommandParameter="{Binding}" />
					<Button Content="LƯU PHIẾU"
							Width="130"
							Height="40"
							Style="{StaticResource MainGradientButton}"
							Command="{Binding XacNhanThuTienCommand}"
							CommandParameter="{Binding}" />
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</UserControl>