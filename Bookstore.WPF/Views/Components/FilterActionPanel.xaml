<UserControl x:Class="Bookstore.WPF.Views.Components.FilterActionPanel"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 x:Name="Root">

	<StackPanel Orientation="Horizontal"
				VerticalAlignment="Center"
				HorizontalAlignment="Right">
		
		<Button Width="42"
				Height="42"
				Margin="10,0,0,0"
				ToolTip="Xóa tất cả bộ lọc"
				Command="{Binding ClearCommand, ElementName=Root}"
				CommandParameter="{Binding}"
				BorderThickness="0"
				Cursor="Hand"
				Visibility="{Binding ShowClearButton, ElementName=Root, Converter={StaticResource BoolToVis}}">
			<Button.Style>
				<Style TargetType="Button">
					<Setter Property="Background"
							Value="#FEE2E2" />
					<Setter Property="Foreground"
							Value="#EF4444" />
					<Style.Triggers>
						<Trigger Property="IsMouseOver"
								 Value="True">
							<Setter Property="Background"
									Value="#FECACA" />
							<Setter Property="Foreground"
									Value="#DC2626" />
						</Trigger>
						<Trigger Property="IsPressed"
								 Value="True">
							<Setter Property="Background"
									Value="#FCA5A5" />
							<Setter Property="Opacity"
									Value="0.8" />
						</Trigger>
					</Style.Triggers>
				</Style>
			</Button.Style>
			<Button.Template>
				<ControlTemplate TargetType="Button">
					<Border Background="{TemplateBinding Background}"
							CornerRadius="10">
						<materialDesign:PackIcon Kind="FilterOff"
												 Width="20"
												 Height="20"
												 Foreground="{TemplateBinding Foreground}"
												 HorizontalAlignment="Center"
												 VerticalAlignment="Center" />
					</Border>
				</ControlTemplate>
			</Button.Template>
		</Button>

		<Button Width="42"
				Height="42"
				ToolTip="Làm mới"
				Command="{Binding RefreshCommand, ElementName=Root}"
				CommandParameter="{Binding}"
				Margin="10,0,0,0"
				BorderThickness="0"
				Cursor="Hand"
				Visibility="{Binding ShowRefreshButton, ElementName=Root, Converter={StaticResource BoolToVis}}">
			<Button.Style>
				<Style TargetType="Button">
					<Setter Property="Background"
							Value="#E0E7FF" />
					<Setter Property="Foreground"
							Value="#4318FF" />
					<Style.Triggers>
						<Trigger Property="IsMouseOver"
								 Value="True">
							<Setter Property="Background"
									Value="#C7D2FE" />
							<Setter Property="Foreground"
									Value="#250AA0" />
						</Trigger>
						<Trigger Property="IsPressed"
								 Value="True">
							<Setter Property="Background"
									Value="#A5B4FC" />
							<Setter Property="Opacity"
									Value="0.8" />
						</Trigger>
					</Style.Triggers>
				</Style>
			</Button.Style>
			<Button.Template>
				<ControlTemplate TargetType="Button">
					<Border Background="{TemplateBinding Background}"
							CornerRadius="10">
						<materialDesign:PackIcon Kind="Refresh"
												 Width="20"
												 Height="20"
												 Foreground="{TemplateBinding Foreground}"
												 HorizontalAlignment="Center"
												 VerticalAlignment="Center" />
					</Border>
				</ControlTemplate>
			</Button.Template>
		</Button>

	</StackPanel>
</UserControl>