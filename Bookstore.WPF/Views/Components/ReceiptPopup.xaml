<UserControl x:Class="Bookstore.WPF.Views.Components.ReceiptPopup"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 xmlns:vm="clr-namespace:Bookstore.WPF.ViewModels"
			 xmlns:local="clr-namespace:Bookstore.WPF.Converters"
			 mc:Ignorable="d"
			 d:DesignHeight="600"
			 d:DesignWidth="800"
			 d:DataContext="{d:DesignInstance Type=vm:ReceiptPopupViewModel}">

	<UserControl.Resources>
		<local:CurrencyConverter x:Key="CurrencyConverter" />
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
		<!-- Row index shown via DataGridRow.Tag set in code-behind -->

		<!-- Style -->
		<SolidColorBrush x:Key="PrimaryDarkColor"
						 Color="#2B3674" />
		<SolidColorBrush x:Key="PrimaryColor"
						 Color="#4318FF" />
		<SolidColorBrush x:Key="TextLightColor"
						 Color="#A3AED0" />
		<SolidColorBrush x:Key="BackgroundColor"
						 Color="#F4F7FE" />
		<SolidColorBrush x:Key="WhiteColor"
						 Color="White" />
		<SolidColorBrush x:Key="DangerColor"
						 Color="#EF4444" />
		<SolidColorBrush x:Key="SuccessColor"
						 Color="#10B981" />
		<SolidColorBrush x:Key="WarningColor"
						 Color="#F59E0B" />

		<LinearGradientBrush x:Key="GradientButtonBrush"
							 StartPoint="0,0"
							 EndPoint="1,0">
			<GradientStop Color="#4318FF"
						  Offset="0" />
			<GradientStop Color="#5B3CFF"
						  Offset="1" />
		</LinearGradientBrush>
		<LinearGradientBrush x:Key="GradientSuccessBrush"
							 StartPoint="0,0"
							 EndPoint="1,0">
			<GradientStop Color="#10B981"
						  Offset="0" />
			<GradientStop Color="#059669"
						  Offset="1" />
		</LinearGradientBrush>

		<DropShadowEffect x:Key="CardShadowEffect"
						  BlurRadius="20"
						  ShadowDepth="0"
						  Opacity="0.08"
						  Color="#4318FF" />
		<DropShadowEffect x:Key="PopupShadowEffect"
						  BlurRadius="30"
						  ShadowDepth="0"
						  Opacity="0.15"
						  Color="#2B3674" />

		<Style x:Key="MainGradientButton"
			   TargetType="Button">
			<Setter Property="Height"
					Value="36" />
			<Setter Property="FontSize"
					Value="13" />
			<Setter Property="FontWeight"
					Value="SemiBold" />
			<Setter Property="Foreground"
					Value="White" />
			<Setter Property="Cursor"
					Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{StaticResource GradientButtonBrush}"
								CornerRadius="12">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="PageButtonStyle"
			   TargetType="Button">
			<Setter Property="Width"
					Value="38" />
			<Setter Property="Height"
					Value="38" />
			<Setter Property="FontSize"
					Value="14" />
			<Setter Property="FontWeight"
					Value="SemiBold" />
			<Setter Property="Foreground"
					Value="#2B3674" />
			<Setter Property="Background"
					Value="Transparent" />
			<Setter Property="BorderThickness"
					Value="0" />
			<Setter Property="Cursor"
					Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border"
								Background="{TemplateBinding Background}"
								CornerRadius="10">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver"
									 Value="True">
								<Setter TargetName="border"
										Property="Background"
										Value="#E0E7FF" />
								<Setter Property="Foreground"
										Value="#4318FF" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="ActivePageButtonStyle"
			   TargetType="Button"
			   BasedOn="{StaticResource PageButtonStyle}">
			<Setter Property="Background"
					Value="#4318FF" />
			<Setter Property="Foreground"
					Value="White" />
		</Style>
		<Style x:Key="ReadOnlyInputStyle"
			   TargetType="Control">
			<Setter Property="Foreground"
					Value="#9CA3AF" />
		</Style>

		<Style x:Key="FilterBorderStyle"
			   TargetType="Border">
			<Setter Property="CornerRadius"
					Value="16" />
			<Setter Property="Background"
					Value="White" />
			<Setter Property="BorderBrush"
					Value="#E2E8F0" />
			<Setter Property="BorderThickness"
					Value="1" />
			<Setter Property="Height"
					Value="42" />
		</Style>

		<Style x:Key="MaterialDesignFloatingHintTextBox"
			   TargetType="TextBox">
			<Setter Property="Height"
					Value="42" />
			<Setter Property="FontSize"
					Value="13" />
			<Setter Property="VerticalContentAlignment"
					Value="Center" />
			<Setter Property="Padding"
					Value="0,8,0,0" />
			<Setter Property="BorderBrush"
					Value="#E2E8F0" />

			<Setter Property="BorderThickness"
					Value="0,0,0,1" />

			<Setter Property="Background"
					Value="Transparent" />
		</Style>
	</UserControl.Resources>

	<Grid x:Name="popupThuTien"
		  Background="#80000000"
		  Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"
		  VerticalAlignment="Stretch"
		  HorizontalAlignment="Stretch"
		  Panel.ZIndex="1000">

		<Border Background="Transparent">
			<Border.InputBindings>
				<MouseBinding MouseAction="LeftClick"
							  Command="{Binding DongPopupCommand}" />
			</Border.InputBindings>
		</Border>

		<Border Width="500"
				Background="White"
				CornerRadius="16"
				Effect="{StaticResource PopupShadowEffect}"
				HorizontalAlignment="Center"
				VerticalAlignment="Center">

			<Grid Margin="28">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>
				
				<!--header-->
				<Grid Grid.Row="0"
					  Margin="0,0,0,20">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="40" />
					</Grid.ColumnDefinitions>
					<StackPanel Orientation="Horizontal"
								VerticalAlignment="Center">
						<materialDesign:PackIcon Kind="Cash"
												 Width="22"
												 Height="22"
												 Foreground="#4318FF"
												 Margin="0,0,8,0" />
						<TextBlock Text="{Binding PopupTitle, TargetNullValue='PHIẾU THU TIỀN'}"
								   FontSize="18"
								   FontWeight="Bold"
								   Foreground="#2B3674"
								   VerticalAlignment="Center" />
					</StackPanel>
					<Button Grid.Column="1"
							Content="✕"
							Width="30"
							Height="30"
							HorizontalAlignment="Right"
							VerticalAlignment="Top"
							Background="Transparent"
							BorderThickness="0"
							Foreground="#A3AED0"
							Command="{Binding DongPopupCommand}" />
				</Grid>
				
				<!-- Mã phiếu thu -->
				<Border Grid.Row="1"
						Style="{StaticResource FilterBorderStyle}"
						Margin="0,0,0,14"
						Background="#F8FAFC"
						Visibility="{Binding IsMaPhieuVisible, Converter={StaticResource BoolToVis}}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="36" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<materialDesign:PackIcon Kind="Barcode"
												 Width="18"
												 Height="18"
												 Foreground="#A3AED0"
												 VerticalAlignment="Center"
												 HorizontalAlignment="Center" />
						<TextBlock Grid.Column="1"
								   Margin="0 0 5 0"
								   Background="Transparent"
								   VerticalAlignment="Center"
								   HorizontalAlignment="Stretch"
								   FontSize="13"
								   Foreground="#9CA3AF">
							<TextBlock.Text>
								<MultiBinding StringFormat="PT{0:ddMMyy}{1:D3}">
									<Binding Path="PhieuThuForm.NgayTao" />
									<Binding Path="PhieuThuForm.MaPhieuThuTien" />
								</MultiBinding>
							</TextBlock.Text>
						</TextBlock>
					</Grid>
				</Border>
				
				<!--Ngày tạo, người tạo-->
				<Grid Grid.Row="2"
					  Margin="0,0,0,12">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="12" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<Border Grid.Column="0"
							Style="{StaticResource FilterBorderStyle}"
							Background="#F8FAFC">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="36" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<materialDesign:PackIcon Kind="CalendarClock"
													 Width="18"
													 Height="18"
													 Foreground="#A3AED0"
													 VerticalAlignment="Center"
													 HorizontalAlignment="Center" />
							<DatePicker Grid.Column="1"
										SelectedDate="{x:Static sys:DateTime.Now}"
										IsEnabled="False"
										Margin="0 0 5 0"
										Background="Transparent"
										BorderThickness="0"
										VerticalAlignment="Center"
										HorizontalAlignment="Stretch"
										FontSize="13"
										Foreground="#9CA3AF" />
						</Grid>
					</Border>

					<Border Grid.Column="2"
							Style="{StaticResource FilterBorderStyle}"
							Background="#F8FAFC">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="36" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<materialDesign:PackIcon Kind="AccountTie"
													 Width="18"
													 Height="18"
													 Foreground="#A3AED0"
													 VerticalAlignment="Center"
													 HorizontalAlignment="Center" />
							<TextBox Grid.Column="1"
									 Text="{Binding PhieuThuForm.TenNguoiTao, UpdateSourceTrigger=PropertyChanged}"
									 IsReadOnly="True"
									 Margin="0 0 5 0"
									 Background="Transparent"
									 BorderThickness="0"
									 VerticalAlignment="Center"
									 HorizontalAlignment="Stretch"
									 FontSize="13"
									 Foreground="#9CA3AF"
									 materialDesign:HintAssist.Hint="Người lập" />
						</Grid>
					</Border>
				</Grid>

				<!--Thông tin khách hàng-->
				<Border Grid.Row="3"
						Style="{StaticResource FilterBorderStyle}"
						Margin="0,0,0,12"
						Background="White">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="36" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<materialDesign:PackIcon Kind="Account"
												 Width="18"
												 Height="18"
												 Foreground="#A3AED0"
												 VerticalAlignment="Center"
												 HorizontalAlignment="Center" />
						<ComboBox Grid.Column="1"
								  ItemsSource="{Binding DanhSachKhachHangCombobox}"
								  SelectedItem="{Binding SelectedKhachHangForm, UpdateSourceTrigger=PropertyChanged}"
								  DisplayMemberPath="TenKhachHang"
								  IsHitTestVisible="{Binding IsKhachHangEnable}"
								  Margin="0 0 5 0"
								  Background="Transparent"
								  BorderThickness="0"
								  VerticalAlignment="Center"
								  HorizontalAlignment="Stretch"
								  FontSize="13"
								  Foreground="#2B3674"
								  materialDesign:HintAssist.Hint="Chọn khách hàng *" />
					</Grid>
				</Border>

				<!--Nhập số tiền-->
				<Border Grid.Row="4"
						Style="{StaticResource FilterBorderStyle}"
						Margin="0,0,0,12"
						BorderBrush="#4318FF"
						BorderThickness="2">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="36" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<materialDesign:PackIcon Kind="CashMultiple"
												 Width="20"
												 Height="20"
												 Foreground="#4318FF"
												 VerticalAlignment="Center"
												 HorizontalAlignment="Center" />

						<DockPanel Grid.Column="1"
								   LastChildFill="True"
								   Margin="0,0,5,0">
							<TextBlock Text="VNĐ"
									   DockPanel.Dock="Right"
									   VerticalAlignment="Center"
									   FontWeight="Bold"
									   Foreground="#4318FF"
									   Margin="5,0,0,0" />

							<TextBox Grid.Column="1"
									 x:Name="txtSoTienThu"
									 Text="{Binding FormSoTienThu, Converter={StaticResource CurrencyConverter}, UpdateSourceTrigger=PropertyChanged}"
									 PreviewTextInput="TxtSoTienThu_PreviewTextInput"
									 TextChanged="TxtSoTienThu_TextChanged"
									 Margin="0 0 5 0"
									 Background="Transparent"
									 BorderThickness="0"
									 VerticalAlignment="Center"
									 HorizontalAlignment="Stretch"
									 FontSize="16"
									 FontWeight="Bold"
									 Foreground="#4318FF"
									 materialDesign:HintAssist.Hint="Số tiền thu" />
						</DockPanel>
					</Grid>
				</Border>

				<!--Lý do thu-->
				<Border Grid.Row="5"
						Style="{StaticResource FilterBorderStyle}"
						Margin="0,0,0,12">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="36" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<materialDesign:PackIcon Kind="Pencil"
												 Width="18"
												 Height="18"
												 Foreground="#A3AED0"
												 VerticalAlignment="Center"
												 HorizontalAlignment="Center" />
						<TextBox Grid.Column="1"
								 Text="{Binding PhieuThuForm.LyDoThu, UpdateSourceTrigger=PropertyChanged}"
								 Margin="0 0 5 0"
								 Background="Transparent"
								 BorderThickness="0"
								 VerticalAlignment="Center"
								 HorizontalAlignment="Stretch"
								 FontSize="13"
								 Foreground="#2B3674"
								 materialDesign:HintAssist.Hint="Lý do thu (VD: Thu nợ tháng 5)" />
					</Grid>
				</Border>

				<!--Nợ sau thu-->
				<Border Grid.Row="6"
						CornerRadius="8"
						Padding="14"
						Margin="0,0,0,20"
						Visibility="{Binding IsConLaiVisible, Converter={StaticResource BoolToVis}}">
					<Grid>
						<TextBlock Text="Công nợ sau khi thu:"
								   FontWeight="SemiBold" />
						<TextBlock Text="{Binding ConNoSauKhiThu, StringFormat={}{0:N0} VNĐ}"
								   HorizontalAlignment="Right"
								   Foreground="#EF4444"
								   FontWeight="Bold"
								   FontSize="16" />
					</Grid>
				</Border>

				<StackPanel Grid.Row="7"
							Orientation="Horizontal"
							HorizontalAlignment="Right">
					<Button Content="HỦY"
							Width="100"
							Height="40"
							Margin="0,0,10,0"
							Style="{StaticResource OutlineButtonStyle}"
							Command="{Binding DongPopupCommand}"
							CommandParameter="{Binding}" />
					<Button Content="LƯU PHIẾU"
							Width="130"
							Height="40"
							Style="{StaticResource MainGradientButton}"
							Command="{Binding LuuPhieuThuCommand}"
							CommandParameter="{Binding}" />
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</UserControl>