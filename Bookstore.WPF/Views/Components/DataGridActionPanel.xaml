<UserControl x:Class="Bookstore.WPF.Views.Components.DataGridActionPanel"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 x:Name="Root">

	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
	</UserControl.Resources>

	<StackPanel Orientation="Horizontal"
				HorizontalAlignment="Center"
				VerticalAlignment="Center">

		<Button Style="{StaticResource ActionTextSuccessButton}"
				Visibility="{Binding ShowAction, ElementName=Root, Converter={StaticResource BoolToVis}}"
				IsEnabled="{Binding IsActionEnabled, ElementName=Root}"
				Command="{Binding ActionCommand, ElementName=Root}"
				CommandParameter="{Binding RowItem, ElementName=Root}"
				ToolTip="{Binding ActionToolTip, ElementName=Root}"
				Margin="0,0,8,0">
			<StackPanel Orientation="Horizontal"
						VerticalAlignment="Center">
				<materialDesign:PackIcon Kind="{Binding ActionIcon, ElementName=Root}"
										 Width="15"
										 Height="15"
										 Margin="0,0,6,0" />
				<TextBlock Text="{Binding ActionText, ElementName=Root}"
						   FontSize="12"
						   FontWeight="SemiBold"
						   VerticalAlignment="Center" />
			</StackPanel>
		</Button>

		<Button Style="{StaticResource MiniPrimaryButton}"
				Visibility="{Binding ShowView, ElementName=Root, Converter={StaticResource BoolToVis}}"
				Command="{Binding ViewCommand, ElementName=Root}"
				CommandParameter="{Binding RowItem, ElementName=Root}"
				ToolTip="Xem chi tiết"
				Margin="0,0,8,0">
			<materialDesign:PackIcon Kind="Eye"
									 Width="15"
									 Height="15" />
		</Button>

		<Button Style="{StaticResource MiniPrimaryButton}"
				Visibility="{Binding ShowEdit, ElementName=Root, Converter={StaticResource BoolToVis}}"
				Command="{Binding EditCommand, ElementName=Root}"
				CommandParameter="{Binding RowItem, ElementName=Root}"
				ToolTip="Sửa thông tin"
				Margin="0,0,8,0">
			<materialDesign:PackIcon Kind="Edit"
									 Width="15"
									 Height="15" />
		</Button>

		<Button Style="{StaticResource MiniDangerButton}"
				Visibility="{Binding ShowDelete, ElementName=Root, Converter={StaticResource BoolToVis}}"
				Command="{Binding DeleteCommand, ElementName=Root}"
				CommandParameter="{Binding RowItem, ElementName=Root}"
				ToolTip="Xóa">
			<materialDesign:PackIcon Kind="Delete"
									 Width="15"
									 Height="15" />
		</Button>

	</StackPanel>
</UserControl>