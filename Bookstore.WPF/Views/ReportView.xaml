<UserControl x:Class="Bookstore.WPF.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="1200" d:DesignWidth="1600"
             Background="#F4F7FE"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/XAMLRes/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <SolidColorBrush x:Key="PrimaryDarkColor" Color="#2B3674"/>
            <SolidColorBrush x:Key="PrimaryColor" Color="#4318FF"/>
            <SolidColorBrush x:Key="TextLightColor" Color="#A3AED0"/>
            <SolidColorBrush x:Key="BackgroundColor" Color="#F4F7FE"/>

            <LinearGradientBrush x:Key="GradientButtonBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#4318FF" Offset="0"/>
                <GradientStop Color="#5B3CFF" Offset="1"/>
            </LinearGradientBrush>

            <Style x:Key="MainGradientButton" TargetType="Button">
                <Setter Property="Height" Value="42"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{StaticResource GradientButtonBrush}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FilterBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height" Value="42"/>
            </Style>

            <Style x:Key="OutlineExcelButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="36"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="Green"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" BorderBrush="Green" BorderThickness="1.5" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="OutlinePDFButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="36"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="OrangeRed"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" BorderBrush="OrangeRed" BorderThickness="1.5" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DashboardCardStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <Style TargetType="DataGrid" x:Key="CleanDataGrid">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
                <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="#2B3674"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
                <Setter Property="RowBackground" Value="White"/>
                <Setter Property="CanUserSortColumns" Value="True"/>
                <Setter Property="SelectionMode" Value="Single"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="MinRowHeight" Value="52"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="CanUserResizeColumns" Value="True"/>
                <Setter Property="CanUserResizeRows" Value="False"/>
                <Setter Property="CanUserReorderColumns" Value="False"/>
                <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
                <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True"/>
            </Style>

            <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Vertical">
                        <Setter Property="LayoutTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleX="0.4"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Margin" Value="0,0,2,0"/>
                    </Trigger>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="LayoutTransform">
                            <Setter.Value>
                                <ScaleTransform ScaleY="0.4"/>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Margin" Value="0,0,0,2"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#F8FAFC"/>
                <Setter Property="Foreground" Value="#2B3674"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style x:Key="CenterHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
            </Style>
            <Style x:Key="LeftHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>
            <Style x:Key="RightHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="HorizontalContentAlignment" Value="Right"/>
            </Style>

            <Style TargetType="DataGridCell">
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Padding" Value="12,0"/>
            </Style>

            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#E0E7FF"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F3F4F6"/>
                        <Setter Property="Cursor" Value="Hand"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CellCenter" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="8,0"/>
            </Style>
            <Style x:Key="CellLeft" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="12,0,8,0"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="CellRight" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="8,0,12,0"/>
            </Style>
            <Style x:Key="CellMoney" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="8,0,12,0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#2B3674"/>
            </Style>
            <Style x:Key="CellProfit" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="8,0,12,0"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#05CD99"/>
            </Style>
            <Style x:Key="CellDebt" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="8,0,12,0"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#EE5D50"/>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundColor}">
        <Ellipse Width="400" Height="400" Fill="#4318FF" Opacity="0.03"
                 VerticalAlignment="Top" HorizontalAlignment="Left" Margin="-150,-150,0,0" IsHitTestVisible="False"/>
        <Ellipse Width="300" Height="300" Fill="#2B3674" Opacity="0.03"
                 VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,-100,-100" IsHitTestVisible="False"/>

        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Margin="0,0,0,12" Padding="20" CornerRadius="16"
                        Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ChartAreaspline" Width="28" Height="28"
                                                     Foreground="#4318FF" Margin="0,0,10,0"/>
                        <TextBlock Text="BÁO CÁO KINH DOANH" FontSize="24" FontWeight="Bold"
                                            Foreground="#2B3674" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource OutlinePDFButtonStyle}" CommandParameter="{Binding}" Width="120" Margin="0,0,10,0" Command="{Binding ExportPdfCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Width="16" Height="16" Foreground="OrangeRed" Margin="0,0,6,0"/>
                                <TextBlock Text="XUẤT PDF"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlineExcelButtonStyle}" CommandParameter="{Binding}" Width="120" Command="{Binding ExportExcelCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExcel" Width="16" Height="16" Foreground="Green" Margin="0,0,6,0"/>
                                <TextBlock Text="XUẤT EXCEL"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,0,0,12" Padding="20" CornerRadius="16"
                    Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Border Style="{StaticResource FilterBorderStyle}" Margin="0,0,12,10" Width="220">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="FileChart" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedReportTypeIndex, Mode=TwoWay}"
                                      Background="Transparent" BorderThickness="0" FontSize="13" Foreground="#2B3674"
                                      VerticalAlignment="Center" materialDesign:HintAssist.Hint="Loại báo cáo">
                                <ComboBoxItem Content="Doanh thu &amp; Lợi nhuận"/>
                                <ComboBoxItem Content="Tồn kho"/>
                                <ComboBoxItem Content="Công nợ"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource FilterBorderStyle}" Margin="0,0,12,10" Width="150">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="CalendarStart" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding FromDate, Mode=TwoWay}"
                                        Background="Transparent" BorderThickness="0" FontSize="13" Foreground="#2B3674"
                                        VerticalAlignment="Center" materialDesign:HintAssist.Hint="Từ ngày"
                                        materialDesign:TextFieldAssist.UnderlineBrush="Transparent"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource FilterBorderStyle}" Margin="0,0,12,10" Width="150">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="CalendarEnd" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding ToDate, Mode=TwoWay}"
                                        Background="Transparent" BorderThickness="0" FontSize="13" Foreground="#2B3674"
                                        VerticalAlignment="Center" materialDesign:HintAssist.Hint="Đến ngày"
                                        materialDesign:TextFieldAssist.UnderlineBrush="Transparent"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding RevenueSecondaryFilterVisibility}">
                        <Border Style="{StaticResource FilterBorderStyle}" Margin="0,0,12,10" Width="150">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="35"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="FilterVariant" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedRevenueSubFilterType, Mode=TwoWay}"
                                          Background="Transparent" BorderThickness="0" FontSize="13" Foreground="#2B3674"
                                          VerticalAlignment="Center" materialDesign:HintAssist.Hint="Lọc theo">
                                    <ComboBoxItem Content="Tất cả"/>
                                    <ComboBoxItem Content="Nhân viên"/>
                                    <ComboBoxItem Content="Thể loại"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource FilterBorderStyle}" Margin="0,0,12,10" Width="180" Visibility="{Binding RevenueSubItemFilterVisibility}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="35"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="SubdirectoryArrowRight" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding RevenueSubItemsSource}" SelectedItem="{Binding SelectedRevenueSubItem, Mode=TwoWay}"
                                          Background="Transparent" BorderThickness="0" FontSize="13" Foreground="#2B3674"
                                          VerticalAlignment="Center" materialDesign:HintAssist.Hint="Chọn..."/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding DebtSecondaryFilterVisibility}">
                        <Border Style="{StaticResource FilterBorderStyle}" Margin="0,0,12,10" Width="200">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="35"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="AccountOutline" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding CustomerList}" SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                                          Background="Transparent" BorderThickness="0" FontSize="13" Foreground="#2B3674"
                                          VerticalAlignment="Center" materialDesign:HintAssist.Hint="Tất cả KH"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Button Style="{StaticResource MainGradientButton}" Command="{Binding ApplyReportCommand}" Width="150" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="XEM BÁO CÁO" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="{Binding ChartIconKind}" Width="20" Height="20" Foreground="#4318FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ChartTitle}" FontSize="15" FontWeight="Bold" Foreground="#2B3674"/>
                                        <TextBlock Text="{Binding ChartSubtitle}" FontSize="11" Foreground="#A3AED0" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding RevenueChartVisibility}">
                                    <Border Width="12" Height="12" Background="#EE5D50" CornerRadius="2" Margin="0,0,5,0"/>
                                    <TextBlock Text="Giá vốn" FontSize="11" Foreground="#64748B" Margin="0,0,12,0"/>
                                    <Border Width="12" Height="12" Background="#05CD99" CornerRadius="2" Margin="0,0,5,0"/>
                                    <TextBlock Text="Lợi nhuận" FontSize="11" Foreground="#64748B"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding DebtChartVisibility}">
                                    <Border Width="12" Height="3" Background="#EE5D50" CornerRadius="2" Margin="0,0,5,0"/>
                                    <TextBlock Text="Nợ phát sinh" FontSize="11" Foreground="#64748B" Margin="0,0,12,0"/>
                                    <Border Width="12" Height="3" Background="#05CD99" CornerRadius="2" Margin="0,0,5,0"/>
                                    <TextBlock Text="Nợ thu hồi" FontSize="11" Foreground="#64748B"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Visibility="{Binding LoadingVisibility}" ZIndex="10" MinHeight="250">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" IsIndeterminate="True" Foreground="#4318FF"/>
                                    <TextBlock Text="Đang vẽ biểu đồ..." FontSize="13" Foreground="#A3AED0" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Visibility="{Binding ContentVisibility}" MinHeight="250">
                                <lvc:CartesianChart Series="{Binding RevenueChartSeries}" XAxes="{Binding RevenueXAxes}" YAxes="{Binding RevenueYAxes}" Visibility="{Binding RevenueChartVisibility}" ZoomMode="X" TooltipPosition="Top" LegendPosition="Hidden"/>
                                <lvc:CartesianChart Series="{Binding InventoryChartSeries}" XAxes="{Binding InventoryXAxes}" YAxes="{Binding InventoryYAxes}" Visibility="{Binding InventoryChartVisibility}" TooltipPosition="Right" LegendPosition="Hidden"/>
                                <lvc:CartesianChart Series="{Binding DebtChartSeries}" XAxes="{Binding DebtXAxes}" Visibility="{Binding DebtChartVisibility}" ZoomMode="X" TooltipPosition="Top" LegendPosition="Hidden"/>

                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ContentVisibility}">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TotalRows}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <materialDesign:PackIcon Kind="ChartBoxOutline" Width="64" Height="64" Foreground="#E2E8F0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Chưa có dữ liệu" FontSize="16" FontWeight="SemiBold" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                    <TextBlock Text="Chọn bộ lọc phù hợp và nhấn 'Xem Báo Cáo'" FontSize="12" Foreground="#E2E8F0" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,5" Padding="20,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TableLarge" Width="18" Height="18" Foreground="#4318FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding TableTitle}" FontSize="15" FontWeight="Bold" Foreground="#2B3674" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Tổng cộng: " FontSize="12" Foreground="#A3AED0"/>
                                    <TextBlock Text="{Binding TotalRows}" FontSize="12" FontWeight="Bold" Foreground="#4318FF"/>
                                    <TextBlock Text=" dòng" FontSize="12" Foreground="#A3AED0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Visibility="{Binding ContentVisibility}">
                                <DataGrid Style="{StaticResource CleanDataGrid}" ItemsSource="{Binding RevenueRows}" Visibility="{Binding RevenueGridVisibility}" PreviewMouseWheel="DataGrid_PreviewMouseWheel">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="NGÀY" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="110" HeaderStyle="{StaticResource CenterHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellCenter}">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="SỐ HÓA ĐƠN" Binding="{Binding InvoiceCount}" Width="120" HeaderStyle="{StaticResource CenterHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellCenter}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="SL SÁCH BÁN" Binding="{Binding BooksSold}" Width="120" HeaderStyle="{StaticResource CenterHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellCenter}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="TỔNG TIỀN HÀNG" Binding="{Binding TotalAmount, StringFormat='{}{0:#,0} đ'}" Width="*" HeaderStyle="{StaticResource RightHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellMoney}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="GIẢM GIÁ" Binding="{Binding Discount, StringFormat='{}{0:#,0} đ'}" Width="130" HeaderStyle="{StaticResource RightHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellRight}">
                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="DOANH THU THUẦN" Binding="{Binding NetRevenue, StringFormat='{}{0:#,0} đ'}" Width="*" HeaderStyle="{StaticResource RightHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellMoney}">
                                                    <Setter Property="Foreground" Value="#4318FF"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="LỢI NHUẬN GỘP" Binding="{Binding GrossProfit, StringFormat='{}{0:#,0} đ'}" Width="*" HeaderStyle="{StaticResource RightHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellProfit}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <DataGrid Style="{StaticResource CleanDataGrid}" ItemsSource="{Binding InventoryRows}" Visibility="{Binding InventoryGridVisibility}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="MÃ SÁCH" Binding="{Binding BookId}" Width="90" HeaderStyle="{StaticResource CenterHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellCenter}">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="#A3AED0"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="TÊN SÁCH" Binding="{Binding BookName}" Width="2*" HeaderStyle="{StaticResource LeftHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellLeft}">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="#1E293B"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="THỂ LOẠI" Binding="{Binding CategoryName}" Width="150" HeaderStyle="{StaticResource CenterHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellCenter}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="TỒN ĐẦU KỲ" Binding="{Binding OpeningQty}" Width="110" HeaderStyle="{StaticResource CenterHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellCenter}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="NHẬP" Binding="{Binding ImportedQty}" Width="90" HeaderStyle="{StaticResource CenterHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellCenter}">
                                                    <Setter Property="Foreground" Value="#4318FF"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="XUẤT (BÁN)" Binding="{Binding SoldQty}" Width="110" HeaderStyle="{StaticResource CenterHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellCenter}">
                                                    <Setter Property="Foreground" Value="#05CD99"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="TỒN CUỐI KỲ" Binding="{Binding ClosingQty}" Width="120" HeaderStyle="{StaticResource CenterHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellCenter}">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="GIÁ TRỊ TỒN KHO" Binding="{Binding StockValue, StringFormat='{}{0:#,0} đ'}" Width="*" HeaderStyle="{StaticResource RightHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellMoney}">
                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <DataGrid Style="{StaticResource CleanDataGrid}" ItemsSource="{Binding DebtRows}" Visibility="{Binding DebtGridVisibility}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="TÊN KHÁCH HÀNG" Binding="{Binding CustomerName}" Width="2*" HeaderStyle="{StaticResource LeftHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellLeft}">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="#1E293B"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="NỢ ĐẦU KỲ" Binding="{Binding OpeningDebt, StringFormat='{}{0:#,0} đ'}" Width="*" HeaderStyle="{StaticResource RightHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellMoney}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="PHÁT SINH" Binding="{Binding NewDebt, StringFormat='{}{0:#,0} đ'}" Width="*" HeaderStyle="{StaticResource RightHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellDebt}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="ĐÃ THU" Binding="{Binding PaidDebt, StringFormat='{}{0:#,0} đ'}" Width="*" HeaderStyle="{StaticResource RightHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellProfit}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="NỢ CUỐI KỲ" Binding="{Binding ClosingDebt, StringFormat='{}{0:#,0} đ'}" Width="*" HeaderStyle="{StaticResource RightHeaderStyle}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Setter Property="Margin" Value="8,0,12,0"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="FontSize" Value="14"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasDebt}" Value="True">
                                                            <Setter Property="Foreground" Value="#EE5D50"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasDebt}" Value="False">
                                                            <Setter Property="Foreground" Value="#05CD99"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>