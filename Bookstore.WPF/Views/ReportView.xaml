<UserControl x:Class="Bookstore.WPF.Views.ReportView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 mc:Ignorable="d"
			 d:DesignHeight="1200"
			 d:DesignWidth="1600">

	<Grid>
		<Grid x:Name="MainReportView"
			  Margin="{StaticResource MainViewMargin}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"></RowDefinition>
				<RowDefinition Height="Auto"></RowDefinition>
				<RowDefinition Height="*"></RowDefinition>
				<RowDefinition Height="Auto"></RowDefinition>
			</Grid.RowDefinitions>

			<components:PageHeaderControl Title="BÁO CÁO KINH DOANH"
										  HeaderIcon="ChartAreaspline"
										  AddTitle="XEM BÁO CÁO"
										  AddIcon="Magnify"
										  AddCommand="{Binding ApplyReportCommand}"
										  AddCommandParameter="{Binding}"
										  ShowExportExcel="True"
										  ExportExcelCommand="{Binding ExportExcelCommand}"
										  ExportExcelCommandParameter="{Binding}"
										  ShowExportPdf="True"
										  ExportPdfCommand="{Binding ExportPdfCommand}"
										  ExportPdfCommandParameter="{Binding}" />

			<Border Grid.Row="1"
					Style="{StaticResource FilterCardStyle}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<components:FilterComboBoxControl Grid.Column="0"
													  Margin="0,0,8,0"
													  IconKind="QuestionMark"
													  HintText="Loại báo cáo"
													  ItemsSource="{Binding ReportTypeList}"
													  SelectedIndex="{Binding SelectedReportTypeIndex, Mode=TwoWay}" />

					<components:FilterDatePickerControl Grid.Column="1"
														Margin="0,0,8,0"
														IconKind="CalendarStart"
														HintText="Từ ngày"
														SelectedDate="{Binding FromDate}" />

					<components:FilterDatePickerControl Grid.Column="2"
														Margin="0,0,8,0"
														IconKind="CalendarEnd"
														HintText="Đến ngày"
														SelectedDate="{Binding ToDate}" />

					<components:FilterComboBoxControl Grid.Column="3"
													  Margin="0,0,8,0"
													  IconKind="FilterVariant"
													  HintText="Lọc theo"
													  ItemsSource="{Binding RevenueSubFilterTypeList}"
													  SelectedIndex="{Binding SelectedRevenueSubFilterType, Mode=TwoWay}" />
				</Grid>
			</Border>

			<ScrollViewer Grid.Row="2"
						  VerticalScrollBarVisibility="Auto">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto"></RowDefinition>
					</Grid.RowDefinitions>

					<Border x:Name="BieuDo"
							Grid.Row="0"
							Style="{StaticResource DashboardCardStyle}"
							Margin="0,0,0,12">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<Grid Grid.Row="0"
								  Margin="0,0,0,10">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0"
											Orientation="Horizontal">
									<materialDesign:PackIcon Kind="{Binding ChartIconKind}"
															 Width="20"
															 Height="20"
															 Foreground="#4318FF"
															 VerticalAlignment="Center"
															 Margin="0,0,8,0" />
									<StackPanel VerticalAlignment="Center">
										<TextBlock Text="{Binding ChartTitle}"
												   FontSize="15"
												   FontWeight="Bold"
												   Foreground="#2B3674" />
										<TextBlock Text="{Binding AnalysisMessage}"
												   FontSize="11"
												   Foreground="#A3AED0"
												   Margin="0,2,0,0" />
									</StackPanel>
								</StackPanel>

								<StackPanel Grid.Column="1"
											Orientation="Horizontal"
											VerticalAlignment="Center"
											Visibility="{Binding RevenueChartVisibility}">
									<Border Width="12"
											Height="12"
											Background="#EE5D50"
											CornerRadius="2"
											Margin="0,0,5,0" />
									<TextBlock Text="Giá vốn"
											   FontSize="11"
											   Foreground="#64748B"
											   Margin="0,0,12,0" />
									<Border Width="12"
											Height="12"
											Background="#05CD99"
											CornerRadius="2"
											Margin="0,0,5,0" />
									<TextBlock Text="Lợi nhuận"
											   FontSize="11"
											   Foreground="#64748B" />
								</StackPanel>
								<StackPanel Grid.Column="1"
											Orientation="Horizontal"
											VerticalAlignment="Center"
											Visibility="{Binding DebtChartVisibility}">
									<Border Width="12"
											Height="3"
											Background="#EE5D50"
											CornerRadius="2"
											Margin="0,0,5,0" />
									<TextBlock Text="Nợ phát sinh"
											   FontSize="11"
											   Foreground="#64748B"
											   Margin="0,0,12,0" />
									<Border Width="12"
											Height="3"
											Background="#05CD99"
											CornerRadius="2"
											Margin="0,0,5,0" />
									<TextBlock Text="Nợ thu hồi"
											   FontSize="11"
											   Foreground="#64748B" />
								</StackPanel>
							</Grid>

							<Grid Grid.Row="1"
								  Visibility="{Binding LoadingVisibility}"
								  Panel.ZIndex="10"
								  MinHeight="250"
								  Background="White">
								<StackPanel HorizontalAlignment="Center"
											VerticalAlignment="Center">
									<ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
												 Value="0"
												 IsIndeterminate="True"
												 Foreground="#4318FF" />
									<TextBlock Text="Đang vẽ biểu đồ..."
											   FontSize="13"
											   Foreground="#A3AED0"
											   Margin="0,10,0,0"
											   HorizontalAlignment="Center" />
								</StackPanel>
							</Grid>

							<Grid Grid.Row="1"
								  MinHeight="250">
								<lvc:CartesianChart Series="{Binding RevenueChartSeries}"
													XAxes="{Binding RevenueXAxes}"
													YAxes="{Binding RevenueYAxes}"
													Visibility="{Binding RevenueChartVisibility}"
													ZoomMode="None"
													TooltipPosition="Top"
													LegendPosition="Hidden" />
								<lvc:CartesianChart Series="{Binding InventoryChartSeries}"
													XAxes="{Binding InventoryXAxes}"
													YAxes="{Binding InventoryYAxes}"
													Visibility="{Binding InventoryChartVisibility}"
													TooltipPosition="Right"
													LegendPosition="Hidden" />
								<lvc:CartesianChart Series="{Binding DebtChartSeries}"
													XAxes="{Binding DebtXAxes}"
													YAxes="{Binding DebtYAxes}"
													Visibility="{Binding DebtChartVisibility}"
													ZoomMode="None"
													TooltipPosition="Top"
													LegendPosition="Hidden" />

								<StackPanel HorizontalAlignment="Center"
											VerticalAlignment="Center">
									<StackPanel.Style>
										<Style TargetType="StackPanel">
											<Setter Property="Visibility"
													Value="Collapsed" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding TotalRows}"
															 Value="0">
													<Setter Property="Visibility"
															Value="Visible" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</StackPanel.Style>
								</StackPanel>
							</Grid>
						</Grid>
					</Border>

					<Border x:Name="DataGrid"
							Grid.Row="1"
							Style="{StaticResource DataGridCardStyle}"
							Margin="0,0,0,5">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="570" />
							</Grid.RowDefinitions>

							<Grid x:Name="TableTitle"
								  Grid.Row="0"
								  Margin="0,0,0,10">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0"
											Orientation="Horizontal">
									<materialDesign:PackIcon Kind="TableLarge"
															 Width="18"
															 Height="18"
															 Foreground="#4318FF"
															 VerticalAlignment="Center"
															 Margin="0,0,8,0" />
									<TextBlock Text="{Binding TableTitle}"
											   FontSize="15"
											   FontWeight="Bold"
											   Foreground="#2B3674"
											   VerticalAlignment="Center" />
								</StackPanel>
								<StackPanel Grid.Column="1"
											Orientation="Horizontal"
											VerticalAlignment="Center">
									<TextBlock Text="Tổng cộng: "
											   FontSize="12"
											   Foreground="#A3AED0" />
									<TextBlock Text="{Binding TotalRows}"
											   FontSize="12"
											   FontWeight="Bold"
											   Foreground="#4318FF" />
									<TextBlock Text=" dòng"
											   FontSize="12"
											   Foreground="#A3AED0" />
								</StackPanel>
							</Grid>

							<Grid Grid.Row="1"
								  Visibility="{Binding ContentVisibility}">
								<DataGrid Style="{StaticResource CleanDataGrid}"
										  ItemsSource="{Binding RevenueRows}"
										  PreviewMouseWheel="DataGrid_PreviewMouseWheel"
										  Visibility="{Binding RevenueGridVisibility}">
									<DataGrid.Columns>
										<DataGridTextColumn Header="Ngày"
															Binding="{Binding Date, StringFormat=dd/MM/yyyy}"
															Width="110"
															HeaderStyle="{StaticResource CenterHeaderStyle}"
															ElementStyle="{StaticResource CellCenter}" />
										<DataGridTextColumn Header="Số hóa đơn"
															Binding="{Binding InvoiceCount}"
															Width="100"
															HeaderStyle="{StaticResource CenterHeaderStyle}"
															ElementStyle="{StaticResource CellCenter}" />

										<DataGridTextColumn Header="Số sách bán"
															Binding="{Binding BooksSold}"
															Width="100"
															HeaderStyle="{StaticResource CenterHeaderStyle}"
															ElementStyle="{StaticResource CellCenter}" />

										<DataGridTextColumn Header="Doanh thu gộp"
															Binding="{Binding TotalAmount, StringFormat='{}{0:#,0} đ'}"
															Width="*"
															HeaderStyle="{StaticResource RightHeaderStyle}"
															ElementStyle="{StaticResource CellMoney}" />

										<DataGridTextColumn Header="Giảm giá"
															Binding="{Binding Discount, StringFormat='{}{0:#,0} đ'}"
															Width="130"
															HeaderStyle="{StaticResource RightHeaderStyle}"
															ElementStyle="{StaticResource CellMoney}" />

										<DataGridTextColumn Header="Doanh thu thuần"
															Binding="{Binding NetRevenue, StringFormat='{}{0:#,0} đ'}"
															Width="*"
															HeaderStyle="{StaticResource RightHeaderStyle}"
															ElementStyle="{StaticResource CellProfit}" />

										<DataGridTextColumn Header="Tổng vốn"
															Binding="{Binding TotalCost, StringFormat='{}{0:#,0} đ'}"
															Width="*"
															HeaderStyle="{StaticResource RightHeaderStyle}"
															ElementStyle="{StaticResource CellDebt}" />

										<DataGridTextColumn Header="Lợi nhuận gộp"
															Binding="{Binding GrossProfit, StringFormat='{}{0:#,0} đ'}"
															Width="*"
															HeaderStyle="{StaticResource RightHeaderStyle}"
															ElementStyle="{StaticResource CellProfit}" />
									</DataGrid.Columns>
								</DataGrid>

								<DataGrid Style="{StaticResource CleanDataGrid}"
										  ItemsSource="{Binding InventoryRows}"
										  Visibility="{Binding InventoryGridVisibility}"
										  PreviewMouseWheel="DataGrid_PreviewMouseWheel">
									<DataGrid.Columns>
										<DataGridTextColumn Header="ISBN"
															Binding="{Binding BookId}"
															Width="150"
															HeaderStyle="{StaticResource LeftHeaderStyle}"
															ElementStyle="{StaticResource CellLeft}" />
										<DataGridTextColumn Header="Tựa sách"
															Binding="{Binding BookName}"
															Width="200"
															HeaderStyle="{StaticResource LeftHeaderStyle}"
															ElementStyle="{StaticResource CellName}" />

										<DataGridTemplateColumn Header="Thể loại"
																Width="150"
																HeaderStyle="{StaticResource CenterHeaderStyle}">
											<DataGridTemplateColumn.CellTemplate>
												<DataTemplate>
													<Border CornerRadius="8"
															Padding="10,4"
															HorizontalAlignment="Center"
															VerticalAlignment="Center">
														<Border.Style>
															<Style TargetType="Border">
																<!-- Màu Nền Mặc định (Nếu thể loại không nằm trong danh sách dưới) -->
																<Setter Property="Background"
																		Value="#F3F4F6" />

																<Style.Triggers>
																	<!-- Công nghệ thông tin: Tone Xanh dương -->
																	<DataTrigger Binding="{Binding CategoryName}"
																				 Value="Công nghệ thông tin">
																		<Setter Property="Background"
																				Value="#DBEAFE" />
																	</DataTrigger>
																	<!-- Văn học nghệ thuật: Tone Hồng -->
																	<DataTrigger Binding="{Binding CategoryName}"
																				 Value="Văn học nghệ thuật">
																		<Setter Property="Background"
																				Value="#FCE7F3" />
																	</DataTrigger>
																	<!-- Kinh tế - Quản trị: Tone Xanh ngọc -->
																	<DataTrigger Binding="{Binding CategoryName}"
																				 Value="Kinh tế - Quản trị">
																		<Setter Property="Background"
																				Value="#D1FAE5" />
																	</DataTrigger>
																	<!-- Tâm lý - Kỹ năng sống: Tone Tím -->
																	<DataTrigger Binding="{Binding CategoryName}"
																				 Value="Tâm lý - Kỹ năng sống">
																		<Setter Property="Background"
																				Value="#EDE9FE" />
																	</DataTrigger>
																	<!-- Truyện tranh: Tone Cam/Vàng -->
																	<DataTrigger Binding="{Binding CategoryName}"
																				 Value="Truyện tranh">
																		<Setter Property="Background"
																				Value="#FEF3C7" />
																	</DataTrigger>
																	<!-- Thiếu nhi: Tone Xanh lá nhạt -->
																	<DataTrigger Binding="{Binding CategoryName}"
																				 Value="Thiếu nhi">
																		<Setter Property="Background"
																				Value="#DCFCE7" />
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</Border.Style>

														<!-- ĐỊNH DẠNG MÀU CHỮ BÊN TRONG -->
														<TextBlock FontSize="12"
																   FontWeight="SemiBold"
																   HorizontalAlignment="Center">
															<TextBlock.Style>
																<Style TargetType="TextBlock">
																	<!-- Chữ Mặc định (Xám đậm) -->
																	<Setter Property="Foreground"
																			Value="#4B5563" />
																	<Setter Property="Text"
																			Value="{Binding CategoryName}" />
																	<Style.Triggers>
																		<!-- Công nghệ thông tin -->
																		<DataTrigger Binding="{Binding CategoryName}"
																					 Value="Công nghệ thông tin">
																			<Setter Property="Foreground"
																					Value="#1D4ED8" />
																		</DataTrigger>
																		<!-- Văn học nghệ thuật -->
																		<DataTrigger Binding="{Binding CategoryName}"
																					 Value="Văn học nghệ thuật">
																			<Setter Property="Foreground"
																					Value="#BE185D" />
																		</DataTrigger>
																		<!-- Kinh tế - Quản trị -->
																		<DataTrigger Binding="{Binding CategoryName}"
																					 Value="Kinh tế - Quản trị">
																			<Setter Property="Foreground"
																					Value="#047857" />
																		</DataTrigger>
																		<!-- Tâm lý - Kỹ năng sống -->
																		<DataTrigger Binding="{Binding CategoryName}"
																					 Value="Tâm lý - Kỹ năng sống">
																			<Setter Property="Foreground"
																					Value="#6D28D9" />
																		</DataTrigger>
																		<!-- Truyện tranh -->
																		<DataTrigger Binding="{Binding CategoryName}"
																					 Value="Truyện tranh">
																			<Setter Property="Foreground"
																					Value="#B45309" />
																		</DataTrigger>
																		<!-- Thiếu nhi -->
																		<DataTrigger Binding="{Binding CategoryName}"
																					 Value="Thiếu nhi">
																			<Setter Property="Foreground"
																					Value="#15803D" />
																		</DataTrigger>
																	</Style.Triggers>
																</Style>
															</TextBlock.Style>
														</TextBlock>
													</Border>
												</DataTemplate>
											</DataGridTemplateColumn.CellTemplate>
										</DataGridTemplateColumn>

										<DataGridTextColumn Header="Tồn đầu"
															Binding="{Binding OpeningQty}"
															Width="*"
															HeaderStyle="{StaticResource CenterHeaderStyle}"
															ElementStyle="{StaticResource CellCenter}" />

										<DataGridTextColumn Header="Nhập"
															Binding="{Binding ImportedQty}"
															Width="*"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
											<DataGridTextColumn.ElementStyle>
												<Style TargetType="TextBlock"
													   BasedOn="{StaticResource CellProfit}">
													<Setter Property="HorizontalAlignment"
															Value="Center" />
												</Style>
											</DataGridTextColumn.ElementStyle>
										</DataGridTextColumn>

										<DataGridTextColumn Header="Xuất"
															Binding="{Binding SoldQty}"
															Width="*"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
											<DataGridTextColumn.ElementStyle>
												<Style TargetType="TextBlock"
													   BasedOn="{StaticResource CellDebt}">
													<Setter Property="HorizontalAlignment"
															Value="Center" />
												</Style>
											</DataGridTextColumn.ElementStyle>
										</DataGridTextColumn>
										<DataGridTextColumn Header="Tồn cuối"
															Binding="{Binding ClosingQty}"
															Width="*"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
											<DataGridTextColumn.ElementStyle>
												<Style TargetType="TextBlock"
													   BasedOn="{StaticResource CellCenter}">
													<Setter Property="FontWeight"
															Value="Bold" />
												</Style>
											</DataGridTextColumn.ElementStyle>
										</DataGridTextColumn>
										<DataGridTextColumn Header="Giá trị tồn"
															Binding="{Binding StockValue, StringFormat='{}{0:#,0} đ'}"
															Width="150"
															HeaderStyle="{StaticResource RightHeaderStyle}"
															ElementStyle="{StaticResource CellProfit}" />
									</DataGrid.Columns>
								</DataGrid>

								<DataGrid Style="{StaticResource CleanDataGrid}"
										  ItemsSource="{Binding DebtRows}"
										  Visibility="{Binding DebtGridVisibility}"
										  PreviewMouseWheel="DataGrid_PreviewMouseWheel">
									<DataGrid.Columns>
										<DataGridTextColumn Header="Tên khách hàng"
															Binding="{Binding CustomerName}"
															Width="2*"
															HeaderStyle="{StaticResource LeftHeaderStyle}"
															ElementStyle="{StaticResource CellLeft}" />
										<DataGridTextColumn Header="Nợ đầu"
															Binding="{Binding OpeningDebt, StringFormat='{}{0:#,0} đ'}"
															Width="*"
															HeaderStyle="{StaticResource RightHeaderStyle}"
															ElementStyle="{StaticResource CellMoney}" />
										<DataGridTextColumn Header="Phát sinh"
															Binding="{Binding NewDebt, StringFormat='{}{0:#,0} đ'}"
															Width="*"
															HeaderStyle="{StaticResource RightHeaderStyle}"
															ElementStyle="{StaticResource CellDebt}" />
										<DataGridTextColumn Header="Thu hồi"
															Binding="{Binding PaidDebt, StringFormat='{}{0:#,0} đ'}"
															Width="*"
															HeaderStyle="{StaticResource RightHeaderStyle}"
															ElementStyle="{StaticResource CellProfit}" />

										<DataGridTextColumn Header="Nợ cuối"
															Binding="{Binding ClosingDebt, StringFormat='{}{0:#,0} đ'}"
															Width="*"
															HeaderStyle="{StaticResource RightHeaderStyle}"
															ElementStyle="{StaticResource CellDynamicDebt}" />
									</DataGrid.Columns>
								</DataGrid>
							</Grid>
						</Grid>
					</Border>

					<components:PaginationControl Grid.Row="3"
												  CurrentPage="{Binding TrangHienTai}"
												  TotalPages="{Binding TongSoTrang}"
												  TotalRecords="{Binding TongBanGhi}"
												  PaginationCommand="{Binding PhanTrangCommand}" />
				</Grid>
			</ScrollViewer>
		</Grid>
	</Grid>
</UserControl>