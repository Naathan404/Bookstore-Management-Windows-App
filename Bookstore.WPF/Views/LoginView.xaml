<Window x:Class="Bookstore.WPF.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Sahara Bookstore - Đăng nhập" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="45*"/>
            <ColumnDefinition Width="55*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Cột trái ================= -->
        <Grid Grid.Column="0" Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- log error -->
            <Border Grid.Row="0" Background="#FFEBE9" BorderBrush="#FF4A4A" BorderThickness="1" 
            CornerRadius="8" Padding="15,10" Margin="0,0,0,20" MaxWidth="400"
            Visibility="{Binding IsErrorLogVisible}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#FF4A4A" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding ErrorLog}" Foreground="#FF4A4A" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            
            <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="400" Margin="0,0,0,50"
                Visibility="{Binding IsLoginVisible}">

                <!-- Tiêu đề -->
                <TextBlock Text="ĐĂNG NHẬP" FontSize="36" FontWeight="Bold" Foreground="#2B3674" Margin="0,0,0,10"/>
                <TextBlock Text="Chào mừng trở lại! Chúc bạn một ngày làm việc tốt lành!" Foreground="#A3AED0" FontSize="14" Margin="0,0,0,40"/>

                <!-- Nhập tên đăng nhập -->
                <TextBlock Text="Tên đăng nhập*" FontWeight="SemiBold" Foreground="#2B3674" Margin="0,0,0,8" FontSize="13"/>
                <TextBox Text="{Binding Username}" 
                         materialDesign:HintAssist.Hint="nhanvien@sahara" 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                         Foreground="#2B3674"
                         Height="50" FontSize="14" Margin="0,0,0,25"/>

                <!-- Nhập mật khẩu -->
                <TextBlock Text="Mật khẩu*" FontWeight="SemiBold" Foreground="#2B3674" Margin="0,0,0,8" FontSize="13"/>
                <PasswordBox materialDesign:PasswordBoxAssist.Password="{Binding Password}"
                             materialDesign:HintAssist.Hint="Tối thiểu 8 ký tự" 
                             Style="{StaticResource MaterialDesignOutlinedRevealPasswordBox}" 
                             Foreground="#2B3674"
                             Height="50" FontSize="14" Margin="0,0,0,25"/>

                <!-- Ghi nhớ tôi & Quên mật khẩu -->
                <Grid Margin="0,0,0,40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Content="Ghi nhớ tôi" Foreground="#2B3674" FontWeight="SemiBold" FontSize="13"
                              materialDesign:CheckBoxAssist.CheckBoxSize="20"/>

                    <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}" 
                        Command="{Binding SwitchStateCommand}" CommandParameter="Forgot"
                        Content="Quên mật khẩu?" Foreground="#4318FF" FontWeight="SemiBold" 
                        FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- Nút Đăng nhập -->
                <Button Content="ĐĂNG NHẬP" Command="{Binding LoginCommand}"
                        Height="55" FontSize="16" FontWeight="Bold" 
                        Background="#4318FF" BorderBrush="#4318FF" Foreground="White" 
                        materialDesign:ButtonAssist.CornerRadius="15">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="15" Color="#4318FF" Opacity="0.3" ShadowDepth="5"/>
                    </Button.Effect>
                </Button>
            </StackPanel>

            <!-- Footer -->
            <TextBlock Grid.Row ="2" Text="Nhóm 12 – Đề tài Quản lý nhà sách" Foreground="#A3AED0" FontSize="12" 
                       VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <!-- ====== KHÔI PHỤC MẬT KHẨU ===== -->
            <!-- bước nhập email -->
            <StackPanel VerticalAlignment="Center" MaxWidth="400" Margin="0,0,0,50" 
            Visibility="{Binding IsForgotVisible}">
        
                <TextBlock Text="KHÔI PHỤC MẬT KHẨU" FontSize="36" FontWeight="Bold" Foreground="#2B3674" Margin="0,0,0,10"/>
                <TextBlock Text="Vui lòng nhập email đã đăng ký!" Foreground="#A3AED0" FontSize="14" Margin="0,0,0,40" TextWrapping="Wrap"/>
                 <!--Nhập email-->
                <TextBlock Text="Email đã đăng ký*" FontWeight="SemiBold" Foreground="#2B3674" Margin="0,0,0,8" FontSize="13"/>
                <TextBox Text="{Binding Email}" 
                     materialDesign:HintAssist.Hint="nhanvien@sahara.com" 
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                     Foreground="#2B3674"
                     Height="50" FontSize="14" Margin="0,0,0,40"/>
                <!--nút gửi mã otp-->
                <Button Content="GỬI MÃ XÁC NHẬN" Command="{Binding SendOTPCommand}"
                    Height="55" FontSize="16" FontWeight="Bold" 
                    Background="#4318FF" BorderBrush="#4318FF" Foreground="White" 
                    materialDesign:ButtonAssist.CornerRadius="15">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="15" Color="#4318FF" Opacity="0.3" ShadowDepth="5"/>
                    </Button.Effect>
                </Button>

                <!-- Nút quay lại -->
                <Button Style="{StaticResource MaterialDesignFlatButton}" 
                    Command="{Binding SwitchStateCommand}" CommandParameter="Login"
                    Content="Quay lại Đăng nhập" Foreground="#A3AED0" Margin="0,20,0,0"/>
            </StackPanel>

            <!-- bước nhaapk otp -->
            <StackPanel VerticalAlignment="Center" MaxWidth="400" Margin="0,0,0,50" 
                Visibility="{Binding IsVerifyVisible}">

                <TextBlock Text="XÁC THỰC EMAIL" FontSize="36" FontWeight="Bold" Foreground="#2B3674" Margin="0,0,0,10"/>
                <TextBlock Text="Chúng tôi đã gửi mã OTP gồm 6 chữ số đến email của bạn." Foreground="#A3AED0" FontSize="14" Margin="0,0,0,40" TextWrapping="Wrap"/>
                   <!-- ô nhapajk mã -->
                <TextBlock Text="Mã OTP*" FontWeight="SemiBold" Foreground="#2B3674" Margin="0,0,0,8" FontSize="13"/>
                <TextBox Text="{Binding OTP}" MaxLength="6"
                         materialDesign:HintAssist.Hint="Nhập 6 số..." 
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                         Foreground="#2B3674" HorizontalContentAlignment="Center"
                         Height="50" FontSize="16" FontWeight="Bold"  Margin="0,0,0,10"/>
                <!-- nút gửi lại -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,30">
                    <TextBlock Text="Chưa nhận được mã? " Foreground="#A3AED0" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource MaterialDesignFlatButton}" 
                        Command="{Binding ResendOTPCommand}"
                        Content="Gửi lại" Foreground="#4318FF" Padding="5,0"/>
                </StackPanel>
                <!-- nút xác nhận -->
                <Button Content="XÁC NHẬN" Command="{Binding VerifyOTPCommand}"
                        Height="55" FontSize="16" FontWeight="Bold" 
                        Background="#4318FF" BorderBrush="#4318FF" Foreground="White" 
                        materialDesign:ButtonAssist.CornerRadius="15">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="15" Color="#4318FF" Opacity="0.3" ShadowDepth="5"/>
                    </Button.Effect>
                </Button>

                <Button Style="{StaticResource MaterialDesignFlatButton}" 
                    Command="{Binding SwitchStateCommand}" CommandParameter="Login"
                    Content="Hủy bỏ" Foreground="#A3AED0" Margin="0,20,0,0"/>
            </StackPanel>

            <!-- đặt lại mật khẩu mới -->
            <StackPanel VerticalAlignment="Center" MaxWidth="400" Margin="0,0,0,50" 
            Visibility="{Binding IsResetVisible}">

                <TextBlock Text="ĐẶT MẬT KHẨU" FontSize="36" FontWeight="Bold" Foreground="#2B3674" Margin="0,0,0,10"/>
                <TextBlock Text="Mã OTP hợp lệ! Vui lòng tạo mật khẩu mới cho tài khoản của bạn." Foreground="#A3AED0" FontSize="14" Margin="0,0,0,40" TextWrapping="Wrap"/>

                <!-- Nhập mật khẩu mới -->
                <TextBlock Text="Mật khẩu mới*" FontWeight="SemiBold" Foreground="#2B3674" Margin="0,0,0,8" FontSize="13"/>
                <PasswordBox PasswordChanged="NewPasswordBox_PasswordChanged"
                             materialDesign:HintAssist.Hint="Tối thiểu 8 ký tự" 
                             Style="{StaticResource MaterialDesignOutlinedRevealPasswordBox}" 
                             Foreground="#2B3674"
                             Height="50" FontSize="14" Margin="0,0,0,25"/>

                <!-- Xác nhận mật khẩu mới -->
                <TextBlock Text="Xác nhận mật khẩu*" FontWeight="SemiBold" Foreground="#2B3674" Margin="0,0,0,8" FontSize="13"/>
                <PasswordBox PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                             materialDesign:HintAssist.Hint="Nhập lại mật khẩu mới" 
                             Style="{StaticResource MaterialDesignOutlinedRevealPasswordBox}" 
                             Foreground="#2B3674"
                             Height="50" FontSize="14" Margin="0,0,0,40"/>

                <Button Content="ĐỔI MẬT KHẨU" Command="{Binding ResetPasswordCommand}"
                        Height="55" FontSize="16" FontWeight="Bold" 
                        Background="#4318FF" BorderBrush="#4318FF" Foreground="White" 
                        materialDesign:ButtonAssist.CornerRadius="15">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="15" Color="#4318FF" Opacity="0.3" ShadowDepth="5"/>
                    </Button.Effect>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= Cột phải ================= -->
        <Grid Grid.Column="1">
            <!-- bo góc -->
            <Border CornerRadius="0,0,0,150" ClipToBounds="True">
                <Border.Background>
                    <ImageBrush ImageSource="/Resources/Images/Login/Background.png" Stretch="UniformToFill"/>
                </Border.Background>
                <Grid>
                    <!-- Logo & Slogan Nhà sách -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Background="White" Width="140" Height="140" CornerRadius="70" 
                                HorizontalAlignment="Center" Margin="0,0,0,25">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Opacity="0.2" ShadowDepth="10"/>
                            </Border.Effect>
                            <!-- icon -->
                            <materialDesign:PackIcon Kind="BookOpenPageVariant" Width="70" Height="70" 
                                                     Foreground="#4318FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="Sahara Bookstore" FontSize="42" FontWeight="Heavy" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="Hệ thống quản lý bán lẻ toàn diện" FontSize="16" Foreground="#E0E5FF" 
                                   HorizontalAlignment="Center" Margin="0,10,0,0" FontWeight="SemiBold"/>

                        <!-- thông tin -->
                        <Border Background="#20FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" 
                                CornerRadius="15" Padding="30,15" Margin="0,40,0,0" HorizontalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="Phát triển bởi Nhóm 12 - UIT" Foreground="#E0E5FF" FontSize="13" HorizontalAlignment="Center"/>
                                <TextBlock Text="Đồ án Nhập môn CNPM" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- dark_light mode -->
                    <Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}" 
                            Background="#30FFFFFF" BorderThickness="0" 
                            VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="20">
                        <materialDesign:PackIcon Kind="WeatherNight" Foreground="White"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>