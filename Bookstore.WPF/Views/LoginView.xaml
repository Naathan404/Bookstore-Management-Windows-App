<Window x:Class="Bookstore.WPF.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Đăng nhập - Nhà sách Sahara" Height="650" Width="1100"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <materialDesign:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Canvas ClipToBounds="True">
            <Canvas.Resources>
                <Storyboard x:Key="ParallaxAnimation">
                    <DoubleAnimation Storyboard.TargetName="Trans1" Storyboard.TargetProperty="Y" From="-5" To="5" Duration="0:0:12" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="Trans2" Storyboard.TargetProperty="Y" From="-8" To="8" Duration="0:0:10" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="Trans3" Storyboard.TargetProperty="Y" From="-12" To="12" Duration="0:0:8" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="Trans4" Storyboard.TargetProperty="Y" From="-15" To="15" Duration="0:0:7" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="Trans5" Storyboard.TargetProperty="Y" From="-20" To="20" Duration="0:0:6" AutoReverse="True" RepeatBehavior="Forever"/>
                </Storyboard>
            </Canvas.Resources>

            <Canvas.Triggers>
                <EventTrigger RoutedEvent="Canvas.Loaded">
                    <BeginStoryboard Storyboard="{StaticResource ParallaxAnimation}"/>
                </EventTrigger>
            </Canvas.Triggers>

            <Image Source="/Resources/Images/Login/bg0.png" Height="712" Width="1164" Canvas.Top="-3"/>

            <Image Source="/Resources/Images/Login/bg1_1.png" Height="712" Width="1164" Canvas.Top="-3">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="Trans1"/>
                </Image.RenderTransform>
            </Image>
            <Image Source="/Resources/Images/Login/bg1_2.png" Height="712" Width="1164" Canvas.Top="-3">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="Trans2"/>
                </Image.RenderTransform>
            </Image>
            <Image Source="/Resources/Images/Login/bg1_3.png" Height="712" Width="1164" Canvas.Top="-3">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="Trans3"/>
                </Image.RenderTransform>
            </Image>
            <Image Source="/Resources/Images/Login/bg1_4.png" Height="712" Width="1164" Canvas.Top="-3">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="Trans4"/>
                </Image.RenderTransform>
            </Image>
            <Image Source="/Resources/Images/Login/bg1_5.png" Height="712" Width="1164" Canvas.Top="-3">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="Trans5"/>
                </Image.RenderTransform>
            </Image>

            <Ellipse Width="400" Height="400" Fill="#FFC75F" Opacity="0.2" Canvas.Left="-100" Canvas.Top="-100">
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="350" Height="350" Fill="#F9F871" Opacity="0.2" Canvas.Right="-50" Canvas.Bottom="-50">
                <Ellipse.Effect>
                    <BlurEffect Radius="70"/>
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <Border Width="450" Height="500" 
                CornerRadius="25" Background="#ffe6a7" 
                Opacity="0.5" Margin="500 50 0 0"/>

        <Border x:Name="MainCard" 
                Width="450" Height="500" 
                CornerRadius="25" Background="#14ffffff"
                BorderBrush="#99582a" BorderThickness="0.5" 
                Margin="500 50 0 0">

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- lời chào -->
                <Grid Grid.Row="0" Margin="0,10,0,30" >
                    <StackPanel>
                        <TextBlock x:Name="txtTitle" 
                                   Text="{Binding Title}"
                                   d:Text="Login"
                                   FontSize="40" Foreground="#432818" FontWeight="Bold"/>
                        <Line Stroke="#99582a" StrokeThickness="2" X1="0" X2="110" Margin="0,5"/>
                        <TextBlock x:Name="txtSubTitle" 
                                   Text="{Binding SubTitle}" 
                                   d:Text="Welcome back"
                                   FontSize="14" Foreground="#99582a" Opacity="0.8"/>
                    </StackPanel>
                    <materialDesign:PackIcon Kind="BookOpenPageVariant" Width="50" Height="50" HorizontalAlignment="Right" Foreground="#99582a"/>
                </Grid>
                
                <!-- bảng thông báo lỗi -->
                <Grid Grid.Row="1" Margin="0 0 0 10" Visibility="{Binding IsErrorLogVisible}">
                    <materialDesign:Card 
                        Height="50"
                        UniformCornerRadius="10"
                        Background="#FFB2B2"
                        >
                        <TextBlock
                            Text="{Binding ErrorLog}"
                            d:Text="Incorrect Username or Password."
                            Foreground="#A82323"
                            VerticalAlignment="Center"
                            Margin="10 0 0 0"
                            FontSize="15"
                            FontWeight="Bold"
                            FontFamily="Segoe UI">
                        </TextBlock>
                    </materialDesign:Card>
                </Grid>
                
                <!-- content đăng nhập chính -->
                <Grid Grid.Row="2">
                    <!--LOG IN-->
                    <StackPanel x:Name="LoginGroup" Visibility="{Binding IsLoginVisible}">
                        <TextBlock Text="Username" Margin="5,0,0,5" FontSize="14" FontWeight="SemiBold" Foreground="#432818"
                                   />
                        <Border Background="#bb9457" CornerRadius="12" Margin="0,0,0,20">
                            <TextBox x:Name="txbUsername" materialDesign:HintAssist.Hint="Enter your username..." 
                                     materialDesign:HintAssist.Foreground="White"
                                     materialDesign:TextFieldAssist.UnderlineBrush="Transparent" 
                                     Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Foreground="White" CaretBrush="White"
                                     materialDesign:TextFieldAssist.LeadingIcon="Account" 
                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                     BorderThickness="0" Height="50" 
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" Padding="10,0"/>
                        </Border>

                        <TextBlock Text="Password" Margin="5,0,0,5" FontSize="14" FontWeight="SemiBold" Foreground="#432818"/>
                        <Border Background="#bb9457" CornerRadius="12">
                            <PasswordBox x:Name="pwbPassword" materialDesign:HintAssist.Hint="Enter your password..." 
                                         materialDesign:HintAssist.Foreground="White"
                                         materialDesign:TextFieldAssist.UnderlineBrush="Transparent" 
                                         PasswordChanged="PasswordBox_PasswordChanged"
                                         Foreground="White" CaretBrush="White"
                                         materialDesign:TextFieldAssist.LeadingIcon="Lock" 
                                         materialDesign:TextFieldAssist.HasClearButton="True"
                                         BorderThickness="0" Height="50" 
                                         Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Padding="10,0"/>
                        </Border>
                        <Grid Margin="0,10,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" 
                                  Content="Remember Me" 
                                  Foreground="#432818" 
                                  FontWeight="SemiBold"
                                  FontSize="13"
                                  Style="{StaticResource MaterialDesignCheckBox}"
                                  materialDesign:CheckBoxAssist.CheckBoxSize="20"
                                  VerticalAlignment="Center"
                                  Background="#432818"/>
                            <Button Grid.Column="1" 
                                Content="Forgot Password?" 
                                Style="{StaticResource MaterialDesignFlatButton}" 
                                Foreground="#432818" 
                                FontSize="13"
                                FontWeight="SemiBold"
                                Padding="0"
                                Command="{Binding SwitchStateCommand}"
                                CommandParameter="Forgot"
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Center" />
                        </Grid>

                        <Button Content="LOGIN" 
                                Height="50" 
                                Command="{Binding LoginCommand}"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                Background="#432818" BorderBrush="Transparent" FontWeight="Bold"/>
                    </StackPanel>
                    <!--FORGOT PASSWORD-->
                    <StackPanel x:Name="ForgotGroup" Visibility="{Binding IsForgotVisible}">
                        <TextBlock Text="Recovery Email" Margin="5,0,0,5" FontSize="14" FontWeight="SemiBold" Foreground="#432818"/>
                        <Border Background="#bb9457" CornerRadius="12" Margin="0,0,0,10">
                            <TextBox materialDesign:HintAssist.Hint="Enter your registered email.." 
                                     Foreground="White" CaretBrush="White"
                                     Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Foreground="White"
                                     materialDesign:TextFieldAssist.UnderlineBrush="Transparent"                                      
                                     materialDesign:TextFieldAssist.LeadingIcon="Email" 
                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                     BorderThickness="0" Height="50" 
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" Padding="10,0"/>
                        </Border>
                        <!-- bảng thông báo lỗi -->
                        <TextBlock Text="We will send you an OTP through this email." FontSize="12" Foreground="#99582a" FontStyle="Italic" Margin="5,0,0,30"/>

                        <Button Content="SEND OTP" Height="50" 
                                Command="{Binding SendOTPCommand}"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                Background="#432818" BorderBrush="Transparent" FontWeight="Bold" Margin="0,0,0,15"/>

                        <Button Content="Return to Login" 
                                Command="{Binding SwitchStateCommand}"
                                CommandParameter="Login"
                                Style="{StaticResource MaterialDesignFlatButton}" 
                                Foreground="#99582a" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="VerifyOTPGroup" Visibility="{Binding IsVerifyVisible}">
                        <TextBlock Text="Verification Code" Margin="5,0,0,5" 
                                   FontSize="18" FontWeight="SemiBold" Foreground="#432818"/>
                        <Border Background="#bb9457" CornerRadius="12" Margin="0,0,0,10">
                            <TextBox materialDesign:HintAssist.Hint="Enter 6-digit OTP..."
                                     Text="{Binding OTP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                     materialDesign:HintAssist.Foreground="White"
                                     materialDesign:TextFieldAssist.UnderlineBrush="Transparent" 
                                     Foreground="White" CaretBrush="White"
                                BorderThickness="0" Height="50" 
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}" Padding="10,0" HorizontalContentAlignment="Left"/>
                        </Border>
                        <TextBlock Text="Check your inbox (including spam folder)." 
                                   FontSize="12" Foreground="#99582a" FontStyle="Italic" Margin="5,0,0,30"/>

                        <Button Content="VERIFY OTP" Height="50" materialDesign:ButtonAssist.CornerRadius="15"
                                   Background="#432818" BorderBrush="Transparent" 
                                Command="{Binding VerifyOTPCommand}"
                                FontWeight="Bold" Margin="0,0,0,15"/>
                        <Button Content="Resend Code" 
                                Style="{StaticResource MaterialDesignFlatButton}" 
                                Foreground="#99582a" HorizontalAlignment="Center"
                                Command="{Binding ResendOTPCommand}"/>
                    </StackPanel>

                    <StackPanel x:Name="ResetPasswordGroup" Visibility="{Binding IsResetVisible}">
                        <TextBlock Text="New Password" Margin="5,0,0,5" FontSize="14" FontWeight="SemiBold" Foreground="#432818"/>
                        <Border Background="#bb9457" CornerRadius="12" Margin="0,0,0,15">
                            <PasswordBox x:Name="pwbNewPassword"
                                PasswordChanged="NewPasswordBox_PasswordChanged"
                                materialDesign:HintAssist.Hint="New password..." 
                                Foreground="White" CaretBrush="White"
                                materialDesign:TextFieldAssist.LeadingIcon="LockReset" 
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                materialDesign:HintAssist.Foreground="White"
                                materialDesign:TextFieldAssist.UnderlineBrush="Transparent"                                          
                                BorderThickness="0" Height="45" 
                                Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Padding="10,0"/>
                        </Border>

                        <TextBlock Text="Confirm Password" Margin="5,0,0,5" FontSize="14" FontWeight="SemiBold" Foreground="#432818"/>
                        <Border Background="#bb9457" CornerRadius="12" Margin="0,0,0,30">
                            <PasswordBox x:Name="pwbConfirmPassword"
                                PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                                materialDesign:HintAssist.Hint="Confirm password..."
                                materialDesign:TextFieldAssist.LeadingIcon="LockCheck" 
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                materialDesign:HintAssist.Foreground="White"
                                Foreground="White" CaretBrush="White"
                                materialDesign:TextFieldAssist.UnderlineBrush="Transparent"                                          
                                BorderThickness="0" Height="45" 
                                Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Padding="10,0"/>
                        </Border>

                        <Button Content="UPDATE PASSWORD" Height="50" materialDesign:ButtonAssist.CornerRadius="15"
                                Background="#432818" BorderBrush="Transparent" FontWeight="Bold"
                                Command="{Binding ResetPasswordCommand}"
                                />
                    </StackPanel>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>