<Window x:Class="Bookstore.WPF.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Đăng nhập - Nhà sách Sahara" Height="650" Width="1100"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <materialDesign:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Canvas ClipToBounds="True">
            <Image Source="/Resources/Images/Login/login0.png" Height="712" Width="1164" Canvas.Top="-3"/>
            <Ellipse Width="400" Height="400" Fill="#FFC75F" Opacity="0.2" Canvas.Left="-100" Canvas.Top="-100">
                <Ellipse.Effect>
                    <BlurEffect Radius="100"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="350" Height="350" 
                     Fill="#F9F871" Opacity="0.2" 
                     Canvas.Right="-50" Canvas.Bottom="-50">
                <Ellipse.Effect>
                    <BlurEffect Radius="70"/>
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <Border Width="450" Height="500" 
                CornerRadius="25" Background="#ffe6a7" 
                Opacity="0.5" Margin="500 50 0 0"/>

        <Border x:Name="MainCard" 
                Width="450" Height="500" 
                CornerRadius="25" Background="#14ffffff"
                BorderBrush="#99582a" BorderThickness="0.5" 
                Margin="500 50 0 0">

            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,10,0,80">
                    <StackPanel>
                        <TextBlock x:Name="txtTitle" 
                                   Text="{Binding Title}" 
                                   FontSize="40" Foreground="#432818" FontWeight="Bold"/>
                        <Line Stroke="#99582a" StrokeThickness="2" X1="0" X2="110" Margin="0,5"/>
                        <TextBlock x:Name="txtSubTitle" 
                                   Text="{Binding Subtitle}" 
                                   FontSize="14" Foreground="#99582a" Opacity="0.8"/>
                    </StackPanel>
                    <materialDesign:PackIcon Kind="BookOpenPageVariant" Width="50" Height="50" HorizontalAlignment="Right" Foreground="#99582a"/>
                </Grid>

                <Grid Grid.Row="1">

                    <StackPanel x:Name="LoginGroup" Visibility="{Binding IsLoginVisible}">
                        <TextBlock Text="Username" Margin="5,0,0,5" FontSize="14" FontWeight="SemiBold" Foreground="#432818"/>
                        <Border Background="#bb9457" CornerRadius="12" Margin="0,0,0,20">
                            <TextBox materialDesign:HintAssist.Hint="Enter your username..." 
                                     materialDesign:HintAssist.Foreground="White"
                                     materialDesign:TextFieldAssist.UnderlineBrush="Transparent" 
                                     Foreground="White" CaretBrush="White"
                                     materialDesign:TextFieldAssist.LeadingIcon="Account" 
                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                     BorderThickness="0" Height="50" 
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" Padding="10,0"/>
                        </Border>

                        <TextBlock Text="Password" Margin="5,0,0,5" FontSize="14" FontWeight="SemiBold" Foreground="#432818"/>
                        <Border Background="#bb9457" CornerRadius="12">
                            <PasswordBox materialDesign:HintAssist.Hint="Enter your password..." 
                                         materialDesign:HintAssist.Foreground="White"
                                         materialDesign:TextFieldAssist.UnderlineBrush="Transparent"   
                                         Foreground="White" CaretBrush="White"
                                         materialDesign:TextFieldAssist.LeadingIcon="Lock" 
                                         materialDesign:TextFieldAssist.HasClearButton="True"
                                         BorderThickness="0" Height="50" 
                                         Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Padding="10,0"/>
                        </Border>

                        <Button Content="Forgot Password?" Style="{StaticResource MaterialDesignFlatButton}" 
                                Foreground="#432818" 
                                Command="{Binding SwitchStateCommand}"
                                CommandParameter="Forgot"
                                HorizontalAlignment="Right" Margin="0,10,0,20" />

                        <Button Content="LOGIN" 
                                Height="50" 
                                Command="{Binding LoginCommand}"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                Background="#432818" BorderBrush="Transparent" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel x:Name="ForgotGroup" Visibility="{Binding IsForgotVisible}">
                        <TextBlock Text="Recovery Email" Margin="5,0,0,5" FontSize="14" FontWeight="SemiBold" Foreground="#432818"/>
                        <Border Background="#bb9457" CornerRadius="12" Margin="0,0,0,10">
                            <TextBox materialDesign:HintAssist.Hint="Enter your registered email.." 
                                     Foreground="White" CaretBrush="White"
                                     materialDesign:HintAssist.Foreground="White"
                                     materialDesign:TextFieldAssist.UnderlineBrush="Transparent"                                      
                                     materialDesign:TextFieldAssist.LeadingIcon="Email" 
                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                     BorderThickness="0" Height="50" 
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" Padding="10,0"/>
                        </Border>

                        <TextBlock Text="We will send you an OTP through this email." FontSize="12" Foreground="#99582a" FontStyle="Italic" Margin="5,0,0,30"/>

                        <Button Content="SEND OTP" Height="50" 
                                Command="{Binding SwitchStateCommand}"
                                CommandParameter="Verify"
                                materialDesign:ButtonAssist.CornerRadius="15"
                                Background="#432818" BorderBrush="Transparent" FontWeight="Bold" Margin="0,0,0,15"/>

                        <Button Content="Return to Login" Style="{StaticResource MaterialDesignFlatButton}" 
                                Foreground="#99582a" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="VerifyOTPGroup" Visibility="{Binding IsVerifyVisible}">
                        <TextBlock Text="Verification Code" Margin="5,0,0,5" 
                                   FontSize="14" FontWeight="SemiBold" Foreground="#432818"/>
                        <Border Background="#bb9457" CornerRadius="12" Margin="0,0,0,10">
                            <TextBox materialDesign:HintAssist.Hint="Enter 6-digit OTP..." 
                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                     materialDesign:HintAssist.Foreground="White"
                                     materialDesign:TextFieldAssist.UnderlineBrush="Transparent" 
                                     Foreground="White" CaretBrush="White"
                                BorderThickness="0" Height="50" 
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}" Padding="10,0" HorizontalContentAlignment="Center" FontSize="18"/>
                        </Border>
                        <TextBlock Text="Check your inbox (including spam folder)." 
                                   FontSize="12" Foreground="#99582a" FontStyle="Italic" Margin="5,0,0,30"/>

                        <Button Content="VERIFY OTP" Height="50" materialDesign:ButtonAssist.CornerRadius="15"
                                   Background="#432818" BorderBrush="Transparent" 
                                Command="{Binding SwitchStateCommand}"
                                CommandParameter="Reset"
                                FontWeight="Bold" Margin="0,0,0,15"/>
                        <Button Content="Resend Code" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#99582a" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="ResetPasswordGroup" Visibility="{Binding IsResetVisible}">
                        <TextBlock Text="New Password" Margin="5,0,0,5" FontSize="14" FontWeight="SemiBold" Foreground="#432818"/>
                        <Border Background="#bb9457" CornerRadius="12" Margin="0,0,0,15">
                            <PasswordBox materialDesign:HintAssist.Hint="New password..." 
                                Foreground="White" CaretBrush="White"
                                materialDesign:TextFieldAssist.LeadingIcon="LockReset" 
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                materialDesign:HintAssist.Foreground="White"
                                materialDesign:TextFieldAssist.UnderlineBrush="Transparent"                                          
                                BorderThickness="0" Height="45" 
                                Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Padding="10,0"/>
                        </Border>

                        <TextBlock Text="Confirm Password" Margin="5,0,0,5" FontSize="14" FontWeight="SemiBold" Foreground="#432818"/>
                        <Border Background="#bb9457" CornerRadius="12" Margin="0,0,0,30">
                            <PasswordBox materialDesign:HintAssist.Hint="Confirm password..."
                                materialDesign:TextFieldAssist.LeadingIcon="LockCheck" 
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                materialDesign:HintAssist.Foreground="White"
                                Foreground="White" CaretBrush="White"
                                materialDesign:TextFieldAssist.UnderlineBrush="Transparent"                                          
                                BorderThickness="0" Height="45" 
                                Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Padding="10,0"/>
                        </Border>

                        <Button Content="UPDATE PASSWORD" Height="50" materialDesign:ButtonAssist.CornerRadius="15"
                                Background="#432818" BorderBrush="Transparent" FontWeight="Bold"
                                Command="{Binding SwitchStateCommand}"
                                CommandParameter="Login"/>
                    </StackPanel>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>