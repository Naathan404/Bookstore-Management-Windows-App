<UserControl x:Class="Bookstore.WPF.Views.ImportView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:viewmodels="clr-namespace:Bookstore.WPF.ViewModels"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 mc:Ignorable="d">
	<Grid>
		<Grid x:Name="MainImportView"
			  Margin="{StaticResource MainViewMargin}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- ==================== HEADER ==================== -->
			<components:PageHeaderControl Title="NHẬP KHO"
										  HeaderIcon="TruckDelivery"
										  ShowAddButton="True"
										  AddTitle="THÊM"
										  AddIcon="Plus"
										  AddCommand="{Binding OpenAddImportCommand}"
										  AddCommandParameter="{Binding}" />

			<!-- ==================== FILTER ==================== -->
			<Border Grid.Row="1"
					Style="{StaticResource FilterCardStyle}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*" />
						<ColumnDefinition Width="2*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<components:FilterInputControl Grid.Column="0"
												   Margin="0,0,8,0"
												   IconKind="Magnify"
												   HintText="Tìm kiếm phiếu nhập..."
												   TextValue="{Binding SearchKeyword}" />

					<components:FilterComboBoxControl Grid.Column="1"
													  Margin="0,0,8,0"
													  IconKind="Truck"
													  HintText="Nhà cung cấp"
													  ItemsSource="{Binding SupplierList}"
													  SelectedItem="{Binding SelectedSupplier}"
													  DisplayMemberPath="TenNhaCungCap" />

					<components:FilterDatePickerControl Grid.Column="2"
														Margin="0,0,8,0"
														IconKind="CalendarStart"
														HintText="Từ ngày"
														SelectedDate="{Binding FilterFromDate}" />

					<components:FilterDatePickerControl Grid.Column="3"
														Margin="0,0,8,0"
														IconKind="CalendarEnd"
														HintText="Đến ngày"
														SelectedDate="{Binding FilterToDate}" />


					<components:FilterActionPanel Grid.Column="4"
												  ClearCommand="{Binding ClearFilterCommand}"
												  RefreshCommand="{Binding RefreshCommand}"
												  ShowRefreshButton="True" />
				</Grid>
			</Border>

			<!-- ==================== DATAGRID ==================== -->
			<Border Style="{StaticResource DataGridCardStyle}"
					Grid.Row="2">
				<DataGrid ItemsSource="{Binding ImportOrders}"
						  SelectedItem="{Binding SelectedImportOrder}"
						  Style="{StaticResource CleanDataGrid}">

					<DataGrid.Columns>
						<DataGridTextColumn Header="Mã phiếu"
											Width="150"
											HeaderStyle="{StaticResource CenterHeaderStyle}"
											ElementStyle="{StaticResource CellCode}"
											SortMemberPath="MaPhieuNhap">
							<DataGridTextColumn.Binding>
								<MultiBinding StringFormat="PN{0:ddMMyy}{1:D3}">
									<Binding Path="NgayNhap" />
									<Binding Path="MaPhieuNhap" />
								</MultiBinding>
							</DataGridTextColumn.Binding>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Ngày nhập"
											Binding="{Binding NgayNhap, StringFormat={}{0:dd/MM/yyyy}}"
											Width="120"
											HeaderStyle="{StaticResource CenterHeaderStyle}"
											ElementStyle="{StaticResource CellCenter}" />

						<DataGridTextColumn Header="Nhà cung cấp"
											Binding="{Binding TenNhaCungCap}"
											Width="*"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}" />

						<DataGridTextColumn Header="Người tạo"
											Binding="{Binding TenNguoiTao}"
											Width="150"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}" />

						<DataGridTextColumn Header="Tổng tiền"
											Binding="{Binding TongTien, StringFormat={}{0:N0} đ}"
											Width="150"
											HeaderStyle="{StaticResource RightHeaderStyle}"
											ElementStyle="{StaticResource CellProfit}" />

						<DataGridTextColumn Header="Ghi chú"
											Binding="{Binding GhiChu}"
											Width="*"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}" />

						<DataGridTemplateColumn Header="Thao tác"
												HeaderStyle="{StaticResource CenterHeaderStyle}"
												Width="100">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<components:DataGridActionPanel RowItem="{Binding}"
																	ShowView="True"
																	ViewCommand="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	ShowDelete="True"
																	DeleteCommand="{Binding DataContext.DeleteImportOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</Border>

			<!-- ==================== FOOTER / PAGINATION ==================== -->
			<components:PaginationControl Grid.Row="3"
										  CurrentPage="{Binding TrangHienTai}"
										  TotalPages="{Binding TongSoTrang}"
										  TotalRecords="{Binding TongBanGhi}"
										  PaginationCommand="{Binding PhanTrangCommand}" />
		</Grid>

		<!-- ==================== POPUP CHI TIẾT PHIẾU NHẬP ==================== -->
		<Grid Style="{StaticResource PopupOverlayStyle}"
			  Visibility="{Binding IsDetailPopupOpen, Converter={StaticResource BoolToVis}}">

			<Grid Background="Transparent">
				<Grid.InputBindings>
					<MouseBinding Gesture="LeftClick"
								  CommandParameter="{Binding}"
								  Command="{Binding ClosePopupCommand}" />
				</Grid.InputBindings>
			</Grid>

			<Border Style="{StaticResource PopupCardStyle}"
					Width="900"
					Height="600">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<components:PopupHeaderControl Title="CHI TIẾT PHIẾU NHẬP KHO"
												   IconKind="InformationOutline" />

					<ScrollViewer VerticalScrollBarVisibility="Auto"
								  Margin="0,0,0,12"
								  Grid.Row="1">
						<StackPanel>
							<Grid Grid.Row="1">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="12" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />

									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<components:FormInputControl Title="Mã phiếu"
															 IconKind="Barcode"
															 IsEnabled="False"
															 FontWeight="Bold"
															 TextValue="{Binding DetailImportOrder.DisplayID, Mode=OneWay}" />

								<components:FormInputControl Title="Ngày nhập"
															 Grid.Column="2"
															 IconKind="CalendarClock"
															 IsEnabled="False"
															 TextValue="{Binding DetailImportOrder.NgayNhap, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />

								<components:FormInputControl Title="Nhà cung cấp"
															 Grid.Row="1"
															 IconKind="TruckOutline"
															 IsEnabled="False"
															 TextValue="{Binding DetailImportOrder.TenNhaCungCap, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />

								<components:FormInputControl Title="Người lập phiếu"
															 Grid.Row="1"
															 Grid.Column="2"
															 IconKind="AccountTie"
															 IsEnabled="False"
															 TextValue="{Binding DetailImportOrder.TenNguoiTao, Mode=OneWay}" />
							</Grid>
							<components:FormInputControl Title="Ghi chú"
														 IconKind="NoteTextOutline"
														 IsEnabled="False"
														 TextValue="{Binding DetailImportOrder.GhiChu, Mode=OneWay}" />


					

							<StackPanel Grid.Row="3"
										Orientation="Horizontal"
										Margin="0,0,0,10"
										VerticalAlignment="Center">
								<TextBlock Text="CHI TIẾT HÀNG NHẬP"
										   FontSize="14"
										   FontWeight="Bold"
										   Foreground="{StaticResource PrimaryDarkColor}" />
								<TextBlock Text="{Binding DetailImportOrder.ChiTietSach.Count, StringFormat=' ({0} đầu sách)'}"
										   FontSize="14"
										   FontWeight="SemiBold"
										   Foreground="#A3AED0" />
							</StackPanel>

							<DataGrid Grid.Row="4"
									  ItemsSource="{Binding DetailImportOrder.ChiTietSach}"
									  AutoGenerateColumns="False"
									  CanUserAddRows="False"
									  IsReadOnly="True"
									  Style="{StaticResource CleanDataGrid}"
									  ScrollViewer.VerticalScrollBarVisibility="Disabled"
									  PreviewMouseWheel="DataGrid_PreviewMouseWheel">
								<DataGrid.Columns>
									<DataGridTextColumn Header="STT"
														Binding="{Binding STT}"
														Width="50"
														ElementStyle="{StaticResource CellCenter}" />
									<DataGridTextColumn Header="Mã ISBN"
														Binding="{Binding ISBN}"
														Width="140"
														ElementStyle="{StaticResource CellLeft}" />
									<DataGridTextColumn Header="Tên sách"
														Binding="{Binding TenSach}"
														Width="*"
														ElementStyle="{StaticResource CellLeft}" />
									<DataGridTextColumn Header="Số lượng"
														Binding="{Binding SoLuong}"
														Width="80"
														ElementStyle="{StaticResource CellCenter}" />
									<DataGridTextColumn Header="Đơn giá nhập"
														HeaderStyle="{StaticResource RightHeaderStyle}"
														Binding="{Binding DonGia, StringFormat='{}{0:N0} đ'}"
														Width="120"
														ElementStyle="{StaticResource CellMoney}" />
									<DataGridTextColumn Header="Thành tiền"
														HeaderStyle="{StaticResource RightHeaderStyle}"
														Binding="{Binding ThanhTien, StringFormat='{}{0:N0} đ'}"
														Width="130"
														ElementStyle="{StaticResource CellProfit}" />
								</DataGrid.Columns>
							</DataGrid>

						</StackPanel>
					</ScrollViewer>
					<Grid Grid.Row="5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<Border Grid.Column="0"
								Background="#FEF3C7"
								Padding="12,8"
								CornerRadius="8"
								HorizontalAlignment="Left">
							<StackPanel Orientation="Horizontal"
										VerticalAlignment="Center">
								<TextBlock Text="TỔNG TIỀN NHẬP:"
										   FontSize="13"
										   FontWeight="SemiBold"
										   Foreground="#92400E"
										   Margin="0,0,10,0"
										   VerticalAlignment="Center" />
								<TextBlock Text="{Binding DetailImportOrder.TongTien, StringFormat={}{0:N0} VNĐ}"
										   FontSize="18"
										   FontWeight="Bold"
										   Foreground="#EF4444" />
							</StackPanel>
						</Border>

						<Button Grid.Column="1"
								Content="ĐÓNG"
								Command="{Binding ClosePopupCommand}"
								CommandParameter="{Binding}"
								Width="120"
								Height="40"
								Cursor="Hand"
								Style="{StaticResource OutlineButtonStyle}" />
					</Grid>
				</Grid>

			</Border>
		</Grid>

		<!-- ==================== POPUP THÊM MỚI PHIẾU NHẬP ==================== -->
		<Grid Style="{StaticResource PopupOverlayStyle}"
			  Visibility="{Binding IsAddPopupOpen, Converter={StaticResource BoolToVis}}">

			<Grid Background="Transparent">
				<Grid.InputBindings>
					<MouseBinding Gesture="LeftClick"
								  Command="{Binding ClosePopupCommand}"
								  CommandParameter="{Binding}" />
				</Grid.InputBindings>
			</Grid>

			<Border Style="{StaticResource PopupCardStyle}"
					Width="900"
					Height="600">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<components:PopupHeaderControl Title="THÊM MỚI PHIẾU NHẬP KHO"
												   IconKind="PackageVariantClosedPlus" />

					<ScrollViewer VerticalScrollBarVisibility="Auto"
								  Margin="0,0,0,12"
								  Grid.Row="1">
						<StackPanel>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="12" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<components:FormComboBoxControl Title="Chọn nhà cung cấp"
																IsRequired="True"
																IconKind="TruckOutline"
																ItemsSource="{Binding SupplierList}"
																SelectedItem="{Binding NewImportOrder.SelectedSupplier, UpdateSourceTrigger=PropertyChanged}"
																DisplayMemberPath="TenNhaCungCap" />

								<components:FormInputControl Title="Người lập phiếu"
															 Grid.Column="2"
															 IconKind="AccountTie"
															 IsEnabled="False"
															 TextValue="{Binding NewImportOrder.TenNguoiTao, Mode=OneWay}" />

								<components:FormInputControl Title="Ghi chú"
															 Grid.Row="1"
															 Grid.Column="0"
															 Grid.ColumnSpan="3"
															 IconKind="NoteEditOutline"
															 TextValue="{Binding NewImportOrder.GhiChu, UpdateSourceTrigger=PropertyChanged}" />


							</Grid>

							<Grid Grid.Row="2"
								  Margin="0,0,0,20">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="1.5*" />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="2*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<components:FormInputControl Title="Tìm tựa sách hoặc ISBN"
															 Grid.Column="0"
															 Margin="0,0,8,0"
															 IconKind="BookSearchOutline"
															 TextValue="{Binding SearchBookKeyword, UpdateSourceTrigger=PropertyChanged}" />
								<Button Grid.Column="1"
										Content="TÌM"
										Command="{Binding SearchBookCommand}"
										CommandParameter="{Binding}"
										Height="40"
										Width="40"
										FontSize="13"
										FontWeight="Bold"
										Margin="0,0,16,0"
										Style="{StaticResource OutlineButtonStyle}" />

								<components:FormComboBoxControl Title="Chọn sách từ kết quả tìm kiếm"
																Grid.Column="2"
																Margin="0,0,8,0"
																IconKind="BookSearch"
																ItemsSource="{Binding SearchBookResults}"
																SelectedItem="{Binding SelectedSearchBook}">

									<components:FormComboBoxControl.ItemTemplate>
										<DataTemplate>
											<TextBlock>
												<Run Text="{Binding ISBN}"
													 FontWeight="Bold"
													 FontSize="12"
													 Foreground="#4318FF" />
												<Run Text=" - " />
												<Run Text="{Binding TenSach}"
													 FontSize="12"
													 FontWeight="Bold" />
												<Run Text="{Binding TonKho, StringFormat=' (Tồn: {0} cuốn)'}"
													 FontStyle="Italic"
													 FontSize="12" />
											</TextBlock>
										</DataTemplate>
									</components:FormComboBoxControl.ItemTemplate>

								</components:FormComboBoxControl>

								<Button Grid.Column="3"
										Content="THÊM"
										Command="{Binding AddBookToImportCommand}"
										CommandParameter="{Binding}"
										Width="70"
										Height="42"
										FontSize="13"
										FontWeight="Bold"
										Style="{StaticResource MainGradientButton}" />
							</Grid>

							<TextBlock Grid.Row="3"
									   Text="CHI TIẾT HÀNG NHẬP"
									   FontSize="14"
									   FontWeight="Bold"
									   Foreground="{StaticResource PrimaryDarkColor}"
									   Margin="0,0,0,10" />

							<DataGrid Grid.Row="4"
									  ItemsSource="{Binding NewImportOrder.ChiTiet}"
									  AutoGenerateColumns="False"
									  CanUserAddRows="False"
									  Style="{StaticResource CleanDataGrid}"
									  MaxHeight="250"
									  ScrollViewer.VerticalScrollBarVisibility="Disabled"
									  PreviewMouseWheel="DataGrid_PreviewMouseWheel"
									  Margin="0,0,0,20">
								<DataGrid.Columns>
									<DataGridTextColumn Header="STT"
														Binding="{Binding STT}"
														Width="50"
														IsReadOnly="True"
														ElementStyle="{StaticResource CellCenter}" />
									<DataGridTextColumn Header="Mã ISBN"
														Binding="{Binding ISBN}"
														Width="110"
														IsReadOnly="True"
														ElementStyle="{StaticResource CellCenter}" />
									<DataGridTextColumn Header="Tên sách"
														Binding="{Binding TenSach}"
														Width="*"
														IsReadOnly="True"
														ElementStyle="{StaticResource CellLeft}" />

									<DataGridTemplateColumn Header="Số lượng"
															HeaderStyle="{StaticResource CenterHeaderStyle}"
															Width="120">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<components:FilterInputControl ShowIcon="False"
																			   UnitText="quyển"
																			   TextAlignment="Center"
																			   TextValue="{Binding SoLuong, UpdateSourceTrigger=PropertyChanged}" />
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn Header="Đơn giá nhập"
															HeaderStyle="{StaticResource CenterHeaderStyle}"
															Width="120">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<components:FilterInputControl ShowIcon="False"
																			   TextAlignment="Right"
																			   IsCurrencyMode="True"
																			   UnitText="đ"
																			   TextValue="{Binding DonGia, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}, ConverterCulture=en-US}" />

											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTextColumn Header="Thành tiền"
														Binding="{Binding ThanhTien, StringFormat='{}{0:N0} đ'}"
														Width="120"
														IsReadOnly="True"
														HeaderStyle="{StaticResource RightHeaderStyle}"
														ElementStyle="{StaticResource CellProfit}" />

									<DataGridTemplateColumn Width="50">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<Button Command="{Binding DataContext.RemoveImportDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
														CommandParameter="{Binding}"
														Style="{StaticResource MiniDeleteButtonStyle}"
														Width="24"
														Height="24"
														ToolTip="Xóa">
													<materialDesign:PackIcon Kind="TrashCanOutline"
																			 Width="18"
																			 Height="18"
																			 HorizontalAlignment="Center"
																			 VerticalAlignment="Center" />
												</Button>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

								</DataGrid.Columns>
							</DataGrid>
						</StackPanel>
					</ScrollViewer>

					<Grid Grid.Row="2">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<Border Grid.Column="0"
								Background="#FEF3C7"
								Padding="12,8"
								CornerRadius="8"
								HorizontalAlignment="Left">
							<StackPanel Orientation="Horizontal"
										VerticalAlignment="Center">
								<TextBlock Text="TỔNG THANH TOÁN:"
										   FontSize="13"
										   FontWeight="SemiBold"
										   Foreground="#92400E"
										   Margin="0,0,10,0"
										   VerticalAlignment="Center" />
								<TextBlock Text="{Binding NewImportOrder.TongTien, StringFormat={}{0:N0} VNĐ}"
										   FontSize="18"
										   FontWeight="Bold"
										   Foreground="#EF4444" />
							</StackPanel>
						</Border>

						<StackPanel Grid.Row="2"
									Orientation="Horizontal"
									HorizontalAlignment="Right"
									VerticalAlignment="Center">
							<Button Content="HỦY BỎ"
									Command="{Binding ClosePopupCommand}"
									CommandParameter="{Binding}"
									Width="120"
									Height="40"
									Margin="0,0,10,0"
									Cursor="Hand"
									Style="{StaticResource OutlineButtonStyle}" />

							<Button Content="LƯU PHIẾU"
									Command="{Binding SaveImportOrderCommand}"
									CommandParameter="{Binding}"
									Width="140"
									Height="40"
									Cursor="Hand"
									Style="{StaticResource MainGradientButton}" />
						</StackPanel>
					</Grid>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</UserControl>