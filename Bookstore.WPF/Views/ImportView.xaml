<UserControl x:Class="Bookstore.WPF.Views.ImportView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:viewmodels="clr-namespace:Bookstore.WPF.ViewModels"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 mc:Ignorable="d">
	<Grid>
		<Grid x:Name="MainImportView"
			  Margin="{StaticResource MainViewMargin}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- ==================== HEADER ==================== -->
			<components:PageHeaderControl Title="NHẬP KHO"
										  HeaderIcon="TruckDelivery"
										  ShowAddButton="True"
										  AddTitle="THÊM"
										  AddIcon="Plus"
										  AddCommand="{Binding OpenAddImportCommand}"
										  AddCommandParameter="{Binding}" />

			<!-- ==================== FILTER ==================== -->
			<Border Grid.Row="1"
					Style="{StaticResource FilterCardStyle}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*" />
						<ColumnDefinition Width="2*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<components:FilterInputControl Grid.Column="0"
												   Margin="0,0,8,0"
												   IconKind="Magnify"
												   HintText="Tìm kiếm phiếu nhập..."
												   TextValue="{Binding SearchKeyword}" />

					<components:FilterComboBoxControl Grid.Column="1"
													  Margin="0,0,8,0"
													  IconKind="Truck"
													  HintText="Nhà cung cấp"
													  ItemsSource="{Binding SupplierList}"
													  SelectedItem="{Binding SelectedSupplier}"
													  DisplayMemberPath="TenNhaCungCap" />

					<components:FilterDatePickerControl Grid.Column="2"
														Margin="0,0,8,0"
														IconKind="CalendarStart"
														HintText="Từ ngày"
														SelectedDate="{Binding FilterFromDate}" />

					<components:FilterDatePickerControl Grid.Column="3"
														Margin="0,0,8,0"
														IconKind="CalendarEnd"
														HintText="Đến ngày"
														SelectedDate="{Binding FilterToDate}" />


					<components:FilterActionPanel Grid.Column="4"
												  ClearCommand="{Binding ClearFilterCommand}"
												  RefreshCommand="{Binding RefreshCommand}"
												  ShowRefreshButton="True" />
				</Grid>
			</Border>

			<!-- ==================== DATAGRID ==================== -->
			<Border Style="{StaticResource DataGridCardStyle}"
					Grid.Row="2">
				<DataGrid ItemsSource="{Binding ImportOrders}"
						  SelectedItem="{Binding SelectedImportOrder}"
						  Style="{StaticResource CleanDataGrid}">

					<DataGrid.Columns>
						<DataGridTextColumn Header="Mã phiếu"
											Width="150"
											HeaderStyle="{StaticResource CenterHeaderStyle}"
											ElementStyle="{StaticResource CellCode}"
											SortMemberPath="MaPhieuNhap">
							<DataGridTextColumn.Binding>
								<MultiBinding StringFormat="PN{0:ddMMyy}{1:D3}">
									<Binding Path="NgayNhap" />
									<Binding Path="MaPhieuNhap" />
								</MultiBinding>
							</DataGridTextColumn.Binding>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Ngày nhập"
											Binding="{Binding NgayNhap, StringFormat={}{0:dd/MM/yyyy}}"
											Width="120"
											HeaderStyle="{StaticResource CenterHeaderStyle}"
											ElementStyle="{StaticResource CellCenter}" />

						<DataGridTextColumn Header="Nhà cung cấp"
											Binding="{Binding TenNhaCungCap}"
											Width="*"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}" />

						<DataGridTextColumn Header="Người tạo"
											Binding="{Binding TenNguoiTao}"
											Width="150"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}" />

						<DataGridTextColumn Header="Tổng tiền"
											Binding="{Binding TongTien, StringFormat={}{0:N0} đ}"
											Width="150"
											HeaderStyle="{StaticResource RightHeaderStyle}"
											ElementStyle="{StaticResource CellProfit}" />

						<DataGridTextColumn Header="Ghi chú"
											Binding="{Binding GhiChu}"
											Width="*"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}" />

						<DataGridTemplateColumn Header="Thao tác"
												HeaderStyle="{StaticResource CenterHeaderStyle}"
												Width="100">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<components:DataGridActionPanel RowItem="{Binding}"
																	ShowEdit="True"
																	EditCommand="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	ShowDelete="True"
																	DeleteCommand="{Binding DataContext.DeleteImportOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</Border>

			<!-- ==================== FOOTER / PAGINATION ==================== -->
			<components:PaginationControl Grid.Row="3"
										  CurrentPage="{Binding TrangHienTai}"
										  TotalPages="{Binding TongSoTrang}"
										  TotalRecords="{Binding TongBanGhi}"
										  PaginationCommand="{Binding PhanTrangCommand}" />
		</Grid>

		<!-- ==================== POPUP CHI TIẾT PHIẾU NHẬP ==================== -->
        <Grid Background="#80000000"
              Visibility="{Binding IsDetailPopupOpen, Converter={StaticResource BoolToVis}}"
              VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="1000">

            <Grid Background="Transparent">
                <Grid.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding ClosePopupCommand}" />
                </Grid.InputBindings>
            </Grid>

            <Border Width="850"
                    Background="White"
                    CornerRadius="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="750">
                    <Grid Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="InformationOutline"
                                                         Width="24" Height="24"
                                                         Foreground="#4318FF"
                                                         Margin="0,0,8,0" />
                                <TextBlock Text="CHI TIẾT PHIẾU NHẬP KHO"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="#2B3674"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="✕" Width="30" Height="30"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="12,0,0,0"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#A3AED0"
                                    Command="{Binding ClosePopupCommand}"
                                    CommandParameter="{Binding}"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource FilterBorderStyle}" Background="#F8FAFC">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Barcode" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,5,0">
                                        <TextBlock Text="Mã phiếu:" FontSize="11" Foreground="#A3AED0" />
                                        <TextBlock Text="{Binding DetailImportOrder.DisplayID}" FontSize="14" FontWeight="Bold" Foreground="#2B3674" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource FilterBorderStyle}" Background="#F8FAFC">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="CalendarClock" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,5,0">
                                        <TextBlock Text="Ngày nhập:" FontSize="11" Foreground="#A3AED0" />
                                        <TextBlock Text="{Binding DetailImportOrder.NgayNhap, StringFormat={}{0:dd/MM/yyyy HH:mm}}" FontSize="14" FontWeight="SemiBold" Foreground="#2B3674" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource FilterBorderStyle}" Background="#F8FAFC">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="TruckOutline" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,5,0">
                                        <TextBlock Text="Nhà cung cấp:" FontSize="11" Foreground="#A3AED0" />
                                        <TextBlock Text="{Binding DetailImportOrder.TenNhaCungCap}" FontSize="14" FontWeight="SemiBold" Foreground="#2B3674" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource FilterBorderStyle}" Background="#F8FAFC">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="AccountTie" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,5,0">
                                        <TextBlock Text="Người lập phiếu:" FontSize="11" Foreground="#A3AED0" />
                                        <TextBlock Text="{Binding DetailImportOrder.TenNguoiTao}" FontSize="14" FontWeight="SemiBold" Foreground="#2B3674" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>


                        <Border Grid.Row="2" Style="{StaticResource FilterBorderStyle}" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="NoteTextOutline" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                <TextBox Grid.Column="1" 
                                 Text="{Binding DetailImportOrder.GhiChu, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="Transparent" BorderThickness="0"
                                 VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                 FontSize="13" Foreground="#2B3674"
                                 materialDesign:HintAssist.Hint="Ghi chú..." />

                                <Button Grid.Column="2" Content="CẬP NHẬT" 
                                Command="{Binding UpdateGhiChuCommand}"
                                        CommandParameter="{Binding}"
                                Height="32" Width="95" Margin="0,0,6,0" FontSize="11" FontWeight="Bold"
                                Style="{StaticResource MainGradientButton}" Cursor="Hand"/>
                            </Grid>
                        </Border>
                        
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                            <TextBlock Text="CHI TIẾT HÀNG NHẬP" FontSize="14" FontWeight="Bold" Foreground="#1E293B" />
                            <TextBlock Text="{Binding DetailImportOrder.ChiTietSach.Count, StringFormat=' ({0} đầu sách)'}" FontSize="14" FontWeight="SemiBold" Foreground="#A3AED0" />
                        </StackPanel>

                        <DataGrid Grid.Row="4" ItemsSource="{Binding DetailImportOrder.ChiTietSach}" 
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  Style="{StaticResource CleanDataGrid}" MaxHeight="300" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="50" ElementStyle="{StaticResource CellCenter}" />
                                <DataGridTextColumn Header="Mã ISBN" Binding="{Binding ISBN}" Width="140" ElementStyle="{StaticResource CellLeft}" />
                                <DataGridTextColumn Header="Tên sách" Binding="{Binding TenSach}" Width="*" ElementStyle="{StaticResource CellLeft}" />
                                <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="80" ElementStyle="{StaticResource CellCenter}"/>
                                <DataGridTextColumn Header="Đơn giá nhập" HeaderStyle="{StaticResource RightHeaderStyle}" Binding="{Binding DonGia, StringFormat={}{0:N0}}" Width="120" ElementStyle="{StaticResource CellMoney}" />
                                <DataGridTextColumn Header="Thành tiền" HeaderStyle="{StaticResource RightHeaderStyle}" Binding="{Binding ThanhTien, StringFormat={}{0:N0}}" Width="130" ElementStyle="{StaticResource CellProfit}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#FEF3C7" Padding="12,8" CornerRadius="8" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="TỔNG TIỀN NHẬP:" FontSize="13" FontWeight="SemiBold" Foreground="#92400E" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DetailImportOrder.TongTien, StringFormat={}{0:N0} VNĐ}" FontSize="18" FontWeight="Bold" Foreground="#EF4444" />
                                </StackPanel>
                            </Border>

                            <Button Grid.Column="1" Content="ĐÓNG" 
                                    Command="{Binding ClosePopupCommand}"
                                    CommandParameter="{Binding}"
                                    Width="120" Height="40" Cursor="Hand"
                                    Style="{StaticResource OutlineButtonStyle}" />
                        </Grid>
                    </Grid>


                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ==================== POPUP THÊM MỚI PHIẾU NHẬP ==================== -->
        <Grid Background="#80000000"
      Visibility="{Binding IsAddPopupOpen, Converter={StaticResource BoolToVis}}"
      VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="1000">

            <Grid Background="Transparent">
                <Grid.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding ClosePopupCommand}"
                                  CommandParameter="{Binding}"/>
                </Grid.InputBindings>
            </Grid>

            <Border Width="850"
            Background="White"
            CornerRadius="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="750">
                    <Grid Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="PackageVariantClosedPlus"
                                                 Width="24" Height="24"
                                                 Foreground="#4318FF"
                                                 Margin="0,0,8,0" />
                                <TextBlock Text="THÊM MỚI PHIẾU NHẬP KHO"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#2B3674"
                                   VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Grid.Column="1"
                            Content="✕" Width="30" Height="30"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="12,0,0,0"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#A3AED0"
                            Command="{Binding ClosePopupCommand}"
                                    CommandParameter="{Binding}"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource FilterBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="TruckOutline" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding SupplierList}" SelectedItem="{Binding NewImportOrder.SelectedSupplier, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="TenNhaCungCap" Margin="0 0 5 0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" HorizontalAlignment="Stretch" FontSize="13" Foreground="#2B3674" materialDesign:HintAssist.Hint="Chọn nhà cung cấp *" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource FilterBorderStyle}" Background="#F8FAFC">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="AccountTie" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding NewImportOrder.TenNguoiTao, Mode=OneWay}" IsReadOnly="True" Margin="0 0 5 0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" HorizontalAlignment="Stretch" FontSize="13" Foreground="#9CA3AF" materialDesign:HintAssist.Hint="Người lập phiếu" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource FilterBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="NoteEditOutline" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding NewImportOrder.GhiChu, UpdateSourceTrigger=PropertyChanged}" 
                     Margin="0 0 5 0" Background="Transparent" BorderThickness="0"
                     VerticalAlignment="Center" HorizontalAlignment="Stretch"
                     FontSize="13" Foreground="#2B3674"
                     materialDesign:HintAssist.Hint="Ghi chú thêm (Tùy chọn)..." />
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource FilterBorderStyle}" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="BookSearchOutline" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBox Grid.Column="1"
										 Text="{Binding SearchBookKeyword, UpdateSourceTrigger=PropertyChanged}"
										 Margin="0 0 5 0" Background="Transparent" BorderThickness="0"
										 VerticalAlignment="Center" HorizontalAlignment="Stretch"
										 FontSize="13" Foreground="#2B3674"
										 materialDesign:HintAssist.Hint="Tìm tựa sách hoặc ISBN..." />
                                </Grid>
                            </Border>

                            <Button Grid.Column="1" Content="TÌM" 
								Command="{Binding SearchBookCommand}"
                                    CommandParameter="{Binding}"
								Height="40" Width="60" FontSize="13" FontWeight="Bold" Margin="0,0,12,0"
								Style="{StaticResource OutlineButtonStyle}" />

                            <ComboBox Grid.Column="2" 
								  ItemsSource="{Binding SearchBookResults}"
								  SelectedItem="{Binding SelectedSearchBook}"
								  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
								  materialDesign:HintAssist.Hint="Chọn sách từ kết quả tìm kiếm..."
								  Margin="0,0,12,0" FontSize="13">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                                <Run Text="{Binding ISBN}" FontWeight="Bold" Foreground="#4318FF"/>
                                                <Run Text=" - "/>
                                                <Run Text="{Binding TenSach}" FontWeight="Bold"/>
                                                <Run Text="{Binding TonKho, StringFormat=' (Tồn: {0} cuốn)'}" FontStyle="Italic" FontSize="13"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Grid.Column="3" Content="THÊM SÁCH" 
							Command="{Binding AddBookToImportCommand}"
                                    CommandParameter="{Binding}"
                                    Width="90"
							Height="40" FontSize="13" FontWeight="Bold"
							Style="{StaticResource MainGradientButton}" />
                        </Grid>

                        <TextBlock Grid.Row="3" Text="CHI TIẾT HÀNG NHẬP" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10" />

                        <DataGrid Grid.Row="4" ItemsSource="{Binding NewImportOrder.ChiTiet}" 
                          AutoGenerateColumns="False" CanUserAddRows="False" 
                          Style="{StaticResource CleanDataGrid}" MaxHeight="250" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="50" IsReadOnly="True" ElementStyle="{StaticResource CellCenter}" />
                                <DataGridTextColumn Header="Mã ISBN" Binding="{Binding ISBN}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource CellCenter}" />
                                <DataGridTextColumn Header="Tên sách" Binding="{Binding TenSach}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource CellLeft}" />

                                <DataGridTemplateColumn Header="Số lượng" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding SoLuong, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Margin="4" 
                                             Style="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Đơn giá nhập" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding DonGia, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Right" Margin="4" 
                                             Style="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0}}" Width="120" IsReadOnly="True" ElementStyle="{StaticResource CellProfit}" />

                                <DataGridTemplateColumn Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.RemoveImportDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}" 
                                            Background="Transparent" BorderThickness="0" Foreground="#EF4444" Width="30" Height="30" ToolTip="Xóa">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="5" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#FEF3C7" Padding="12,8" CornerRadius="8" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="TỔNG THANH TOÁN:" FontSize="13" FontWeight="SemiBold" Foreground="#92400E" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding NewImportOrder.TongTien, StringFormat={}{0:N0} VNĐ}" FontSize="18" FontWeight="Bold" Foreground="#EF4444" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="HỦY BỎ" 
                                Command="{Binding ClosePopupCommand}"
                                        CommandParameter="{Binding}"
                                Width="120" Height="40" Margin="0,0,10,0" Cursor="Hand"
                                Style="{StaticResource OutlineButtonStyle}" />

                                <Button Content="LƯU PHIẾU" 
                                Command="{Binding SaveImportOrderCommand}"
                                        CommandParameter="{Binding}"
                                Width="140" Height="40" Cursor="Hand"
                                Style="{StaticResource MainGradientButton}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>