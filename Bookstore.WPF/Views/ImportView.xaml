<UserControl x:Class="Bookstore.WPF.Views.ImportView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:viewmodels="clr-namespace:Bookstore.WPF.ViewModels"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 mc:Ignorable="d">
	<Grid>
		<Grid x:Name="MainImportView"
			  Margin="{StaticResource MainViewMargin}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- ==================== HEADER ==================== -->
			<components:PageHeaderControl Title="NHẬP KHO"
										  HeaderIcon="TruckDelivery"
										  ShowAddButton="True"
										  AddTitle="THÊM"
										  AddIcon="Plus"
										  AddCommand="{Binding OpenAddImportCommand}"
										  AddCommandParameter="{Binding}" />

			<!-- ==================== FILTER ==================== -->
			<Border Grid.Row="1"
					Style="{StaticResource FilterCardStyle}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*" />
						<ColumnDefinition Width="2*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<components:FilterInputControl Grid.Column="0"
												   Margin="0,0,8,0"
												   IconKind="Magnify"
												   HintText="Tìm kiếm phiếu nhập..."
												   TextValue="{Binding SearchKeyword}" />

					<components:FilterComboBoxControl Grid.Column="1"
													  Margin="0,0,8,0"
													  IconKind="Truck"
													  HintText="Nhà cung cấp"
													  ItemsSource="{Binding SupplierList}"
													  SelectedItem="{Binding SelectedSupplier}"
													  DisplayMemberPath="TenNhaCungCap" />

					<components:FilterDatePickerControl Grid.Column="2"
														Margin="0,0,8,0"
														IconKind="CalendarStart"
														HintText="Từ ngày"
														SelectedDate="{Binding FilterFromDate}" />

					<components:FilterDatePickerControl Grid.Column="3"
														Margin="0,0,8,0"
														IconKind="CalendarEnd"
														HintText="Đến ngày"
														SelectedDate="{Binding FilterToDate}" />


					<components:FilterActionPanel Grid.Column="4"
												  ClearCommand="{Binding ClearFilterCommand}"
												  RefreshCommand="{Binding RefreshCommand}"
												  ShowRefreshButton="True" />
				</Grid>
			</Border>

			<!-- ==================== DATAGRID ==================== -->
			<Border Style="{StaticResource DataGridCardStyle}"
					Grid.Row="2">
				<DataGrid ItemsSource="{Binding ImportOrders}"
						  SelectedItem="{Binding SelectedImportOrder}"
						  Style="{StaticResource CleanDataGrid}">

					<DataGrid.Columns>
						<DataGridTextColumn Header="Mã phiếu"
											Width="150"
											HeaderStyle="{StaticResource CenterHeaderStyle}"
											ElementStyle="{StaticResource CellCode}"
											SortMemberPath="MaPhieuNhap">
							<DataGridTextColumn.Binding>
								<MultiBinding StringFormat="PN{0:ddMMyy}{1:D3}">
									<Binding Path="NgayNhap" />
									<Binding Path="MaPhieuNhap" />
								</MultiBinding>
							</DataGridTextColumn.Binding>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Ngày nhập"
											Binding="{Binding NgayNhap, StringFormat={}{0:dd/MM/yyyy}}"
											Width="120"
											HeaderStyle="{StaticResource CenterHeaderStyle}"
											ElementStyle="{StaticResource CellCenter}" />

						<DataGridTextColumn Header="Nhà cung cấp"
											Binding="{Binding TenNhaCungCap}"
											Width="*"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}" />

						<DataGridTextColumn Header="Người tạo"
											Binding="{Binding TenNguoiTao}"
											Width="150"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}" />

						<DataGridTextColumn Header="Tổng tiền"
											Binding="{Binding TongTien, StringFormat={}{0:N0} đ}"
											Width="150"
											HeaderStyle="{StaticResource RightHeaderStyle}"
											ElementStyle="{StaticResource CellProfit}" />

						<DataGridTextColumn Header="Ghi chú"
											Binding="{Binding GhiChu}"
											Width="*"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}" />

						<DataGridTemplateColumn Header="Thao tác"
												HeaderStyle="{StaticResource CenterHeaderStyle}"
												Width="100">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<components:DataGridActionPanel RowItem="{Binding}"
																	ShowEdit="True"
																	EditCommand="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	ShowDelete="True"
																	DeleteCommand="{Binding DataContext.DeleteImportOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</Border>

			<!-- ==================== FOOTER / PAGINATION ==================== -->
			<components:PaginationControl Grid.Row="3"
										  CurrentPage="{Binding TrangHienTai}"
										  TotalPages="{Binding TongSoTrang}"
										  TotalRecords="{Binding TongBanGhi}"
										  PaginationCommand="{Binding PhanTrangCommand}" />
		</Grid>

		<!-- ==================== POPUP CHI TIẾT PHIẾU NHẬP ==================== -->
		<Grid Background="#80000000"
			  Visibility="{Binding IsDetailPopupOpen, Converter={StaticResource BoolToVis}}"
			  VerticalAlignment="Stretch"
			  HorizontalAlignment="Stretch"
			  Panel.ZIndex="1000">
			<Border Background="#80000000"
					MouseLeftButtonDown="PopupDetail_Close" />

			<Border Width="680"
					Background="White"
					CornerRadius="16"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					MaxHeight="600">
				<Grid Margin="24">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!-- Header -->
					<StackPanel Grid.Row="0"
								Orientation="Horizontal"
								HorizontalAlignment="Center"
								Margin="0,0,0,16">
						<materialDesign:PackIcon Kind="Information"
												 Width="22"
												 Height="22"
												 Foreground="#4318FF"
												 Margin="0,0,8,0" />
						<TextBlock Text="CHI TIẾT PHIẾU NHẬP"
								   FontSize="18"
								   FontWeight="Bold"
								   Foreground="#2B3674" />
					</StackPanel>

					<!-- Thông tin chung - Dạng 2 cột gọn -->
					<Border Grid.Row="1"
							Background="#F8FAFC"
							CornerRadius="8"
							Padding="16"
							Margin="0,0,0,8">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<!-- Mã phiếu -->
							<TextBlock Grid.Row="0"
									   Grid.Column="0"
									   Text="Mã phiếu:"
									   Foreground="#A3AED0"
									   FontSize="12"
									   Margin="0,0,8,4" />
							<TextBlock Grid.Row="0"
									   Grid.Column="1"
									   Text="{Binding DetailImportOrder.MaPhieuNhap}"
									   FontSize="13"
									   FontWeight="SemiBold"
									   Foreground="#2B3674"
									   Margin="0,0,16,4" />

							<!-- Ngày nhập -->
							<TextBlock Grid.Row="0"
									   Grid.Column="2"
									   Text="Ngày nhập:"
									   Foreground="#A3AED0"
									   FontSize="12"
									   Margin="0,0,8,4" />
							<TextBlock Grid.Row="0"
									   Grid.Column="3"
									   Text="{Binding DetailImportOrder.NgayNhap, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
									   FontSize="13"
									   FontWeight="SemiBold"
									   Foreground="#2B3674"
									   Margin="0,0,0,4" />

							<!-- Nhà cung cấp -->
							<TextBlock Grid.Row="1"
									   Grid.Column="0"
									   Text="NCC:"
									   Foreground="#A3AED0"
									   FontSize="12"
									   Margin="0,0,8,4" />
							<TextBlock Grid.Row="1"
									   Grid.Column="1"
									   Text="{Binding DetailImportOrder.TenNhaCungCap}"
									   FontSize="13"
									   FontWeight="SemiBold"
									   Foreground="#2B3674"
									   Margin="0,0,16,4" />

							<!-- Người tạo -->
							<TextBlock Grid.Row="1"
									   Grid.Column="2"
									   Text="Người tạo:"
									   Foreground="#A3AED0"
									   FontSize="12"
									   Margin="0,0,8,4" />
							<TextBlock Grid.Row="1"
									   Grid.Column="3"
									   Text="{Binding DetailImportOrder.TenNguoiTao}"
									   FontSize="13"
									   FontWeight="SemiBold"
									   Foreground="#2B3674"
									   Margin="0,0,0,4" />

							<!-- Tổng tiền + Ghi chú -->
							<TextBlock Grid.Row="2"
									   Grid.Column="0"
									   Text="Tổng tiền:"
									   Foreground="#A3AED0"
									   FontSize="12"
									   Margin="0,0,8,0" />
							<TextBlock Grid.Row="2"
									   Grid.Column="1"
									   Text="{Binding DetailImportOrder.TongTien, StringFormat={}{0:N0} VNĐ}"
									   FontSize="15"
									   FontWeight="Bold"
									   Foreground="#059669"
									   Margin="0,0,16,0" />

							<TextBlock Grid.Row="2"
									   Grid.Column="2"
									   Text="Ghi chú:"
									   Foreground="#A3AED0"
									   FontSize="12"
									   Margin="0,0,8,0" />
							<TextBlock Grid.Row="2"
									   Grid.Column="3"
									   Text="{Binding DetailImportOrder.GhiChu}"
									   FontSize="12"
									   Foreground="#2B3674"
									   TextWrapping="Wrap"
									   Margin="0,0,0,0" />
						</Grid>
					</Border>

					<!-- Separator -->
					<Border Grid.Row="2"
							Height="1"
							Background="#E2E8F0"
							Margin="0,4,0,8" />

					<!-- Title danh sách sách -->
					<TextBlock Grid.Row="3"
							   Text="DANH SÁCH SÁCH NHẬP"
							   FontSize="13"
							   FontWeight="SemiBold"
							   Foreground="#2B3674"
							   Margin="0,0,0,8" />

					<!-- DataGrid sách - Gọn không scroll ngang -->
					<DataGrid Grid.Row="4"
							  ItemsSource="{Binding DetailImportOrder.ChiTietSach}"
							  AutoGenerateColumns="False"
							  HeadersVisibility="Column"
							  BorderThickness="0"
							  RowHeight="38"
							  FontSize="12"
							  AlternatingRowBackground="#F8FAFC"
							  RowBackground="White"
							  Foreground="#2B3674"
							  GridLinesVisibility="Horizontal"
							  HorizontalGridLinesBrush="#E2E8F0"
							  VerticalGridLinesBrush="Transparent"
							  IsReadOnly="True"
							  CanUserAddRows="False"
							  CanUserDeleteRows="False"
							  CanUserReorderColumns="False"
							  CanUserResizeColumns="False"
							  CanUserSortColumns="False"
							  MaxHeight="240"
							  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
							  ScrollViewer.VerticalScrollBarVisibility="Auto">
						<DataGrid.Resources>
							<Style TargetType="DataGridColumnHeader">
								<Setter Property="Background"
										Value="#F8FAFC" />
								<Setter Property="Foreground"
										Value="#2B3674" />
								<Setter Property="FontWeight"
										Value="SemiBold" />
								<Setter Property="FontSize"
										Value="11" />
								<Setter Property="Height"
										Value="34" />
								<Setter Property="BorderBrush"
										Value="#E2E8F0" />
								<Setter Property="BorderThickness"
										Value="0,0,0,1" />
								<Setter Property="VerticalContentAlignment"
										Value="Center" />
								<Setter Property="Padding"
										Value="8,0" />
								<Setter Property="Template">
									<Setter.Value>
										<ControlTemplate TargetType="DataGridColumnHeader">
											<Border Background="{TemplateBinding Background}"
													BorderBrush="{TemplateBinding BorderBrush}"
													BorderThickness="{TemplateBinding BorderThickness}"
													Padding="{TemplateBinding Padding}">
												<ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
																  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
											</Border>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
							</Style>
							<Style TargetType="DataGridCell">
								<Setter Property="VerticalContentAlignment"
										Value="Center" />
								<Setter Property="BorderThickness"
										Value="0" />
								<Setter Property="Padding"
										Value="8,0" />
								<Setter Property="FocusVisualStyle"
										Value="{x:Null}" />
								<Setter Property="Template">
									<Setter.Value>
										<ControlTemplate TargetType="DataGridCell">
											<Border Background="{TemplateBinding Background}"
													BorderBrush="{TemplateBinding BorderBrush}"
													BorderThickness="{TemplateBinding BorderThickness}"
													Padding="{TemplateBinding Padding}">
												<ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
																  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
											</Border>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
							</Style>
						</DataGrid.Resources>
						<DataGrid.Columns>
							<!-- STT -->
							<DataGridTemplateColumn Header="#"
													Width="35">
								<DataGridTemplateColumn.HeaderStyle>
									<Style TargetType="DataGridColumnHeader"
										   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
										<Setter Property="HorizontalContentAlignment"
												Value="Center" />
									</Style>
								</DataGridTemplateColumn.HeaderStyle>
								<DataGridTemplateColumn.CellStyle>
									<Style TargetType="DataGridCell"
										   BasedOn="{StaticResource {x:Type DataGridCell}}">
										<Setter Property="HorizontalContentAlignment"
												Value="Center" />
									</Style>
								</DataGridTemplateColumn.CellStyle>
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding STT}"
												   TextAlignment="Center"
												   Foreground="#A3AED0"
												   FontSize="12" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>

							<!-- Tên sách -->
							<DataGridTemplateColumn Header="Tên sách"
													Width="175">
								<DataGridTemplateColumn.HeaderStyle>
									<Style TargetType="DataGridColumnHeader"
										   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
										<Setter Property="HorizontalContentAlignment"
												Value="Left" />
									</Style>
								</DataGridTemplateColumn.HeaderStyle>
								<DataGridTemplateColumn.CellStyle>
									<Style TargetType="DataGridCell"
										   BasedOn="{StaticResource {x:Type DataGridCell}}">
										<Setter Property="HorizontalContentAlignment"
												Value="Left" />
									</Style>
								</DataGridTemplateColumn.CellStyle>
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding TenSach}"
												   TextTrimming="CharacterEllipsis"
												   FontSize="12" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>

							<!-- ISBN -->
							<DataGridTemplateColumn Header="ISBN"
													Width="120">
								<DataGridTemplateColumn.HeaderStyle>
									<Style TargetType="DataGridColumnHeader"
										   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
										<Setter Property="HorizontalContentAlignment"
												Value="Left" />
									</Style>
								</DataGridTemplateColumn.HeaderStyle>
								<DataGridTemplateColumn.CellStyle>
									<Style TargetType="DataGridCell"
										   BasedOn="{StaticResource {x:Type DataGridCell}}">
										<Setter Property="HorizontalContentAlignment"
												Value="Left" />
									</Style>
								</DataGridTemplateColumn.CellStyle>
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding ISBN}"
												   FontSize="12" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>

							<!-- Số lượng -->
							<DataGridTemplateColumn Header="SL"
													Width="50">
								<DataGridTemplateColumn.HeaderStyle>
									<Style TargetType="DataGridColumnHeader"
										   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
										<Setter Property="HorizontalContentAlignment"
												Value="Center" />
									</Style>
								</DataGridTemplateColumn.HeaderStyle>
								<DataGridTemplateColumn.CellStyle>
									<Style TargetType="DataGridCell"
										   BasedOn="{StaticResource {x:Type DataGridCell}}">
										<Setter Property="HorizontalContentAlignment"
												Value="Center" />
									</Style>
								</DataGridTemplateColumn.CellStyle>
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding SoLuong}"
												   TextAlignment="Center"
												   FontSize="12" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>

							<!-- Đơn giá -->
							<DataGridTemplateColumn Header="Đơn giá"
													Width="100">
								<DataGridTemplateColumn.HeaderStyle>
									<Style TargetType="DataGridColumnHeader"
										   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
										<Setter Property="HorizontalContentAlignment"
												Value="Right" />
									</Style>
								</DataGridTemplateColumn.HeaderStyle>
								<DataGridTemplateColumn.CellStyle>
									<Style TargetType="DataGridCell"
										   BasedOn="{StaticResource {x:Type DataGridCell}}">
										<Setter Property="HorizontalContentAlignment"
												Value="Right" />
									</Style>
								</DataGridTemplateColumn.CellStyle>
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding DonGia, StringFormat={}{0:N0}}"
												   TextAlignment="Right"
												   FontSize="12" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>

							<!-- Thành tiền -->
							<DataGridTemplateColumn Header="Thành tiền"
													Width="120">
								<DataGridTemplateColumn.HeaderStyle>
									<Style TargetType="DataGridColumnHeader"
										   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
										<Setter Property="HorizontalContentAlignment"
												Value="Right" />
									</Style>
								</DataGridTemplateColumn.HeaderStyle>
								<DataGridTemplateColumn.CellStyle>
									<Style TargetType="DataGridCell"
										   BasedOn="{StaticResource {x:Type DataGridCell}}">
										<Setter Property="HorizontalContentAlignment"
												Value="Right" />
									</Style>
								</DataGridTemplateColumn.CellStyle>
								<DataGridTemplateColumn.CellTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding ThanhTien, StringFormat={}{0:N0}}"
												   TextAlignment="Right"
												   FontWeight="SemiBold"
												   FontSize="12" />
									</DataTemplate>
								</DataGridTemplateColumn.CellTemplate>
							</DataGridTemplateColumn>
						</DataGrid.Columns>
					</DataGrid>

					<!-- Tổng kết -->
					<Border Grid.Row="5"
							Background="#F0FDF4"
							CornerRadius="6"
							Padding="10,8"
							Margin="0,8,0,0">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0"
									   Text="TỔNG TIỀN:"
									   FontSize="14"
									   FontWeight="Bold"
									   Foreground="#166534"
									   Margin="0,0,8,0" />
							<TextBlock Grid.Column="1"
									   Text="{Binding DetailImportOrder.TongTien, StringFormat={}{0:N0} VNĐ}"
									   FontSize="16"
									   FontWeight="Bold"
									   Foreground="#059669"
									   HorizontalAlignment="Right" />
						</Grid>
					</Border>

					<!-- Số lượng sách -->
					<TextBlock Grid.Row="6"
							   Text="{Binding DetailImportOrder.ChiTietSach.Count, StringFormat='Tổng số: {0} đầu sách'}"
							   FontSize="11"
							   Foreground="#A3AED0"
							   HorizontalAlignment="Right"
							   Margin="0,4,0,8" />

					<!-- Nút đóng -->
					<Button Grid.Row="7"
							Content="ĐÓNG"
							Width="100"
							Height="36"
							FontSize="13"
							FontWeight="SemiBold"
							Foreground="#A3AED0"
							Background="Transparent"
							BorderBrush="#E2E8F0"
							BorderThickness="1"
							Cursor="Hand"
							HorizontalAlignment="Center"
							Click="PopupDetail_Close" />
				</Grid>
			</Border>
		</Grid>

		<!-- ==================== POPUP THÊM MỚI PHIẾU NHẬP ==================== -->
		<Grid Background="#80000000"
			  Visibility="{Binding IsAddPopupOpen, Converter={StaticResource BoolToVis}}"
			  VerticalAlignment="Stretch"
			  HorizontalAlignment="Stretch"
			  Panel.ZIndex="1000">
			<Border Background="#80000000"
					MouseLeftButtonDown="PopupAdd_Close" />

			<Border Width="850"
					Background="White"
					CornerRadius="16"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					MaxHeight="750">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<Grid Margin="28">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<!-- ===== PHẦN 1: Header ===== -->
						<StackPanel Grid.Row="0"
									Orientation="Horizontal"
									HorizontalAlignment="Center"
									Margin="0,0,0,20">
							<materialDesign:PackIcon Kind="PlusCircle"
													 Width="24"
													 Height="24"
													 Foreground="#4318FF"
													 Margin="0,0,10,0" />
							<TextBlock Text="THÊM MỚI PHIẾU NHẬP"
									   FontSize="20"
									   FontWeight="Bold"
									   Foreground="#2B3674" />
						</StackPanel>

						<!-- ===== PHẦN 2: Thông tin chung ===== -->
						<Border Grid.Row="1"
								Background="#F8FAFC"
								CornerRadius="10"
								Padding="16"
								Margin="0,0,0,16">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="12" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<!-- Mã phiếu (tự động) -->
								<TextBox Grid.Row="0"
										 Grid.Column="0"
										 Text="{Binding NewImportOrder.MaPhieuNhap, Mode=OneWay}"
										 materialDesign:HintAssist.Hint="Mã phiếu (tự động)"
										 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
										 IsReadOnly="True"
										 Margin="0,0,0,12" />

								<!-- Nhà cung cấp -->
								<ComboBox Grid.Row="0"
										  Grid.Column="2"
										  materialDesign:HintAssist.Hint="Nhà cung cấp *"
										  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
										  FontSize="14"
										  Height="48"
										  ItemsSource="{Binding SupplierList}"
										  SelectedItem="{Binding NewImportOrder.SelectedSupplier}"
										  DisplayMemberPath="TenNhaCungCap"
										  Margin="0,0,0,12" />

								<!-- Ngày nhập -->
								<DatePicker Grid.Row="1"
											Grid.Column="0"
											Height="40"
											FontSize="13"
											materialDesign:HintAssist.Hint="Ngày nhập"
											SelectedDate="{Binding NewImportOrder.NgayNhap}"
											VerticalAlignment="Center" />

								<!-- Ghi chú -->
								<TextBox Grid.Row="1"
										 Grid.Column="2"
										 materialDesign:HintAssist.Hint="Ghi chú"
										 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
										 Text="{Binding NewImportOrder.GhiChu}" />
							</Grid>
						</Border>

						<!-- ===== PHẦN 3: Separator + Tiêu đề ===== -->
						<Border Grid.Row="2"
								Height="1"
								Background="#E2E8F0"
								Margin="0,0,0,12" />

						<TextBlock Grid.Row="3"
								   Text="DANH SÁCH SÁCH NHẬP"
								   FontSize="14"
								   FontWeight="SemiBold"
								   Foreground="#2B3674"
								   Margin="0,0,0,8" />

						<!-- ===== PHẦN 4: Thanh tìm kiếm sách + Nút thêm ===== -->
						<Border Grid.Row="4"
								Background="#F8FAFC"
								CornerRadius="8"
								Padding="12"
								Margin="0,0,0,8">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<!-- Ô tìm kiếm sách -->
								<Grid Grid.Column="0"
									  Margin="0,0,12,0">
									<TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
											 materialDesign:HintAssist.Hint="Tìm sách (tên sách, ISBN, tác giả)..."
											 FontSize="13"
											 Foreground="#2B3674"
											 Text="{Binding SearchBookKeyword, UpdateSourceTrigger=PropertyChanged}" />
									<materialDesign:PackIcon Kind="Magnify"
															 Width="18"
															 Height="18"
															 Foreground="#A3AED0"
															 HorizontalAlignment="Right"
															 VerticalAlignment="Center"
															 Margin="0,0,12,0" />
								</Grid>

								<!-- Nút Tìm -->
								<Button Grid.Column="1"
										Content="TÌM"
										Width="70"
										Height="38"
										FontSize="13"
										FontWeight="SemiBold"
										Foreground="White"
										Background="#4318FF"
										Cursor="Hand"
										Command="{Binding SearchBookCommand}"
										Margin="0,0,8,0" />

								<!-- Nút Thêm (tạm thời chưa làm chức năng) -->
								<Button Grid.Column="2"
										Content="THÊM"
										Width="70"
										Height="38"
										FontSize="13"
										FontWeight="SemiBold"
										Foreground="White"
										Background="#10B981"
										Cursor="Hand"
										Command="{Binding AddBookToImportCommand}" />
							</Grid>
						</Border>

						<!-- ===== PHẦN 5: DataGrid sách nhập ===== -->
						<DataGrid Grid.Row="5"
								  ItemsSource="{Binding NewImportOrder.ImportDetailItems}"
								  AutoGenerateColumns="False"
								  HeadersVisibility="Column"
								  BorderThickness="0"
								  RowHeight="40"
								  FontSize="12"
								  AlternatingRowBackground="#F8FAFC"
								  RowBackground="White"
								  Foreground="#2B3674"
								  GridLinesVisibility="Horizontal"
								  HorizontalGridLinesBrush="#E2E8F0"
								  VerticalGridLinesBrush="Transparent"
								  CanUserAddRows="False"
								  CanUserDeleteRows="True"
								  CanUserReorderColumns="False"
								  CanUserResizeColumns="False"
								  CanUserSortColumns="False"
								  MaxHeight="220"
								  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
								  ScrollViewer.VerticalScrollBarVisibility="Auto"
								  Margin="0,0,0,12">
							<DataGrid.Resources>
								<Style TargetType="DataGridColumnHeader">
									<Setter Property="Background"
											Value="#F8FAFC" />
									<Setter Property="Foreground"
											Value="#2B3674" />
									<Setter Property="FontWeight"
											Value="SemiBold" />
									<Setter Property="FontSize"
											Value="11" />
									<Setter Property="Height"
											Value="34" />
									<Setter Property="BorderBrush"
											Value="#E2E8F0" />
									<Setter Property="BorderThickness"
											Value="0,0,0,1" />
									<Setter Property="VerticalContentAlignment"
											Value="Center" />
									<Setter Property="Padding"
											Value="8,0" />
									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="DataGridColumnHeader">
												<Border Background="{TemplateBinding Background}"
														BorderBrush="{TemplateBinding BorderBrush}"
														BorderThickness="{TemplateBinding BorderThickness}"
														Padding="{TemplateBinding Padding}">
													<ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
																	  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
								</Style>
								<Style TargetType="DataGridCell">
									<Setter Property="VerticalContentAlignment"
											Value="Center" />
									<Setter Property="BorderThickness"
											Value="0" />
									<Setter Property="Padding"
											Value="8,0" />
									<Setter Property="FocusVisualStyle"
											Value="{x:Null}" />
									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="DataGridCell">
												<Border Background="{TemplateBinding Background}"
														BorderBrush="{TemplateBinding BorderBrush}"
														BorderThickness="{TemplateBinding BorderThickness}"
														Padding="{TemplateBinding Padding}">
													<ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
																	  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
								</Style>
							</DataGrid.Resources>

							<DataGrid.Columns>
								<!-- STT -->
								<DataGridTemplateColumn Header="#"
														Width="35"
														IsReadOnly="True">
									<DataGridTemplateColumn.HeaderStyle>
										<Style TargetType="DataGridColumnHeader"
											   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
											<Setter Property="HorizontalContentAlignment"
													Value="Center" />
										</Style>
									</DataGridTemplateColumn.HeaderStyle>
									<DataGridTemplateColumn.CellStyle>
										<Style TargetType="DataGridCell"
											   BasedOn="{StaticResource {x:Type DataGridCell}}">
											<Setter Property="HorizontalContentAlignment"
													Value="Center" />
										</Style>
									</DataGridTemplateColumn.CellStyle>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<TextBlock Text="{Binding STT}"
													   TextAlignment="Center"
													   Foreground="#A3AED0"
													   FontSize="12" />
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<!-- Tên sách (khóa) -->
								<DataGridTemplateColumn Header="Tên sách"
														Width="160"
														IsReadOnly="True">
									<DataGridTemplateColumn.HeaderStyle>
										<Style TargetType="DataGridColumnHeader"
											   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
											<Setter Property="HorizontalContentAlignment"
													Value="Left" />
										</Style>
									</DataGridTemplateColumn.HeaderStyle>
									<DataGridTemplateColumn.CellStyle>
										<Style TargetType="DataGridCell"
											   BasedOn="{StaticResource {x:Type DataGridCell}}">
											<Setter Property="HorizontalContentAlignment"
													Value="Left" />
										</Style>
									</DataGridTemplateColumn.CellStyle>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<TextBlock Text="{Binding TenSach}"
													   TextTrimming="CharacterEllipsis"
													   FontSize="12" />
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<!-- ISBN (khóa) -->
								<DataGridTemplateColumn Header="ISBN"
														Width="110"
														IsReadOnly="True">
									<DataGridTemplateColumn.HeaderStyle>
										<Style TargetType="DataGridColumnHeader"
											   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
											<Setter Property="HorizontalContentAlignment"
													Value="Left" />
										</Style>
									</DataGridTemplateColumn.HeaderStyle>
									<DataGridTemplateColumn.CellStyle>
										<Style TargetType="DataGridCell"
											   BasedOn="{StaticResource {x:Type DataGridCell}}">
											<Setter Property="HorizontalContentAlignment"
													Value="Left" />
										</Style>
									</DataGridTemplateColumn.CellStyle>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<TextBlock Text="{Binding ISBN}"
													   FontSize="12" />
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<!-- Tác giả (khóa) -->
								<DataGridTemplateColumn Header="Tác giả"
														Width="100"
														IsReadOnly="True">
									<DataGridTemplateColumn.HeaderStyle>
										<Style TargetType="DataGridColumnHeader"
											   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
											<Setter Property="HorizontalContentAlignment"
													Value="Left" />
										</Style>
									</DataGridTemplateColumn.HeaderStyle>
									<DataGridTemplateColumn.CellStyle>
										<Style TargetType="DataGridCell"
											   BasedOn="{StaticResource {x:Type DataGridCell}}">
											<Setter Property="HorizontalContentAlignment"
													Value="Left" />
										</Style>
									</DataGridTemplateColumn.CellStyle>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<TextBlock Text="{Binding TacGia}"
													   TextTrimming="CharacterEllipsis"
													   FontSize="12" />
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<!-- Số lượng (có thể nhập) -->
								<DataGridTemplateColumn Header="Số lượng"
														Width="65">
									<DataGridTemplateColumn.HeaderStyle>
										<Style TargetType="DataGridColumnHeader"
											   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
											<Setter Property="HorizontalContentAlignment"
													Value="Center" />
										</Style>
									</DataGridTemplateColumn.HeaderStyle>
									<DataGridTemplateColumn.CellStyle>
										<Style TargetType="DataGridCell"
											   BasedOn="{StaticResource {x:Type DataGridCell}}">
											<Setter Property="HorizontalContentAlignment"
													Value="Center" />
										</Style>
									</DataGridTemplateColumn.CellStyle>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<TextBox Text="{Binding SoLuong, UpdateSourceTrigger=PropertyChanged}"
													 TextAlignment="Center"
													 FontSize="12"
													 BorderThickness="1"
													 BorderBrush="#E2E8F0"
													 Padding="4,4"
													 MinWidth="40" />
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<!-- Đơn giá (có thể nhập) -->
								<DataGridTemplateColumn Header="Đơn giá"
														Width="100">
									<DataGridTemplateColumn.HeaderStyle>
										<Style TargetType="DataGridColumnHeader"
											   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
											<Setter Property="HorizontalContentAlignment"
													Value="Right" />
										</Style>
									</DataGridTemplateColumn.HeaderStyle>
									<DataGridTemplateColumn.CellStyle>
										<Style TargetType="DataGridCell"
											   BasedOn="{StaticResource {x:Type DataGridCell}}">
											<Setter Property="HorizontalContentAlignment"
													Value="Right" />
										</Style>
									</DataGridTemplateColumn.CellStyle>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<TextBox Text="{Binding DonGia, UpdateSourceTrigger=PropertyChanged}"
													 TextAlignment="Right"
													 FontSize="12"
													 BorderThickness="1"
													 BorderBrush="#E2E8F0"
													 Padding="4,4"
													 MinWidth="70" />
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<!-- Thành tiền (tự tính) -->
								<DataGridTemplateColumn Header="Thành tiền"
														Width="110"
														IsReadOnly="True">
									<DataGridTemplateColumn.HeaderStyle>
										<Style TargetType="DataGridColumnHeader"
											   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
											<Setter Property="HorizontalContentAlignment"
													Value="Right" />
										</Style>
									</DataGridTemplateColumn.HeaderStyle>
									<DataGridTemplateColumn.CellStyle>
										<Style TargetType="DataGridCell"
											   BasedOn="{StaticResource {x:Type DataGridCell}}">
											<Setter Property="HorizontalContentAlignment"
													Value="Right" />
										</Style>
									</DataGridTemplateColumn.CellStyle>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<TextBlock Text="{Binding ThanhTien, StringFormat={}{0:N0}}"
													   TextAlignment="Right"
													   FontWeight="SemiBold"
													   FontSize="12" />
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>

								<!-- Nút xóa dòng -->
								<DataGridTemplateColumn Width="35"
														IsReadOnly="True">
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<Button Width="24"
													Height="24"
													Background="#FEE2E2"
													BorderThickness="0"
													Cursor="Hand"
													ToolTip="Xóa dòng"
													Command="{Binding DataContext.RemoveImportDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
													CommandParameter="{Binding}"
													HorizontalAlignment="Center">
												<Button.Template>
													<ControlTemplate TargetType="Button">
														<Border x:Name="border"
																Background="{TemplateBinding Background}"
																CornerRadius="4">
															<materialDesign:PackIcon Kind="Close"
																					 Width="12"
																					 Height="12"
																					 Foreground="#EF4444"
																					 HorizontalAlignment="Center"
																					 VerticalAlignment="Center" />
														</Border>
														<ControlTemplate.Triggers>
															<Trigger Property="IsMouseOver"
																	 Value="True">
																<Setter TargetName="border"
																		Property="Background"
																		Value="#FECACA" />
															</Trigger>
														</ControlTemplate.Triggers>
													</ControlTemplate>
												</Button.Template>
											</Button>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
							</DataGrid.Columns>
						</DataGrid>

						<!-- ===== PHẦN 6: Tổng tiền + Nút điều khiển ===== -->
						<Border Grid.Row="6"
								Margin="0,0,0,0">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<!-- Tổng tiền -->
								<StackPanel Grid.Column="0"
											Orientation="Horizontal"
											VerticalAlignment="Center">
									<TextBlock Text="TỔNG TIỀN:"
											   FontSize="15"
											   FontWeight="Bold"
											   Foreground="#2B3674"
											   Margin="0,0,8,0" />
									<TextBlock Text="{Binding NewImportOrder.TongTien, StringFormat={}{0:N0} VNĐ}"
											   FontSize="18"
											   FontWeight="Bold"
											   Foreground="#059669" />
								</StackPanel>

								<!-- Nút Hủy bỏ + Tạo phiếu -->
								<StackPanel Grid.Column="1"
											Orientation="Horizontal">
									<Button Content="HỦY BỎ"
											Width="110"
											Height="40"
											Margin="0,0,10,0"
											FontSize="13"
											FontWeight="SemiBold"
											Foreground="#A3AED0"
											Background="Transparent"
											BorderBrush="#E2E8F0"
											BorderThickness="1"
											Cursor="Hand"
											Click="PopupAdd_Close" />
									<Button Content="TẠO PHIẾU"
											Width="130"
											Height="40"
											FontSize="13"
											FontWeight="SemiBold"
											Foreground="White"
											Background="#10B981"
											Cursor="Hand"
											Command="{Binding SaveImportOrderCommand}" />
								</StackPanel>
							</Grid>
						</Border>
					</Grid>
				</ScrollViewer>
			</Border>
		</Grid>
	</Grid>
</UserControl>