<UserControl x:Class="Bookstore.WPF.Views.CategoryView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 mc:Ignorable="d">
	
	<Grid>
		<Grid x:Name="MainCategoryView">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<components:PageHeaderControl Title="QUẢN LÝ DANH MỤC"
										  HeaderIcon="CategoryPlus"
										  ShowAddButton="False" />

			<TabControl Grid.Row="1"
						Background="Transparent"
						BorderThickness="0">
				<TabItem Header="ĐẦU SÁCH"
						 Style="{StaticResource CategoryTabItem}"
						 FontWeight="Bold">
					<Grid Margin="0,15,0,0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<Grid Grid.Row="0"
							  Margin="0,0,0,15">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="300" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Border Style="{StaticResource FilterBorderStyle}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="40" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<materialDesign:PackIcon Kind="Book"
															 Foreground="#A3AED0"
															 VerticalAlignment="Center"
															 HorizontalAlignment="Center" />
									<TextBox Grid.Column="1"
											 Text="{Binding SearchDauSach, UpdateSourceTrigger=PropertyChanged}"
											 materialDesign:HintAssist.Hint="Tìm đầu sách..."
											 BorderThickness="0"
											 VerticalAlignment="Center"
											 Background="Transparent"
											 Margin="0 0 10 0"
											 Foreground="Black" />
								</Grid>
							</Border>
							<Button Grid.Column="2"
									Style="{StaticResource MainGradientButton}"
									Width="150"
									Command="{Binding OpenAddDauSachCommand}"
									CommandParameter="{Binding}"
									Content="+ THÊM ĐẦU SÁCH" />
						</Grid>
						<Border Grid.Row="1"
								CornerRadius="20"
								Background="White"
								BorderBrush="#E2E8F0"
								BorderThickness="1"
								Padding="20">
							<DataGrid Grid.Row="1"
									  ItemsSource="{Binding FilteredDauSachs}"
									  AutoGenerateColumns="False"
									  IsReadOnly="True"
									  Background="White"
									  FontWeight="SemiBold"
									  SelectionMode="Extended"
									  SelectionUnit="FullRow"
									  HeadersVisibility="Column"
									  BorderThickness="0"
									  MinRowHeight="52"
									  FontSize="13"
									  AlternatingRowBackground="#F8FAFC"
									  RowBackground="White"
									  Foreground="#2B3674"
									  GridLinesVisibility="Horizontal"
									  HorizontalGridLinesBrush="#E2E8F0"
									  VerticalGridLinesBrush="Transparent"
									  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
									  ScrollViewer.VerticalScrollBarVisibility="Auto"
									  CanUserAddRows="False"
									  CanUserDeleteRows="False"
									  CanUserResizeColumns="False"
									  CanUserResizeRows="False"
									  CanUserReorderColumns="False"
									  VirtualizingStackPanel.IsVirtualizing="True"
									  VirtualizingStackPanel.VirtualizationMode="Recycling"
									  ScrollViewer.IsDeferredScrollingEnabled="True">

								<DataGrid.Columns>
									<!-- Cột STT-->
									<DataGridTextColumn Header="STT"
														Binding="{Binding Stt}"
														Width="60"
														HeaderStyle="{StaticResource CenterHeaderStyle}">
										<DataGridTextColumn.ElementStyle>
											<Style TargetType="TextBlock">
												<Setter Property="HorizontalAlignment"
														Value="Center" />
												<Setter Property="VerticalAlignment"
														Value="Center" />
												<Setter Property="FontWeight"
														Value="SemiBold" />
												<Setter Property="Foreground"
														Value="#A3AED0" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}"
																 Value="True">
														<Setter Property="Foreground"
																Value="White" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</DataGridTextColumn.ElementStyle>
									</DataGridTextColumn>
									<!-- Cột tên sách-->
									<DataGridTextColumn Header="Tên đầu sách"
														Binding="{Binding Name}"
														Width="230">
										<DataGridTextColumn.ElementStyle>
											<Style TargetType="TextBlock">
												<Setter Property="VerticalAlignment"
														Value="Center" />
												<Setter Property="TextWrapping"
														Value="Wrap" />
												<Setter Property="FontWeight"
														Value="SemiBold" />
											</Style>
										</DataGridTextColumn.ElementStyle>
									</DataGridTextColumn>

									<!-- Cột Tác Giả -->
									<DataGridTemplateColumn Header="Tác giả"
															Width="130">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<ItemsControl ItemsSource="{Binding DanhSachTacGia}"
															  VerticalAlignment="Center">
													<ItemsControl.ItemsPanel>
														<ItemsPanelTemplate>
															<WrapPanel Orientation="Horizontal"
																	   VerticalAlignment="Center" />
														</ItemsPanelTemplate>
													</ItemsControl.ItemsPanel>
													<ItemsControl.ItemTemplate>
														<DataTemplate>
															<Border Background="#EEF2FF"
																	CornerRadius="6"
																	Padding="6,2"
																	Margin="0,2,4,2">
																<TextBlock Text="{Binding TenTacGia}"
																		   Foreground="#4318FF"
																		   FontSize="11"
																		   FontWeight="SemiBold" />
															</Border>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<!-- Cột Thể Loại -->
									<DataGridTemplateColumn Header="Thể loại"
															Width="180"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<Border CornerRadius="8"
														Padding="10,4"
														HorizontalAlignment="Center"
														VerticalAlignment="Center">
													<Border.Style>
														<Style TargetType="Border">
															<!-- Màu Nền Mặc định (Nếu thể loại không nằm trong danh sách dưới) -->
															<Setter Property="Background"
																	Value="#F3F4F6" />

															<Style.Triggers>
																<!-- Công nghệ thông tin: Tone Xanh dương -->
																<DataTrigger Binding="{Binding TenTheLoai}"
																			 Value="Công nghệ thông tin">
																	<Setter Property="Background"
																			Value="#DBEAFE" />
																</DataTrigger>
																<!-- Văn học nghệ thuật: Tone Hồng -->
																<DataTrigger Binding="{Binding TenTheLoai}"
																			 Value="Văn học nghệ thuật">
																	<Setter Property="Background"
																			Value="#FCE7F3" />
																</DataTrigger>
																<!-- Kinh tế - Quản trị: Tone Xanh ngọc -->
																<DataTrigger Binding="{Binding TenTheLoai}"
																			 Value="Kinh tế - Quản trị">
																	<Setter Property="Background"
																			Value="#D1FAE5" />
																</DataTrigger>
																<!-- Tâm lý - Kỹ năng sống: Tone Tím -->
																<DataTrigger Binding="{Binding TenTheLoai}"
																			 Value="Tâm lý - Kỹ năng sống">
																	<Setter Property="Background"
																			Value="#EDE9FE" />
																</DataTrigger>
																<!-- Truyện tranh: Tone Cam/Vàng -->
																<DataTrigger Binding="{Binding TenTheLoai}"
																			 Value="Truyện tranh">
																	<Setter Property="Background"
																			Value="#FEF3C7" />
																</DataTrigger>
																<!-- Thiếu nhi: Tone Xanh lá nhạt -->
																<DataTrigger Binding="{Binding TenTheLoai}"
																			 Value="Thiếu nhi">
																	<Setter Property="Background"
																			Value="#DCFCE7" />
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</Border.Style>

													<!-- ĐỊNH DẠNG MÀU CHỮ BÊN TRONG -->
													<TextBlock FontSize="12"
															   FontWeight="SemiBold"
															   HorizontalAlignment="Center">
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<!-- Chữ Mặc định (Xám đậm) -->
																<Setter Property="Foreground"
																		Value="#4B5563" />
																<Setter Property="Text"
																		Value="{Binding TenTheLoai}" />
																<Style.Triggers>
																	<!-- Công nghệ thông tin -->
																	<DataTrigger Binding="{Binding TenTheLoai}"
																				 Value="Công nghệ thông tin">
																		<Setter Property="Foreground"
																				Value="#1D4ED8" />
																	</DataTrigger>
																	<!-- Văn học nghệ thuật -->
																	<DataTrigger Binding="{Binding TenTheLoai}"
																				 Value="Văn học nghệ thuật">
																		<Setter Property="Foreground"
																				Value="#BE185D" />
																	</DataTrigger>
																	<!-- Kinh tế - Quản trị -->
																	<DataTrigger Binding="{Binding TenTheLoai}"
																				 Value="Kinh tế - Quản trị">
																		<Setter Property="Foreground"
																				Value="#047857" />
																	</DataTrigger>
																	<!-- Tâm lý - Kỹ năng sống -->
																	<DataTrigger Binding="{Binding TenTheLoai}"
																				 Value="Tâm lý - Kỹ năng sống">
																		<Setter Property="Foreground"
																				Value="#6D28D9" />
																	</DataTrigger>
																	<!-- Truyện tranh -->
																	<DataTrigger Binding="{Binding TenTheLoai}"
																				 Value="Truyện tranh">
																		<Setter Property="Foreground"
																				Value="#B45309" />
																	</DataTrigger>
																	<!-- Thiếu nhi -->
																	<DataTrigger Binding="{Binding TenTheLoai}"
																				 Value="Thiếu nhi">
																		<Setter Property="Foreground"
																				Value="#15803D" />
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<!-- Mô tả-->
									<DataGridTextColumn Header="Mô tả"
														Binding="{Binding MoTa}"
														Width="*">
										<DataGridTextColumn.ElementStyle>
											<Style TargetType="TextBlock">
												<Setter Property="VerticalAlignment"
														Value="Center" />
												<Setter Property="TextWrapping"
														Value="Wrap" />
												<Setter Property="FontWeight"
														Value="SemiBold" />
												<Setter Property="Margin"
														Value="0 10 0 10"></Setter>
											</Style>
										</DataGridTextColumn.ElementStyle>
									</DataGridTextColumn>
									<!-- Cột thao tác-->
									<DataGridTemplateColumn Header="Thao tác"
															Width="100"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<StackPanel Orientation="Horizontal"
															HorizontalAlignment="Center">
													<Button Height="32"
															Width="32"
															Command="{Binding DataContext.EditDauSachCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
															CommandParameter="{Binding}">
														<Button.Style>
															<Style TargetType="Button">
																<Setter Property="Background"
																		Value="#E0E7FF" />
																<Setter Property="Foreground"
																		Value="#4318FF" />

																<Style.Triggers>
																	<Trigger Property="IsMouseOver"
																			 Value="True">
																		<Setter Property="Background"
																				Value="#C7D2FE" />
																		<Setter Property="Foreground"
																				Value="#250AA0" />
																	</Trigger>

																	<Trigger Property="IsPressed"
																			 Value="True">
																		<Setter Property="Background"
																				Value="#A5B4FC" />
																		<Setter Property="Opacity"
																				Value="0.8" />
																	</Trigger>
																</Style.Triggers>
															</Style>
														</Button.Style>
														<materialDesign:PackIcon Kind="Edit" />
														<Button.Template>
															<ControlTemplate TargetType="Button">
																<Border x:Name="border"
																		Background="{TemplateBinding Background}"
																		CornerRadius="6">
																	<materialDesign:PackIcon Kind="Edit"
																							 Width="16"
																							 Height="16"
																							 Foreground="#4318FF"
																							 HorizontalAlignment="Center"
																							 VerticalAlignment="Center" />
																</Border>
															</ControlTemplate>
														</Button.Template>
													</Button>
													<Button Width="32"
															Height="32"
															Command="{Binding DataContext.DeleteDauSachCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
															CommandParameter="{Binding}"
															Background="#FEE2E2"
															Margin="5,0,0,0">
														<Button.Style>
															<Style TargetType="Button">
																<Setter Property="Background"
																		Value="#FEE2E2" />
																<Setter Property="Foreground"
																		Value="#EF4444" />
																<Style.Triggers>
																	<Trigger Property="IsMouseOver"
																			 Value="True">
																		<Setter Property="Background"
																				Value="#FECACA" />
																		<Setter Property="Foreground"
																				Value="#DC2626" />
																	</Trigger>

																	<Trigger Property="IsPressed"
																			 Value="True">
																		<Setter Property="Background"
																				Value="#FCA5A5" />
																		<Setter Property="Opacity"
																				Value="0.8" />
																	</Trigger>
																</Style.Triggers>
															</Style>
														</Button.Style>
														<materialDesign:PackIcon Kind="Delete" />
														<Button.Template>
															<ControlTemplate TargetType="Button">
																<Border x:Name="border"
																		Background="{TemplateBinding Background}"
																		CornerRadius="6">
																	<materialDesign:PackIcon Kind="Delete"
																							 Width="16"
																							 Height="16"
																							 Foreground="#EF4444"
																							 HorizontalAlignment="Center"
																							 VerticalAlignment="Center" />
																</Border>
															</ControlTemplate>
														</Button.Template>
													</Button>
												</StackPanel>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
								</DataGrid.Columns>
							</DataGrid>
						</Border>
					</Grid>
				</TabItem>

				<TabItem Header="TÁC GIẢ"
						 Style="{StaticResource CategoryTabItem}"
						 FontWeight="Bold">
					<Grid Margin="0,15,0,0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<Grid Grid.Row="0"
							  Margin="0,0,0,15">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="300" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Border Style="{StaticResource FilterBorderStyle}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="40" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<materialDesign:PackIcon Kind="Person"
															 Foreground="#A3AED0"
															 VerticalAlignment="Center"
															 HorizontalAlignment="Center" />
									<TextBox Grid.Column="1"
											 Text="{Binding SearchTacGia, UpdateSourceTrigger=PropertyChanged}"
											 materialDesign:HintAssist.Hint="Tìm tác giả..."
											 BorderThickness="0"
											 VerticalAlignment="Center"
											 Background="Transparent"
											 Margin="0 0 10 0"
											 Foreground="Black" />
								</Grid>
							</Border>
							<Button Grid.Column="2"
									Style="{StaticResource MainGradientButton}"
									Width="150"
									Command="{Binding OpenAddTacGiaCommand}"
									CommandParameter="{Binding}"
									Content="+ THÊM TÁC GIẢ" />
						</Grid>
						<Border Grid.Row="1"
								CornerRadius="20"
								Background="White"
								BorderBrush="#E2E8F0"
								BorderThickness="1"
								Padding="20">
							<DataGrid Grid.Row="1"
									  ItemsSource="{Binding FilteredTacGias}"
									  AutoGenerateColumns="False"
									  IsReadOnly="True"
									  Background="White"
									  FontWeight="SemiBold"
									  SelectionMode="Extended"
									  SelectionUnit="FullRow"
									  HeadersVisibility="Column"
									  BorderThickness="0"
									  MinRowHeight="52"
									  FontSize="13"
									  AlternatingRowBackground="#F8FAFC"
									  RowBackground="White"
									  Foreground="#2B3674"
									  GridLinesVisibility="Horizontal"
									  HorizontalGridLinesBrush="#E2E8F0"
									  VerticalGridLinesBrush="Transparent"
									  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
									  ScrollViewer.VerticalScrollBarVisibility="Auto"
									  CanUserAddRows="False"
									  CanUserDeleteRows="False"
									  CanUserResizeColumns="False"
									  CanUserResizeRows="False"
									  CanUserReorderColumns="False"
									  VirtualizingStackPanel.IsVirtualizing="True"
									  VirtualizingStackPanel.VirtualizationMode="Recycling"
									  ScrollViewer.IsDeferredScrollingEnabled="True">

								<DataGrid.Columns>
									<!-- Cột STT-->
									<DataGridTextColumn Header="STT"
														Binding="{Binding Stt}"
														Width="60"
														HeaderStyle="{StaticResource CenterHeaderStyle}">
										<DataGridTextColumn.ElementStyle>
											<Style TargetType="TextBlock">
												<Setter Property="HorizontalAlignment"
														Value="Center" />
												<Setter Property="VerticalAlignment"
														Value="Center" />
												<Setter Property="FontWeight"
														Value="SemiBold" />
												<Setter Property="Foreground"
														Value="#A3AED0" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}"
																 Value="True">
														<Setter Property="Foreground"
																Value="White" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</DataGridTextColumn.ElementStyle>
									</DataGridTextColumn>
									<!-- Cột tên tác giả-->
									<DataGridTextColumn Header="Tên tác giả"
														Binding="{Binding Name}"
														Width="*">
										<DataGridTextColumn.ElementStyle>
											<Style TargetType="TextBlock">
												<Setter Property="VerticalAlignment"
														Value="Center" />
												<Setter Property="TextWrapping"
														Value="Wrap" />
												<Setter Property="FontWeight"
														Value="SemiBold" />
											</Style>
										</DataGridTextColumn.ElementStyle>
									</DataGridTextColumn>
									<!-- Cột thao tác-->
									<DataGridTemplateColumn Header="Thao tác"
															Width="100"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<StackPanel Orientation="Horizontal"
															HorizontalAlignment="Center">
													<Button Width="32"
															Height="32"
															Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
															CommandParameter="{Binding}">
														<Button.Style>
															<Style TargetType="Button">
																<Setter Property="Background"
																		Value="#E0E7FF" />
																<Setter Property="Foreground"
																		Value="#4318FF" />

																<Style.Triggers>
																	<Trigger Property="IsMouseOver"
																			 Value="True">
																		<Setter Property="Background"
																				Value="#C7D2FE" />
																		<Setter Property="Foreground"
																				Value="#250AA0" />
																	</Trigger>

																	<Trigger Property="IsPressed"
																			 Value="True">
																		<Setter Property="Background"
																				Value="#A5B4FC" />
																		<Setter Property="Opacity"
																				Value="0.8" />
																	</Trigger>
																</Style.Triggers>
															</Style>
														</Button.Style>
														<materialDesign:PackIcon Kind="Edit" />
														<Button.Template>
															<ControlTemplate TargetType="Button">
																<Border x:Name="border"
																		Background="{TemplateBinding Background}"
																		CornerRadius="6">
																	<materialDesign:PackIcon Kind="Edit"
																							 Width="15"
																							 Height="15"
																							 Foreground="#4318FF"
																							 HorizontalAlignment="Center"
																							 VerticalAlignment="Center" />
																</Border>
															</ControlTemplate>
														</Button.Template>
													</Button>
													<Button Width="32"
															Height="32"
															Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
															CommandParameter="{Binding}"
															Background="#FEE2E2"
															Margin="5,0,0,0">
														<Button.Style>
															<Style TargetType="Button">
																<Setter Property="Background"
																		Value="#FEE2E2" />
																<Setter Property="Foreground"
																		Value="#EF4444" />
																<Style.Triggers>
																	<Trigger Property="IsMouseOver"
																			 Value="True">
																		<Setter Property="Background"
																				Value="#FECACA" />
																		<Setter Property="Foreground"
																				Value="#DC2626" />
																	</Trigger>

																	<Trigger Property="IsPressed"
																			 Value="True">
																		<Setter Property="Background"
																				Value="#FCA5A5" />
																		<Setter Property="Opacity"
																				Value="0.8" />
																	</Trigger>
																</Style.Triggers>
															</Style>
														</Button.Style>
														<materialDesign:PackIcon Kind="Delete"
																				 Foreground="Red" />
														<Button.Template>
															<ControlTemplate TargetType="Button">
																<Border x:Name="border"
																		Background="{TemplateBinding Background}"
																		CornerRadius="6">
																	<materialDesign:PackIcon Kind="Delete"
																							 Width="15"
																							 Height="15"
																							 Foreground="#EF4444"
																							 HorizontalAlignment="Center"
																							 VerticalAlignment="Center" />
																</Border>
															</ControlTemplate>
														</Button.Template>
													</Button>
												</StackPanel>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
								</DataGrid.Columns>
							</DataGrid>
						</Border>
					</Grid>
				</TabItem>

				<TabItem Header="THỂ LOẠI"
						 Style="{StaticResource CategoryTabItem}"
						 FontWeight="Bold">
					<Grid Margin="0,15,0,0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<Grid Grid.Row="0"
							  Margin="0,0,0,15">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="300" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Border Style="{StaticResource FilterBorderStyle}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="40" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
