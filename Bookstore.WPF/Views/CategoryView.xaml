											Padding="10"
											Height="75">
										<TextBox Text="{Binding EditingDauSach.MoTa, UpdateSourceTrigger=PropertyChanged}"
												 materialDesign:HintAssist.Hint="Viết tóm tắt/mô tả..."
												 TextWrapping="Wrap"
												 AcceptsReturn="True"
												 VerticalScrollBarVisibility="Auto"
												 BorderThickness="0"
												 Background="Transparent"
												 VerticalAlignment="Top" />
									</Border>
								</StackPanel>
							</StackPanel>
						</Grid>

						<StackPanel Orientation="Horizontal"
									HorizontalAlignment="Right"
									Margin="0,10,0,0">
							<Button Content="HỦY"
									Command="{Binding CloseDauSachPopupCommand}"
									CommandParameter="{Binding}"
									Style="{StaticResource OutlineButtonStyle}"
									Width="100"
									Margin="0,0,10,0" />
							<Button Content="LƯU ĐẦU SÁCH"
									Command="{Binding SaveDauSachCommand}"
									CommandParameter="{Binding}"
									Style="{StaticResource MainGradientButton}"
									Width="150" />
						</StackPanel>
					</StackPanel>
				</Border>
			</Grid>
		</Grid>

	</Grid>
</UserControl>