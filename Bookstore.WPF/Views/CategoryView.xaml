<UserControl x:Class="Bookstore.WPF.Views.CategoryView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 mc:Ignorable="d">
	
	<Grid>
		<Grid x:Name="MainCategoryView"
			  Margin="{StaticResource MainViewMargin}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<components:PageHeaderControl Title="QUẢN LÝ DANH MỤC"
										  HeaderIcon="CategoryPlus"
										  ShowAddButton="False"
                                          
                                          ShowExportExcel="True"
                                          ExportExcelCommand="{Binding ExportExcelCommand}"
                                          ExportExcelCommandParameter="{Binding}"/>

			<TabControl Grid.Row="1"
						Style="{StaticResource TabControlStyle}">
				<TabItem Header="ĐẦU SÁCH">
					<Grid Margin="0,15,0,0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>


						<Grid Grid.Row="0"
							  Margin="0,0,0,15">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="300" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>


							<components:FilterInputControl Grid.Column="0"
														   IconKind="Book"
														   HintText="Tìm đầu sách..."
														   TextValue="{Binding SearchDauSach}" />
							<Button Grid.Column="2"
									Style="{StaticResource MainGradientButton}"
									Width="150"
									Command="{Binding OpenAddDauSachCommand}"
									CommandParameter="{Binding}"
									Content="+ THÊM ĐẦU SÁCH" />
						</Grid>
						<Border Grid.Row="1"
								Style="{StaticResource DataGridCardStyle}">
							<DataGrid Grid.Row="1"
									  ItemsSource="{Binding FilteredDauSachs}"
									  Style="{StaticResource CleanDataGrid}">
								<DataGrid.Columns>
									<!-- Cột STT-->
									<DataGridTextColumn Header="STT"
														Binding="{Binding Stt}"
														Width="50"
														HeaderStyle="{StaticResource CenterHeaderStyle}"
														ElementStyle="{StaticResource CellText}" />
									<!-- Cột tên sách-->
									<DataGridTextColumn Header="Tên đầu sách"
														Binding="{Binding Name}"
														HeaderStyle="{StaticResource LeftHeaderStyle}"
														ElementStyle="{StaticResource CellName}"
														Width="230" />

									<!-- Cột Tác Giả -->
									<DataGridTemplateColumn Header="Tác giả"
															Width="130">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<ItemsControl ItemsSource="{Binding DanhSachTacGia}"
															  VerticalAlignment="Center">
													<ItemsControl.ItemsPanel>
														<ItemsPanelTemplate>
															<WrapPanel Orientation="Horizontal"
																	   VerticalAlignment="Center" />
														</ItemsPanelTemplate>
													</ItemsControl.ItemsPanel>
													<ItemsControl.ItemTemplate>
														<DataTemplate>
															<Border Background="#EEF2FF"
																	CornerRadius="6"
																	Padding="6,2"
																	Margin="0,2,4,2">
																<TextBlock Text="{Binding TenTacGia}"
																		   Foreground="#4318FF"
																		   FontSize="11"
																		   FontWeight="SemiBold" />
															</Border>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<!-- Cột Thể Loại -->
									<DataGridTemplateColumn Header="Thể loại"
															Width="180"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<Border CornerRadius="8"
														Padding="10,4"
														HorizontalAlignment="Center"
														VerticalAlignment="Center">
													<Border.Style>
														<Style TargetType="Border">
															<!-- Màu Nền Mặc định (Nếu thể loại không nằm trong danh sách dưới) -->
															<Setter Property="Background"
																	Value="#F3F4F6" />

															<Style.Triggers>
																<!-- Công nghệ thông tin: Tone Xanh dương -->
																<DataTrigger Binding="{Binding TenTheLoai}"
																			 Value="Công nghệ thông tin">
																	<Setter Property="Background"
																			Value="#DBEAFE" />
																</DataTrigger>
																<!-- Văn học nghệ thuật: Tone Hồng -->
																<DataTrigger Binding="{Binding TenTheLoai}"
																			 Value="Văn học nghệ thuật">
																	<Setter Property="Background"
																			Value="#FCE7F3" />
																</DataTrigger>
																<!-- Kinh tế - Quản trị: Tone Xanh ngọc -->
																<DataTrigger Binding="{Binding TenTheLoai}"
																			 Value="Kinh tế - Quản trị">
																	<Setter Property="Background"
																			Value="#D1FAE5" />
																</DataTrigger>
																<!-- Tâm lý - Kỹ năng sống: Tone Tím -->
																<DataTrigger Binding="{Binding TenTheLoai}"
																			 Value="Tâm lý - Kỹ năng sống">
																	<Setter Property="Background"
																			Value="#EDE9FE" />
																</DataTrigger>
																<!-- Truyện tranh: Tone Cam/Vàng -->
																<DataTrigger Binding="{Binding TenTheLoai}"
																			 Value="Truyện tranh">
																	<Setter Property="Background"
																			Value="#FEF3C7" />
																</DataTrigger>
																<!-- Thiếu nhi: Tone Xanh lá nhạt -->
																<DataTrigger Binding="{Binding TenTheLoai}"
																			 Value="Thiếu nhi">
																	<Setter Property="Background"
																			Value="#DCFCE7" />
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</Border.Style>

													<!-- ĐỊNH DẠNG MÀU CHỮ BÊN TRONG -->
													<TextBlock FontSize="12"
															   FontWeight="SemiBold"
															   HorizontalAlignment="Center">
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<!-- Chữ Mặc định (Xám đậm) -->
																<Setter Property="Foreground"
																		Value="#4B5563" />
																<Setter Property="Text"
																		Value="{Binding TenTheLoai}" />
																<Style.Triggers>
																	<!-- Công nghệ thông tin -->
																	<DataTrigger Binding="{Binding TenTheLoai}"
																				 Value="Công nghệ thông tin">
																		<Setter Property="Foreground"
																				Value="#1D4ED8" />
																	</DataTrigger>
																	<!-- Văn học nghệ thuật -->
																	<DataTrigger Binding="{Binding TenTheLoai}"
																				 Value="Văn học nghệ thuật">
																		<Setter Property="Foreground"
																				Value="#BE185D" />
																	</DataTrigger>
																	<!-- Kinh tế - Quản trị -->
																	<DataTrigger Binding="{Binding TenTheLoai}"
																				 Value="Kinh tế - Quản trị">
																		<Setter Property="Foreground"
																				Value="#047857" />
																	</DataTrigger>
																	<!-- Tâm lý - Kỹ năng sống -->
																	<DataTrigger Binding="{Binding TenTheLoai}"
																				 Value="Tâm lý - Kỹ năng sống">
																		<Setter Property="Foreground"
																				Value="#6D28D9" />
																	</DataTrigger>
																	<!-- Truyện tranh -->
																	<DataTrigger Binding="{Binding TenTheLoai}"
																				 Value="Truyện tranh">
																		<Setter Property="Foreground"
																				Value="#B45309" />
																	</DataTrigger>
																	<!-- Thiếu nhi -->
																	<DataTrigger Binding="{Binding TenTheLoai}"
																				 Value="Thiếu nhi">
																		<Setter Property="Foreground"
																				Value="#15803D" />
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<!-- Mô tả-->
									<DataGridTextColumn Header="Mô tả"
														Binding="{Binding MoTa}"
														HeaderStyle="{StaticResource LeftHeaderStyle}"
														ElementStyle="{StaticResource CellLeft}"
														Width="*" />
									<!-- Cột thao tác-->
									<DataGridTemplateColumn Header="Thao tác"
															Width="100"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<components:DataGridActionPanel RowItem="{Binding}"
																				ShowEdit="True"
																				EditCommand="{Binding DataContext.EditDauSachCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																				ShowDelete="True"
																				DeleteCommand="{Binding DataContext.DeleteDauSachCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
								</DataGrid.Columns>
							</DataGrid>
						</Border>
					</Grid>
				</TabItem>

				<TabItem Header="TÁC GIẢ">
					<Grid Margin="0,15,0,0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<Grid Grid.Row="0"
							  Margin="0,0,0,15">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="300" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<components:FilterInputControl Grid.Column="0"
														   IconKind="Person"
														   HintText="Tìm tác giả..."
														   TextValue="{Binding SearchTacGia}" />

							<Button Grid.Column="2"
									Style="{StaticResource MainGradientButton}"
									Width="150"
									Command="{Binding OpenAddTacGiaCommand}"
									CommandParameter="{Binding}"
									Content="+ THÊM TÁC GIẢ" />
						</Grid>
						<Border Grid.Row="1"
								Style="{StaticResource DataGridCardStyle}">
							<DataGrid Grid.Row="1"
									  ItemsSource="{Binding FilteredTacGias}"
									  Style="{StaticResource CleanDataGrid}">

								<DataGrid.Columns>
									<!-- Cột STT-->
									<DataGridTextColumn Header="STT"
														Binding="{Binding Stt}"
														Width="50"
														HeaderStyle="{StaticResource CenterHeaderStyle}"
														ElementStyle="{StaticResource CellText}" />
									<!-- Cột tên tác giả-->
									<DataGridTextColumn Header="Tên tác giả"
														Binding="{Binding Name}"
														HeaderStyle="{StaticResource LeftHeaderStyle}"
														ElementStyle="{StaticResource CellName}"
														Width="*" />
									<!-- Cột thao tác-->
									<DataGridTemplateColumn Header="Thao tác"
															Width="100"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<components:DataGridActionPanel RowItem="{Binding}"
																				ShowEdit="True"
																				EditCommand="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																				ShowDelete="True"
																				DeleteCommand="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
								</DataGrid.Columns>
							</DataGrid>
						</Border>
					</Grid>
				</TabItem>

				<TabItem Header="THỂ LOẠI">
					<Grid Margin="0,15,0,0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<Grid Grid.Row="0"
							  Margin="0,0,0,15">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="300" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<components:FilterInputControl Grid.Column="0"
														   IconKind="Tag"
														   HintText="Tìm thể loại..."
														   TextValue="{Binding SearchTheLoai}" />
							<Button Grid.Column="2"
									Style="{StaticResource MainGradientButton}"
									Width="150"
									Command="{Binding OpenAddTheLoaiCommand}"
									CommandParameter="{Binding}"
									Content="+ THÊM THỂ LOẠI" />
						</Grid>
						<Border Grid.Row="1"
								Style="{StaticResource DataGridCardStyle}">
							<DataGrid Grid.Row="1"
									  ItemsSource="{Binding FilteredTheLoais}"
									  Style="{StaticResource CleanDataGrid}">
								<DataGrid.Columns>
									<DataGridTextColumn Header="STT"
														Binding="{Binding Stt}"
														Width="50"
														HeaderStyle="{StaticResource CenterHeaderStyle}"
														ElementStyle="{StaticResource CellText}" />
									<!-- Cột tên tác giả-->
									<DataGridTextColumn Header="Tên thể loại"
														Binding="{Binding Name}"
														HeaderStyle="{StaticResource LeftHeaderStyle}"
														ElementStyle="{StaticResource CellName}"
														Width="*" />
									<!-- Cột thao tác-->
									<DataGridTemplateColumn Header="Thao tác"
															Width="100"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<components:DataGridActionPanel RowItem="{Binding}"
																				ShowEdit="True"
																				EditCommand="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																				ShowDelete="True"
																				DeleteCommand="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
								</DataGrid.Columns>
							</DataGrid>
						</Border>
					</Grid>
				</TabItem>

				<TabItem Header="NHÀ XUẤT BẢN">
					<Grid Margin="0,15,0,0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<Grid Grid.Row="0"
							  Margin="0,0,0,15">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="300" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<components:FilterInputControl Grid.Column="0"
														   IconKind="Building"
														   HintText="Tìm Nhà xuất bản..."
														   TextValue="{Binding SearchNXB}" />
							<Button Grid.Column="2"
									Style="{StaticResource MainGradientButton}"
									Width="200"
									Command="{Binding OpenAddNXBCommand}"
									CommandParameter="{Binding}"
									Content="+ THÊM NHÀ XUẤT BẢN"
									FontWeight="SemiBold" />
						</Grid>
						<Border Grid.Row="1"
								Style="{StaticResource DataGridCardStyle}">
							<DataGrid Grid.Row="1"
									  ItemsSource="{Binding FilteredNXBs}"
									  Style="{StaticResource CleanDataGrid}">

								<DataGrid.Columns>
									<DataGridTextColumn Header="STT"
														Binding="{Binding Stt}"
														Width="50"
														HeaderStyle="{StaticResource CenterHeaderStyle}"
														ElementStyle="{StaticResource CellText}" />
									<!-- Cột tên tác giả-->
									<DataGridTextColumn Header="Tên Nhà xuất bản"
														Binding="{Binding Name}"
														HeaderStyle="{StaticResource LeftHeaderStyle}"
														ElementStyle="{StaticResource CellName}"
														Width="*" />
									<!-- Cột thao tác-->
									<DataGridTemplateColumn Header="Thao tác"
															Width="100"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<components:DataGridActionPanel RowItem="{Binding}"
																				ShowEdit="True"
																				EditCommand="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																				ShowDelete="True"
																				DeleteCommand="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
								</DataGrid.Columns>
							</DataGrid>
						</Border>
					</Grid>
				</TabItem>

			</TabControl>

			<Grid Grid.RowSpan="2"
				  Panel.ZIndex="1000"
				  Visibility="{Binding IsPopupVisible}"
				  Background="#80000000">
				<Border Width="380"
						Height="180"
						Background="White"
						CornerRadius="16"
						VerticalAlignment="Center"
						Padding="25">
					<StackPanel>
						<TextBlock Text="{Binding PopupTitle}"
								   FontSize="18"
								   FontWeight="Bold"
								   Margin="0,0,0,15" />
						<TextBox Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
								 materialDesign:HintAssist.Hint="Nhập tên..."
								 Margin="0,0,0,25"
								 FontWeight="SemiBold" />
						<StackPanel Orientation="Horizontal"
									HorizontalAlignment="Right">
							<Button Content="HỦY"
									Command="{Binding ClosePopupCommand}"
									CommandParameter="{Binding}"
									Style="{StaticResource OutlineButtonStyle}"
									Width="80"
									Margin="0,0,10,0" />
							<Button Content="LƯU"
									Command="{Binding SaveCommand}"
									CommandParameter="{Binding}"
									Style="{StaticResource MainGradientButton}"
									Width="100" />
						</StackPanel>
					</StackPanel>
				</Border>
			</Grid>

			<Grid Grid.RowSpan="2"
				  Panel.ZIndex="1001"
				  Visibility="{Binding IsDauSachPopupVisible}"
				  Background="#80000000">
				<Border Width="700"
						Background="White"
						CornerRadius="16"
						VerticalAlignment="Center"
						Padding="30">
					<StackPanel>
						<TextBlock Text="{Binding DauSachPopupTitle}"
								   FontSize="22"
								   FontWeight="Bold"
								   Margin="0,0,0,20"
								   Foreground="#2B3674" />

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="200" />
								<ColumnDefinition Width="20" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0"
										VerticalAlignment="Center">
								<Border Width="200"
										Height="250"
										BorderBrush="#E2E8F0"
										BorderThickness="1.5"
										CornerRadius="8"
										Background="#F8FAFC"
										ClipToBounds="True">
									<Border.InputBindings>
										<MouseBinding MouseAction="LeftClick"
													  Command="{Binding SelectImageCommand}"
													  CommandParameter="{Binding}" />
									</Border.InputBindings>
									<Grid>
										<Image Source="{Binding EditingDauSach.ImageUrl}"
											   Stretch="UniformToFill"
											   HorizontalAlignment="Center" />
										<Border Background="#99000000"
												VerticalAlignment="Bottom"
												Height="30">
											<TextBlock Text="Đổi ảnh"
													   Foreground="White"
													   FontSize="11"
													   HorizontalAlignment="Center"
													   VerticalAlignment="Center"
													   FontWeight="SemiBold" />
										</Border>
									</Grid>
								</Border>
							</StackPanel>

							<StackPanel Grid.Column="2">
								<Grid Margin="0,0,0,15">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="15" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>

									<StackPanel Grid.Column="0">
										<TextBlock Text="Tên đầu sách *"
												   FontWeight="SemiBold"
												   Foreground="#A3AED0"
												   Margin="0,0,0,5">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Foreground"
															Value="#A3AED0" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding EditingDauSach.Name, TargetNullValue=''}"
																	 Value="">
															<Setter Property="Foreground"
																	Value="#EF4444" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
										<Border CornerRadius="8"
												BorderBrush="#E2E8F0"
												BorderThickness="1"
												Background="#F8FAFC"
												Height="42"
												Padding="10,0">
											<TextBox Text="{Binding EditingDauSach.Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
													 materialDesign:HintAssist.Hint="Nhập tên..."
													 BorderThickness="0"
													 Background="Transparent"
													 VerticalAlignment="Center" />
										</Border>
									</StackPanel>

									<StackPanel Grid.Column="2">
										<TextBlock Text="Thể loại *"
												   FontWeight="SemiBold"
												   Foreground="#A3AED0"
												   Margin="0,0,0,5">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Foreground"
															Value="#A3AED0" />
													<Style.Triggers>
														<DataTrigger Binding="{Binding EditingDauSach.TenTheLoai, TargetNullValue=''}"
																	 Value="">
															<Setter Property="Foreground"
																	Value="#EF4444" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
										<Border CornerRadius="8"
												BorderBrush="#E2E8F0"
												BorderThickness="1"
												Background="#F8FAFC"
												Height="42"
												Padding="10,0">
											<ComboBox ItemsSource="{Binding ListTheLoai}"
													  SelectedItem="{Binding EditingDauSach.TenTheLoai, Mode=TwoWay}"
													  materialDesign:HintAssist.Hint="Chọn thể loại..."
													  BorderThickness="0"
													  Background="Transparent"
													  VerticalAlignment="Center" />
										</Border>
									</StackPanel>
								</Grid>

								<StackPanel Margin="0,0,0,15">
									<TextBlock Text="Tác giả *"
											   FontWeight="SemiBold"
											   Foreground="#A3AED0"
											   Margin="0,0,0,5">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Setter Property="Foreground"
														Value="#A3AED0" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding EditingBook.DanhSachTacGia.Count, TargetNullValue=0}"
																 Value="0">
														<Setter Property="Foreground"
																Value="#EF4444" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
									<Border CornerRadius="8"
											BorderBrush="#E2E8F0"
											BorderThickness="1"
											Background="#F8FAFC"
											Height="42"
											Padding="10,0">
										<ComboBox ItemsSource="{Binding ListTatCaTacGia}"
												  DisplayMemberPath="TenTacGia"
												  SelectedItem="{Binding SelectedTacGiaToAdd}"
												  materialDesign:HintAssist.Hint="Nhấn vào đây để chọn tác giả..."
												  BorderThickness="0"
												  Background="Transparent"
												  VerticalAlignment="Center" />
									</Border>

									<ItemsControl ItemsSource="{Binding EditingDauSach.DanhSachTacGia}"
												  Margin="0,10,0,0">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<WrapPanel Orientation="Horizontal" />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border Background="#EEF2FF"
														CornerRadius="15"
														Padding="10,5"
														Margin="0,0,8,8">
													<StackPanel Orientation="Horizontal">
														<TextBlock Text="{Binding TenTacGia}"
																   Foreground="#4318FF"
																   FontWeight="SemiBold"
																   VerticalAlignment="Center" />
														<Button Command="{Binding DataContext.RemoveTacGiaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																CommandParameter="{Binding}"
																Background="Transparent"
																BorderThickness="0"
																Padding="0"
																Width="18"
																Height="18"
																Margin="5,0,0,0">
															<materialDesign:PackIcon Kind="Close"
																					 Width="14"
																					 Height="14"
																					 Foreground="#EF4444"
																					 VerticalAlignment="Center" />
														</Button>
													</StackPanel>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>

								<StackPanel Margin="0,0,0,20">
									<TextBlock Text="Mô tả nội dung"
											   FontWeight="SemiBold"
											   Foreground="#A3AED0"
											   Margin="0,0,0,5" />
									<Border CornerRadius="8"
											BorderBrush="#E2E8F0"
											BorderThickness="1"
											Background="#F8FAFC"
											Padding="10"
											Height="75">
										<TextBox Text="{Binding EditingDauSach.MoTa, UpdateSourceTrigger=PropertyChanged}"
												 materialDesign:HintAssist.Hint="Viết tóm tắt/mô tả..."
												 TextWrapping="Wrap"
												 AcceptsReturn="True"
												 VerticalScrollBarVisibility="Auto"
												 BorderThickness="0"
												 Background="Transparent"
												 VerticalAlignment="Top" />
									</Border>
								</StackPanel>
							</StackPanel>
						</Grid>

						<StackPanel Orientation="Horizontal"
									HorizontalAlignment="Right"
									Margin="0,10,0,0">
							<Button Content="HỦY"
									Command="{Binding CloseDauSachPopupCommand}"
									CommandParameter="{Binding}"
									Style="{StaticResource OutlineButtonStyle}"
									Width="100"
									Margin="0,0,10,0" />
							<Button Content="LƯU ĐẦU SÁCH"
									Command="{Binding SaveDauSachCommand}"
									CommandParameter="{Binding}"
									Style="{StaticResource MainGradientButton}"
									Width="150" />
						</StackPanel>
					</StackPanel>
				</Border>
			</Grid>
		</Grid>
	</Grid>
</UserControl>