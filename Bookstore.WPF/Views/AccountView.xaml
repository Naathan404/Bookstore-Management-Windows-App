<UserControl x:Class="Bookstore.WPF.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F4F7FE">

    <UserControl.Resources>

        <LinearGradientBrush x:Key="GradientButtonBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4318FF" Offset="0"/>
            <GradientStop Color="#5B3CFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- MAIN BUTTON -->
        <Style x:Key="MainGradientButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource GradientButtonBrush}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ICON BUTTON -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="#F4F7FE">

        <!-- BACKGROUND DECORATIONS -->
        <Ellipse Width="400" Height="400" Fill="#4318FF" Opacity="0.03"
                 VerticalAlignment="Top" HorizontalAlignment="Left" Margin="-150,-150,0,0"/>
        <Ellipse Width="300" Height="300" Fill="#2B3674" Opacity="0.03"
                 VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,-100,-100"/>

        <!-- MAIN LAYOUT -->
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="330"/>
                <RowDefinition Height="90"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== HEADER ==================== -->
            <Border Grid.Row="0" Margin="0,0,0,12" Padding="20"
                    CornerRadius="16" Background="White"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountGroup" Width="28" Height="28"
                                                 Foreground="#4318FF" Margin="0,0,10,0"/>
                        <TextBlock Text="QUẢN LÝ TÀI KHOẢN" FontSize="24"
                                   FontWeight="Bold" Foreground="#2B3674"/>
                    </StackPanel>

                    <Button Grid.Column="1" Width="190" Height="30"
                            Style="{StaticResource MainGradientButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16"
                                                     Margin="0,0,6,0" Foreground="White"/>
                            <TextBlock Text="THÊM TÀI KHOẢN"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ==================== PROFILE ==================== -->
            <Border Grid.Row="1" Margin="0,0,0,10" Padding="24"
                    CornerRadius="20" Background="White"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Avatar + Name + Role + Password button -->
                    <StackPanel Grid.Column="0">
                        <Border Width="110" Height="110" CornerRadius="55"
                                Background="#EEF2FF" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="AccountCircle" Width="60" Height="60"
                                                     Foreground="#4318FF"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <TextBlock Text="{Binding CurrentUser.HoTen}" FontSize="28"
                                       FontWeight="Bold" Foreground="#2B3674"/>
                            <Button Margin="10,0,0,0" Background="#E0E7FF"
                                    Style="{StaticResource IconButtonStyle}">
                                <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14" Foreground="#4318FF"/>
                            </Button>
                        </StackPanel>

                        <Border Background="#DCFCE7" CornerRadius="10" Padding="14,6"
                                Margin="0,14,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUser.ChucVu}"
                                       Foreground="#15803D" FontWeight="SemiBold"/>
                        </Border>

                        <Button Margin="0,18,0,0" Height="34" Width="180"
                                HorizontalAlignment="Center"
                                Style="{StaticResource MainGradientButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="LockReset" Width="14" Height="14"
                                                         Margin="0,0,5,0" Foreground="White"/>
                                <TextBlock Text="ĐỔI MẬT KHẨU" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- RIGHT: Info fields -->
                    <ScrollViewer Grid.Column="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">

                            <!-- Reusable field template (Họ tên / Giới tính / SĐT / Email / Username / Mật khẩu / Chức vụ) -->

                            <!-- HỌ VÀ TÊN -->
                            <Border Height="58" Margin="0,0,0,12" Background="#F8FAFC"
                                    CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#06B6D4" CornerRadius="3"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Họ và tên" FontSize="11" Foreground="#A3AED0"/>
                                        <TextBlock Text="{Binding CurrentUser.HoTen}" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="#2B3674"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- GIỚI TÍNH -->
                            <Border Height="58" Margin="0,0,0,12" Background="#F8FAFC"
                                    CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#EC4899" CornerRadius="3"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Giới tính" FontSize="11" Foreground="#A3AED0"/>
                                        <TextBlock Text="{Binding CurrentUser.GioiTinh}" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="#2B3674"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- SỐ ĐIỆN THOẠI -->
                            <Border Height="58" Margin="0,0,0,12" Background="#F8FAFC"
                                    CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#8B5CF6" CornerRadius="3"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Số điện thoại" FontSize="11" Foreground="#A3AED0"/>
                                        <TextBlock Text="{Binding CurrentUser.SoDienThoai}" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="#2B3674"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- EMAIL -->
                            <Border Height="58" Margin="0,0,0,12" Background="#F8FAFC"
                                    CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#EF4444" CornerRadius="3"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Gmail" FontSize="11" Foreground="#A3AED0"/>
                                        <TextBlock Text="{Binding CurrentUser.Email}" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="#2B3674"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- TÊN ĐĂNG NHẬP -->
                            <Border Height="58" Margin="0,0,0,12" Background="#F8FAFC"
                                    CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#10B981" CornerRadius="3"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Tên đăng nhập" FontSize="11" Foreground="#A3AED0"/>
                                        <TextBlock Text="{Binding CurrentUser.TenDangNhap}" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="#2B3674"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- MẬT KHẨU -->
                            <Border Height="58" Margin="0,0,0,12" Background="#F8FAFC"
                                    CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#F59E0B" CornerRadius="3"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Mật khẩu" FontSize="11" Foreground="#A3AED0"/>
                                        <TextBlock Text="••••••••" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="#2B3674"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- CHỨC VỤ -->
                            <Border Height="58" Margin="0,0,0,12" Background="#F8FAFC"
                                    CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#14B8A6" CornerRadius="3"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Chức vụ" FontSize="11" Foreground="#A3AED0"/>
                                        <TextBlock Text="{Binding CurrentUser.ChucVu}" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="#2B3674"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Border>

            <!-- ==================== SEARCH ==================== -->
            <Border Grid.Row="2" Margin="0,0,0,12" Padding="20"
                    CornerRadius="16" Background="White"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <!-- SEARCH BOX -->
                    <Border Grid.Column="0" Background="#F8FAFC"
                            CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18"
                                                     Margin="12,0,6,0" Foreground="#A3AED0"
                                                     VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent"
                                     FontSize="13" Text="{Binding SearchKeyword}"
                                     VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- TÌM THEO -->
                    <ComboBox Grid.Column="2" Height="42" FontSize="13" FontWeight="SemiBold"
                              Foreground="#2B3674" BorderBrush="#E2E8F0" BorderThickness="1"
                              Background="White" materialDesign:HintAssist.Hint="Tìm theo">
                        <ComboBoxItem>
                            <Border Background="#E0E7FF" CornerRadius="8" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#4318FF" Margin="0,0,6,0"/>
                                    <TextBlock Text="Tên đăng nhập" Foreground="#4318FF"/>
                                </StackPanel>
                            </Border>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <Border Background="#CFFAFE" CornerRadius="8" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#0891B2" Margin="0,0,6,0"/>
                                    <TextBlock Text="Họ tên" Foreground="#0891B2"/>
                                </StackPanel>
                            </Border>
                        </ComboBoxItem>
                    </ComboBox>

                    <!-- NHÓM QUYỀN FILTER -->
                    <ComboBox Grid.Column="4" Height="42" FontSize="13" FontWeight="SemiBold"
                              SelectedItem="{Binding SelectedRole}"
                              BorderBrush="#E2E8F0" BorderThickness="1" Background="White"
                              materialDesign:HintAssist.Hint="Nhóm quyền">
                        <ComboBoxItem>
                            <Border Background="#E2E8F0" CornerRadius="8" Padding="10,4">
                                <TextBlock Text="Tất cả" Foreground="#475569"/>
                            </Border>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <Border Background="#FEE2E2" CornerRadius="8" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#DC2626" Margin="0,0,6,0"/>
                                    <TextBlock Text="Admin" Foreground="#DC2626"/>
                                </StackPanel>
                            </Border>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <Border Background="#DBEAFE" CornerRadius="8" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#2563EB" Margin="0,0,6,0"/>
                                    <TextBlock Text="Quản lý" Foreground="#2563EB"/>
                                </StackPanel>
                            </Border>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <Border Background="#DCFCE7" CornerRadius="8" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#16A34A" Margin="0,0,6,0"/>
                                    <TextBlock Text="Nhân viên" Foreground="#16A34A"/>
                                </StackPanel>
                            </Border>
                        </ComboBoxItem>
                    </ComboBox>

                </Grid>
            </Border>

            <!-- ==================== DATAGRID ==================== -->
            <Border Grid.Row="3" CornerRadius="20" Background="White"
                    BorderBrush="#E2E8F0" BorderThickness="1" Padding="16">
                <DataGrid ItemsSource="{Binding Accounts}"
                          AutoGenerateColumns="False"
                          Height="260"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          RowHeight="52"
                          BorderThickness="0"
                          CanUserResizeColumns="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False"
                          CanUserResizeRows="False"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ScrollViewer.CanContentScroll="False"
                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                          ScrollViewer.HorizontalScrollBarVisibility="Visible">
                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Họ và tên"      Binding="{Binding HoTen}"        Width="230"/>
                        <DataGridTextColumn Header="Giới tính"      Binding="{Binding GioiTinh}"     Width="120"/>
                        <DataGridTextColumn Header="Số điện thoại"  Binding="{Binding SoDienThoai}"  Width="170"/>
                        <DataGridTextColumn Header="Gmail"           Binding="{Binding Email}"        Width="260"/>
                        <DataGridTextColumn Header="Tên đăng nhập"  Binding="{Binding TenDangNhap}"  Width="220"/>

                        <!-- MẬT KHẨU -->
                        <DataGridTemplateColumn Header="Mật khẩu" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="••••••••" FontWeight="SemiBold"
                                               Foreground="#2B3674" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Chức vụ" Binding="{Binding ChucVu}" Width="160"/>

                        <!-- NHÓM QUYỀN -->
                        <DataGridTemplateColumn Header="Nhóm quyền" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="10,4" CornerRadius="8" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NhomNguoiDung}" Value="Admin">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NhomNguoiDung}" Value="Quản lý">
                                                        <Setter Property="Background" Value="#DBEAFE"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding NhomNguoiDung}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NhomNguoiDung}" Value="Admin">
                                                            <Setter Property="Foreground" Value="#DC2626"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding NhomNguoiDung}" Value="Quản lý">
                                                            <Setter Property="Foreground" Value="#2563EB"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- TRẠNG THÁI -->
                        <DataGridTemplateColumn Header="Trạng thái" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="10,4" CornerRadius="8"
                                            Background="#DCFCE7" HorizontalAlignment="Center">
                                        <TextBlock Text="Hoạt động"
                                                   Foreground="#15803D" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- THAO TÁC -->
                        <DataGridTemplateColumn Header="Thao tác" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Width="32" Height="32" Margin="0,0,6,0"
                                                Background="#E0E7FF" BorderThickness="0">
                                            <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14"
                                                                     Foreground="#4318FF"/>
                                        </Button>
                                        <Button Width="32" Height="32"
                                                Background="#FEE2E2" BorderThickness="0">
                                            <materialDesign:PackIcon Kind="Lock" Width="14" Height="14"
                                                                     Foreground="#DC2626"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </Grid>

        <!-- ==================== POPUP ĐỔI MẬT KHẨU ==================== -->
        <Grid Background="#80000000" Panel.ZIndex="1000"
              Visibility="{Binding IsChangePasswordPopupVisible}">

            <Border Background="Transparent">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding CloseChangePasswordPopupCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border Width="460" Height="380" Padding="28" CornerRadius="20"
                    Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <materialDesign:PackIcon Kind="LockReset" Width="26" Height="26"
                                                 Foreground="#4318FF" Margin="0,0,10,0"/>
                        <TextBlock Text="Đổi mật khẩu" FontSize="22"
                                   FontWeight="Bold" Foreground="#2B3674"/>
                    </StackPanel>

                    <!-- FORM -->
                    <StackPanel Grid.Row="1">
                        <Border Height="50" Margin="0,0,0,16" CornerRadius="10"
                                Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                            <PasswordBox Margin="12,0" Background="Transparent" BorderThickness="0"
                                         FontSize="13" materialDesign:HintAssist.Hint="Mật khẩu cũ"/>
                        </Border>
                        <Border Height="50" Margin="0,0,0,16" CornerRadius="10"
                                Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                            <PasswordBox Margin="12,0" Background="Transparent" BorderThickness="0"
                                         FontSize="13" materialDesign:HintAssist.Hint="Mật khẩu mới"/>
                        </Border>
                        <Border Height="50" CornerRadius="10"
                                Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                            <PasswordBox Margin="12,0" Background="Transparent" BorderThickness="0"
                                         FontSize="13" materialDesign:HintAssist.Hint="Xác nhận mật khẩu mới"/>
                        </Border>
                    </StackPanel>

                    <!-- BUTTONS -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Width="120" Height="40" Margin="0,0,10,0" Content="HỦY"
                                Command="{Binding CloseChangePasswordPopupCommand}"/>
                        <Button Width="150" Height="40" Content="CẬP NHẬT"
                                Style="{StaticResource MainGradientButton}"/>
                    </StackPanel>

                </Grid>
            </Border>

        </Grid>

        <!-- ==================== POPUP THÊM TÀI KHOẢN ==================== -->
        <Grid Background="#80000000" Panel.ZIndex="1000"
              Visibility="{Binding IsAddAccountPopupVisible}">

            <Border Background="Transparent">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding CloseAddAccountPopupCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border Width="760" Height="560" Padding="28" CornerRadius="20"
                    Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <materialDesign:PackIcon Kind="AccountPlus" Width="26" Height="26"
                                                 Foreground="#4318FF" Margin="0,0,10,0"/>
                        <TextBlock Text="Thêm tài khoản mới" FontSize="22"
                                   FontWeight="Bold" Foreground="#2B3674"/>
                    </StackPanel>

                    <!-- FORM (2 cột) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CỘT TRÁI -->
                        <StackPanel Grid.Column="0">

                            <!-- Họ và tên -->
                            <Border Height="58" Margin="0,0,0,16" Background="#F8FAFC"
                                    CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#06B6D4" CornerRadius="3"/>
                                    <Grid Grid.Column="2">
                                        <TextBlock Text="Họ và tên" FontSize="11"
                                                   Foreground="#A3AED0" Margin="0,8,0,0"/>
                                        <TextBox Margin="0,22,0,0" BorderThickness="0"
                                                 Background="Transparent" FontSize="14"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Giới tính -->
                            <Border Height="58" Margin="0,0,0,16" Background="#F8FAFC"
                                    CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#EC4899" CornerRadius="3"/>
                                    <Grid Grid.Column="2">
                                        <TextBlock Text="Giới tính" FontSize="11"
                                                   Foreground="#A3AED0" Margin="0,8,0,0"/>
                                        <ComboBox Margin="0,22,0,0" BorderThickness="0"
                                                  Background="Transparent" FontSize="14">
                                            <ComboBoxItem Content="Nam"/>
                                            <ComboBoxItem Content="Nữ"/>
                                        </ComboBox>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Số điện thoại -->
                            <Border Height="58" Margin="0,0,0,16" Background="#F8FAFC"
                                    CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#8B5CF6" CornerRadius="3"/>
                                    <Grid Grid.Column="2">
                                        <TextBlock Text="Số điện thoại" FontSize="11"
                                                   Foreground="#A3AED0" Margin="0,8,0,0"/>
                                        <TextBox Margin="0,22,0,0" BorderThickness="0"
                                                 Background="Transparent" FontSize="14"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Gmail -->
                            <Border Height="58" Background="#F8FAFC"
                                    CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#EF4444" CornerRadius="3"/>
                                    <Grid Grid.Column="2">
                                        <TextBlock Text="Gmail" FontSize="11"
                                                   Foreground="#A3AED0" Margin="0,8,0,0"/>
                                        <TextBox Margin="0,22,0,0" BorderThickness="0"
                                                 Background="Transparent" FontSize="14"/>
                                    </Grid>
                                </Grid>
                            </Border>

                        </StackPanel>

                        <!-- CỘT PHẢI -->
                        <StackPanel Grid.Column="2">

                            <!-- Tên đăng nhập -->
                            <Border Height="58" Margin="0,0,0,16" Background="#F8FAFC"
                                    CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#10B981" CornerRadius="3"/>
                                    <Grid Grid.Column="2">
                                        <TextBlock Text="Tên đăng nhập" FontSize="11"
                                                   Foreground="#A3AED0" Margin="0,8,0,0"/>
                                        <TextBox Margin="0,22,0,0" BorderThickness="0"
                                                 Background="Transparent" FontSize="14"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Mật khẩu -->
                            <Border Height="58" Margin="0,0,0,16" Background="#F8FAFC"
                                    CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#F59E0B" CornerRadius="3"/>
                                    <Grid Grid.Column="2">
                                        <TextBlock Text="Mật khẩu" FontSize="11"
                                                   Foreground="#A3AED0" Margin="0,8,0,0"/>
                                        <PasswordBox Margin="0,22,0,0" BorderThickness="0"
                                                     Background="Transparent" FontSize="14"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Chức vụ -->
                            <Border Height="58" Margin="0,0,0,16" Background="#F8FAFC"
                                    CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#14B8A6" CornerRadius="3"/>
                                    <Grid Grid.Column="2">
                                        <TextBlock Text="Chức vụ" FontSize="11"
                                                   Foreground="#A3AED0" Margin="0,8,0,0"/>
                                        <TextBox Margin="0,22,0,0" BorderThickness="0"
                                                 Background="Transparent" FontSize="14"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Nhóm quyền -->
                            <Border Height="58" Background="#F8FAFC"
                                    CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Grid Margin="16,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#4318FF" CornerRadius="3"/>
                                    <Grid Grid.Column="2">
                                        <TextBlock Text="Nhóm quyền" FontSize="11"
                                                   Foreground="#A3AED0" Margin="0,8,0,0"/>
                                        <ComboBox Margin="0,22,0,0" BorderThickness="0"
                                                  Background="Transparent" FontSize="14">
                                            <ComboBoxItem Content="Admin"/>
                                            <ComboBoxItem Content="Quản lý"/>
                                            <ComboBoxItem Content="Nhân viên"/>
                                        </ComboBox>
                                    </Grid>
                                </Grid>
                            </Border>

                        </StackPanel>

                    </Grid>

                    <!-- BUTTONS -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Width="120" Height="40" Margin="0,0,10,0" Content="HỦY"
                                Command="{Binding CloseAddAccountPopupCommand}"/>
                        <Button Width="180" Height="40" Content="THÊM TÀI KHOẢN"
                                Style="{StaticResource MainGradientButton}"/>
                    </StackPanel>

                </Grid>
            </Border>

        </Grid>

    </Grid>

</UserControl>
