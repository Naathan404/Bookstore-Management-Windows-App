<UserControl x:Class="Bookstore.WPF.Views.AccountView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 mc:Ignorable="d">

	<Grid>
		<Grid x:Name="MainAccountView"
			  Margin="{StaticResource MainViewMargin}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<components:PageHeaderControl Title="TÀI KHOẢN &amp; PHÂN QUYỀN"
										  HeaderIcon="ShieldAccount"
										  ShowAddButton="True"
										  AddTitle="THÊM TÀI KHOẢN"
										  AddCommand="{Binding OpenAddAccountPopupCommand}"
										  AddCommandParameter="{Binding}"
										  ShowSecondButton="True"
										  SecondTitle="THÊM NHÓM"
										  SecondCommand="{Binding OpenAddRolePopupCommand}"
										  SecondCommandParameter="{Binding}" />

			<TabControl Grid.Row="1"
						Style="{StaticResource TabControlStyle}">

				<TabItem Header="DANH SÁCH TÀI KHOẢN">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<Border Grid.Row="0"
								Style="{StaticResource FilterCardStyle}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<components:FilterInputControl Grid.Column="0"
															   Margin="0,0,8,0"
															   IconKind="Magnify"
															   HintText="Tìm tên đăng nhập, họ tên..."
															   TextValue="{Binding SearchKeyword}" />

								<components:FilterComboBoxControl Grid.Column="1"
																  Margin="0,0,8,0"
																  IconKind="AccountGroup"
																  HintText="Nhóm người dùng"
																  ItemsSource="{Binding RoleFilterList}"
																  SelectedItem="{Binding SelectedRoleFilter, Mode=TwoWay}"
																  DisplayMemberPath="TenNhomNguoiDung" />

								<components:FilterComboBoxControl Grid.Column="2"
																  Margin="0,0,8,0"
																  IconKind="Work"
																  HintText="Trạng thái làm việc"
																  ItemsSource="{Binding StatusFilterList}"
																  SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}" />

								
								<components:FilterActionPanel Grid.Column="3"
															  ClearCommand="{Binding ClearFilterCommand}"
															  RefreshCommand="{Binding RefreshCommand}"
															  ShowRefreshButton="True" />
							</Grid>
						</Border>

						<Border Grid.Row="1"
								Style="{StaticResource DataGridCardStyle}">
							<DataGrid ItemsSource="{Binding PagedAccounts}"
									  Style="{StaticResource CleanDataGrid}">
								
								<DataGrid.Columns>
									<!-- Cột STT-->
									<DataGridTextColumn Header="STT"
														Binding="{Binding STT}"
														Width="50"
														HeaderStyle="{StaticResource CenterHeaderStyle}"
														ElementStyle="{StaticResource CellText}"/>
									<!-- Cột tên đăng nhập-->
									<DataGridTextColumn Header="Tên đăng nhập"
														Binding="{Binding Username}"
														Width="150"
														HeaderStyle="{StaticResource CenterHeaderStyle}"
														ElementStyle="{StaticResource CellCenter}"/>
									<!-- Cột Họ tên tài khoản-->
									<DataGridTextColumn Header="Họ và tên"
														Binding="{Binding HoTen}"
														Width="*"
														HeaderStyle="{StaticResource LeftHeaderStyle}"
														ElementStyle="{StaticResource CellName}"/>
									<!-- Cột Chức vụ-->
									<DataGridTextColumn Header="Chức vụ"
														Binding="{Binding ChucVu}"
														Width="*"
														HeaderStyle="{StaticResource LeftHeaderStyle}"
														ElementStyle="{StaticResource CellLeft}"/>
									<!-- Cột Email-->
									<DataGridTextColumn Header="Email"
														Binding="{Binding Email}"
														Width="200"
														FontWeight="SemiBold"
														HeaderStyle="{StaticResource LeftHeaderStyle}"
														ElementStyle="{StaticResource CellLeft}"/>

									<DataGridTemplateColumn Header="Nhóm quyền"
															HeaderStyle="{StaticResource CenterHeaderStyle}"
															Width="150">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<Border CornerRadius="8"
														Padding="10,4"
														HorizontalAlignment="Center"
														VerticalAlignment="Center">
													<Border.Style>
														<Style TargetType="Border">
															<!-- mặc định -->
															<Setter Property="Background"
																	Value="#EDE9FE" />

															<Style.Triggers>
																<!-- admin -->
																<DataTrigger Binding="{Binding RoleName}"
																			 Value="ADMIN">
																	<Setter Property="Background"
																			Value="#DBEAFE" />
																</DataTrigger>
																<!-- quản lý -->
																<DataTrigger Binding="{Binding RoleName}"
																			 Value="QUẢN LÝ">
																	<Setter Property="Background"
																			Value="#D1FAE5" />
																</DataTrigger>
																<!-- nhân viên -->
																<DataTrigger Binding="{Binding RoleName}"
																			 Value="NHÂN VIÊN">
																	<Setter Property="Background"
																			Value="#FEF3C7" />
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</Border.Style>

													<!-- ĐỊNH DẠNG MÀU CHỮ BÊN TRONG -->
													<TextBlock FontSize="12"
															   FontWeight="Bold"
															   HorizontalAlignment="Center">
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<!-- default -->
																<Setter Property="Foreground"
																		Value="#6D28D9" />
																<Setter Property="Text"
																		Value="{Binding RoleName}" />
																<Style.Triggers>
																	<!-- admin -->
																	<DataTrigger Binding="{Binding RoleName}"
																				 Value="ADMIN">
																		<Setter Property="Foreground"
																				Value="#1D4ED8" />
																	</DataTrigger>
																	<!-- quản lý -->
																	<DataTrigger Binding="{Binding RoleName}"
																				 Value="QUẢN LÝ">
																		<Setter Property="Foreground"
																				Value="#047857" />
																	</DataTrigger>
																	<!-- nhân viên -->
																	<DataTrigger Binding="{Binding RoleName}"
																				 Value="NHÂN VIÊN">
																		<Setter Property="Foreground"
																				Value="#B45309" />
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<DataGridTemplateColumn Header="Thao tác"
															Width="150"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<StackPanel Orientation="Horizontal"
															HorizontalAlignment="Center"
															VerticalAlignment="Center">

													<Button Style="{StaticResource MiniActionButtonBase}"
															ToolTip="Khôi phục mật khẩu mặc định"
															Margin="0,0,8,0"
															Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
															CommandParameter="{Binding}">

														<materialDesign:PackIcon Kind="Key"
																				 Width="16"
																				 Height="16" />
													</Button>

													<components:DataGridActionPanel RowItem="{Binding}"
																					ShowEdit="True"
																					EditCommand="{Binding DataContext.OpenEditAccountPopupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																					ShowDelete="True"
																					DeleteCommand="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />

												</StackPanel>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
								</DataGrid.Columns>
							</DataGrid>
						</Border>

						<!--Phân trang-->
						<components:PaginationControl Grid.Row="2"
													  CurrentPage="{Binding TrangHienTai}"
													  TotalPages="{Binding TongSoTrang}"
													  TotalRecords="{Binding TongBanGhi}"
													  PaginationCommand="{Binding PhanTrangCommand}" />
					</Grid>
				</TabItem>

				<TabItem Header="NHÓM &amp; PHÂN QUYỀN">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="300" />
							<ColumnDefinition Width="20" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<Border Grid.Column="0"
								CornerRadius="16"
								Background="White"
								BorderBrush="#E2E8F0"
								BorderThickness="1"
								Padding="15">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="*" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
										   Text="Danh sách Nhóm"
										   FontSize="16"
										   FontWeight="Bold"
										   Foreground="#2B3674"
										   Margin="5,0,0,15" />

								<ListBox Grid.Row="1"
										 ItemsSource="{Binding RolesList}"
										 SelectedItem="{Binding SelectedRole}"
										 BorderThickness="0"
										 Background="Transparent"
										 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
									<ListBox.ItemContainerStyle>
										<Style TargetType="ListBoxItem">
											<Setter Property="Padding"
													Value="15" />
											<Setter Property="Margin"
													Value="0,0,0,8" />
											<Setter Property="Background"
													Value="#F8FAFC" />
											<Setter Property="Template">
												<Setter.Value>
													<ControlTemplate TargetType="ListBoxItem">
														<Border Background="{TemplateBinding Background}"
																CornerRadius="10"
																BorderBrush="#E2E8F0"
																BorderThickness="1">
															<ContentPresenter HorizontalAlignment="Left"
																			  VerticalAlignment="Center"
																			  Margin="{TemplateBinding Padding}" />
														</Border>
														<ControlTemplate.Triggers>
															<Trigger Property="IsMouseOver"
																	 Value="True">
																<Setter Property="Background"
																		Value="#E0E7FF" />
																<Setter Property="Cursor"
																		Value="Hand" />
															</Trigger>
															<Trigger Property="IsSelected"
																	 Value="True">
																<Setter Property="Background"
																		Value="#4318FF" />
																<Setter Property="TextElement.Foreground"
																		Value="White" />
															</Trigger>
														</ControlTemplate.Triggers>
													</ControlTemplate>
												</Setter.Value>
											</Setter>
										</Style>
									</ListBox.ItemContainerStyle>
									<ListBox.ItemTemplate>
										<DataTemplate>
											<StackPanel Orientation="Horizontal">
												<materialDesign:PackIcon Kind="AccountMultiple"
																		 Width="20"
																		 Height="20"
																		 Margin="0,0,10,0"
																		 VerticalAlignment="Center" />
												<TextBlock Text="{Binding TenNhomNguoiDung}"
														   FontSize="14"
														   FontWeight="Bold"
														   VerticalAlignment="Center" />
											</StackPanel>
										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>
							</Grid>
						</Border>

						<Border Grid.Column="2"
								CornerRadius="16"
								Background="White"
								BorderBrush="#E2E8F0"
								BorderThickness="1"
								Padding="25">
							<Grid>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="*" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>

								<TextBlock Grid.Row="0"
										   Text="Cấp quyền truy cập màn hình"
										   FontSize="18"
										   FontWeight="Bold"
										   Foreground="#2B3674" />
								<TextBlock Grid.Row="1"
										   Text="{Binding SelectedRole.TenNhomNguoiDung, StringFormat='Đang chỉnh sửa quyền cho nhóm: {0}'}"
										   FontSize="13"
										   Foreground="#A3AED0"
										   Margin="0,5,0,20" />

								<ItemsControl Grid.Row="2"
											  ItemsSource="{Binding ScreenPermissions}"
											  HorizontalAlignment="Center">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<WrapPanel Orientation="Horizontal"
													   MaxWidth="650" />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Background="#F8FAFC"
													CornerRadius="10"
													Margin="0,0,15,15"
													Padding="12,10"
													Width="200"
													BorderBrush="#E2E8F0"
													BorderThickness="1">
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="Auto" />
													</Grid.ColumnDefinitions>

													<TextBlock Grid.Column="0"
															   Text="{Binding TenChucNang}"
															   FontWeight="SemiBold"
															   Foreground="#2B3674"
															   VerticalAlignment="Center"
															   TextWrapping="Wrap" />

													<components:TickComponent Grid.Column="1"
																			  IsChecked="{Binding IsGranted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
																			  VerticalAlignment="Center"
																			  Cursor="Hand">
														<components:TickComponent.LayoutTransform>
															<ScaleTransform ScaleX="1.2"
																			ScaleY="1.2" />
														</components:TickComponent.LayoutTransform>
													</components:TickComponent>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>

								<Button Grid.Row="3"
										Style="{StaticResource MainGradientButton}"
										Command="{Binding SavePermissionsCommand}"
										CommandParameter="{Binding}"
										Width="160"
										HorizontalAlignment="Right"
										Margin="0,20,0,0">
									<StackPanel Orientation="Horizontal">
										<materialDesign:PackIcon Kind="ContentSave"
																 Width="18"
																 Height="18"
																 Foreground="White"
																 Margin="0,0,6,0" />
										<TextBlock Text="LƯU PHÂN QUYỀN" />
									</StackPanel>
								</Button>
							</Grid>
						</Border>
					</Grid>
				</TabItem>
			</TabControl>
		</Grid>

		<Grid Background="#80000000"
			  VerticalAlignment="Stretch"
			  HorizontalAlignment="Stretch"
			  Panel.ZIndex="1000"
			  Visibility="{Binding IsAccountPopupVisible, Converter={StaticResource BoolToVis}}">
			<Border Background="#80000000">
				<Border.InputBindings>
					<MouseBinding MouseAction="LeftClick"
								  Command="{Binding ClosePopupCommand}"
								  CommandParameter="{Binding}" />
				</Border.InputBindings>
			</Border>

			<Border Width="750"
					Height="Auto"
					Background="White"
					CornerRadius="20"
					Padding="30"
					HorizontalAlignment="Center"
					VerticalAlignment="Center">
				<StackPanel>
					<StackPanel.Resources>
						<Style x:Key="BaseInputBorder"
							   TargetType="Border">
							<Setter Property="CornerRadius"
									Value="10" />
							<Setter Property="Background"
									Value="White" />
							<Setter Property="BorderBrush"
									Value="#E2E8F0" />
							<Setter Property="BorderThickness"
									Value="1.5" />
							<Style.Triggers>
								<Trigger Property="IsEnabled"
										 Value="False">
									<Setter Property="Background"
											Value="#F1F5F9" />
									<Setter Property="BorderBrush"
											Value="#CBD5E1" />
								</Trigger>
							</Style.Triggers>
						</Style>
					</StackPanel.Resources>

					<StackPanel Orientation="Horizontal"
								HorizontalAlignment="Center"
								Margin="0,0,0,25">
						<materialDesign:PackIcon Kind="AccountEdit"
												 Width="26"
												 Height="26"
												 Foreground="#4318FF"
												 Margin="0,0,10,0"
												 VerticalAlignment="Center" />
						<TextBlock Text="{Binding AccountPopupTitle}"
								   FontSize="20"
								   FontWeight="Bold"
								   Foreground="#2B3674"
								   VerticalAlignment="Center" />
					</StackPanel>

					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="30" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0">
							<Border Height="55"
									Margin="0,0,0,18">
								<Border.Style>
									<Style TargetType="Border"
										   BasedOn="{StaticResource BaseInputBorder}">
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsEditMode}"
														 Value="True">
												<Setter Property="IsEnabled"
														Value="False" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Border.Style>
								<Grid>
									<TextBlock Text="Tên đăng nhập *"
											   FontSize="11"
											   Foreground="#A3AED0"
											   Margin="12,5,0,0"
											   VerticalAlignment="Top" />
									<TextBox Text="{Binding EditingAccount.Username, UpdateSourceTrigger=PropertyChanged}"
											 FontSize="14"
											 FontWeight="SemiBold"
											 Foreground="#2B3674"
											 BorderThickness="0"
											 Background="Transparent"
											 VerticalAlignment="Bottom"
											 Margin="10,0,10,6"
											 Padding="0" />
								</Grid>
							</Border>

							<Border Style="{StaticResource BaseInputBorder}"
									Height="55"
									Margin="0,0,0,18">
								<Grid>
									<TextBlock Text="Họ và tên hiển thị *"
											   FontSize="11"
											   Foreground="#A3AED0"
											   Margin="12,5,0,0"
											   VerticalAlignment="Top" />
									<TextBox Text="{Binding EditingAccount.HoTen, UpdateSourceTrigger=PropertyChanged}"
											 FontSize="14"
											 FontWeight="SemiBold"
											 Foreground="#2B3674"
											 BorderThickness="0"
											 Background="Transparent"
											 VerticalAlignment="Bottom"
											 Margin="10,0,10,6"
											 Padding="0" />
								</Grid>
							</Border>

							<Border Style="{StaticResource BaseInputBorder}"
									Height="55"
									Margin="0,0,0,18">
								<Grid>
									<TextBlock Text="Nhóm người dùng *"
											   FontSize="11"
											   Foreground="#A3AED0"
											   Margin="12,5,0,0"
											   VerticalAlignment="Top" />
									<ComboBox ItemsSource="{Binding RolesList}"
											  SelectedItem="{Binding EditingAccount.SelectedRole}"
											  DisplayMemberPath="TenNhomNguoiDung"
											  FontSize="14"
											  FontWeight="SemiBold"
											  Foreground="#2B3674"
											  BorderThickness="0"
											  Background="Transparent"
											  VerticalAlignment="Bottom"
											  Margin="10,0,10,6"
											  Padding="0" />
								</Grid>
							</Border>

							<Border Style="{StaticResource BaseInputBorder}"
									Height="55"
									Margin="0,0,0,18">
								<Grid>
									<TextBlock Text="Chức vụ"
											   FontSize="11"
											   Foreground="#A3AED0"
											   Margin="12,5,0,0"
											   VerticalAlignment="Top" />
									<TextBox Text="{Binding EditingAccount.ChucVu, UpdateSourceTrigger=PropertyChanged}"
											 FontSize="14"
											 FontWeight="SemiBold"
											 Foreground="#2B3674"
											 BorderThickness="0"
											 Background="Transparent"
											 VerticalAlignment="Bottom"
											 Margin="10,0,10,6"
											 Padding="0" />
								</Grid>
							</Border>

							<Border Style="{StaticResource BaseInputBorder}"
									Height="55"
									Margin="0,0,0,18">
								<Grid>
									<TextBlock Text="Giới tính"
											   FontSize="11"
											   Foreground="#A3AED0"
											   Margin="12,5,0,0"
											   VerticalAlignment="Top" />
									<ComboBox SelectedValue="{Binding EditingAccount.GioiTinh}"
											  SelectedValuePath="Content"
											  FontSize="14"
											  FontWeight="SemiBold"
											  Foreground="#2B3674"
											  BorderThickness="0"
											  Background="Transparent"
											  VerticalAlignment="Bottom"
											  Margin="10,0,10,6"
											  Padding="0">
										<ComboBoxItem Content="Nam" />
										<ComboBoxItem Content="Nữ" />
										<ComboBoxItem Content="Khác" />
									</ComboBox>
								</Grid>
							</Border>
						</StackPanel>

						<StackPanel Grid.Column="2">
							<Border Style="{StaticResource BaseInputBorder}"
									Height="55"
									Margin="0,0,0,18">
								<Grid>
									<TextBlock Text="Email liên hệ"
											   FontSize="11"
											   Foreground="#A3AED0"
											   Margin="12,5,0,0"
											   VerticalAlignment="Top" />
									<TextBox Text="{Binding EditingAccount.Email, UpdateSourceTrigger=PropertyChanged}"
											 FontSize="14"
											 FontWeight="SemiBold"
											 Foreground="#2B3674"
											 BorderThickness="0"
											 Background="Transparent"
											 VerticalAlignment="Bottom"
											 Margin="10,0,10,6"
											 Padding="0" />
								</Grid>
							</Border>

							<Border Style="{StaticResource BaseInputBorder}"
									Height="55"
									Margin="0,0,0,18">
								<Grid>
									<TextBlock Text="Ngày sinh"
											   FontSize="11"
											   Foreground="#A3AED0"
											   Margin="12,5,0,0"
											   VerticalAlignment="Top" />
									<DatePicker SelectedDate="{Binding EditingAccount.NgaySinhDateTime}"
												FontSize="14"
												FontWeight="SemiBold"
												Foreground="#2B3674"
												BorderThickness="0"
												Background="Transparent"
												VerticalAlignment="Bottom"
												Margin="10,0,10,6"
												Padding="0" />
								</Grid>
							</Border>

							<Border Style="{StaticResource BaseInputBorder}"
									Height="55"
									Margin="0,0,0,18">
								<Grid>
									<TextBlock Text="Ngày vào làm"
											   FontSize="11"
											   Foreground="#A3AED0"
											   Margin="12,5,0,0"
											   VerticalAlignment="Top" />
									<DatePicker SelectedDate="{Binding EditingAccount.NgayVaoLamDateTime}"
												FontSize="14"
												FontWeight="SemiBold"
												Foreground="#2B3674"
												BorderThickness="0"
												Background="Transparent"
												VerticalAlignment="Bottom"
												Margin="10,0,10,6"
												Padding="0" />
								</Grid>
							</Border>

							<Border Style="{StaticResource BaseInputBorder}"
									Height="55"
									Margin="0,0,0,18"
									Padding="15,0">
								<StackPanel Orientation="Horizontal"
											VerticalAlignment="Center">
									<TextBlock Text="Trạng thái làm việc:"
											   FontSize="12"
											   Foreground="#A3AED0"
											   VerticalAlignment="Center"
											   Margin="0,0,15,0" />
									<ToggleButton IsChecked="{Binding EditingAccount.DangLamViec, UpdateSourceTrigger=PropertyChanged}"
												  Style="{StaticResource MaterialDesignSwitchToggleButton}"
												  Cursor="Hand"
												  VerticalAlignment="Center" />
									<TextBlock Text="{Binding EditingAccount.TrangThaiText}"
											   Foreground="{Binding EditingAccount.TrangThaiColor}"
											   FontWeight="Bold"
											   FontSize="14"
											   Margin="10,0,0,0"
											   VerticalAlignment="Center" />
								</StackPanel>
							</Border>
						</StackPanel>
					</Grid>

					<TextBlock Text="* Mật khẩu mặc định khi thêm mới là: 123456"
							   FontSize="12"
							   Foreground="#EF4444"
							   FontStyle="Italic"
							   Visibility="{Binding IsAddMode, Converter={StaticResource BoolToVis}}"
							   Margin="0,10,0,25"
							   HorizontalAlignment="Center" />

					<StackPanel Orientation="Horizontal"
								HorizontalAlignment="Center"
								Margin="0,5,0,0">
						<Button Content="HỦY BỎ"
								Command="{Binding ClosePopupCommand}"
								CommandParameter="{Binding}"
								Width="120"
								Height="40"
								Margin="0,0,15,0"
								Style="{StaticResource OutlineButtonStyle}" />
						<Button Content="LƯU THÔNG TIN"
								Command="{Binding SaveAccountCommand}"
								CommandParameter="{Binding}"
								Width="140"
								Height="40"
								Style="{StaticResource MainGradientButton}" />
					</StackPanel>
				</StackPanel>
			</Border>
		</Grid>

		<Grid Background="#80000000"
			  VerticalAlignment="Stretch"
			  HorizontalAlignment="Stretch"
			  Panel.ZIndex="1000"
			  Visibility="{Binding IsRolePopupVisible, Converter={StaticResource BoolToVis}}">
			<Border Background="#80000000">
				<Border.InputBindings>
					<MouseBinding MouseAction="LeftClick"
								  Command="{Binding ClosePopupCommand}"
								  CommandParameter="{Binding}" />
				</Border.InputBindings>
			</Border>

			<Border Width="400"
					Height="Auto"
					Background="White"
					CornerRadius="20"
					Padding="30"
					HorizontalAlignment="Center"
					VerticalAlignment="Center">
				<StackPanel>
					<StackPanel Orientation="Horizontal"
								HorizontalAlignment="Center"
								Margin="0,0,0,25">
						<materialDesign:PackIcon Kind="AccountGroup"
												 Width="26"
												 Height="26"
												 Foreground="#4318FF"
												 Margin="0,0,10,0"
												 VerticalAlignment="Center" />
						<TextBlock Text="THÊM NHÓM QUYỀN MỚI"
								   FontSize="20"
								   FontWeight="Bold"
								   Foreground="#2B3674"
								   VerticalAlignment="Center" />
					</StackPanel>

					<TextBox Text="{Binding NewRoleName}"
							 FontSize="14"
							 Foreground="#2B3674"
							 materialDesign:HintAssist.Hint="Tên nhóm người dùng *"
							 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
							 Margin="0,0,0,30" />

					<StackPanel Orientation="Horizontal"
								HorizontalAlignment="Center">
						<Button Content="HỦY BỎ"
								Command="{Binding ClosePopupCommand}"
								CommandParameter="{Binding}"
								Width="120"
								Height="40"
								Margin="0,0,15,0"
								Style="{StaticResource OutlineButtonStyle}" />
						<Button Content="THÊM NHÓM"
								Command="{Binding SaveNewRoleCommand}"
								CommandParameter="{Binding}"
								Width="140"
								Height="40"
								Style="{StaticResource MainGradientButton}" />
					</StackPanel>
				</StackPanel>
			</Border>
		</Grid>

	</Grid>
</UserControl>