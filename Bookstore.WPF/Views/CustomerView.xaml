											 VerticalAlignment="Center"
											 HorizontalAlignment="Stretch"
											 FontSize="13"
											 Foreground="#2B3674"
											 materialDesign:HintAssist.Hint="Địa chỉ" />
								</Grid>
							</Border>

							<Border Grid.Column="2"
									Style="{StaticResource FilterBorderStyle}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="36" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<materialDesign:PackIcon Kind="CardAccountDetails"
															 Width="18"
															 Height="18"
															 Foreground="#A3AED0"
															 VerticalAlignment="Center"
															 HorizontalAlignment="Center" />
									<TextBox Grid.Column="1"
											 Text="{Binding KhachHangForm.MaSoThue, UpdateSourceTrigger=PropertyChanged}"
											 Margin="0 0 5 0"
											 Background="Transparent"
											 BorderThickness="0"
											 VerticalAlignment="Center"
											 HorizontalAlignment="Stretch"
											 FontSize="13"
											 Foreground="#2B3674"
											 materialDesign:HintAssist.Hint="Mã số thuế" />
								</Grid>
							</Border>
						</Grid>

						<!-- Công nợ -->
						<Border Grid.Row="6"
								Visibility="{Binding IsCongNoVisible, Converter={StaticResource BoolToVis}}"
								Background="#FEF3C7"
								Padding="12"
								CornerRadius="8"
								Margin="0,0,0,20">
							<TextBlock Text="{Binding KhachHangForm.CongNo, StringFormat={}{0:N0} VNĐ, UpdateSourceTrigger=PropertyChanged}"
									   FontSize="14"
									   FontWeight="Bold"
									   Foreground="#EF4444" />
						</Border>

						<!-- Buttons -->
						<StackPanel Grid.Row="7"
									Orientation="Horizontal"
									HorizontalAlignment="Right">
							<Button x:Name="btnPopupQuayLai"
									Content="QUAY LẠI"
									Width="120"
									Height="42"
									Margin="0,0,10,0"
									Foreground="#A3AED0"
									Background="Transparent"
									BorderBrush="#E2E8F0"
									BorderThickness="1"
									Command="{Binding DongPopupKhachHangCommand}"
									CommandParameter="1" />
							<Button x:Name="btnPopupLuu"
									Content="LƯU"
									Width="120"
									Height="42"
									Foreground="White"
									Background="#10B981"
									Command="{Binding LuuKhachHangCommand}"
									CommandParameter="1" />
						</StackPanel>
					</Grid>
				</ScrollViewer>
			</Border>
		</Grid>
	</Grid>
</UserControl>

