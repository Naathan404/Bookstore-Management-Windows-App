<UserControl x:Class="Bookstore.WPF.Views.CustomerView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 mc:Ignorable="d"
			 Background="#F4F7FE"
			 HorizontalAlignment="Stretch"
			 VerticalAlignment="Stretch"
			 xmlns:vm="clr-namespace:Bookstore.WPF.ViewModels"
			 d:DataContext="{d:DesignInstance Type=vm:CustomerViewModel}">

	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
		<!-- Row index shown via DataGridRow.Tag set in code-behind -->

		<!-- Style -->
		<SolidColorBrush x:Key="PrimaryDarkColor"
						 Color="#2B3674" />
		<SolidColorBrush x:Key="PrimaryColor"
						 Color="#4318FF" />
		<SolidColorBrush x:Key="TextLightColor"
						 Color="#A3AED0" />
		<SolidColorBrush x:Key="BackgroundColor"
						 Color="#F4F7FE" />
		<SolidColorBrush x:Key="WhiteColor"
						 Color="White" />
		<SolidColorBrush x:Key="DangerColor"
						 Color="#EF4444" />
		<SolidColorBrush x:Key="SuccessColor"
						 Color="#10B981" />
		<SolidColorBrush x:Key="WarningColor"
						 Color="#F59E0B" />

		<LinearGradientBrush x:Key="GradientButtonBrush"
							 StartPoint="0,0"
							 EndPoint="1,0">
			<GradientStop Color="#4318FF"
						  Offset="0" />
			<GradientStop Color="#5B3CFF"
						  Offset="1" />
		</LinearGradientBrush>
		<LinearGradientBrush x:Key="GradientSuccessBrush"
							 StartPoint="0,0"
							 EndPoint="1,0">
			<GradientStop Color="#10B981"
						  Offset="0" />
			<GradientStop Color="#059669"
						  Offset="1" />
		</LinearGradientBrush>

		<DropShadowEffect x:Key="CardShadowEffect"
						  BlurRadius="20"
						  ShadowDepth="0"
						  Opacity="0.08"
						  Color="#4318FF" />
		<DropShadowEffect x:Key="PopupShadowEffect"
						  BlurRadius="30"
						  ShadowDepth="0"
						  Opacity="0.15"
						  Color="#2B3674" />

		<Style x:Key="MainGradientButton"
			   TargetType="Button">
			<Setter Property="Height"
					Value="36" />
			<Setter Property="FontSize"
					Value="13" />
			<Setter Property="FontWeight"
					Value="SemiBold" />
			<Setter Property="Foreground"
					Value="White" />
			<Setter Property="Cursor"
					Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{StaticResource GradientButtonBrush}"
								CornerRadius="12">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="PageButtonStyle"
			   TargetType="Button">
			<Setter Property="Width"
					Value="38" />
			<Setter Property="Height"
					Value="38" />
			<Setter Property="FontSize"
					Value="14" />
			<Setter Property="FontWeight"
					Value="SemiBold" />
			<Setter Property="Foreground"
					Value="#2B3674" />
			<Setter Property="Background"
					Value="Transparent" />
			<Setter Property="BorderThickness"
					Value="0" />
			<Setter Property="Cursor"
					Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border"
								Background="{TemplateBinding Background}"
								CornerRadius="10">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver"
									 Value="True">
								<Setter TargetName="border"
										Property="Background"
										Value="#E0E7FF" />
								<Setter Property="Foreground"
										Value="#4318FF" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="ActivePageButtonStyle"
			   TargetType="Button"
			   BasedOn="{StaticResource PageButtonStyle}">
			<Setter Property="Background"
					Value="#4318FF" />
			<Setter Property="Foreground"
					Value="White" />
		</Style>
		<Style x:Key="ReadOnlyInputStyle"
			   TargetType="Control">
			<Setter Property="Foreground"
					Value="#9CA3AF" />
		</Style>

		<Style x:Key="FilterBorderStyle"
			   TargetType="Border">
			<Setter Property="CornerRadius"
					Value="16" />
			<Setter Property="Background"
					Value="White" />
			<Setter Property="BorderBrush"
					Value="#E2E8F0" />
			<Setter Property="BorderThickness"
					Value="1" />
			<Setter Property="Height"
					Value="42" />
		</Style>

		<Style x:Key="MaterialDesignFloatingHintTextBox"
			   TargetType="TextBox">
			<Setter Property="Height"
					Value="42" />
			<Setter Property="FontSize"
					Value="13" />
			<Setter Property="VerticalContentAlignment"
					Value="Center" />
			<Setter Property="Padding"
					Value="0,8,0,0" />
			<Setter Property="BorderBrush"
					Value="#E2E8F0" />

			<Setter Property="BorderThickness"
					Value="0,0,0,1" />

			<Setter Property="Background"
					Value="Transparent" />
		</Style>
	</UserControl.Resources>

	<Grid Background="{StaticResource BackgroundColor}">
		<Ellipse Width="600"
				 Height="600"
				 Fill="#4318FF"
				 Opacity="0.03"
				 VerticalAlignment="Top"
				 HorizontalAlignment="Left"
				 Margin="-200,-200,0,0"
				 IsHitTestVisible="False" />
		<Ellipse Width="500"
				 Height="500"
				 Fill="#2B3674"
				 Opacity="0.03"
				 VerticalAlignment="Bottom"
				 HorizontalAlignment="Right"
				 Margin="0,0,-150,-150"
				 IsHitTestVisible="False" />

		<Grid Margin="5">
			<Grid.RowDefinitions>
				<RowDefinition Height="90" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- HEADER -->
			<Border Grid.Row="0"
					Margin="0,0,0,12"
					Padding="20"
					CornerRadius="16"
					Background="White"
					BorderBrush="#E2E8F0"
					BorderThickness="1">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0"
								Orientation="Horizontal">
						<materialDesign:PackIcon Kind="AccountGroup"
												 Width="28"
												 Height="28"
												 Foreground="#4318FF"
												 Margin="0,0,10,0" />
						<TextBlock Text="KHÁCH HÀNG"
								   FontSize="24"
								   FontWeight="Bold"
								   Foreground="#2B3674"
								   VerticalAlignment="Center" />
					</StackPanel>

					<StackPanel Grid.Column="1"
								Orientation="Horizontal"
								VerticalAlignment="Center">
						<Button x:Name="btnThemMoi"
								Style="{StaticResource MainGradientButton}"
								Width="110"
								Margin="0,0,10,0"
								Command="{Binding MoPopupThemCommand}"
								CommandParameter="1">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon Kind="AccountPlus"
														 Width="16"
														 Height="16"
														 Foreground="White"
														 Margin="0,0,6,0" />
								<TextBlock Text="THÊM" />
							</StackPanel>
						</Button>
					</StackPanel>
				</Grid>
			</Border>

			<!-- FILTER -->
			<Border Grid.Row="1"
					Margin="0,0,0,12"
					Padding="20"
					CornerRadius="16"
					Background="White"
					BorderBrush="#E2E8F0"
					BorderThickness="1">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<Grid Grid.Column="0"
						  Margin="0,0,16,0">
						<Border Style="{StaticResource FilterBorderStyle}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="36" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<materialDesign:PackIcon Kind="Magnify"
														 Width="18"
														 Height="18"
														 Foreground="#A3AED0"
														 VerticalAlignment="Center"
														 HorizontalAlignment="Center" />
								<TextBox Grid.Column="1"
										 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
										 materialDesign:HintAssist.Hint="Tìm kiếm khách hàng..."
										 FontSize="13"
										 Foreground="#2B3674"
										 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
										 Background="Transparent"
										 BorderThickness="0"
										 VerticalAlignment="Center"
										 Padding="0" />
							</Grid>
						</Border>
					</Grid>

					<StackPanel Grid.Column="1"
								Orientation="Horizontal"
								VerticalAlignment="Center">

						<Border Style="{StaticResource FilterBorderStyle}"
								Margin="0,0,12,0"
								Width="150">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="32" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<materialDesign:PackIcon Kind="FormatListBulleted"
														 Width="16"
														 Height="16"
														 Foreground="#A3AED0"
														 VerticalAlignment="Center"
														 HorizontalAlignment="Center" />
								<ComboBox Grid.Column="1"
										  x:Name="cboKieuTimKiem"
										  Margin="0 0 5 0"
										  Background="Transparent"
										  BorderThickness="0"
										  VerticalAlignment="Center"
										  HorizontalAlignment="Stretch"
										  FontSize="13"
										  Foreground="#2B3674"
										  materialDesign:HintAssist.Hint="Tìm theo"
										  SelectedValue="{Binding KieuTimKiem}"
										  SelectedValuePath="Content">
									<ComboBoxItem Content="Số điện thoại"
												  IsSelected="True" />
									<ComboBoxItem Content="Tên khách hàng" />
									<ComboBoxItem Content="Email" />
								</ComboBox>
							</Grid>
						</Border>

						<Border Style="{StaticResource FilterBorderStyle}"
								Margin="0,0,12,0"
								Width="140">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="32" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<materialDesign:PackIcon Kind="AccountStar"
														 Width="16"
														 Height="16"
														 Foreground="#A3AED0"
														 VerticalAlignment="Center"
														 HorizontalAlignment="Center" />
								<ComboBox Grid.Column="1"
										  Margin="0 0 5 0"
										  Background="Transparent"
										  BorderThickness="0"
										  VerticalAlignment="Center"
										  HorizontalAlignment="Stretch"
										  FontSize="13"
										  Foreground="#2B3674"
										  materialDesign:HintAssist.Hint="Loại KH"
										  ItemsSource="{Binding DanhSachLoaiKhachLoc}"
										  SelectedItem="{Binding LocLoaiKhach, UpdateSourceTrigger=PropertyChanged}" />
							</Grid>
						</Border>

						<Border Style="{StaticResource FilterBorderStyle}"
								Margin="0,0,12,0"
								Width="160">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="32" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<materialDesign:PackIcon Kind="CashMinus"
														 Width="16"
														 Height="16"
														 Foreground="#A3AED0"
														 VerticalAlignment="Center"
														 HorizontalAlignment="Center" />
								<ComboBox Grid.Column="1"
										  Margin="0 0 5 0"
										  Background="Transparent"
										  BorderThickness="0"
										  VerticalAlignment="Center"
										  HorizontalAlignment="Stretch"
										  FontSize="13"
										  Foreground="#2B3674"
										  materialDesign:HintAssist.Hint="Công nợ"
										  SelectedValue="{Binding LocCongNo, UpdateSourceTrigger=PropertyChanged}"
										  SelectedValuePath="Content">
									<ComboBoxItem Content="Tất cả"
												  IsSelected="True" />
									<ComboBoxItem Content="Không nợ" />
									<ComboBoxItem Content="Dưới 1 triệu" />
									<ComboBoxItem Content="1 - 2 triệu" />
									<ComboBoxItem Content="2 - 3 triệu" />
									<ComboBoxItem Content="3 - 4 triệu" />
									<ComboBoxItem Content="4 - 5 triệu" />
									<ComboBoxItem Content="Trên 5 triệu" />
								</ComboBox>
							</Grid>
						</Border>

						<Border Background="#F4F7FE"
								CornerRadius="10"
								Padding="12,10"
								Margin="0,0,12,0">
							<StackPanel Orientation="Horizontal"
										VerticalAlignment="Center">
								<TextBlock Text="Tổng:"
										   Foreground="#A3AED0"
										   FontSize="12"
										   Margin="0,0,6,0" />
								<TextBlock Text="{Binding TongBanGhi}"
										   FontWeight="Bold"
										   FontSize="14"
										   Foreground="#4318FF" />
							</StackPanel>
						</Border>

						<Button x:Name="btnXoaLoc"
								Width="42"
								Height="42"
								Style="{StaticResource MaterialDesignIconForegroundButton}"
								Foreground="#EF4444"
								ToolTip="Xóa bộ lọc"
								Command="{Binding XoaLocCommand}"
								CommandParameter="1">
							<materialDesign:PackIcon Kind="FilterRemove"
													 Width="22"
													 Height="22" />
						</Button>
					</StackPanel>
				</Grid>
			</Border>

			<!-- DATAGRID -->
			<Border Grid.Row="2"
					CornerRadius="20"
					Background="White"
					BorderBrush="#E2E8F0"
					BorderThickness="1"
					Padding="20">

				<DataGrid x:Name="dgDanhSachKhach"
						  ItemsSource="{Binding DanhSachKhachHang}"
						  LoadingRow="DataGrid_LoadingRow"
						  AutoGenerateColumns="False"
						  SelectionMode="Single"
						  SelectionUnit="FullRow"
						  HeadersVisibility="Column"
						  BorderThickness="0"
						  RowHeight="52"
						  FontSize="13"
						  AlternatingRowBackground="#F8FAFC"
						  RowBackground="White"
						  Foreground="#2B3674"
						  GridLinesVisibility="Horizontal"
						  HorizontalGridLinesBrush="#E2E8F0"
						  VerticalGridLinesBrush="Transparent"
						  ScrollViewer.HorizontalScrollBarVisibility="Auto"
						  ScrollViewer.VerticalScrollBarVisibility="Auto"
						  IsReadOnly="True"
						  CanUserAddRows="False"
						  CanUserDeleteRows="False"
						  CanUserResizeRows="False"
						  CanUserReorderColumns="False">

					<DataGrid.Resources>
						<!-- Header Style -->
						<Style TargetType="DataGridColumnHeader">
							<Setter Property="Background"
									Value="#F8FAFC" />
							<Setter Property="Foreground"
									Value="#2B3674" />
							<Setter Property="FontWeight"
									Value="SemiBold" />
							<Setter Property="FontSize"
									Value="13" />
							<Setter Property="Height"
									Value="44" />
							<Setter Property="BorderBrush"
									Value="#E2E8F0" />
							<Setter Property="BorderThickness"
									Value="0,0,0,2" />
							<Setter Property="HorizontalContentAlignment"
									Value="Stretch" />
							<Setter Property="VerticalContentAlignment"
									Value="Center" />
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="DataGridColumnHeader">
										<Border Background="{TemplateBinding Background}"
												BorderBrush="{TemplateBinding BorderBrush}"
												BorderThickness="{TemplateBinding BorderThickness}">
											<ContentPresenter VerticalAlignment="Center"
															  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
															  Margin="12,0" />
										</Border>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>

						<!-- Cell Style -->
						<Style TargetType="DataGridCell">
							<Setter Property="VerticalContentAlignment"
									Value="Center" />
							<Setter Property="HorizontalContentAlignment"
									Value="Stretch" />
							<Setter Property="BorderThickness"
									Value="0" />
							<Setter Property="FocusVisualStyle"
									Value="{x:Null}" />
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="DataGridCell">
										<Border Background="{TemplateBinding Background}"
												BorderBrush="{TemplateBinding BorderBrush}"
												BorderThickness="{TemplateBinding BorderThickness}">
											<ContentPresenter VerticalAlignment="Center"
															  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
															  Margin="12,0" />
										</Border>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>

						<!-- Row Style -->
						<Style TargetType="DataGridRow">
							<Setter Property="Background"
									Value="Transparent" />
							<Style.Triggers>
								<Trigger Property="IsSelected"
										 Value="True">
									<Setter Property="Background"
											Value="#E0E7FF" />
								</Trigger>
								<Trigger Property="IsMouseOver"
										 Value="True">
									<Setter Property="Background"
											Value="#F3F4F6" />
									<Setter Property="Cursor"
											Value="Hand" />
								</Trigger>
							</Style.Triggers>
						</Style>
					</DataGrid.Resources>

					<DataGrid.Columns>
						<!-- Mã Khách hàng  -->
						<DataGridTextColumn Header="Mã KH"
											Width="130"
											SortMemberPath="MaKhachHang">
							<DataGridTextColumn.Binding>
								<MultiBinding StringFormat="KH{0:ddMMyy}{1:D3}">
									<Binding Path="NgayTao" />
									<Binding Path="MaKhachHang" />
								</MultiBinding>
							</DataGridTextColumn.Binding>

							<DataGridTextColumn.HeaderStyle>
								<Style TargetType="DataGridColumnHeader"
									   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
									<Setter Property="HorizontalContentAlignment"
											Value="Center" />
								</Style>
							</DataGridTextColumn.HeaderStyle>

							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="HorizontalAlignment"
											Value="Center" />
									<Setter Property="Foreground"
											Value="#4318FF" />
									<Setter Property="FontWeight"
											Value="Bold" />
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<!-- Tên KH -->
						<DataGridTextColumn Header="Tên khách hàng"
											Binding="{Binding TenKhachHang}"
											Width="*">
							<DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader"
									   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment"
											Value="Left" />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock" BasedOn="{StaticResource CellLeft}">
									<Setter Property="TextTrimming"
											Value="CharacterEllipsis" />
                                    <Setter Property="TextWrapping" Value="Wrap"></Setter>
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<!-- SĐT -->
						<DataGridTextColumn Header="Số điện thoại"
											Binding="{Binding SoDienThoai}"
											Width="130">
							<DataGridTextColumn.HeaderStyle>
								<Style TargetType="DataGridColumnHeader"
									   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
									<Setter Property="HorizontalContentAlignment"
											Value="Center" />
								</Style>
							</DataGridTextColumn.HeaderStyle>
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="HorizontalAlignment"
											Value="Center" />
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<!-- Email -->
						<DataGridTextColumn Header="Email"
											Binding="{Binding Email}"
											Width="150">
							<DataGridTextColumn.HeaderStyle>
								<Style TargetType="DataGridColumnHeader"
									   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment"
											Value="Left" />
                                </Style>
                                
							</DataGridTextColumn.HeaderStyle>
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="TextTrimming"
											Value="CharacterEllipsis" />
                                    <Setter Property="TextWrapping" Value="Wrap"></Setter>
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<!-- Công nợ -->
						<DataGridTextColumn Header="Công nợ"
											Binding="{Binding CongNo, StringFormat={}{0:N0} VNĐ}"
											Width="140">
							<DataGridTextColumn.HeaderStyle>
								<Style TargetType="DataGridColumnHeader"
									   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
									<Setter Property="HorizontalContentAlignment"
											Value="Right" />
								</Style>
							</DataGridTextColumn.HeaderStyle>
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="HorizontalAlignment"
											Value="Right" />
									<Setter Property="Foreground"
											Value="#EF4444" />
									<Setter Property="FontWeight"
											Value="SemiBold" />
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<!-- Loại KH -->
						<DataGridTextColumn Header="Loại KH"
											Binding="{Binding LoaiKhach}"
											Width="120">
							<DataGridTextColumn.HeaderStyle>
								<Style TargetType="DataGridColumnHeader"
									   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
									<Setter Property="HorizontalContentAlignment"
											Value="Center" />
								</Style>
							</DataGridTextColumn.HeaderStyle>
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="HorizontalAlignment"
											Value="Center" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding LoaiKhach}"
													 Value="VIP">
											<Setter Property="Foreground"
													Value="#F59E0B" />
											<Setter Property="FontWeight"
													Value="Bold" />
										</DataTrigger>
										<DataTrigger Binding="{Binding LoaiKhach}"
													 Value="Doanh nghiệp">
											<Setter Property="Foreground"
													Value="#10B981" />
											<Setter Property="FontWeight"
													Value="SemiBold" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<!-- single Thu button removed — handled in Thao tác column -->

						<!-- Thao tác: Thu tiền / Sửa / Xóa -->
						<DataGridTemplateColumn Header="Thao tác"
												Width="180">
							<DataGridTemplateColumn.HeaderStyle>
								<Style TargetType="DataGridColumnHeader"
									   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
									<Setter Property="HorizontalContentAlignment"
											Value="Center" />
								</Style>
							</DataGridTemplateColumn.HeaderStyle>

							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal"
												HorizontalAlignment="Center"
												VerticalAlignment="Center">

										<Button Height="32"
												FontSize="12"
												FontWeight="SemiBold"
												Foreground="#059669"
												Background="#D1FAE5"
												BorderThickness="0"
												Cursor="Hand"
												ToolTip="Lập phiếu thu tiền"
												Command="{Binding DataContext.MoPopupThuTienCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
												CommandParameter="{Binding}">
											<Button.Template>
												<ControlTemplate TargetType="Button">
													<Border x:Name="border"
															Background="{TemplateBinding Background}"
															CornerRadius="6"
															Padding="12,0">
														<StackPanel Orientation="Horizontal"
																	HorizontalAlignment="Center"
																	VerticalAlignment="Center">
