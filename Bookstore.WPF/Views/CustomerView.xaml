<UserControl x:Class="Bookstore.WPF.Views.CustomerView"
			 mc:Ignorable="d"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 xmlns:vm="clr-namespace:Bookstore.WPF.ViewModels"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 xmlns:popup="clr-namespace:Bookstore.WPF.Views.Popup">
	<Grid>
		<Grid x:Name="MainCustomerView"
			  Margin="{StaticResource MainViewMargin}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- HEADER -->
			<components:PageHeaderControl Title="KHÁCH HÀNG"
										  HeaderIcon="AccountGroup"
										  ShowAddButton="True"
										  AddCommand="{Binding MoPopupThemCommand}"
										  AddCommandParameter="{Binding}" 
                                          
                                          ShowExportExcel="True"
                                          ExportExcelCommand="{Binding ExportExcelCommand}"
                                          ExportExcelCommandParameter="{Binding}"/>

			<!-- FILTER -->
			<Border Grid.Row="1"
					Style="{StaticResource FilterCardStyle}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<components:FilterInputControl Grid.Column="0"
												   Margin="0,0,8,0"
												   IconKind="Magnify"
												   HintText="Tìm kiếm khách hàng..."
												   TextValue="{Binding SearchKeyword}" />
					<components:FilterComboBoxControl Grid.Column="1"
													  Margin="0,0,8,0"
													  IconKind="Help"
													  HintText="Kiểu tìm kiếm"
													  ItemsSource="{Binding DanhSachKieuTimKiem}"
													  SelectedItem="{Binding KieuTimKiem}" />

					<components:FilterComboBoxControl Grid.Column="2"
													  Margin="0,0,8,0"
													  IconKind="Account"
													  HintText="Loại khách hàng"
													  ItemsSource="{Binding DanhSachLoaiKhachLoc}"
													  SelectedItem="{Binding LocLoaiKhach}" />

					<components:FilterComboBoxControl Grid.Column="3"
													  Margin="0,0,8,0"
													  IconKind="Cash"
													  HintText="Công nợ"
													  ItemsSource="{Binding DanhSachLocCongNo}"
													  SelectedItem="{Binding LocCongNo}" />
					<components:FilterActionPanel Grid.Column="4"
												  ClearCommand="{Binding XoaLocCommand}"
												  RefreshCommand="{Binding RefreshCommand}"
												  ShowRefreshButton="True" />
				</Grid>
			</Border>

			<!-- DATAGRID -->
			<Border Grid.Row="2"
					Style="{StaticResource DataGridCardStyle}">

				<DataGrid x:Name="dgDanhSachKhach"
						  ItemsSource="{Binding DanhSachKhachHang}"
						  Style="{StaticResource CleanDataGrid}">

					<DataGrid.Columns>
						<!-- Mã Khách hàng  -->
						<DataGridTextColumn Header="Mã KH"
											Width="120"
											HeaderStyle="{StaticResource CenterHeaderStyle}"
											ElementStyle="{StaticResource CellCode}"
											SortMemberPath="MaKhachHang">
							<DataGridTextColumn.Binding>
								<MultiBinding StringFormat="KH{0:ddMMyy}{1:D3}">
									<Binding Path="NgayTao" />
									<Binding Path="MaKhachHang" />
								</MultiBinding>
							</DataGridTextColumn.Binding>
						</DataGridTextColumn>

						<!-- Tên KH -->
						<DataGridTextColumn Header="Tên khách hàng"
											Binding="{Binding TenKhachHang}"
											ElementStyle="{StaticResource CellName}"
											Width="*" />

						<!-- SĐT -->
						<DataGridTextColumn Header="Số điện thoại"
											Binding="{Binding SoDienThoai}"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}"
											Width="120" />

						<!-- Email -->
						<DataGridTextColumn Header="Email"
											Binding="{Binding Email}"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}"
											Width="160" />

						<!-- Loại KH -->
						<DataGridTextColumn Header="Loại KH"
											Binding="{Binding LoaiKhach}"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellName}"
											Width="80" />

						<!-- Công nợ -->
						<DataGridTextColumn Header="Công nợ"
											Binding="{Binding CongNo, StringFormat={}{0:N0} VNĐ}"
											HeaderStyle="{StaticResource RightHeaderStyle}"
											ElementStyle="{StaticResource CellDebt}"
											Width="150" />

						<!-- Thao tác: Thu tiền / Sửa / Xóa -->
						<DataGridTemplateColumn Header="Thao tác"
												Width="180"
												HeaderStyle="{StaticResource CenterHeaderStyle}">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<components:DataGridActionPanel RowItem="{Binding}"
																	ShowEdit="True"
																	EditCommand="{Binding DataContext.MoPopupSuaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	ShowDelete="True"
																	DeleteCommand="{Binding DataContext.XoaKhachHangCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	ShowAction="True"
																	ActionIcon="Cash"
																	ActionText="Thu"
																	ActionCommand="{Binding DataContext.MoPopupThuTienCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">

										<components:DataGridActionPanel.Style>
											<Style TargetType="components:DataGridActionPanel">
												<Setter Property="IsActionEnabled"
														Value="True" />
												<Setter Property="ActionToolTip"
														Value="Lập phiếu thu tiền" />

												<Style.Triggers>
													<DataTrigger Binding="{Binding CongNo}"
																 Value="0">
														<Setter Property="IsActionEnabled"
																Value="False" />
														<Setter Property="ActionToolTip"
																Value="Khách hàng không có nợ" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</components:DataGridActionPanel.Style>
\									</components:DataGridActionPanel>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</Border>

			<!-- FOOTER -->
			<components:PaginationControl Grid.Row="3"
										  CurrentPage="{Binding TrangHienTai}"
										  TotalPages="{Binding TongSoTrang}"
										  TotalRecords="{Binding TongBanGhi}"
										  PaginationCommand="{Binding PhanTrangCommand}" />

		</Grid>

		<!-- ==================== POPUP THU TIỀN ==================== -->
		<popup:ReceiptPopup DataContext="{Binding PopupThuTienVM}" />

		<!-- ==================== POPUP THÊM/SỬA KHÁCH HÀNG ==================== -->
		<Grid x:Name="popupThemSua"
			  Background="#80000000"
			  Visibility="{Binding IsKhachHangPopupOpen, Converter={StaticResource BoolToVis}}"
			  VerticalAlignment="Stretch"
			  HorizontalAlignment="Stretch"
			  Panel.ZIndex="1000">

			<Border Background="Transparent">
				<Border.InputBindings>
					<MouseBinding MouseAction="LeftClick"
								  Command="{Binding DongPopupKhachHangCommand}" />
				</Border.InputBindings>
			</Border>

			<Border Width="620"
					Background="White"
					CornerRadius="16"
					HorizontalAlignment="Center"
					VerticalAlignment="Center">
				<ScrollViewer VerticalScrollBarVisibility="Auto"
							  MaxHeight="700">
					<Grid Margin="30">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<!-- Header -->
						<Grid Grid.Row="0"
							  Margin="0,0,0,20">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="40" />
							</Grid.ColumnDefinitions>

							<StackPanel Orientation="Horizontal"
										VerticalAlignment="Center">
								<materialDesign:PackIcon Width="22"
														 Height="22"
														 Foreground="#4318FF"
														 Margin="0,0,8,0">
									<materialDesign:PackIcon.Style>
										<Style TargetType="materialDesign:PackIcon">
											<Setter Property="Kind"
													Value="AccountPlus" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding PopupTitle}"
															 Value="CHỈNH SỬA KHÁCH HÀNG">
													<Setter Property="Kind"
															Value="AccountEdit" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</materialDesign:PackIcon.Style>
								</materialDesign:PackIcon>
								<TextBlock Text="{Binding PopupTitle}"
										   FontSize="18"
										   FontWeight="Bold"
										   Foreground="#2B3674"
										   VerticalAlignment="Center" />
							</StackPanel>
							<Button Grid.Column="1"
									Content="✕"
									Width="30"
									Height="30"
									HorizontalAlignment="Right"
									VerticalAlignment="Top"
									Margin="12,0,0,0"
									Background="Transparent"
									BorderThickness="0"
									Foreground="#A3AED0"
									Command="{Binding DongPopupKhachHangCommand}" />
						</Grid>

						<!-- Mã KH -->
						<Border Grid.Row="1"
								Style="{StaticResource FilterBorderStyle}"
								Visibility="{Binding MaKhachHangVisibility}"
								Margin="0,0,0,14"
								Background="#F8FAFC">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="36" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<materialDesign:PackIcon Kind="Barcode"
														 Width="18"
														 Height="18"
														 Foreground="#A3AED0"
														 VerticalAlignment="Center"
														 HorizontalAlignment="Center" />
								<TextBlock Grid.Column="1"
										   Margin="0 0 5 0"
										   Background="Transparent"
										   VerticalAlignment="Center"
										   HorizontalAlignment="Stretch"
										   FontSize="13"
										   Foreground="#9CA3AF">
									<TextBlock.Text>
										<MultiBinding StringFormat="KH{0:ddMMyy}{1:D3}">
											<Binding Path="KhachHangForm.NgayTao" />
											<Binding Path="KhachHangForm.MaKhachHang" />
										</MultiBinding>
									</TextBlock.Text>
								</TextBlock>
							</Grid>
						</Border>

						<!-- Tên + Loại -->
						<Grid Grid.Row="2"
							  Margin="0,0,0,14">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="12" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<Border Grid.Column="0"
									Style="{StaticResource FilterBorderStyle}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="36" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<materialDesign:PackIcon Kind="Account"
															 Width="18"
															 Height="18"
															 Foreground="#A3AED0"
															 VerticalAlignment="Center"
															 HorizontalAlignment="Center" />
									<TextBox Grid.Column="1"
											 Text="{Binding KhachHangForm.TenKhachHang, UpdateSourceTrigger=PropertyChanged}"
											 Margin="0 0 5 0"
											 Background="Transparent"
											 BorderThickness="0"
											 VerticalAlignment="Center"
											 HorizontalAlignment="Stretch"
											 FontSize="13"
											 Foreground="#2B3674"
											 materialDesign:HintAssist.Hint="Tên khách hàng *" />
								</Grid>
							</Border>

							<Border Grid.Column="2"
									Style="{StaticResource FilterBorderStyle}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="36" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<materialDesign:PackIcon Kind="Tag"
															 Width="18"
															 Height="18"
															 Foreground="#A3AED0"
															 VerticalAlignment="Center"
															 HorizontalAlignment="Center" />
									<ComboBox Grid.Column="1"
											  ItemsSource="{Binding DanhSachLoaiKhachForm}"
											  SelectedItem="{Binding KhachHangForm.LoaiKhach, UpdateSourceTrigger=PropertyChanged}"
											  Margin="0 0 5 0"
											  Background="Transparent"
											  BorderThickness="0"
											  VerticalAlignment="Center"
											  HorizontalAlignment="Stretch"
											  FontSize="13"
											  Foreground="#2B3674"
											  materialDesign:HintAssist.Hint="Loại khách hàng" />
								</Grid>
							</Border>
						</Grid>

						<!-- SĐT + Email -->
						<Grid Grid.Row="3"
							  Margin="0,0,0,14">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="12" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<Border Grid.Column="0"
									Style="{StaticResource FilterBorderStyle}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="36" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<materialDesign:PackIcon Kind="Phone"
															 Width="18"
															 Height="18"
															 Foreground="#A3AED0"
															 VerticalAlignment="Center"
															 HorizontalAlignment="Center" />
									<TextBox Grid.Column="1"
											 Text="{Binding KhachHangForm.SoDienThoai, UpdateSourceTrigger=PropertyChanged}"
											 Margin="0 0 5 0"
											 Background="Transparent"
											 BorderThickness="0"
											 VerticalAlignment="Center"
											 HorizontalAlignment="Stretch"
											 FontSize="13"
											 Foreground="#2B3674"
											 materialDesign:HintAssist.Hint="Số điện thoại *" />
								</Grid>
							</Border>

							<Border Grid.Column="2"
									Style="{StaticResource FilterBorderStyle}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="36" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<materialDesign:PackIcon Kind="Email"
															 Width="18"
															 Height="18"
															 Foreground="#A3AED0"
															 VerticalAlignment="Center"
															 HorizontalAlignment="Center" />
									<TextBox Grid.Column="1"
											 Text="{Binding KhachHangForm.Email, UpdateSourceTrigger=PropertyChanged}"
											 Margin="0 0 5 0"
											 Background="Transparent"
											 BorderThickness="0"
											 VerticalAlignment="Center"
											 HorizontalAlignment="Stretch"
											 FontSize="13"
											 Foreground="#2B3674"
											 materialDesign:HintAssist.Hint="Email" />
								</Grid>
							</Border>
						</Grid>

						<!-- Giới tính + Ngày sinh -->
						<Grid Grid.Row="4"
							  Margin="0,0,0,14">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="12" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<Border Grid.Column="0"
									Style="{StaticResource FilterBorderStyle}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="36" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<materialDesign:PackIcon Kind="GenderMaleFemale"
															 Width="18"
															 Height="18"
															 Foreground="#A3AED0"
															 VerticalAlignment="Center"
															 HorizontalAlignment="Center" />
									<ComboBox Grid.Column="1"
											  SelectedValue="{Binding KhachHangForm.GioiTinh, UpdateSourceTrigger=PropertyChanged}"
											  SelectedValuePath="Content"
											  Margin="0 0 5 0"
											  Background="Transparent"
											  BorderThickness="0"
											  VerticalAlignment="Center"
											  HorizontalAlignment="Stretch"
											  FontSize="13"
											  Foreground="#2B3674"
											  materialDesign:HintAssist.Hint="Giới tính">
										<ComboBoxItem Content="Nam"
													  IsSelected="True" />
										<ComboBoxItem Content="Nữ" />
										<ComboBoxItem Content="Khác" />
									</ComboBox>
								</Grid>
							</Border>

							<Border Grid.Column="2"
									Style="{StaticResource FilterBorderStyle}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="36" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<materialDesign:PackIcon Kind="Calendar"
															 Width="18"
															 Height="18"
															 Foreground="#A3AED0"
															 VerticalAlignment="Center"
															 HorizontalAlignment="Center" />
									<DatePicker Grid.Column="1"
												SelectedDate="{Binding KhachHangForm.NgaySinh, UpdateSourceTrigger=PropertyChanged}"
												Margin="0 0 5 0"
												Background="Transparent"
												BorderThickness="0"
												VerticalAlignment="Center"
												HorizontalAlignment="Stretch"
												FontSize="13"
												Foreground="#2B3674"
												materialDesign:HintAssist.Hint="Ngày sinh" />
								</Grid>
							</Border>
						</Grid>

						<!-- Địa chỉ + MST -->
						<Grid Grid.Row="5"
							  Margin="0,0,0,14">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="12" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<Border Grid.Column="0"
									Style="{StaticResource FilterBorderStyle}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="36" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<materialDesign:PackIcon Kind="MapMarker"
															 Width="18"
															 Height="18"
															 Foreground="#A3AED0"
															 VerticalAlignment="Center"
															 HorizontalAlignment="Center" />
									<TextBox Grid.Column="1"
											 Text="{Binding KhachHangForm.DiaChi, UpdateSourceTrigger=PropertyChanged}"
											 Margin="0 0 5 0"
											 Background="Transparent"
											 BorderThickness="0"
											 VerticalAlignment="Center"
											 HorizontalAlignment="Stretch"
											 FontSize="13"
											 Foreground="#2B3674"
											 materialDesign:HintAssist.Hint="Địa chỉ" />
								</Grid>
							</Border>

							<Border Grid.Column="2"
									Style="{StaticResource FilterBorderStyle}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="36" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<materialDesign:PackIcon Kind="CardAccountDetails"
															 Width="18"
															 Height="18"
															 Foreground="#A3AED0"
															 VerticalAlignment="Center"
															 HorizontalAlignment="Center" />
									<TextBox Grid.Column="1"
											 Text="{Binding KhachHangForm.MaSoThue, UpdateSourceTrigger=PropertyChanged}"
											 Margin="0 0 5 0"
											 Background="Transparent"
											 BorderThickness="0"
											 VerticalAlignment="Center"
											 HorizontalAlignment="Stretch"
											 FontSize="13"
											 Foreground="#2B3674"
											 materialDesign:HintAssist.Hint="Mã số thuế" />
								</Grid>
							</Border>
						</Grid>

						<!-- Công nợ -->
						<Border Grid.Row="6"
								Visibility="{Binding IsCongNoVisible, Converter={StaticResource BoolToVis}}"
								Background="#FEF3C7"
								Padding="12"
								CornerRadius="8"
								Margin="0,0,0,20">
							<TextBlock Text="{Binding KhachHangForm.CongNo, StringFormat={}{0:N0} VNĐ, UpdateSourceTrigger=PropertyChanged}"
									   FontSize="14"
									   FontWeight="Bold"
									   Foreground="#EF4444" />
						</Border>

						<!-- Buttons -->
						<StackPanel Grid.Row="7"
									Orientation="Horizontal"
									Margin="0,20,0,0"
									HorizontalAlignment="Right">

							<Button Content="HỦY BỎ"
									Command="{Binding DongPopupKhachHangCommand}"
									CommandParameter="Close"
									Width="120"
									Height="40"
									Margin="0,0,10,0"
									Cursor="Hand"
									Style="{StaticResource OutlineButtonStyle}" />

							<Button Content="LƯU THÔNG TIN"
									Command="{Binding LuuKhachHangCommand}"
									CommandParameter="Save"
									Width="140"
									Height="40"
									Style="{StaticResource MainGradientButton}"
									Cursor="Hand" />
						</StackPanel>
					</Grid>
				</ScrollViewer>
			</Border>
		</Grid>
	</Grid>
</UserControl>

