<UserControl x:Class="Bookstore.WPF.Views.CustomerView"             
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Background="#F4F7FE"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <!-- Màu sắc -->
        <SolidColorBrush x:Key="PrimaryDarkColor" Color="#2B3674"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#4318FF"/>
        <SolidColorBrush x:Key="TextLightColor" Color="#A3AED0"/>
        <SolidColorBrush x:Key="BackgroundColor" Color="#F4F7FE"/>
        <SolidColorBrush x:Key="WhiteColor" Color="White"/>
        <SolidColorBrush x:Key="DangerColor" Color="#EF4444"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>

        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="GradientButtonBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4318FF" Offset="0"/>
            <GradientStop Color="#5B3CFF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GradientSuccessBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#10B981" Offset="0"/>
            <GradientStop Color="#059669" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GradientDangerBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#EF4444" Offset="0"/>
            <GradientStop Color="#DC2626" Offset="1"/>
        </LinearGradientBrush>

        <!-- Shadow Effects -->
        <DropShadowEffect x:Key="CardShadowEffect" BlurRadius="20" ShadowDepth="0" Opacity="0.08" Color="#4318FF"/>
        <DropShadowEffect x:Key="ButtonShadowEffect" BlurRadius="10" ShadowDepth="2" Opacity="0.25" Color="#4318FF"/>
        <DropShadowEffect x:Key="PopupShadowEffect" BlurRadius="30" ShadowDepth="0" Opacity="0.15" Color="#2B3674"/>

        <!-- Styles -->
        <Style x:Key="MainGradientButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource ButtonShadowEffect}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource GradientButtonBrush}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessGradientButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource ButtonShadowEffect}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource GradientSuccessBrush}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#4318FF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                BorderBrush="#4318FF"
                                BorderThickness="1.5"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerOutlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#EF4444"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                BorderBrush="#EF4444"
                                BorderThickness="1.5"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="48"/>
        </Style>

        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="12,10"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#F4F7FE"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2B3674"/>
            <Setter Property="Height" Value="42"/>
        </Style>

        <Style x:Key="RoundedComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#F4F7FE"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2B3674"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style x:Key="RoundedDatePicker" TargetType="DatePicker">
            <Setter Property="Background" Value="#F4F7FE"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2B3674"/>
            <Setter Property="Height" Value="42"/>
        </Style>

        <Style x:Key="FilterChipStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#2B3674"/>
            <Setter Property="Background" Value="#F4F7FE"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#4318FF"/>
                                <Setter Property="BorderBrush" Value="#4318FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2B3674"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2B3674"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundColor}">
        <!-- Decorative Background -->
        <Ellipse Width="600" Height="600" 
                 Fill="#4318FF" Opacity="0.03"
                 VerticalAlignment="Top" HorizontalAlignment="Left"
                 Margin="-200,-200,0,0"/>
        <Ellipse Width="500" Height="500" 
                 Fill="#2B3674" Opacity="0.03"
                 VerticalAlignment="Bottom" HorizontalAlignment="Right"
                 Margin="0,0,-150,-150"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Margin="0,0,0,24" 
                        Padding="28,20"
                        CornerRadius="20"
                        Background="White"
                        Effect="{StaticResource CardShadowEffect}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <materialDesign:PackIcon Kind="AccountGroup" 
                                                     Width="36" 
                                                     Height="36"
                                                     Foreground="#4318FF"
                                                     Margin="0,0,12,0"/>
                            <TextBlock Text="KHÁCH HÀNG" 
                                       FontSize="28" 
                                       FontWeight="Bold"
                                       Foreground="#2B3674"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Background="#F4F7FE" CornerRadius="12" Padding="12,6" Margin="8,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Account" Width="18" Height="18" Foreground="#4318FF"/>
                                    <TextBlock x:Name="txtTongKhach" Text="0" FontWeight="Bold" Margin="6,0,0,0"/>
                                    <TextBlock Text="Tổng KH" Margin="4,0,0,0" Foreground="#A3AED0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FEF3C7" CornerRadius="12" Padding="12,6" Margin="8,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Alert" Width="18" Height="18" Foreground="#F59E0B"/>
                                    <TextBlock x:Name="txtKhachNo" Text="0" FontWeight="Bold" Margin="6,0,0,0"/>
                                    <TextBlock Text="Còn nợ" Margin="4,0,0,0" Foreground="#A3AED0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Content -->
                <Border Grid.Row="1"
        Margin="0,0,0,24" 
        Padding="28"
        CornerRadius="20"
        Background="White"
        Effect="{StaticResource CardShadowEffect}">

                    <StackPanel>
                        <!-- Tìm kiếm và Bộ lọc - Cùng hàng -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24" VerticalAlignment="Center">
                            <!-- Ô tìm kiếm -->
                            <Border Style="{StaticResource SearchBorderStyle}" 
                    Width="380">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Magnify" 
                                             Width="20" 
                                             Height="20"
                                             Foreground="#A3AED0"
                                             Margin="16,0,12,0"/>
                                    <TextBox x:Name="txtTimKiem" 
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalAlignment="Center"
                             FontSize="14"
                             Foreground="#2B3674"
                             materialDesign:HintAssist.Hint="Tìm kiếm theo tên, số điện thoại hoặc email..."
                             Width="300"
                             TextChanged="txtTimKiem_TextChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- Filter ComboBox - Ngay sau ô tìm kiếm -->
                            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Lọc nhanh:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <ComboBox x:Name="cboLocNhanh" 
                          Width="120"
                          Height="34"
                          FontSize="13"
                          Foreground="#2B3674"
                          Background="White"
                          BorderBrush="#E2E8F0"
                          BorderThickness="1"
                          SelectionChanged="cboLocNhanh_SelectionChanged">
                                    <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                                    <ComboBoxItem Content="Còn nợ"/>
                                    <ComboBoxItem Content="Khách VIP"/>
                                    <ComboBoxItem Content="Khách mới"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                       <!-- Danh sách khách hàng -->
<DataGrid x:Name="dgDanhSachKhach"
          AutoGenerateColumns="False"
          SelectionMode="Single"
          HeadersVisibility="Column"
          BorderThickness="0"
          RowHeight="55"
          FontSize="13"
          AlternatingRowBackground="#F8FAFC"
          RowBackground="White"
          Foreground="#2B3674"
          GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="#E2E8F0"
          VerticalGridLinesBrush="#E2E8F0"
          MaxHeight="350"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          SelectionChanged="dgDanhSachKhach_SelectionChanged"
          IsReadOnly="True"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          CanUserResizeRows="False"
          CanUserReorderColumns="False">

                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" 
                         Color="#4318FF" Opacity="0.1"/>

                                <!-- Style cho Header - KHÔNG căn giữa cứng nữa, để mỗi cột tự quyết định -->
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                    <Setter Property="Foreground" Value="#2B3674"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Height" Value="45"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Padding" Value="12,4"/>
                                    <!-- Đồng bộ padding với cell -->
                                </Style>

                                <!-- Style cho Cell -->
                                <Style TargetType="DataGridCell">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="12,4"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <!-- Mã KH - căn giữa -->
                                <DataGridTextColumn Header="Mã KH" Binding="{Binding MaKhachHang}" Width="100">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Foreground" Value="#4318FF"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Tên khách hàng - căn trái (Header và Cell đều căn trái) -->
                                <DataGridTextColumn Header="Tên khách hàng" Binding="{Binding TenKhachHang}" Width="200">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Số điện thoại - căn giữa -->
                                <DataGridTextColumn Header="Số điện thoại" Binding="{Binding SoDienThoai}" Width="120">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Email - căn trái (Header và Cell đều căn trái) -->
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Công nợ - căn phải -->
                                <DataGridTextColumn Header="Công nợ" Binding="{Binding CongNo, StringFormat={}{0:N0} VNĐ}" Width="130">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#EF4444"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Loại KH - căn giữa -->
                                <DataGridTextColumn Header="Loại KH" Binding="{Binding LoaiKhach}" Width="100">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LoaiKhach}" Value="VIP">
                                                    <Setter Property="Foreground" Value="#F59E0B"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LoaiKhach}" Value="Doanh nghiệp">
                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button x:Name="btnThemKhach" 
                    Style="{StaticResource MainGradientButton}"
                    Width="130"
                    Margin="0,0,12,0"
                    Click="btnThemKhach_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountPlus" Width="18" Height="18" Foreground="White" Margin="0,0,8,0"/>
                                    <TextBlock Text="THÊM "/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnSuaKhach" 
                    Style="{StaticResource OutlineButtonStyle}"
                    Width="100"
                    Margin="0,0,12,0"
                    Click="btnSuaKhach_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountEdit" Width="16" Height="16" Foreground="#4318FF" Margin="0,0,6,0"/>
                                    <TextBlock Text="SỬA"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnXoaKhach" 
                    Style="{StaticResource DangerOutlineButtonStyle}"
                    Width="100"
                    Margin="0,0,12,0"
                    Click="btnXoaKhach_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountRemove" Width="16" Height="16" Foreground="#EF4444" Margin="0,0,6,0"/>
                                    <TextBlock Text="XÓA"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLapPhieuThu" 
                    Style="{StaticResource SuccessGradientButton}"
                    Width="130"
                    Click="btnLapPhieuThu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Cash" Width="18" Height="18" Foreground="White" Margin="0,0,8,0"/>
                                    <TextBlock Text="THU TIỀN"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Form Thông tin chi tiết / Thêm mới khách hàng -->
<Border Grid.Row="2"
        Margin="0,0,0,24" 
        Padding="28"
        CornerRadius="20"
        Background="White"
        Effect="{StaticResource CardShadowEffect}">

    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
            <materialDesign:PackIcon Kind="AccountDetails" Width="24" Height="24" Foreground="#4318FF" Margin="0,0,12,0"/>
            <TextBlock Text="THÔNG TIN KHÁCH HÀNG" 
                       FontSize="18" 
                       FontWeight="SemiBold" 
                       Foreground="#2B3674"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Hàng 1: Tên khách hàng + Loại khách hàng -->
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,20,16">
                <TextBlock Text="Tên khách hàng" 
                           FontSize="13" 
                           FontWeight="SemiBold" 
                           Foreground="#2B3674" 
                           Margin="0,0,0,8"/>
                <Border Background="White" 
                        BorderBrush="#E2E8F0" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Height="44">
                    <DockPanel Margin="12,0,0,0">
                        <materialDesign:PackIcon Kind="Account" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtTenKhachHang" 
                                 Background="Transparent" 
                                 BorderThickness="0"
                                 FontSize="13"
                                 Foreground="#2B3674"
                                 VerticalAlignment="Center"
                                 Margin="10,0,0,0"/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                <TextBlock Text="Loại khách hàng" 
                           FontSize="13" 
                           FontWeight="SemiBold" 
                           Foreground="#2B3674" 
                           Margin="0,0,0,8"/>
                <Border Background="White" 
                        BorderBrush="#E2E8F0" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Height="44">
                    <DockPanel Margin="12,0,0,0">
                        <materialDesign:PackIcon Kind="AccountStar" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cboLoaiKhach" 
                                  Background="Transparent" 
                                  BorderThickness="0"
                                  FontSize="13"
                                  Foreground="#2B3674"
                                  VerticalAlignment="Center"
                                  Margin="10,0,0,0">
                            <ComboBoxItem Content="Thường" IsSelected="True"/>
                            <ComboBoxItem Content="VIP"/>
                            <ComboBoxItem Content="Doanh nghiệp"/>
                            <ComboBoxItem Content="Thân thiết"/>
                        </ComboBox>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Hàng 2: Giới tính + Ngày sinh -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,20,16">
                <TextBlock Text="Giới tính" 
                           FontSize="13" 
                           FontWeight="SemiBold" 
                           Foreground="#2B3674" 
                           Margin="0,0,0,8"/>
                <Border Background="White" 
                        BorderBrush="#E2E8F0" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Height="44">
                    <DockPanel Margin="12,0,0,0">
                        <materialDesign:PackIcon Kind="GenderMaleFemale" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cboGioiTinh" 
                                  Background="Transparent" 
                                  BorderThickness="0"
                                  FontSize="13"
                                  Foreground="#2B3674"
                                  VerticalAlignment="Center"
                                  Margin="10,0,0,0">
                            <ComboBoxItem Content="Nam" IsSelected="True"/>
                            <ComboBoxItem Content="Nữ"/>
                            <ComboBoxItem Content="Khác"/>
                        </ComboBox>
                    </DockPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,16">
                <TextBlock Text="Ngày sinh" 
                           FontSize="13" 
                           FontWeight="SemiBold" 
                           Foreground="#2B3674" 
                           Margin="0,0,0,8"/>
                <Border Background="White" 
                        BorderBrush="#E2E8F0" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Height="44">
                    <DockPanel Margin="12,0,0,0">
                        <materialDesign:PackIcon Kind="Calendar" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center"/>
                        <DatePicker x:Name="dpNgaySinh" 
                                    Background="Transparent" 
                                    BorderThickness="0"
                                    FontSize="13"
                                    Foreground="#2B3674"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    SelectedDateFormat="Short"/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Hàng 3: Mã số thuế + Địa chỉ -->
            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,20,16">
                <TextBlock Text="Mã số thuế" 
                           FontSize="13" 
                           FontWeight="SemiBold" 
                           Foreground="#2B3674" 
                           Margin="0,0,0,8"/>
                <Border Background="White" 
                        BorderBrush="#E2E8F0" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Height="44">
                    <DockPanel Margin="12,0,0,0">
                        <materialDesign:PackIcon Kind="TextBox" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtMaSoThue" 
                                 Background="Transparent" 
                                 BorderThickness="0"
                                 FontSize="13"
                                 Foreground="#2B3674"
                                 VerticalAlignment="Center"
                                 Margin="10,0,0,0"/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,16">
                <TextBlock Text="Địa chỉ" 
                           FontSize="13" 
                           FontWeight="SemiBold" 
                           Foreground="#2B3674" 
                           Margin="0,0,0,8"/>
                <Border Background="White" 
                        BorderBrush="#E2E8F0" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Height="44">
                    <DockPanel Margin="12,0,0,0">
                        <materialDesign:PackIcon Kind="MapMarker" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtDiaChi" 
                                 Background="Transparent" 
                                 BorderThickness="0"
                                 FontSize="13"
                                 Foreground="#2B3674"
                                 VerticalAlignment="Center"
                                 Margin="10,0,0,0"/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Hàng 4: Số điện thoại + Email -->
            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,20,16">
                <TextBlock Text="Số điện thoại" 
                           FontSize="13" 
                           FontWeight="SemiBold" 
                           Foreground="#2B3674" 
                           Margin="0,0,0,8"/>
                <Border Background="White" 
                        BorderBrush="#E2E8F0" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Height="44">
                    <DockPanel Margin="12,0,0,0">
                        <materialDesign:PackIcon Kind="Phone" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtSoDienThoai" 
                                 Background="Transparent" 
                                 BorderThickness="0"
                                 FontSize="13"
                                 Foreground="#2B3674"
                                 VerticalAlignment="Center"
                                 Margin="10,0,0,0"/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,16">
                <TextBlock Text="Email" 
                           FontSize="13" 
                           FontWeight="SemiBold" 
                           Foreground="#2B3674" 
                           Margin="0,0,0,8"/>
                <Border Background="White" 
                        BorderBrush="#E2E8F0" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Height="44">
                    <DockPanel Margin="12,0,0,0">
                        <materialDesign:PackIcon Kind="Email" Width="18" Height="18" Foreground="#A3AED0" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtEmail" 
                                 Background="Transparent" 
                                 BorderThickness="0"
                                 FontSize="13"
                                 Foreground="#2B3674"
                                 VerticalAlignment="Center"
                                 Margin="10,0,0,0"/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Hàng 5: Buttons -->
            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="btnLuuKhach" 
                        Style="{StaticResource SuccessGradientButton}"
                        Width="120"
                        Height="40"
                        Margin="0,0,12,0"
                        Click="btnLuuKhach_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Foreground="White" Margin="0,0,6,0"/>
                        <TextBlock Text="LƯU" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnHuyForm" 
                        Style="{StaticResource OutlineButtonStyle}"
                        Width="100"
                        Height="40"
                        Click="btnHuyForm_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#4318FF" Margin="0,0,6,0"/>
                        <TextBlock Text="HUỶ" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </StackPanel>
</Border>
                <!-- Footer -->
                <Border Grid.Row="3"
                        Margin="0,0,0,0" 
                        Padding="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Information" Width="14" Height="14" Foreground="#A3AED0" Margin="0,0,8,0"/>
                        <TextBlock Text="Khách hàng" Foreground="#A3AED0" FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Popup Thu Tiền -->
        <Grid x:Name="popupThuTien" 
      Background="#80000000"
      Visibility="Collapsed"
      VerticalAlignment="Stretch"
      HorizontalAlignment="Stretch"
      Panel.ZIndex="1000">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="550"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Nền mờ -->
            <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3"
            Background="#80000000"
            MouseLeftButtonDown="popupThuTien_MouseLeftButtonDown"/>

            <!-- Popup Content -->
            <Border Grid.Row="1" Grid.Column="1"
            Background="White"
            CornerRadius="16"
            Effect="{StaticResource PopupShadowEffect}">

                <Grid Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Margin="0,0,0,20" Padding="12" Background="#F4F7FE" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="FileDocument" Width="24" Height="24" Foreground="#4318FF" Margin="0,0,10,0"/>
                            <TextBlock Text="PHIẾU THU TIỀN" FontSize="18" FontWeight="Bold" Foreground="#2B3674"/>
                        </StackPanel>
                    </Border>

                    <!-- Mã phiếu -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,15">
                        <TextBlock Text="Mã phiếu" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" Margin="0,0,0,5"/>
                        <Border Background="#F4F7FE" BorderBrush="#E2E8F0" BorderThickness="1" Height="35" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Tag" Width="16" Height="16" Foreground="#A3AED0" Margin="10,0,8,0"/>
                                <TextBlock x:Name="txtPopupMaPhieu" Text="PT202412010001" FontSize="13" FontWeight="SemiBold" 
                                   Foreground="#4318FF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Ngày lập -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,15">
                        <TextBlock Text="Ngày lập" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" Margin="0,0,0,5"/>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Height="35" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Calendar" Width="16" Height="16" Foreground="#A3AED0" Margin="10,0,8,0"/>
                                <DatePicker x:Name="dtpPopupNgayLap" FontSize="13" BorderThickness="0" SelectedDateFormat="Short"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Người lập -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,15">
                        <TextBlock Text="Người lập" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" Margin="0,0,0,5"/>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Height="35" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Account" Width="16" Height="16" Foreground="#A3AED0" Margin="10,0,8,0"/>
                                <TextBox x:Name="txtPopupNguoiLap" Text="Admin" FontSize="13" BorderThickness="0" Background="Transparent"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Khách hàng -->
                    <StackPanel Grid.Row="4" Margin="0,0,0,15">
                        <TextBlock Text="Khách hàng" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" Margin="0,0,0,5"/>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Height="35" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AccountCircle" Width="16" Height="16" Foreground="#A3AED0" Margin="10,0,8,0"/>
                                <TextBox x:Name="txtPopupKhachHang" FontSize="13" BorderThickness="0" Background="Transparent" IsReadOnly="True"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Số tiền thu -->
                    <StackPanel Grid.Row="5" Margin="0,0,0,20">
                        <TextBlock Text="Số tiền thu" FontSize="13" FontWeight="SemiBold" Foreground="#2B3674" Margin="0,0,0,5"/>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Height="45" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Cash" Width="16" Height="16" Foreground="#A3AED0" Margin="10,0,8,0"/>
                                <TextBox x:Name="txtPopupSoTienThu" FontSize="16" FontWeight="Bold" Foreground="#4318FF" 
                                 BorderThickness="0" Background="Transparent" TextAlignment="Right" 
                                 TextChanged="txtPopupSoTienThu_TextChanged" Width="380"/>
                                <TextBlock Text="VNĐ" FontSize="13" Foreground="#A3AED0" Margin="5,0,10,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Công nợ sau khi thu -->
                    <Border Grid.Row="6" CornerRadius="8" Background="#DCFCE7" Padding="12" Margin="0,0,0,20">
                        <Grid>
                            <TextBlock Text="Công nợ sau khi thu:" Foreground="#166534" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtPopupConNoSauKhiThu" 
                               Text="0 VNĐ" 
                               HorizontalAlignment="Right" 
                               Foreground="#EF4444" 
                               FontWeight="Bold" 
                               FontSize="16"/>
                        </Grid>
                    </Border>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button x:Name="btnPopupDong" 
                        Content="HỦY" 
                        Width="80" 
                        Height="35" 
                        Margin="0,0,10,0"
                        Style="{StaticResource OutlineButtonStyle}"
                        Click="btnPopupDong_Click"/>

                        <Button x:Name="btnPopupXacNhan" 
                        Content="LƯU PHIẾU" 
                        Width="100" 
                        Height="35"
                        Style="{StaticResource SuccessGradientButton}"
                        Click="btnPopupXacNhan_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>