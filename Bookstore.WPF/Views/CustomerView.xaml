<UserControl x:Class="Bookstore.WPF.Views.CustomerView"
			 mc:Ignorable="d"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 xmlns:vm="clr-namespace:Bookstore.WPF.ViewModels"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 xmlns:popup="clr-namespace:Bookstore.WPF.Views.Popup">
	<Grid>
		<Grid x:Name="MainCustomerView"
			  Margin="{StaticResource MainViewMargin}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- HEADER -->
			<components:PageHeaderControl Title="KHÁCH HÀNG"
										  HeaderIcon="AccountGroup"
										  ShowAddButton="True"
										  AddCommand="{Binding MoPopupThemCommand}"
										  AddCommandParameter="{Binding}"
										  ShowExportExcel="True"
										  ExportExcelCommand="{Binding ExportExcelCommand}"
										  ExportExcelCommandParameter="{Binding}" />

			<!-- FILTER -->
			<Border Grid.Row="1"
					Style="{StaticResource FilterCardStyle}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<components:FilterInputControl Grid.Column="0"
												   Margin="0,0,8,0"
												   IconKind="Magnify"
												   HintText="Tìm kiếm khách hàng..."
												   TextValue="{Binding SearchKeyword}" />
					<components:FilterComboBoxControl Grid.Column="1"
													  Margin="0,0,8,0"
													  IconKind="Help"
													  HintText="Kiểu tìm kiếm"
													  ItemsSource="{Binding DanhSachKieuTimKiem}"
													  SelectedItem="{Binding KieuTimKiem}" />

					<components:FilterComboBoxControl Grid.Column="2"
													  Margin="0,0,8,0"
													  IconKind="Account"
													  HintText="Loại khách hàng"
													  ItemsSource="{Binding DanhSachLoaiKhachLoc}"
													  SelectedItem="{Binding LocLoaiKhach}" />

					<components:FilterComboBoxControl Grid.Column="3"
													  Margin="0,0,8,0"
													  IconKind="Cash"
													  HintText="Công nợ"
													  ItemsSource="{Binding DanhSachLocCongNo}"
													  SelectedItem="{Binding LocCongNo}" />
					<components:FilterActionPanel Grid.Column="4"
												  ClearCommand="{Binding XoaLocCommand}"
												  RefreshCommand="{Binding RefreshCommand}"
												  ShowRefreshButton="True" />
				</Grid>
			</Border>

			<!-- DATAGRID -->
			<Border Grid.Row="2"
					Style="{StaticResource DataGridCardStyle}">

				<DataGrid x:Name="dgDanhSachKhach"
						  ItemsSource="{Binding DanhSachKhachHang}"
						  Style="{StaticResource CleanDataGrid}">

					<DataGrid.Columns>
						<!-- Mã Khách hàng  -->
						<DataGridTextColumn Header="Mã KH"
											Width="120"
											HeaderStyle="{StaticResource CenterHeaderStyle}"
											ElementStyle="{StaticResource CellCode}"
											SortMemberPath="MaKhachHang">
							<DataGridTextColumn.Binding>
								<MultiBinding StringFormat="KH{0:ddMMyy}{1:D3}">
									<Binding Path="NgayTao" />
									<Binding Path="MaKhachHang" />
								</MultiBinding>
							</DataGridTextColumn.Binding>
						</DataGridTextColumn>

						<!-- Tên KH -->
						<DataGridTextColumn Header="Tên khách hàng"
											Binding="{Binding TenKhachHang}"
											ElementStyle="{StaticResource CellName}"
											Width="*" />

						<!-- SĐT -->
						<DataGridTextColumn Header="Số điện thoại"
											Binding="{Binding SoDienThoai}"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}"
											Width="120" />

						<!-- Email -->
						<DataGridTextColumn Header="Email"
											Binding="{Binding Email}"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}"
											Width="160" />

						<!-- Loại KH -->
						<DataGridTextColumn Header="Loại KH"
											Binding="{Binding LoaiKhach}"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellName}"
											Width="80" />

						<!-- Công nợ -->
						<DataGridTextColumn Header="Công nợ"
											Binding="{Binding CongNo, StringFormat={}{0:N0} VNĐ}"
											HeaderStyle="{StaticResource RightHeaderStyle}"
											ElementStyle="{StaticResource CellDebt}"
											Width="150" />

						<!-- Thao tác: Thu tiền / Sửa / Xóa -->
						<DataGridTemplateColumn Header="Thao tác"
												Width="250"
												HeaderStyle="{StaticResource CenterHeaderStyle}">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<components:DataGridActionPanel RowItem="{Binding}"
																	ShowView="{Binding DataContext.CanView, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	ShowEdit="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	ShowDelete="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	EditCommand="{Binding DataContext.MoPopupSuaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	ViewCommand="{Binding DataContext.MoPopupXemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	DeleteCommand="{Binding DataContext.XoaKhachHangCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	ShowAction="True"
																	ActionIcon="Cash"
																	ActionText="Thu"
																	ActionCommand="{Binding DataContext.MoPopupThuTienCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">

										<components:DataGridActionPanel.Style>
											<Style TargetType="components:DataGridActionPanel">
												<Setter Property="IsActionEnabled"
														Value="True" />
												<Setter Property="ActionToolTip"
														Value="Lập phiếu thu tiền" />

												<Style.Triggers>
													<DataTrigger Binding="{Binding CongNo}"
																 Value="0">
														<Setter Property="IsActionEnabled"
																Value="False" />
														<Setter Property="ActionToolTip"
																Value="Khách hàng không có nợ" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</components:DataGridActionPanel.Style>

									</components:DataGridActionPanel>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</Border>

			<!-- FOOTER -->
			<components:PaginationControl Grid.Row="3"
										  CurrentPage="{Binding TrangHienTai}"
										  TotalPages="{Binding TongSoTrang}"
										  TotalRecords="{Binding TongBanGhi}"
										  PaginationCommand="{Binding PhanTrangCommand}" />

		</Grid>

		<!-- ==================== POPUP THU TIỀN ==================== -->
		<popup:ReceiptPopup DataContext="{Binding PopupThuTienVM}" />

		<!-- ==================== POPUP THÊM/SỬA KHÁCH HÀNG ==================== -->
		<Grid x:Name="popupThemSua"
			  Visibility="{Binding IsKhachHangPopupOpen, Converter={StaticResource BoolToVis}}"
			  Style="{StaticResource PopupOverlayStyle}">

			<Border Background="Transparent">
				<Border.InputBindings>
					<MouseBinding MouseAction="LeftClick"
								  Command="{Binding DongPopupKhachHangCommand}" />
				</Border.InputBindings>
			</Border>

			<Border Style="{StaticResource PopupCardStyle}"
					Height="600"
					Width="600">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<components:PopupHeaderControl Grid.Row="0"
												   Title="{Binding PopupTitle}"
												   Margin="0,0,0,16">
						<components:PopupHeaderControl.Style>
							<Style TargetType="components:PopupHeaderControl">
								<Setter Property="IconKind"
										Value="AccountPlus" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding PopupTitle}"
												 Value="THÔNG TIN KHÁCH HÀNG">
										<Setter Property="IconKind"
												Value="AccountEdit" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</components:PopupHeaderControl.Style>
					</components:PopupHeaderControl>

					<ScrollViewer Grid.Row="1"
								  VerticalScrollBarVisibility="Auto"
								  Margin="0,0,0,16"
								  Padding="24,0,24,0">
						<StackPanel>

							<components:FormInputControl Title="Mã khách hàng"
														 IconKind="Barcode"
														 Visibility="{Binding MaKhachHangVisibility}"
														 IsEnabled="False">
								<components:FormInputControl.TextValue>
									<MultiBinding StringFormat="KH{0:ddMMyy}{1:D3}">
										<Binding Path="KhachHangForm.NgayTao" />
										<Binding Path="KhachHangForm.MaKhachHang" />
									</MultiBinding>
								</components:FormInputControl.TextValue>
							</components:FormInputControl>

							<components:FormInputControl Title="Tên khách hàng"
														 IsRequired="True"
														 IconKind="Text"
														 IsEnabled="{Binding IsEdit}"
														 TextValue="{Binding KhachHangForm.TenKhachHang, UpdateSourceTrigger=PropertyChanged}" />

							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="16" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

								<components:FormComboBoxControl Title="Loại khách hàng"
																Grid.Column="0"
																IconKind="Tag"
																ItemsSource="{Binding DanhSachLoaiKhachForm}"
																SelectedItem="{Binding KhachHangForm.LoaiKhach, UpdateSourceTrigger=PropertyChanged}">
									<components:FormComboBoxControl.Style>
										<Style TargetType="components:FormComboBoxControl">
											<Setter Property="IsEnabled"
													Value="True" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding MaKhachHangVisibility}"
															 Value="Visible">
													<Setter Property="IsEnabled"
															Value="False" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</components:FormComboBoxControl.Style>
								</components:FormComboBoxControl>

								<components:FormInputControl Title="Số điện thoại"
															 Grid.Column="2"
															 IsRequired="True"
															 IconKind="Phone"
															 TextValue="{Binding KhachHangForm.SoDienThoai, UpdateSourceTrigger=PropertyChanged}">
									<components:FormInputControl.Style>
										<Style TargetType="components:FormInputControl">
											<Setter Property="IsEnabled"
													Value="True" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding MaKhachHangVisibility}"
															 Value="Visible">
													<Setter Property="IsEnabled"
															Value="False" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</components:FormInputControl.Style>
								</components:FormInputControl>
							</Grid>

							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="16" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

								<components:FormInputControl Title="Email"
															 Grid.Column="0"
															 IconKind="Email"
															 IsEnabled="{Binding IsEdit}"
															 TextValue="{Binding KhachHangForm.Email, UpdateSourceTrigger=PropertyChanged}" />

								<components:FormComboBoxControl Title="Giới tính"
																Grid.Column="2"
																IconKind="GenderMaleFemale"
																IsEnabled="{Binding IsEdit}"
																ItemsSource="{Binding DanhSachGioiTinh}"
																SelectedValue="{Binding KhachHangForm.GioiTinh, UpdateSourceTrigger=PropertyChanged}" />
							</Grid>

							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="16" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

								<components:FormDatePickerControl Title="Ngày sinh"
																  Grid.Column="0"
																  IsEnabled="{Binding IsEdit}"
																  SelectedDate="{Binding KhachHangForm.NgaySinh, UpdateSourceTrigger=PropertyChanged}"
																  IconKind="Calendar" />

								<components:FormInputControl Title="Mã số thuế"
															 Grid.Column="2"
															 IconKind="CardAccountDetails"
															 IsEnabled="{Binding IsEdit}"
															 TextValue="{Binding KhachHangForm.MaSoThue, UpdateSourceTrigger=PropertyChanged}" />
							</Grid>

							<components:FormInputControl Title="Địa chỉ"
														 IconKind="MapMarker"
														 IsEnabled="{Binding IsEdit}"
														 TextValue="{Binding KhachHangForm.DiaChi, UpdateSourceTrigger=PropertyChanged}" />


							<components:FormInputControl Title="Công nợ hiện tại"
														 IconKind="CashMultiple"
														 IsCurrencyMode="True"
														 IsEnabled="False"
														 Visibility="{Binding IsCongNoVisible, Converter={StaticResource BoolToVis}}"
														 UnitText="đ"
														 FontWeight="Bold"
														 TextValue="{Binding KhachHangForm.CongNo, UpdateSourceTrigger=PropertyChanged}">
								<components:FormInputControl.Style>
									<Style TargetType="components:FormInputControl">
										<Setter Property="State"
												Value="Warning" />

										<Style.Triggers>
											<DataTrigger Binding="{Binding KhachHangForm.CongNo, UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:N0}, ConverterCulture=en-US}"
														 Value="0">
												<Setter Property="State"
														Value="Normal" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</components:FormInputControl.Style>
							</components:FormInputControl>
						</StackPanel>
					</ScrollViewer>

					<Border Grid.Row="2">
						<StackPanel Orientation="Horizontal"
									HorizontalAlignment="Right">
							<Button Content="HỦY BỎ"
									Command="{Binding DongPopupKhachHangCommand}"
									CommandParameter="Close"
									Width="100"
									Height="40"
									Margin="0,0,12,0"
									Cursor="Hand"
									Style="{StaticResource OutlineButtonStyle}" />

							<Button Content="LƯU THÔNG TIN"
									Command="{Binding LuuKhachHangCommand}"
									Visibility="{Binding IsEdit, Converter={StaticResource BoolToVis}}"
									CommandParameter="Save"
									Width="140"
									Height="40"
									Style="{StaticResource MainGradientButton}"
									Cursor="Hand" />
						</StackPanel>
					</Border>

				</Grid>
			</Border>
		</Grid>
	</Grid>
</UserControl>

