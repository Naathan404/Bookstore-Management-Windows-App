<UserControl x:Class="Bookstore.WPF.Views.CustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             Background="#F4F7FE"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <!-- Style -->
        <SolidColorBrush x:Key="PrimaryDarkColor" Color="#2B3674"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#4318FF"/>
        <SolidColorBrush x:Key="TextLightColor" Color="#A3AED0"/>
        <SolidColorBrush x:Key="BackgroundColor" Color="#F4F7FE"/>
        <SolidColorBrush x:Key="WhiteColor" Color="White"/>
        <SolidColorBrush x:Key="DangerColor" Color="#EF4444"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#10B981"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>

        <LinearGradientBrush x:Key="GradientButtonBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4318FF" Offset="0"/>
            <GradientStop Color="#5B3CFF" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GradientSuccessBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#10B981" Offset="0"/>
            <GradientStop Color="#059669" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="CardShadowEffect" BlurRadius="20" ShadowDepth="0" Opacity="0.08" Color="#4318FF"/>
        <DropShadowEffect x:Key="ButtonShadowEffect" BlurRadius="10" ShadowDepth="2" Opacity="0.25" Color="#4318FF"/>
        <DropShadowEffect x:Key="PopupShadowEffect" BlurRadius="30" ShadowDepth="0" Opacity="0.15" Color="#2B3674"/>

        <Style x:Key="MainGradientButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource ButtonShadowEffect}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource GradientButtonBrush}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2B3674"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E7FF"/>
                                <Setter Property="Foreground" Value="#4318FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActivePageButtonStyle" TargetType="Button" BasedOn="{StaticResource PageButtonStyle}">
            <Setter Property="Background" Value="#4318FF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundColor}">
        <Ellipse Width="600" Height="600" Fill="#4318FF" Opacity="0.03" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="-200,-200,0,0"/>
        <Ellipse Width="500" Height="500" Fill="#2B3674" Opacity="0.03" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,-150,-150"/>

        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Margin="0,0,0,16" Padding="24,16" CornerRadius="20" Background="White" Effect="{StaticResource CardShadowEffect}">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <materialDesign:PackIcon Kind="AccountGroup" Width="32" Height="32" Foreground="#4318FF" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="KHÁCH HÀNG" FontSize="26" FontWeight="Bold" Foreground="#2B3674" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="btnThemMoi" Style="{StaticResource MainGradientButton}" Width="140" HorizontalAlignment="Right" Click="btnThemKhach_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountPlus" Width="18" Height="18" Foreground="White" Margin="0,0,8,0"/>
                            <TextBlock Text="THÊM MỚI"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- FILTER -->
            <Border Grid.Row="1" Margin="0,0,0,16" Padding="20,16" CornerRadius="20" Background="White" Effect="{StaticResource CardShadowEffect}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,16,0">
                        <TextBox x:Name="txtTimKiem"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                 materialDesign:HintAssist.Hint="Tìm kiếm khách hàng..."
                                 FontSize="14" Foreground="#2B3674"
                                 TextChanged="txtTimKiem_TextChanged"/>
                        <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="#A3AED0"
                                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ComboBox x:Name="cboKieuTimKiem" Width="150" Height="48"
                                  materialDesign:HintAssist.Hint="Tìm theo"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                  FontSize="13" Foreground="#2B3674" Margin="0,0,12,0"
                                  SelectionChanged="cboKieuTimKiem_SelectionChanged">
                            <ComboBoxItem Content="Tên khách hàng" IsSelected="True"/>
                            <ComboBoxItem Content="Số điện thoại"/>
                            <ComboBoxItem Content="Email"/>
                        </ComboBox>

                        <ComboBox x:Name="cboLocLoaiKhach" Width="140" Height="48"
                                  materialDesign:HintAssist.Hint="Loại KH"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                  FontSize="13" Foreground="#2B3674" Margin="0,0,12,0"
                                  SelectionChanged="cboLocLoaiKhach_SelectionChanged">
                            <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                            <ComboBoxItem Content="Cá nhân"/>
                            <ComboBoxItem Content="Doanh nghiệp"/>
                        </ComboBox>

                        <ComboBox x:Name="cboLocCongNo" Width="160" Height="48"
                                  materialDesign:HintAssist.Hint="Công nợ"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                  FontSize="13" Foreground="#2B3674" Margin="0,0,12,0"
                                  SelectionChanged="cboLocCongNo_SelectionChanged">
                            <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                            <ComboBoxItem Content="Không nợ"/>
                            <ComboBoxItem Content="Dưới 1 triệu"/>
                            <ComboBoxItem Content="1 - 2 triệu"/>
                            <ComboBoxItem Content="2 - 3 triệu"/>
                            <ComboBoxItem Content="3 - 4 triệu"/>
                            <ComboBoxItem Content="4 - 5 triệu"/>
                            <ComboBoxItem Content="Trên 5 triệu"/>
                        </ComboBox>

                        <Border Background="#F4F7FE" CornerRadius="10" Padding="12,10" Margin="8,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Tổng:" Foreground="#A3AED0" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock x:Name="txtTongBanGhi" Text="0" FontWeight="Bold" FontSize="14" Foreground="#4318FF"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="btnXoaLoc" Width="42" Height="42"
                                Style="{StaticResource MaterialDesignIconForegroundButton}"
                                Foreground="#EF4444" ToolTip="Xóa bộ lọc"
                                Click="btnXoaLoc_Click" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FilterRemove" Width="22" Height="22"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DATAGRID -->
            <Border Grid.Row="2" Margin="0,0,0,16" Padding="20" CornerRadius="20" Background="White" Effect="{StaticResource CardShadowEffect}">
                <DataGrid x:Name="dgDanhSachKhach"
              AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow"
              HeadersVisibility="Column" BorderThickness="0" RowHeight="52"
              FontSize="13" AlternatingRowBackground="#F8FAFC" RowBackground="White"
              Foreground="#2B3674" GridLinesVisibility="Horizontal"
              HorizontalGridLinesBrush="#E2E8F0" VerticalGridLinesBrush="Transparent"
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
              CanUserResizeRows="False" CanUserReorderColumns="False">

                    <DataGrid.Resources>
                        <!-- Header Style -->
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#2B3674"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Height" Value="44"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter VerticalAlignment="Center" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  Margin="12,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- Cell Style -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter VerticalAlignment="Center" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  Margin="12,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- Row Style -->
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E0E7FF"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F3F4F6"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!-- Mã KH -->
                        <DataGridTextColumn Header="Mã KH" Binding="{Binding MaKhachHang}" Width="100">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#4318FF"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Tên KH -->
                        <DataGridTextColumn Header="Tên khách hàng" Binding="{Binding TenKhachHang}" Width="190">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- SĐT -->
                        <DataGridTextColumn Header="Số điện thoại" Binding="{Binding SoDienThoai}" Width="130">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Email -->
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Công nợ -->
                        <DataGridTextColumn Header="Công nợ" Binding="{Binding CongNo, StringFormat={}{0:N0} VNĐ}" Width="140">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Loại KH -->
                        <DataGridTextColumn Header="Loại KH" Binding="{Binding LoaiKhach}" Width="120">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LoaiKhach}" Value="VIP">
                                            <Setter Property="Foreground" Value="#F59E0B"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LoaiKhach}" Value="Doanh nghiệp">
                                            <Setter Property="Foreground" Value="#10B981"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Thu tiền -->
                        <DataGridTemplateColumn Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Height="30" FontSize="12" FontWeight="SemiBold"
                                Foreground="#059669" Background="#D1FAE5"
                                BorderThickness="0" Cursor="Hand" ToolTip="Lập phiếu thu tiền"
                                Click="btnLapPhieuThu_Click" Tag="{Binding}"
                                HorizontalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" Background="{TemplateBinding Background}" 
                                            CornerRadius="6" Padding="10,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Cash" Width="14" Height="14" 
                                                                     Foreground="#059669" Margin="0,0,5,0"/>
                                                        <TextBlock Text="Thu tiền" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#A7F3D0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Sửa -->
                        <DataGridTemplateColumn Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Width="34" Height="34" Background="#E0E7FF" 
                                BorderThickness="0" Cursor="Hand" ToolTip="Sửa"
                                Click="btnSuaKhach_Click" Tag="{Binding}"
                                HorizontalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <materialDesign:PackIcon Kind="Edit" Width="16" Height="16" 
                                                                 Foreground="#4318FF"
                                                                 HorizontalAlignment="Center" 
                                                                 VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#C7D2FE"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Xóa -->
                        <DataGridTemplateColumn Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Width="34" Height="34" Background="#FEE2E2" 
                                BorderThickness="0" Cursor="Hand" ToolTip="Xóa"
                                Click="btnXoaKhach_Click" Tag="{Binding}"
                                HorizontalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <materialDesign:PackIcon Kind="Delete" Width="16" Height="16" 
                                                                 Foreground="#EF4444"
                                                                 HorizontalAlignment="Center" 
                                                                 VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#FECACA"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- FOOTER -->
            <Border Grid.Row="3" Padding="20,12" CornerRadius="20" Background="White" Effect="{StaticResource CardShadowEffect}">
                <Grid>
                    <!-- THÊM DÒNG NÀY -->
                    <TextBlock x:Name="txtPhanTrangInfo" Text="Trang 1/1" 
                   Foreground="#A3AED0" FontSize="13" VerticalAlignment="Center" 
                   HorizontalAlignment="Left"/>

                    <StackPanel x:Name="pnlPhanTrang" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="«" Style="{StaticResource PageButtonStyle}" Click="btnTrangDau_Click"/>
                        <Button Content="‹" Style="{StaticResource PageButtonStyle}" Click="btnTrangTruoc_Click" Margin="4,0,0,0"/>
                        <Button x:Name="btnTrang1" Content="1" Style="{StaticResource ActivePageButtonStyle}" Margin="4,0,0,0" Click="btnTrangSo_Click" Tag="1"/>
                        <Button x:Name="btnTrang2" Content="2" Style="{StaticResource PageButtonStyle}" Margin="4,0,0,0" Click="btnTrangSo_Click" Tag="2" Visibility="Collapsed"/>
                        <Button x:Name="btnTrang3" Content="3" Style="{StaticResource PageButtonStyle}" Margin="4,0,0,0" Click="btnTrangSo_Click" Tag="3" Visibility="Collapsed"/>
                        <TextBlock x:Name="txtEllipsis" Text="..." Foreground="#A3AED0" FontSize="13" Margin="4,0,4,0" Visibility="Collapsed"/>
                        <Button x:Name="btnTrangCuoiSo" Content="10" Style="{StaticResource PageButtonStyle}" Margin="4,0,0,0" Click="btnTrangSo_Click" Tag="10" Visibility="Collapsed"/>
                        <Button Content="›" Style="{StaticResource PageButtonStyle}" Click="btnTrangSau_Click" Margin="8,0,0,0"/>
                        <Button Content="»" Style="{StaticResource PageButtonStyle}" Click="btnTrangCuoi_Click" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== POPUP THU TIỀN ==================== -->
        <Grid x:Name="popupThuTien" Background="#80000000" Visibility="Collapsed"
              VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="1000">
            <Border Background="#80000000" MouseLeftButtonDown="btnPopupDong_Click"/>

            <Border Width="500" Background="White" CornerRadius="16"
                    Effect="{StaticResource PopupShadowEffect}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Margin="28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <TextBlock Grid.Row="0" Text="PHIẾU THU TIỀN" FontSize="20" FontWeight="Bold" 
                               Foreground="#2B3674" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <!-- Mã phiếu -->
                    <TextBox Grid.Row="1" x:Name="txtPopupMaPhieu" 
                             materialDesign:HintAssist.Hint="Mã phiếu"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             Margin="0,0,0,12"/>

                    <!-- Ngày lập + Người lập -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker x:Name="dtpPopupNgayLap" 
            Height="40" FontSize="13"
            materialDesign:HintAssist.Hint="Ngày lập"
            VerticalAlignment="Center"/>
                        <TextBox Grid.Column="2" x:Name="txtPopupNguoiLap" 
                                 materialDesign:HintAssist.Hint="Người lập"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 Text="Admin"/>
                    </Grid>

                    <!-- Khách hàng -->
                    <TextBox Grid.Row="3" x:Name="txtPopupKhachHang" 
                             materialDesign:HintAssist.Hint="Khách hàng"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             IsReadOnly="True" Margin="0,0,0,12"/>

                    <!-- Số tiền thu -->
                    <TextBox Grid.Row="4" x:Name="txtPopupSoTienThu" 
                             materialDesign:HintAssist.Hint="Số tiền thu"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                             FontSize="16" FontWeight="Bold" Foreground="#4318FF" 
                             TextAlignment="Right" Margin="0,0,0,12"
                             TextChanged="txtPopupSoTienThu_TextChanged"/>

                    <!-- Công nợ sau khi thu -->
                    <Border Grid.Row="5" CornerRadius="8" Background="#DCFCE7" Padding="14" Margin="0,0,0,20">
                        <Grid>
                            <TextBlock Text="Công nợ sau khi thu:" Foreground="#166534" 
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtPopupConNoSauKhiThu" Text="0 VNĐ" 
                                       HorizontalAlignment="Right" Foreground="#EF4444" 
                                       FontWeight="Bold" FontSize="16"/>
                        </Grid>
                    </Border>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="HỦY" Width="100" Height="40" Margin="0,0,10,0"
                                FontSize="14" FontWeight="SemiBold" Foreground="#A3AED0"
                                Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1"
                                Cursor="Hand" Click="btnPopupDong_Click"/>
                        <Button Content="LƯU PHIẾU" Width="130" Height="40"
                                FontSize="14" FontWeight="SemiBold" Foreground="White"
                                Background="#10B981" Cursor="Hand" Click="btnPopupXacNhan_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== POPUP THÊM/SỬA KHÁCH HÀNG ==================== -->
        <Grid x:Name="popupKhachHang" Background="#80000000" Visibility="Collapsed"
              VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="1000">
            <Border Background="#80000000" MouseLeftButtonDown="btnPopupQuayLai_Click"/>

            <Border Width="620" Background="White" CornerRadius="16"
                    Effect="{StaticResource PopupShadowEffect}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="700">
                    <Grid Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <materialDesign:PackIcon x:Name="iconPopupKhachHang" Kind="AccountPlus" 
                                                     Width="24" Height="24" Foreground="#4318FF" Margin="0,0,10,0"/>
                            <TextBlock x:Name="txtPopupTitle" Text="THÊM KHÁCH HÀNG MỚI" 
                                       FontSize="18" FontWeight="Bold" Foreground="#2B3674"/>
                        </StackPanel>

                        <!-- Mã KH -->
                        <TextBox Grid.Row="1" x:Name="txtPopupMaKH" 
                                 materialDesign:HintAssist.Hint="Mã khách hàng"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                 IsReadOnly="True" Margin="0,0,0,14"/>

                        <!-- Tên + Loại -->
                        <Grid Grid.Row="2" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtPopupTenKH" 
                                     materialDesign:HintAssist.Hint="Tên khách hàng *"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                            <ComboBox Grid.Column="2" x:Name="cboPopupLoaiKH" 
                                      materialDesign:HintAssist.Hint="Loại khách hàng"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}">
                                <ComboBoxItem Content="Cá nhân" IsSelected="True"/>
                                <ComboBoxItem Content="Doanh nghiệp"/>
                            </ComboBox>
                        </Grid>

                        <!-- SĐT + Email -->
                        <Grid Grid.Row="3" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtPopupSDT" 
                                     materialDesign:HintAssist.Hint="Số điện thoại *"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                            <TextBox Grid.Column="2" x:Name="txtPopupEmail" 
                                     materialDesign:HintAssist.Hint="Email"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                        </Grid>

                        <!-- Giới tính + Ngày sinh -->
                        <Grid Grid.Row="4" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="cboPopupGioiTinh" 
                                      materialDesign:HintAssist.Hint="Giới tính"
                                      Style="{StaticResource MaterialDesignFloatingHintComboBox}">
                                <ComboBoxItem Content="Nam" IsSelected="True"/>
                                <ComboBoxItem Content="Nữ"/>
                                <ComboBoxItem Content="Khác"/>
                            </ComboBox>
                            <DatePicker Grid.Column="2" x:Name="dpPopupNgaySinh" 
            Height="40" FontSize="13"
            materialDesign:HintAssist.Hint="Ngày sinh"
            VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Địa chỉ + MST -->
                        <Grid Grid.Row="5" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtPopupDiaChi" 
                                     materialDesign:HintAssist.Hint="Địa chỉ"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                            <TextBox Grid.Column="2" x:Name="txtPopupMaSoThue" 
                                     materialDesign:HintAssist.Hint="Mã số thuế"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                        </Grid>

                        <!-- Công nợ -->
                        <Border Grid.Row="6" Background="#FEF3C7" Padding="12" CornerRadius="8" 
                                Margin="0,0,0,20" x:Name="pnlCongNo">
                            <TextBlock x:Name="txtPopupCongNo" Text="0 VNĐ" FontSize="14" 
                                       FontWeight="Bold" Foreground="#EF4444"/>
                        </Border>

                        <!-- Buttons -->
                        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="QUAY LẠI" Width="120" Height="42" Margin="0,0,10,0"
                                    FontSize="14" FontWeight="SemiBold" Foreground="#A3AED0"
                                    Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1"
                                    Cursor="Hand" Click="btnPopupQuayLai_Click"/>
                            <Button Content="LƯU" Width="120" Height="42"
                                    FontSize="14" FontWeight="SemiBold" Foreground="White"
                                    Background="#10B981" Cursor="Hand" Click="btnPopupLuu_Click"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>