<UserControl x:Class="Bookstore.WPF.Views.Popup.ReceiptPopup"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:sys="clr-namespace:System;assembly=mscorlib"
			 xmlns:vm="clr-namespace:Bookstore.WPF.ViewModels"
			 xmlns:local="clr-namespace:Bookstore.WPF.Converters"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 mc:Ignorable="d"
			 d:DataContext="{d:DesignInstance Type=vm:ReceiptPopupViewModel}">

	<UserControl.Resources>
		<local:CurrencyConverter x:Key="CurrencyConverter" />
	</UserControl.Resources>

	<Grid x:Name="popupThuTien"
		  Style="{StaticResource PopupOverlayStyle}"
		  Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">

		<Border Background="Transparent">
			<Border.InputBindings>
				<MouseBinding MouseAction="LeftClick"
							  Command="{Binding DongPopupCommand}" />
			</Border.InputBindings>
		</Border>

		<Border Width="500"
				Style="{StaticResource PopupCardStyle}">

			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<!--header-->
				<components:PopupHeaderControl Grid.Row="0"
											   Title="{Binding PopupTitle, TargetNullValue='PHIẾU THU TIỀN'}"
											   IconKind="Cash" />

				<!-- Mã phiếu thu -->
				<components:FormInputControl Title="Mã phiếu thu"
											 Grid.Row="1"
											 Visibility="{Binding IsMaPhieuVisible, Converter={StaticResource BoolToVis}}"
											 IsEnabled="False"
											 IconKind="Barcode">
					<components:FormInputControl.TextValue>
						<MultiBinding StringFormat="PT{0:ddMMyy}{1:D3}">
							<Binding Path="PhieuThuForm.NgayTao" />
							<Binding Path="PhieuThuForm.MaPhieuThuTien" />
						</MultiBinding>
					</components:FormInputControl.TextValue>
				</components:FormInputControl>


				<!--Ngày tạo, người tạo-->
				<Grid Grid.Row="2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="12" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<components:FormDatePickerControl Title="Ngày tạo"
													  SelectedDate="{Binding PhieuThuForm.NgayTao, UpdateSourceTrigger=PropertyChanged}"
													  IconKind="Calendar"
													  IsEnabled="False" />
					<components:FormInputControl Title="Người tạo"
												 Grid.Column="2"
												 IconKind="Person"
												 IsReadOnly="True"
												 IsEnabled="False"
												 TextValue="{Binding PhieuThuForm.TenNguoiTao, UpdateSourceTrigger=PropertyChanged}" />
				</Grid>

				<!--Thông tin khách hàng-->
				<components:FormComboBoxControl Title="Tên khách hàng"
												Grid.Row="3"
												ItemsSource="{Binding DanhSachKhachHangCombobox}"
												SelectedItem="{Binding SelectedKhachHangForm, UpdateSourceTrigger=PropertyChanged}"
												DisplayMemberPath="TenKhachHang"
												IconKind="Person"
												IsRequired="True"
												IsEnabled="{Binding IsKhachHangEnable}" />

				<components:FormInputControl Title="Số tiền thu"
											 Grid.Row="4"
											 TextValue="{Binding FormSoTienThu, Converter={StaticResource CurrencyConverter}, UpdateSourceTrigger=PropertyChanged}"
											 UnitText="đ"
											 IconKind="Cash"
											 IsRequired="True"
											 State="{Binding SoTienState}"
											 HelperText="{Binding SoTienHelperText}" />

				<components:FormInputControl Title="Lý do thu"
											 Grid.Row="5"
											 InputHeight="80"
											 ShowIcon="False"
											 IsMultiLine="True"
											 TextValue="{Binding PhieuThuForm.LyDoThu, UpdateSourceTrigger=PropertyChanged}" />



				<!--Nợ sau thu-->
				<Grid Grid.Row="6"
					  Margin="0,0,0,16"
					  Visibility="{Binding IsConLaiVisible, Converter={StaticResource BoolToVis}}">
					<TextBlock Text="Công nợ sau khi thu:"
							   FontWeight="SemiBold" />
					<TextBlock Text="{Binding ConNoSauKhiThu, StringFormat={}{0:N0} VNĐ}"
							   HorizontalAlignment="Right"
							   Foreground="{StaticResource DangerColor}"
							   FontWeight="Bold"
							   FontSize="16" />
				</Grid>


				<StackPanel Grid.Row="7"
							Orientation="Horizontal"
							HorizontalAlignment="Right">
					<Button Content="HỦY"
							Width="60"
							Margin="0,0,10,0"
							Style="{StaticResource OutlineButtonStyle}"
							Command="{Binding DongPopupCommand}"
							CommandParameter="{Binding}" />
					<Button Content="LƯU PHIẾU"
							Width="100"
							Style="{StaticResource MainGradientButton}"
							Command="{Binding LuuPhieuThuCommand}"
							CommandParameter="{Binding}" />
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</UserControl>