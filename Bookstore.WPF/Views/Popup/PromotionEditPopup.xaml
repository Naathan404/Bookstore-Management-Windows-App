<UserControl x:Class="Bookstore.WPF.Views.Popup.PromotionEditPopup"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 xmlns:enums="clr-namespace:Bookstore.Share.Enums;assembly=Bookstore.Share"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

	<components:FormPopupControl Title="{Binding PopupTitle, FallbackValue='LẬP PHIẾU THÔNG TIN ƯU ĐÃI'}"
								 IconKind="TicketPercent"
								 IsOpen="{Binding IsPopupVisible}"
								 CloseCommand="{Binding ClosePopupCommand}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<ScrollViewer Grid.Row="0"
						  VerticalScrollBarVisibility="Auto"
						  Margin="0,0,0,15"
						  Padding="0,0,10,0">
				<StackPanel>
					<TextBlock Text="1. THÔNG TIN CHUNG"
							   FontSize="16"
							   FontWeight="Bold"
							   Foreground="{StaticResource PrimaryColor}"
							   Margin="0,8,0,8" />
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="20" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0">
							<components:FormInputControl Title="Tên chương trình"
														 TextValue="{Binding EditingPromotion.TenChuongTrinh, UpdateSourceTrigger=PropertyChanged}"
														 IsRequired="True" />

							<components:FormInputControl Title="Mã ưu đãi (Voucher Code)"
														 IconKind="Barcode"
														 IsEnabled="{Binding IsCoreEditingAllowed}"
														 TextValue="{Binding EditingPromotion.Code, UpdateSourceTrigger=PropertyChanged}"
														 IsRequired="True"
														 Foreground="{StaticResource PrimaryColor}"
														 FontWeight="Bold" />

							<components:FormComboBoxControl Title="Loại khách hàng áp dụng"
															IsRequired="True"
															ItemsSource="{Binding ListLoaiKhachHang}"
															SelectedValue="{Binding EditingPromotion.MaLoaiKhachHang, UpdateSourceTrigger=PropertyChanged}"
															DisplayMemberPath="TenLoaiKhachHang"
															SelectedValuePath="MaLoaiKhachHang"
															IconKind="AccountGroup"
															IsEnabled="{Binding IsCoreEditingAllowed}" />
						</StackPanel>

						<StackPanel Grid.Column="2">
							<components:FormDatePickerControl Title="Ngày có hiệu lực"
															  IsRequired="True"
															  HintText="Chọn ngày..."
															  IconKind="CalendarStart"
															  SelectedDate="{Binding EditingPromotion.NgayBatDau, UpdateSourceTrigger=PropertyChanged}" 
                                                              IsEnabled="{Binding IsCoreEditingAllowed}"/>
							<components:FormDatePickerControl Title="Ngày hết hạn"
															  IsRequired="True"
															  IconKind="CalendarEnd"
															  HintText="Chọn ngày..."
															  SelectedDate="{Binding EditingPromotion.NgayKetThuc, UpdateSourceTrigger=PropertyChanged}" />
							<components:FormInputControl Title="Số lượng phát hành tối đa"
														 TextValue="{Binding EditingPromotion.SoLuongToiDa, UpdateSourceTrigger=PropertyChanged}"
														 IsRequired="True"
														 UnitText="lượt"
														 IconKind="Counter" />
						</StackPanel>
					</Grid>

					<components:FormInputControl Title="Mô tả chương trình"
												 TextValue="{Binding EditingPromotion.MoTa, UpdateSourceTrigger=PropertyChanged}"
												 InputHeight="84"
												 IsMultiLine="True"
												 ShowIcon="False" />

					<TextBlock Text="2. CẤU HÌNH LOẠI ƯU ĐÃI"
							   FontSize="16"
							   FontWeight="Bold"
							   Foreground="{StaticResource PrimaryColor}"
							   Margin="0,8,0,8" />

					<components:FormComboBoxControl Title="Loại ưu đãi"
													IsRequired="True"
													IconKind="TagOutline"
													ItemsSource="{Binding AvailablePromotionTypes}"
													SelectedValue="{Binding SelectedMaLoaiUuDai, UpdateSourceTrigger=PropertyChanged}"
													SelectedValuePath="MaLoaiUuDai"
													DisplayMemberPath="TenLoaiUuDai"
													IsEnabled="{Binding IsCoreEditingAllowed}" />

					<StackPanel>
						<StackPanel.Style>
							<Style TargetType="StackPanel">
								<Setter Property="Visibility"
										Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding SelectedMaLoaiUuDai}"
												 Value="{x:Static enums:PromotionType.SachQua}">
										<Setter Property="Visibility"
												Value="Visible" />
									</DataTrigger>
									<DataTrigger Binding="{Binding SelectedMaLoaiUuDai}"
												 Value="{x:Static enums:PromotionType.SachGiam}">
										<Setter Property="Visibility"
												Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</StackPanel.Style>

						<TextBlock Text="ĐIỀU KIỆN ÁP DỤNG KHI MUA SÁCH"
								   FontWeight="Bold"
								   Foreground="{StaticResource DangerColor}"
								   Margin="4,0,0,8" />

						<Grid IsEnabled="{Binding IsCoreEditingAllowed}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="2*" />
								<ColumnDefinition Width="20" />
								<ColumnDefinition Width="1*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<components:FormComboBoxControl ItemsSource="{Binding ListSach}"
															SelectedValue="{Binding TempIsbnDieuKien, UpdateSourceTrigger=PropertyChanged}"
															DisplayMemberPath="TenSach"
															SelectedValuePath="ISBN"
															Title="Chọn sách yêu cầu"
															IconKind="Book"
															IsEditable="True" />
							<components:FormInputControl Grid.Column="2"
														 TextValue="{Binding TempSoLuongDieuKien, UpdateSourceTrigger=PropertyChanged}"
														 IconKind="Counting4"
														 UnitText="quyển"
														 Title="Số lượng" />
							<Button Grid.Column="3"
									Command="{Binding AddSachDieuKienCommand}"
									CommandParameter="{Binding}"
									Height="42"
									Width="42"
									Margin="12,0,0,0"
									Style="{StaticResource MiniAddButtonStyle}">
								<Button.Content>
									<materialDesign:PackIcon Kind="Add"
															 Width="22"
															 Height="22" />
								</Button.Content>
							</Button>
							<!--<Button Grid.Column="3"
									Content="THÊM"
									Command="{Binding AddSachDieuKienCommand}"
									VerticalAlignment="Bottom"
									Margin="12,0,0,10"
									Style="{StaticResource MaterialDesignRaisedButton}"
									Background="{StaticResource PrimaryColor}" />-->
						</Grid>

						<ItemsControl ItemsSource="{Binding UI_DanhSachSachDieuKien}"
									  Margin="0,8,0,16">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Style="{StaticResource CardStyle}"
											CornerRadius="12"
											Padding="12,8"
											Margin="0,0,0,8">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>

											<!-- CỘT TRÁI: TÊN SÁCH VÀ MÃ ISBN -->
											<StackPanel Grid.Column="0"
														VerticalAlignment="Center"
														Margin="0,0,12,0">
												<TextBlock Text="{Binding TenSach}"
														   FontWeight="Bold"
														   FontSize="13"
														   TextTrimming="CharacterEllipsis"
														   Foreground="{StaticResource PrimaryDarkColor}" />

												<TextBlock Text="{Binding ISBN, StringFormat='ISBN: {0}'}"
														   FontSize="11"
														   FontWeight="SemiBold"
														   Foreground="{StaticResource TextLightColor}"
														   Opacity="0.8"
														   Margin="0,2,0,0" />
											</StackPanel>

											<!-- CỘT PHẢI: SỐ LƯỢNG VÀ NÚT XÓA -->
											<StackPanel Grid.Column="1"
														Orientation="Horizontal"
														VerticalAlignment="Center">
												<TextBlock Text="{Binding SoLuongMua, StringFormat='Yêu cầu: {0} quyển'}"
														   VerticalAlignment="Center"
														   Margin="0,0,16,0"
														   Foreground="{StaticResource WarningColor}"
														   FontWeight="Bold" />

												<Button Style="{StaticResource MiniDeleteButtonStyle}"
														Command="{Binding DataContext.RemoveSachTangCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
														CommandParameter="{Binding}"
														IsEnabled="{Binding DataContext.IsCoreEditingAllowed, RelativeSource={RelativeSource AncestorType=UserControl}}">
													<materialDesign:PackIcon Kind="Close"
																			 Width="14"
																			 Height="14" />
												</Button>
											</StackPanel>
										</Grid>
									</Border>
								</DataTemplate>
								<!--<DataTemplate>
									<Border Background="#F8FAFC"
											BorderBrush="#E2E8F0"
											BorderThickness="1"
											CornerRadius="4"
											Padding="8"
											Margin="0,0,0,4">
										<Grid>
											<TextBlock Text="{Binding ISBN, StringFormat='Mã ISBN: {0}'}"
													   VerticalAlignment="Center"
													   FontWeight="SemiBold" />
											<StackPanel Orientation="Horizontal"
														HorizontalAlignment="Right">
												<TextBlock Text="{Binding SoLuongMua, StringFormat='Yêu cầu mua: {0} cuốn'}"
														   VerticalAlignment="Center"
														   Margin="0,0,16,0"
														   Foreground="{StaticResource WarningColor}"
														   FontWeight="Bold" />
												<Button Style="{StaticResource MiniDeleteButtonStyle}"
														Command="{Binding DataContext.RemoveSachDieuKienCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
														CommandParameter="{Binding}"
														IsEnabled="{Binding DataContext.IsCoreEditingAllowed, RelativeSource={RelativeSource AncestorType=UserControl}}">
													<materialDesign:PackIcon Kind="Close"
																			 Width="14"
																			 Height="14" />
												</Button>
											</StackPanel>
										</Grid>
									</Border>
								</DataTemplate>-->
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>

					<StackPanel>
						<StackPanel.Style>
							<Style TargetType="StackPanel">
								<Setter Property="Visibility"
										Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding SelectedMaLoaiUuDai}"
												 Value="{x:Static enums:PromotionType.HoaDonQua}">
										<Setter Property="Visibility"
												Value="Visible" />
									</DataTrigger>
									<DataTrigger Binding="{Binding SelectedMaLoaiUuDai}"
												 Value="{x:Static enums:PromotionType.HoaDonGiam}">
										<Setter Property="Visibility"
												Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</StackPanel.Style>

						<TextBlock Text="ĐIỀU KIỆN ÁP DỤNG CHO HÓA ĐƠN"
								   FontWeight="Bold"
								   Foreground="{StaticResource DangerColor}"
								   Margin="4,0,0,8" />

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="20" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<components:FormInputControl Grid.Column="0"
														 Title="Số tiền hóa đơn tối thiểu"
														 TextValue="{Binding EditingPromotion.SoTienToiThieu, UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:N0}, ConverterCulture=en-US}"
														 IsRequired="True"
														 IsCurrencyMode="True"
														 UnitText="đ"
														 IconKind="Download"
														 IsEnabled="{Binding IsCoreEditingAllowed}" />
							<components:FormInputControl Grid.Column="2"
														 Title="Số tiền hóa đơn tối đa"
														 IsCurrencyMode="True"
														 TextValue="{Binding EditingPromotion.SoTienToiDa, UpdateSourceTrigger=PropertyChanged,StringFormat={}{0:N0}, ConverterCulture=en-US}"
														 IsRequired="True"
														 UnitText="đ"
														 IconKind="Upload"
														 IsEnabled="{Binding IsCoreEditingAllowed}" />
						</Grid>
					</StackPanel>

					<StackPanel>
						<StackPanel.Style>
							<Style TargetType="StackPanel">
								<Setter Property="Visibility"
										Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding SelectedMaLoaiUuDai}"
												 Value="{x:Static enums:PromotionType.HoaDonGiam}">
										<Setter Property="Visibility"
												Value="Visible" />
									</DataTrigger>
									<DataTrigger Binding="{Binding SelectedMaLoaiUuDai}"
												 Value="{x:Static enums:PromotionType.SachGiam}">
										<Setter Property="Visibility"
												Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</StackPanel.Style>

						<TextBlock Text="CẤU HÌNH GIẢM GIÁ"
								   FontWeight="Bold"
								   Foreground="{StaticResource DangerColor}"
								   Margin="4,0,0,8" />


						<StackPanel>

							<RadioButton Content="Giảm tiền mặt trực tiếp"
										 GroupName="DiscountType"
										 IsChecked="{Binding IsGiamTienMode}"
										 IsEnabled="{Binding IsCoreEditingAllowed}"
										 FontWeight="SemiBold"
										 Foreground="{StaticResource PrimaryDarkColor}"
										 FontSize="14"
										 Margin="0,0,0,0" />

							<Grid IsEnabled="{Binding IsGiamTienMode}"
								  Margin="26,0,0,0">
								<components:FormInputControl Title="Số tiền giảm"
															 IconKind="Cash"
															 UnitText="đ"
															 IsCurrencyMode="True"
															 TextValue="{Binding EditingPromotion.SoTienGiam, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}, ConverterCulture=en-US}"
															 IsEnabled="{Binding IsCoreEditingAllowed}" />
							</Grid>

							<RadioButton Content="Giảm theo phần trăm (%)"
										 GroupName="DiscountType"
										 IsChecked="{Binding IsGiamPhanTramMode}"
										 IsEnabled="{Binding IsCoreEditingAllowed}"
										 FontWeight="SemiBold"
										 Foreground="{StaticResource PrimaryDarkColor}"
										 FontSize="14"
										 Margin="0,0,0,0" />

							<Grid IsEnabled="{Binding IsGiamPhanTramMode}"
								  Margin="26,0,0,0">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="20" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<components:FormInputControl Grid.Column="0"
															 Title="Tỉ lệ giảm"
															 UnitText="%"
															 IconKind="Discount"
															 TextValue="{Binding EditingPromotion.TiLeGiam, UpdateSourceTrigger=PropertyChanged}"
															 IsEnabled="{Binding IsCoreEditingAllowed}" />
								<components:FormInputControl Grid.Column="2"
															 Title="Giảm tối đa"
															 UnitText="đ"
															 IsCurrencyMode="True"
															 TextValue="{Binding EditingPromotion.GiamToiDa, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}, ConverterCulture=en-US}"
															 IsEnabled="{Binding IsCoreEditingAllowed}" />
							</Grid>

						</StackPanel>

					</StackPanel>

					<StackPanel>
						<StackPanel.Style>
							<Style TargetType="StackPanel">
								<Setter Property="Visibility"
										Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding SelectedMaLoaiUuDai}"
												 Value="{x:Static enums:PromotionType.HoaDonQua}">
										<Setter Property="Visibility"
												Value="Visible" />
									</DataTrigger>
									<DataTrigger Binding="{Binding SelectedMaLoaiUuDai}"
												 Value="{x:Static enums:PromotionType.SachQua}">
										<Setter Property="Visibility"
												Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</StackPanel.Style>

						<TextBlock Text="DANH SÁCH QUÀ TẶNG"
								   FontWeight="Bold"
								   Foreground="{StaticResource DangerColor}"
								   Margin="4,0,0,8" />

						<Grid IsEnabled="{Binding IsCoreEditingAllowed}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="2*" />
								<ColumnDefinition Width="20" />
								<ColumnDefinition Width="1*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<components:FormComboBoxControl ItemsSource="{Binding ListSach}"
															SelectedValue="{Binding TempIsbnTang, UpdateSourceTrigger=PropertyChanged}"
															DisplayMemberPath="TenSach"
															SelectedValuePath="ISBN"
															Title="Chọn sách làm quà"
															IconKind="Gift"
															IsEditable="True" />
							<components:FormInputControl Grid.Column="2"
														 TextValue="{Binding TempSoLuongTang, UpdateSourceTrigger=PropertyChanged}"
														 IconKind="Counting4"
														 UnitText="quyển"
														 Title="Số lượng tặng" />
							<Button Grid.Column="3"
									Command="{Binding AddSachTangCommand}"
									CommandParameter="{Binding}"
									Height="42"
									Width="42"
									Margin="12,0,0,0"
									Style="{StaticResource MiniAddButtonStyle}">
								<Button.Content>
									<materialDesign:PackIcon Kind="Add"
															 Width="22"
															 Height="22" />
								</Button.Content>
							</Button>
						</Grid>

						<ItemsControl ItemsSource="{Binding UI_DanhSachSachTang}"
									  Margin="0,8,0,0">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Style="{StaticResource CardStyle}"
											CornerRadius="12"
											Padding="12,8"
											Margin="0,0,0,8">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>

											<!-- CỘT TRÁI: TÊN SÁCH VÀ MÃ ISBN -->
											<StackPanel Grid.Column="0"
														VerticalAlignment="Center"
														Margin="0,0,12,0">
												<TextBlock Text="{Binding TenSach}"
														   FontWeight="Bold"
														   FontSize="13"
														   TextTrimming="CharacterEllipsis"
														   Foreground="{StaticResource PrimaryDarkColor}" />

												<TextBlock Text="{Binding ISBN, StringFormat='ISBN: {0}'}"
														   FontSize="11"
														   FontWeight="SemiBold"
														   Foreground="{StaticResource TextLightColor}"
														   Opacity="0.8"
														   Margin="0,2,0,0" />
											</StackPanel>

											<!-- CỘT PHẢI: SỐ LƯỢNG VÀ NÚT XÓA -->
											<StackPanel Grid.Column="1"
														Orientation="Horizontal"
														VerticalAlignment="Center">
												<TextBlock Text="{Binding SoLuongTang, StringFormat='Tặng: {0} quyển'}"
														   VerticalAlignment="Center"
														   Margin="0,0,16,0"
														   Foreground="{StaticResource SuccessColor}"
														   FontWeight="Bold" />

												<Button Style="{StaticResource MiniDeleteButtonStyle}"
														Command="{Binding DataContext.RemoveSachTangCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
														CommandParameter="{Binding}"
														IsEnabled="{Binding DataContext.IsCoreEditingAllowed, RelativeSource={RelativeSource AncestorType=UserControl}}">
													<materialDesign:PackIcon Kind="Close"
																			 Width="14"
																			 Height="14" />
												</Button>
											</StackPanel>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>

				</StackPanel>
			</ScrollViewer>

			<Grid Grid.Row="1">
				<StackPanel Orientation="Horizontal"
							HorizontalAlignment="Right">
					<Button Content="HỦY BỎ"
							Command="{Binding ClosePopupCommand}"
							CommandParameter="{Binding}"
							Width="80"
							Margin="0,0,12,0"
							Style="{StaticResource OutlineButtonStyle}" />
					<Button Content="{Binding SaveButtonText}"
							Command="{Binding SavePromotionCommand}"
							Style="{StaticResource MainGradientButton}"
							CommandParameter="{Binding}"
							Width="150"
							FontSize="13"
							FontWeight="SemiBold"
							Cursor="Hand" />
				</StackPanel>
			</Grid>
		</Grid>
	</components:FormPopupControl>
</UserControl>