<UserControl x:Class="Bookstore.WPF.Views.Popup.BookDetailPopup"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components">

	<Grid Style="{StaticResource PopupOverlayStyle}"
		  Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">

		<Border Background="Transparent">
			<Border.InputBindings>
				<MouseBinding MouseAction="LeftClick"
							  Command="{Binding CloseCommand}" />
			</Border.InputBindings>
		</Border>

		<Border Width="550"
				Padding="24"
				Style="{StaticResource PopupCardStyle}">
			<StackPanel>
				<components:PopupHeaderControl Grid.Row="0"
											   Title="CHI TIẾT SÁCH"
											   IconKind="Book" />
				<!--<Grid Margin="0,0,0,16">
					<TextBlock Text="CHI TIẾT SẢN PHẨM"
							   FontSize="18"
							   FontWeight="Bold"
							   Foreground="#2B3674" />
					<Button HorizontalAlignment="Right"
							Style="{StaticResource MaterialDesignFlatButton}"
							Foreground="Gray"
							Command="{Binding CloseCommand}">
						<materialDesign:PackIcon Kind="Close" />
					</Button>
				</Grid>-->

				<Border CornerRadius="8"
						ClipToBounds="True"
						HorizontalAlignment="Center"
						Margin="0,0,0,16"
						Background="#F4F7FE"
						Width="160"
						Height="200">
					<Image Source="{Binding BookDetails.HinhAnh}"
						   Stretch="UniformToFill"
						   RenderOptions.BitmapScalingMode="HighQuality" />
				</Border>

				<Grid Margin="0,0,0,8">
					<TextBlock Text="Tên sách:"
							   Foreground="#A3AED0" />
					<TextBlock Text="{Binding BookDetails.TenSach}"
							   HorizontalAlignment="Right"
							   FontWeight="Bold"
							   Foreground="#2B3674" />
				</Grid>
				<Grid Margin="0,0,0,8">
					<TextBlock Text="Mã ISBN:"
							   Foreground="#A3AED0" />
					<TextBlock Text="{Binding BookDetails.ISBN}"
							   HorizontalAlignment="Right"
							   Foreground="#2B3674" />
				</Grid>
				<Grid Margin="0,0,0,8">
					<TextBlock Text="Thể loại:"
							   Foreground="#A3AED0" />
					<TextBlock Text="{Binding BookDetails.TheLoai}"
							   HorizontalAlignment="Right"
							   Foreground="#2B3674" />
				</Grid>
				<Grid Margin="0,0,0,16">
					<TextBlock Text="Giá bán:"
							   Foreground="#A3AED0" />
					<TextBlock Text="{Binding BookDetails.DonGiaBan, StringFormat='{}{0:N0} đ'}"
							   HorizontalAlignment="Right"
							   Foreground="#EF4444"
							   FontWeight="Bold" />
				</Grid>

				<Button Content="Thêm vào giỏ hàng"
						Style="{StaticResource MainGradientButton}"
						Command="{Binding AddToCartCommand}" />
			</StackPanel>
		</Border>
	</Grid>
</UserControl>