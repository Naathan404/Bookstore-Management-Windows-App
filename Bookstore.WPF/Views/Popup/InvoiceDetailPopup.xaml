<UserControl x:Class="Bookstore.WPF.Views.Popup.InvoiceDetailPopup"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components">

	<UserControl.Resources>
		<Style x:Key="Content"
			   TargetType="TextBlock">
			<Setter Property="FontSize"
					Value="13" />
			<Setter Property="Foreground"
					Value="{StaticResource TextLightColor}" />
		</Style>
	</UserControl.Resources>

	<Grid Style="{StaticResource PopupOverlayStyle}"
		  Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">

		<Border Background="Transparent">
			<Border.InputBindings>
				<MouseBinding MouseAction="LeftClick"
							  CommandParameter="{Binding}"
							  Command="{Binding CloseCommand}" />
			</Border.InputBindings>
		</Border>

		<Border Width="600"
				Height="600"
				Style="{StaticResource PopupCardStyle}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<components:PopupHeaderControl Grid.Row="0"
											   Title="CHI TIẾT HÓA ĐƠN"
											   IconKind="ReceiptText" />

				<ScrollViewer Grid.Row="1"
							  VerticalScrollBarVisibility="Auto"
							  PanningMode="VerticalOnly"
							  Margin="0,0,0,16">
					<StackPanel x:Name="InvoicePrintArea"
								
								Background="White">


						<TextBlock Text="THÔNG TIN HÓA ĐƠN"
								   Foreground="{StaticResource PrimaryDarkColor}"
								   FontWeight="Bold"
								   Margin="0,0,0,8"
								   FontSize="14" />
						<Border Padding="16,0"
								Margin="0,0,0,16">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

								<StackPanel Grid.Column="0">
									<TextBlock Text="Khách hàng:"
											   Style="{StaticResource Content}" />
									<TextBlock Text="{Binding InvoiceInfo.TenKhachHang}"
											   FontWeight="Bold"
											   Foreground="{StaticResource PrimaryDarkColor}"
											   FontSize="14"
											   Margin="0,0,0,8" />

									<TextBlock Text="Người tạo:"
											   Style="{StaticResource Content}" />
									<TextBlock Text="{Binding InvoiceInfo.TenNguoiTao}"
											   Foreground="{StaticResource PrimaryDarkColor}"
											   FontSize="14"
											   Margin="0,0,0,0" />
								</StackPanel>

								<StackPanel Grid.Column="1">
									<TextBlock Text="Mã hóa đơn:"
											   Style="{StaticResource Content}" />
									<TextBlock FontWeight="Bold"
											   Foreground="{StaticResource PrimaryColor}"
											   FontSize="14"
											   Margin="0,0,0,8">
										<TextBlock.Text>
											<MultiBinding StringFormat="HD{0:ddMMyy}{1:D3}">
												<Binding Path="InvoiceInfo.NgayTao" />
												<Binding Path="InvoiceInfo.MaHoaDon" />
											</MultiBinding>
										</TextBlock.Text>
									</TextBlock>

									<TextBlock Text="Ngày tạo:"
											   Style="{StaticResource Content}" />
									<TextBlock Text="{Binding InvoiceInfo.NgayTao, StringFormat='HH:mm - dd/MM/yyyy'}"
											   Foreground="{StaticResource PrimaryDarkColor}"
											   FontSize="14"
											   Margin="0,0,0,0" />
								</StackPanel>
							</Grid>
						</Border>

						<TextBlock Text="DANH SÁCH SẢN PHẨM"
								   Foreground="{StaticResource PrimaryDarkColor}"
								   FontWeight="Bold"
								   Margin="0,0,0,8"
								   FontSize="14" />
						<Border Style="{StaticResource DarkCardStyle}"
								Padding="16"
								Margin="0,0,0,16">
							<ItemsControl ItemsSource="{Binding DanhSachSanPham}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Padding="0,8">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="40" />
													<ColumnDefinition Width="100" />
												</Grid.ColumnDefinitions>

												<StackPanel Grid.Column="0"
															VerticalAlignment="Center"
															Margin="0,0,12,0">
													<TextBlock Text="{Binding TenSach}"
															   Foreground="{StaticResource PrimaryDarkColor}"
															   FontWeight="Bold"
															   TextTrimming="CharacterEllipsis"
															   FontSize="13" />
													<TextBlock Text="{Binding ISBN, StringFormat='ISBN: {0}'}"
															   Foreground="{StaticResource TextLightColor}"
															   FontSize="11"
															   Margin="0,2,0,0" />
													<TextBlock Text="🎁 Quà tặng"
															   Foreground="{StaticResource SuccessColor}"
															   FontSize="11"
															   FontWeight="Bold"
															   Margin="0,2,0,0"
															   Visibility="{Binding IsGift, Converter={StaticResource BoolToVis}}" />
												</StackPanel>

												<TextBlock Grid.Column="1"
														   Text="{Binding SoLuong, StringFormat='x{0}'}"
														   Foreground="{StaticResource TextLightColor}"
														   TextAlignment="Center"
														   VerticalAlignment="Center" />

												<Grid Grid.Column="2"
													  VerticalAlignment="Center"
													  HorizontalAlignment="Right">
													<TextBlock Text="{Binding GiaBan, StringFormat='{}{0:N0} đ'}"
															   Foreground="{StaticResource PrimaryColor}"
															   FontWeight="Bold"
															   HorizontalAlignment="Right"
															   Visibility="{Binding IsNormalPrice, Converter={StaticResource BoolToVis}}" />
													<StackPanel Visibility="{Binding HasPromotion, Converter={StaticResource BoolToVis}}">
														<TextBlock Text="{Binding GiaBan, StringFormat='{}{0:N0} đ'}"
																   Foreground="{StaticResource DangerColor}"
																   FontWeight="Bold"
																   HorizontalAlignment="Right" />
														<TextBlock Text="{Binding GiaNiemYet, StringFormat='{}{0:N0} đ'}"
																   Foreground="{StaticResource TextLightColor}"
																   FontSize="11"
																   TextDecorations="Strikethrough"
																   HorizontalAlignment="Right"
																   Margin="0,2,0,0" />
													</StackPanel>
													<TextBlock Text="0 đ"
															   Foreground="{StaticResource SuccessColor}"
															   FontWeight="Bold"
															   HorizontalAlignment="Right"
															   Visibility="{Binding IsGift, Converter={StaticResource BoolToVis}}" />
												</Grid>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Border>

						<StackPanel Visibility="{Binding DanhSachUuDai.Count, Converter={StaticResource InvertZeroToVis}, FallbackValue=Collapsed}">
							<TextBlock Text="ƯU ĐÃI ĐÃ ÁP DỤNG"
									   Foreground="{StaticResource PrimaryDarkColor}"
									   FontWeight="Bold"
									   Margin="0,0,0,8"
									   FontSize="14" />
							<ItemsControl ItemsSource="{Binding DanhSachUuDai}"
										  Margin="0,0,0,16">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Padding="16,0"
												Margin="0,0,0,8">
											<Grid>
												<Grid.RowDefinitions>
													<RowDefinition Height="Auto" />
													<RowDefinition Height="Auto" />
												</Grid.RowDefinitions>
												<Grid Grid.Row="0">
													<TextBlock Text="{Binding Code}"
															   Foreground="{StaticResource PrimaryColor}"
															   FontWeight="Bold"
															   FontSize="13" />
													<TextBlock Text="{Binding SoTienGiamHienThi}"
															   Foreground="{StaticResource SuccessColor}"
															   FontWeight="Bold"
															   HorizontalAlignment="Right"
															   FontSize="13" />
												</Grid>
												<TextBlock Text="{Binding TenUuDai}"
														   Grid.Row="1"
														   Foreground="{StaticResource TextLightColor}"
														   FontSize="13" />
											</Grid>
										</Border>
									</DataTemplate>

								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>

						<TextBlock Text="THÔNG TIN THANH TOÁN"
								   Foreground="{StaticResource PrimaryDarkColor}"
								   FontWeight="Bold"
								   Margin="0,0,0,8"
								   FontSize="14" />

						<Border Style="{StaticResource DarkCardStyle}"
								Padding="16">
							<StackPanel>
								<Grid Margin="0,0,0,8">
									<TextBlock Text="Tổng tiền tạm tính:"
											   Foreground="{StaticResource PrimaryDarkColor}"
											   FontSize="14" />
									<TextBlock Text="{Binding InvoiceInfo.TongTienTamTinh, StringFormat='{}{0:N0} đ'}"
											   HorizontalAlignment="Right"
											   FontWeight="Bold"
											   Foreground="{StaticResource PrimaryDarkColor}"
											   FontSize="14" />
								</Grid>

								<Grid Margin="0,0,0,12"
									  Visibility="{Binding InvoiceInfo.GiamGia, Converter={StaticResource InvertZeroToVis}}">
									<TextBlock Text="Tổng khuyến mãi:"
											   Foreground="{StaticResource PrimaryDarkColor}"
											   FontSize="14" />
									<TextBlock Text="{Binding InvoiceInfo.GiamGia, StringFormat='-{0:N0} đ'}"
											   HorizontalAlignment="Right"
											   FontWeight="Bold"
											   Foreground="{StaticResource SuccessColor}"
											   FontSize="14" />
								</Grid>

								<Grid Margin="0,0,0,12"
									  Visibility="{Binding InvoiceInfo.Thue, Converter={StaticResource InvertZeroToVis}}">
									<TextBlock Text="Thuế VAT:"
											   Foreground="{StaticResource PrimaryDarkColor}"
											   FontSize="14" />
									<TextBlock Text="{Binding InvoiceInfo.Thue, StringFormat='+ {0:N0} đ'}"
											   HorizontalAlignment="Right"
											   FontWeight="Bold"
											   Foreground="{StaticResource WarningColor}"
											   FontSize="14" />
								</Grid>

								<Border BorderBrush="#E2E8F0"
										BorderThickness="0,1,0,0"
										Margin="0,0,0,12"
										Padding="0,12,0,0">
									<Grid>
										<TextBlock Text="THÀNH TIỀN:"
												   Foreground="{StaticResource PrimaryDarkColor}"
												   FontWeight="Bold"
												   FontSize="14"
												   VerticalAlignment="Center" />
										<TextBlock Text="{Binding InvoiceInfo.TongTien, StringFormat='{}{0:N0} đ'}"
												   HorizontalAlignment="Right"
												   FontWeight="Black"
												   Foreground="{StaticResource DangerColor}"
												   FontSize="18" />
									</Grid>
								</Border>

								<Grid Margin="0,0,0,8">
									<TextBlock Text="Khách đã thanh toán:"
											   Foreground="{StaticResource PrimaryDarkColor}"
											   FontSize="14" />
									<TextBlock Text="{Binding InvoiceInfo.SoTienTra, StringFormat='{}{0:N0} đ'}"
											   HorizontalAlignment="Right"
											   FontWeight="Bold"
											   Foreground="{StaticResource PrimaryColor}"
											   FontSize="14" />
								</Grid>

								<Grid Visibility="{Binding InvoiceInfo.ConLai, Converter={StaticResource InvertZeroToVis}}">
									<TextBlock Text="Khách còn nợ:"
											   Foreground="{StaticResource PrimaryDarkColor}"
											   FontSize="14" />
									<TextBlock Text="{Binding InvoiceInfo.ConLai, StringFormat='{}{0:N0} đ'}"
											   HorizontalAlignment="Right"
											   FontWeight="Bold"
											   Foreground="{StaticResource DangerColor}"
											   FontSize="14" />
								</Grid>
							</StackPanel>
						</Border>

					</StackPanel>
				</ScrollViewer>

				<StackPanel Grid.Row="2"
							Orientation="Horizontal"
							HorizontalAlignment="Right"
							Margin="0,8,0,0">

					<Button Content="ĐÓNG"
							Style="{StaticResource OutlineButtonStyle}"
							Margin="0,0,12,0"
							Width="80"
							CommandParameter="{Binding}"
							Command="{Binding CloseCommand}" />
					<Button Content="TẢI HÓA ĐƠN"
							Style="{StaticResource MainGradientButton}"
							Width="120"
							CommandParameter="{Binding ElementName=InvoicePrintArea}"
							Command="{Binding TaiHoaDonCommand}" />
				</StackPanel>


			</Grid>
		</Border>
	</Grid>
</UserControl>