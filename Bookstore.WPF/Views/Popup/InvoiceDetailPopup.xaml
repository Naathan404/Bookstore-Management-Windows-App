<UserControl x:Class="Bookstore.WPF.Views.Popup.InvoiceDetailPopup"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components">

	<Grid Style="{StaticResource PopupOverlayStyle}"
		  Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">

		<Border Background="Transparent">
			<Border.InputBindings>
				<MouseBinding MouseAction="LeftClick"
							  Command="{Binding CloseCommand}"
							  CommandParameter="{Binding}" />
			</Border.InputBindings>
		</Border>

		<Border Width="650"
				MaxHeight="750"
				Style="{StaticResource PopupCardStyle}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<components:PopupHeaderControl Grid.Row="0"
											   Title="CHI TIẾT HÓA ĐƠN"
											   IconKind="ReceiptText" />

				<ScrollViewer Grid.Row="1"
							  VerticalScrollBarVisibility="Auto"
							  Margin="0,0,0,16">
					<StackPanel Margin="0,0,12,0">
						<Grid Margin="0,0,0,16">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0">
								<TextBlock Text="Khách hàng:"
										   Foreground="{StaticResource TextLightColor}" />
								<TextBlock Text="{Binding InvoiceInfo.TenKhachHang}"
										   FontWeight="Bold"
										   Foreground="{StaticResource PrimaryDarkColor}"
										   FontSize="14"
										   Margin="0,4,0,8" />

								<TextBlock Text="Người tạo:"
										   Foreground="{StaticResource TextLightColor}" />
								<TextBlock Text="{Binding InvoiceInfo.TenNguoiTao}"
										   Foreground="{StaticResource PrimaryDarkColor}"
										   FontSize="14"
										   Margin="0,4,0,0" />
							</StackPanel>

							<StackPanel Grid.Column="1">
								<TextBlock Text="Mã hóa đơn:"
										   Foreground="{StaticResource TextLightColor}" />
								<TextBlock FontWeight="Bold"
										   Foreground="{StaticResource PrimaryColor}"
										   FontSize="14"
										   Margin="0,4,0,8">
									<TextBlock.Text>
										<MultiBinding StringFormat="HD{0:ddMMyy}{1:D3}">
											<Binding Path="InvoiceInfo.NgayTao" />
											<Binding Path="InvoiceInfo.MaHoaDon" />
										</MultiBinding>
									</TextBlock.Text>
								</TextBlock>

								<TextBlock Text="Ngày tạo:"
										   Foreground="{StaticResource TextLightColor}" />
								<TextBlock Text="{Binding InvoiceInfo.NgayTao, StringFormat='HH:mm - dd/MM/yyyy'}"
										   Foreground="{StaticResource PrimaryDarkColor}"
										   FontSize="14"
										   Margin="0,4,0,0" />
							</StackPanel>
						</Grid>

						<TextBlock Text="DANH SÁCH SẢN PHẨM"
								   Foreground="{StaticResource PrimaryDarkColor}"
								   FontWeight="Bold"
								   Margin="0,0,0,8"
								   FontSize="14" />
						<Border Style="{StaticResource DarkCardStyle}"
								Padding="12"
								Margin="0,0,0,16">
							<ItemsControl ItemsSource="{Binding DanhSachSanPham}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border BorderBrush="#E2E8F0"
												BorderThickness="0,0,0,1"
												Padding="0,8">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="40" />
													<ColumnDefinition Width="100" />
												</Grid.ColumnDefinitions>

												<StackPanel Grid.Column="0"
															VerticalAlignment="Center"
															Margin="0,0,12,0">
													<TextBlock Text="{Binding TenSach}"
															   Foreground="{StaticResource PrimaryDarkColor}"
															   FontWeight="Bold"
															   TextTrimming="CharacterEllipsis"
															   FontSize="13" />
													<TextBlock Text="{Binding ISBN, StringFormat='ISBN: {0}'}"
															   Foreground="{StaticResource TextLightColor}"
															   FontSize="11"
															   Margin="0,2,0,0" />

													<TextBlock Text="🎁 Quà tặng"
															   Foreground="{StaticResource SuccessColor}"
															   FontSize="11"
															   FontWeight="Bold"
															   Margin="0,2,0,0"
															   Visibility="{Binding IsGift, Converter={StaticResource BoolToVis}}" />
												</StackPanel>

												<TextBlock Grid.Column="1"
														   Text="{Binding SoLuong, StringFormat='x{0}'}"
														   Foreground="{StaticResource TextLightColor}"
														   TextAlignment="Center"
														   VerticalAlignment="Center" />

												<Grid Grid.Column="2"
													  VerticalAlignment="Center"
													  HorizontalAlignment="Right">

													<TextBlock Text="{Binding DonGia, StringFormat='{}{0:N0} đ'}"
															   Foreground="{StaticResource PrimaryColor}"
															   FontWeight="Bold"
															   HorizontalAlignment="Right"
															   Visibility="{Binding IsNormalPrice, Converter={StaticResource BoolToVis}}" />

													<StackPanel Visibility="{Binding HasPromotion, Converter={StaticResource BoolToVis}}">
														<TextBlock Text="{Binding DonGia, StringFormat='{}{0:N0} đ'}"
																   Foreground="{StaticResource DangerColor}"
																   FontWeight="Bold"
																   HorizontalAlignment="Right" />
														<TextBlock Text="{Binding GiaNiemYet, StringFormat='{}{0:N0} đ'}"
																   Foreground="{StaticResource TextLightColor}"
																   FontSize="11"
																   TextDecorations="Strikethrough"
																   HorizontalAlignment="Right"
																   Margin="0,2,0,0" />
													</StackPanel>

													<TextBlock Text="0 đ"
															   Foreground="{StaticResource SuccessColor}"
															   FontWeight="Bold"
															   HorizontalAlignment="Right"
															   Visibility="{Binding IsGift, Converter={StaticResource BoolToVis}}" />
												</Grid>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Border>

						<TextBlock Text="ƯU ĐÃI ĐÃ ÁP DỤNG"
								   Foreground="{StaticResource PrimaryDarkColor}"
								   FontWeight="Bold"
								   Margin="0,0,0,8"
								   FontSize="14" />
						<ItemsControl ItemsSource="{Binding DanhSachUuDai}"
									  Margin="0,0,0,16">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Background="#FFF9DB"
											CornerRadius="6"
											Padding="12,8"
											Margin="0,0,0,6">
										<Grid>
											<TextBlock Text="{Binding TenUuDai}"
													   Foreground="#F59E0B"
													   FontWeight="SemiBold"
													   FontSize="13" />
											<TextBlock Text="{Binding SoTienGiam, StringFormat='-{0:N0} đ'}"
													   Foreground="{StaticResource SuccessColor}"
													   FontWeight="Bold"
													   HorizontalAlignment="Right"
													   FontSize="13" />
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<Border Background="#F8FAFC"
								CornerRadius="8"
								BorderBrush="#E2E8F0"
								BorderThickness="1"
								Padding="16">
							<StackPanel>
								<Grid Margin="0,0,0,8">
									<TextBlock Text="Tạm tính:"
											   Foreground="{StaticResource TextLightColor}"
											   FontSize="14" />
									<TextBlock Text="{Binding InvoiceInfo.TongTienTamTinh, StringFormat='{}{0:N0} đ'}"
											   HorizontalAlignment="Right"
											   FontWeight="SemiBold"
											   Foreground="{StaticResource PrimaryDarkColor}"
											   FontSize="14" />
								</Grid>

								<Grid Margin="0,0,0,12"
									  Visibility="{Binding InvoiceInfo.GiamGia, Converter={StaticResource InvertZeroToVis}}">
									<TextBlock Text="Tổng khuyến mãi:"
											   Foreground="{StaticResource TextLightColor}"
											   FontSize="14" />
									<TextBlock Text="{Binding InvoiceInfo.GiamGia, StringFormat='-{0:N0} đ'}"
											   HorizontalAlignment="Right"
											   FontWeight="Bold"
											   Foreground="{StaticResource SuccessColor}"
											   FontSize="14" />
								</Grid>

								<Border BorderBrush="#E2E8F0"
										BorderThickness="0,1,0,0"
										Margin="0,0,0,12"
										Padding="0,12,0,0">
									<Grid>
										<TextBlock Text="TỔNG PHẢI THU:"
												   Foreground="{StaticResource PrimaryDarkColor}"
												   FontWeight="Bold"
												   FontSize="14"
												   VerticalAlignment="Center" />
										<TextBlock Text="{Binding InvoiceInfo.TongTien, StringFormat='{}{0:N0} đ'}"
												   HorizontalAlignment="Right"
												   FontWeight="Black"
												   Foreground="{StaticResource DangerColor}"
												   FontSize="18" />
									</Grid>
								</Border>

								<Grid>
									<TextBlock Text="Khách đã thanh toán:"
											   Foreground="{StaticResource TextLightColor}"
											   FontSize="13" />
									<TextBlock Text="{Binding InvoiceInfo.SoTienTra, StringFormat='{}{0:N0} đ'}"
											   HorizontalAlignment="Right"
											   FontWeight="Bold"
											   Foreground="{StaticResource PrimaryColor}"
											   FontSize="13" />
								</Grid>
							</StackPanel>
						</Border>

					</StackPanel>
				</ScrollViewer>

				<Button Grid.Row="2"
						Content="ĐÓNG"
						Style="{StaticResource OutlineButtonStyle}"
						Width="120"
						HorizontalAlignment="Right"
						Command="{Binding CloseCommand}"
						CommandParameter="{Binding}" />
			</Grid>
		</Border>
	</Grid>
</UserControl>