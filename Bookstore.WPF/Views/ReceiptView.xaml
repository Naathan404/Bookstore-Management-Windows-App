<UserControl x:Class="Bookstore.WPF.Views.ReceiptView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 mc:Ignorable="d"
			 Background="#F4F7FE"
			 HorizontalAlignment="Stretch"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 VerticalAlignment="Stretch">

	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
		<!-- Row index shown via DataGridRow.Tag set in code-behind -->

		<!-- Style -->
		<SolidColorBrush x:Key="PrimaryDarkColor"
						 Color="#2B3674" />
		<SolidColorBrush x:Key="PrimaryColor"
						 Color="#4318FF" />
		<SolidColorBrush x:Key="TextLightColor"
						 Color="#A3AED0" />
		<SolidColorBrush x:Key="BackgroundColor"
						 Color="#F4F7FE" />
		<SolidColorBrush x:Key="WhiteColor"
						 Color="White" />
		<SolidColorBrush x:Key="DangerColor"
						 Color="#EF4444" />
		<SolidColorBrush x:Key="SuccessColor"
						 Color="#10B981" />
		<SolidColorBrush x:Key="WarningColor"
						 Color="#F59E0B" />

		<LinearGradientBrush x:Key="GradientButtonBrush"
							 StartPoint="0,0"
							 EndPoint="1,0">
			<GradientStop Color="#4318FF"
						  Offset="0" />
			<GradientStop Color="#5B3CFF"
						  Offset="1" />
		</LinearGradientBrush>
		<LinearGradientBrush x:Key="GradientSuccessBrush"
							 StartPoint="0,0"
							 EndPoint="1,0">
			<GradientStop Color="#10B981"
						  Offset="0" />
			<GradientStop Color="#059669"
						  Offset="1" />
		</LinearGradientBrush>

		<DropShadowEffect x:Key="CardShadowEffect"
						  BlurRadius="20"
						  ShadowDepth="0"
						  Opacity="0.08"
						  Color="#4318FF" />
		<DropShadowEffect x:Key="PopupShadowEffect"
						  BlurRadius="30"
						  ShadowDepth="0"
						  Opacity="0.15"
						  Color="#2B3674" />

		<Style x:Key="MainGradientButton"
			   TargetType="Button">
			<Setter Property="Height"
					Value="36" />
			<Setter Property="FontSize"
					Value="13" />
			<Setter Property="FontWeight"
					Value="SemiBold" />
			<Setter Property="Foreground"
					Value="White" />
			<Setter Property="Cursor"
					Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{StaticResource GradientButtonBrush}"
								CornerRadius="12">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="PageButtonStyle"
			   TargetType="Button">
			<Setter Property="Width"
					Value="38" />
			<Setter Property="Height"
					Value="38" />
			<Setter Property="FontSize"
					Value="14" />
			<Setter Property="FontWeight"
					Value="SemiBold" />
			<Setter Property="Foreground"
					Value="#2B3674" />
			<Setter Property="Background"
					Value="Transparent" />
			<Setter Property="BorderThickness"
					Value="0" />
			<Setter Property="Cursor"
					Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border"
								Background="{TemplateBinding Background}"
								CornerRadius="10">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver"
									 Value="True">
								<Setter TargetName="border"
										Property="Background"
										Value="#E0E7FF" />
								<Setter Property="Foreground"
										Value="#4318FF" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="ActivePageButtonStyle"
			   TargetType="Button"
			   BasedOn="{StaticResource PageButtonStyle}">
			<Setter Property="Background"
					Value="#4318FF" />
			<Setter Property="Foreground"
					Value="White" />
		</Style>
		<Style x:Key="ReadOnlyInputStyle"
			   TargetType="Control">
			<Setter Property="Foreground"
					Value="#9CA3AF" />
		</Style>

		<Style x:Key="FilterBorderStyle"
			   TargetType="Border">
			<Setter Property="CornerRadius"
					Value="16" />
			<Setter Property="Background"
					Value="White" />
			<Setter Property="BorderBrush"
					Value="#E2E8F0" />
			<Setter Property="BorderThickness"
					Value="1" />
			<Setter Property="Height"
					Value="42" />
		</Style>

		<Style x:Key="MaterialDesignFloatingHintTextBox"
			   TargetType="TextBox">
			<Setter Property="Height"
					Value="42" />
			<Setter Property="FontSize"
					Value="13" />
			<Setter Property="VerticalContentAlignment"
					Value="Center" />
			<Setter Property="Padding"
					Value="0,8,0,0" />
			<Setter Property="BorderBrush"
					Value="#E2E8F0" />

			<Setter Property="BorderThickness"
					Value="0,0,0,1" />

			<Setter Property="Background"
					Value="Transparent" />
		</Style>
	</UserControl.Resources>

	<Grid Background="{StaticResource BackgroundColor}">
		<Grid Margin="5">
			<Grid.RowDefinitions>
				<RowDefinition Height="90" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			 
			<!-- HEADER -->
			<Border Grid.Row="0"
					Margin="0,0,0,12"
					Padding="20"
					CornerRadius="16"
					Background="White"
					BorderBrush="#E2E8F0"
					BorderThickness="1">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					
					<StackPanel Grid.Column="0"
								Orientation="Horizontal">
						<materialDesign:PackIcon Kind="ReceiptText"
												 Width="28"
												 Height="28"
												 Foreground="#4318FF"
												 Margin="0,0,0,0" />
						<TextBlock Text="QUẢN LÝ PHIẾU THU"
								   FontSize="24"
								   FontWeight="Bold"
								   Foreground="#2B3674"
								   VerticalAlignment="Center" />
					</StackPanel>

					<StackPanel Grid.Column="1"
								Orientation="Horizontal"
								VerticalAlignment="Center">
						<Button Style="{StaticResource MainGradientButton}"
								CommandParameter="{Binding}"
								Width="100"
								Margin="0,0,10,0"
								Command="{Binding MoPopupThemCommand}">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon Kind="Plus"
														 Width="16"
														 Height="16"
														 Foreground="White"
														 Margin="0,0,6,0" />
								<TextBlock Text="THÊM" />
							</StackPanel>
						</Button>
						<!--<Button Style="{StaticResource OutlineExcelButtonStyle}"
								CommandParameter="{Binding}"
								Width="120"
								Command="{Binding ExportExcelCommand}">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon Kind="FileExcel"
														 Width="16"
														 Height="16"
														 Foreground="Green"
														 Margin="0,0,6,0" />
								<TextBlock Text="XUẤT EXCEL" />
							</StackPanel>
						</Button>-->
					</StackPanel>
				</Grid>
			</Border>

			<Border Grid.Row="0"
					Margin="0,0,0,12"
					Padding="20"
					CornerRadius="16"
					Background="White"
					BorderBrush="#E2E8F0"
					BorderThickness="1">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<StackPanel Grid.Column="0"
								Orientation="Horizontal">
						<materialDesign:PackIcon Kind="BookSearch"
												 Width="28"
												 Height="28"
												 Foreground="#4318FF"
												 Margin="0,0,10,0" />
						<TextBlock Text="TRA CỨU SÁCH"
								   FontSize="24"
								   FontWeight="Bold"
								   Foreground="#2B3674"
								   VerticalAlignment="Center" />
					</StackPanel>


					<StackPanel Grid.Column="1"
								Orientation="Horizontal"
								VerticalAlignment="Center">
						<Button Style="{StaticResource MainGradientButton}"
								CommandParameter="{Binding}"
								Width="100"
								Margin="0,0,10,0"
								Command="{Binding OpenAddPopupCommand}">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon Kind="Plus"
														 Width="16"
														 Height="16"
														 Foreground="White"
														 Margin="0,0,6,0" />
								<TextBlock Text="THÊM" />
							</StackPanel>
						</Button>
						<Button Style="{StaticResource OutlineExcelButtonStyle}"
								CommandParameter="{Binding}"
								Width="120"
								Command="{Binding ExportExcelCommand}">
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon Kind="FileExcel"
														 Width="16"
														 Height="16"
														 Foreground="Green"
														 Margin="0,0,6,0" />
								<TextBlock Text="XUẤT EXCEL" />
							</StackPanel>
						</Button>
					</StackPanel>
				</Grid>
			</Border>


			<!-- FILTER -->
			<Border Grid.Row="1"
					Margin="0,0,0,12"
					Padding="20"
					CornerRadius="16"
					Background="White"
					BorderBrush="#E2E8F0"
					BorderThickness="1">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*" />
						<ColumnDefinition Width="1.5*" />
						<ColumnDefinition Width="1.5*" />
						<ColumnDefinition Width="120" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<Border Grid.Column="0"
							Style="{StaticResource FilterBorderStyle}"
							Margin="0,0,8,0">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="36" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<materialDesign:PackIcon Kind="Magnify"
													 Width="18"
													 Height="18"
													 Foreground="#A3AED0"
													 VerticalAlignment="Center"
													 HorizontalAlignment="Center" />
							<TextBox Grid.Column="1"
									 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
									 Margin="0 0 5 0"
									 Background="Transparent"
									 BorderThickness="0"
									 VerticalAlignment="Center"
									 HorizontalAlignment="Stretch"
									 FontSize="13"
									 Foreground="#2B3674"
									 materialDesign:HintAssist.Hint="Tìm khách hàng hoặc người thu..." />
						</Grid>
					</Border>

					<Border Grid.Column="1"
							Style="{StaticResource FilterBorderStyle}"
							Margin="0,0,8,0">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="36" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<materialDesign:PackIcon Kind="CalendarStart"
													 Width="18"
													 Height="18"
													 Foreground="#A3AED0"
													 VerticalAlignment="Center"
													 HorizontalAlignment="Center" />
							<DatePicker Grid.Column="1"
										SelectedDate="{Binding FromDate, UpdateSourceTrigger=PropertyChanged}"
										Margin="0 0 5 0"
										Background="Transparent"
										BorderThickness="0"
										VerticalAlignment="Center"
										HorizontalAlignment="Stretch"
										FontSize="13"
										Foreground="#2B3674"
										materialDesign:HintAssist.Hint="Từ ngày" />
						</Grid>
					</Border>

					<Border Grid.Column="2"
							Style="{StaticResource FilterBorderStyle}"
							Margin="0,0,8,0">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="36" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<materialDesign:PackIcon Kind="CalendarEnd"
													 Width="18"
													 Height="18"
													 Foreground="#A3AED0"
													 VerticalAlignment="Center"
													 HorizontalAlignment="Center" />
							<DatePicker Grid.Column="1"
										SelectedDate="{Binding ToDate, UpdateSourceTrigger=PropertyChanged}"
										Margin="0 0 5 0"
										Background="Transparent"
										BorderThickness="0"
										VerticalAlignment="Center"
										HorizontalAlignment="Stretch"
										FontSize="13"
										Foreground="#2B3674"
										materialDesign:HintAssist.Hint="Đến ngày" />
						</Grid>
					</Border>

					<Border Grid.Column="3"
							Background="#F4F7FE"
							CornerRadius="10"
							Padding="15,0"
							Margin="0,0,10,0">
						<StackPanel Orientation="Horizontal"
									VerticalAlignment="Center">
							<TextBlock Text="Tổng:"
									   Foreground="#A3AED0"
									   FontSize="12"
									   VerticalAlignment="Center" />
							<TextBlock Text="{Binding TongBanGhi}"
									   FontWeight="Bold"
									   Foreground="#4318FF"
									   FontSize="15"
									   Margin="8,0,0,0"
									   VerticalAlignment="Center" />
						</StackPanel>
					</Border>

					<Button Grid.Column="4"
							Width="42"
							Height="42"
							ToolTip="Xóa tất cả bộ lọc"
							Command="{Binding XoaLocCommand}"
							Background="#FEE2E2"
							BorderThickness="0"
							Cursor="Hand">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border Background="{TemplateBinding Background}"
										CornerRadius="10">
									<materialDesign:PackIcon Kind="FilterOff"
															 Width="20"
															 Height="20"
															 Foreground="#EF4444"
															 HorizontalAlignment="Center"
															 VerticalAlignment="Center" />
								</Border>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</Grid>
			</Border>
		
			
			<!-- DATA GRID -->
			<Border Grid.Row="2"
					CornerRadius="20"
					Background="White"
					BorderBrush="#E2E8F0"
					BorderThickness="1"
					Padding="20">
				<DataGrid AutoGenerateColumns="False"
						  ItemsSource="{Binding DanhSachPhieuThu}"
						  SelectionMode="Extended"
						  SelectionUnit="FullRow"
						  IsReadOnly="True"
						  HeadersVisibility="Column"
						  BorderThickness="0"
						  MinRowHeight="52"
						  FontSize="13"
						  AlternatingRowBackground="#F8FAFC"
						  RowBackground="White"
						  Foreground="#2B3674"
						  GridLinesVisibility="Horizontal"
						  HorizontalGridLinesBrush="#E2E8F0"
						  VerticalGridLinesBrush="Transparent"
						  CanUserAddRows="False"
						  CanUserDeleteRows="False"
						  CanUserResizeColumns="False"
						  CanUserResizeRows="False"
						  CanUserReorderColumns="False"
						  VirtualizingStackPanel.IsVirtualizing="True">

					<DataGrid.Resources>
						<Style TargetType="DataGridColumnHeader">
							<Setter Property="Background"
									Value="#F8FAFC" />
							<Setter Property="Foreground"
									Value="#2B3674" />
							<Setter Property="FontWeight"
									Value="SemiBold" />
							<Setter Property="FontSize"
									Value="13" />
							<Setter Property="Height"
									Value="44" />
							<Setter Property="BorderBrush"
									Value="#E2E8F0" />
							<Setter Property="BorderThickness"
									Value="0,0,0,2" />
							<Setter Property="Padding"
									Value="12,0" />
							<Setter Property="VerticalContentAlignment"
									Value="Center" />
						</Style>
						<Style TargetType="DataGridCell">
							<Setter Property="VerticalContentAlignment"
									Value="Center" />
							<Setter Property="HorizontalContentAlignment"
									Value="Stretch" />
							<Setter Property="BorderThickness"
									Value="0" />
							<Setter Property="Padding"
									Value="12,0" />
						</Style>
						<Style TargetType="DataGridRow">
							<Setter Property="Background"
									Value="Transparent" />
							<Style.Triggers>
								<Trigger Property="IsSelected"
										 Value="True">
									<Setter Property="Background"
											Value="#E0E7FF" />
								</Trigger>
								<Trigger Property="IsMouseOver"
										 Value="True">
									<Setter Property="Background"
											Value="#F3F4F6" />
								</Trigger>
							</Style.Triggers>
						</Style>
					</DataGrid.Resources>

					<DataGrid.Columns>
						<DataGridTextColumn Header="Mã PT"
											Binding="{Binding MaPhieuThuTienView}"
											Width="100">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="VerticalAlignment"
											Value="Center" />
									<Setter Property="FontWeight"
											Value="Bold" />
									<Setter Property="Foreground"
											Value="#4318FF" />
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Ngày thu"
											Binding="{Binding NgayTao, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
											Width="140">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="VerticalAlignment"
											Value="Center" />
									<Setter Property="Foreground"
											Value="#A3AED0" />
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Khách hàng"
											Binding="{Binding TenKhachHang}"
											Width="1.5*">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="VerticalAlignment"
											Value="Center" />
									<Setter Property="FontWeight"
											Value="SemiBold" />
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Người thu"
											Binding="{Binding TenNguoiTao}"
											Width="1.5*">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="VerticalAlignment"
											Value="Center" />
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Lý do thu"
											Binding="{Binding LyDoThu}"
											Width="2*">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="VerticalAlignment"
											Value="Center" />
									<Setter Property="TextTrimming"
											Value="CharacterEllipsis" />
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Số tiền thu"
											Binding="{Binding SoTienThu, StringFormat={}{0:N0} đ}"
											Width="150"
											HeaderStyle="{StaticResource RightHeaderStyle}">
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="HorizontalAlignment"
											Value="Right" />
									<Setter Property="VerticalAlignment"
											Value="Center" />
									<Setter Property="FontWeight"
											Value="Bold" />
									<Setter Property="Foreground"
											Value="#10B981" />
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTemplateColumn Header="Thao tác"
												Width="100"
												HeaderStyle="{StaticResource CenterHeaderStyle}">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal"
												HorizontalAlignment="Center"
												VerticalAlignment="Center">
										<Button Width="32"
												Height="32"
												Background="#EEF2FF"
												BorderThickness="0"
												Cursor="Hand"
												ToolTip="In phiếu"
												Command="{Binding DataContext.PrintReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
												CommandParameter="{Binding}">
											<Button.Template>
												<ControlTemplate TargetType="Button">
													<Border Background="{TemplateBinding Background}"
															CornerRadius="6">
														<materialDesign:PackIcon Kind="Printer"
																				 Width="15"
																				 Height="15"
																				 Foreground="#4318FF"
																				 HorizontalAlignment="Center"
																				 VerticalAlignment="Center" />
													</Border>
												</ControlTemplate>
											</Button.Template>
										</Button>

										<Button Width="32"
												Height="32"
												Background="#FEE2E2"
												BorderThickness="0"
												Cursor="Hand"
												ToolTip="Xóa phiếu thu"
												Margin="6,0,0,0"
												Command="{Binding DataContext.XoaPhieuThuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
												CommandParameter="{Binding}">
											<Button.Template>
												<ControlTemplate TargetType="Button">
													<Border Background="{TemplateBinding Background}"
															CornerRadius="6">
														<materialDesign:PackIcon Kind="Delete"
																				 Width="15"
																				 Height="15"
																				 Foreground="#EF4444"
																				 HorizontalAlignment="Center"
																				 VerticalAlignment="Center" />
													</Border>
												</ControlTemplate>
											</Button.Template>
										</Button>
									</StackPanel>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</Border>

			
			<!-- FOOTER -->
			<Border Grid.Row="3"
					Margin="0,12,0,0"
					Padding="12,8"
					CornerRadius="12"
					Background="White"
					BorderBrush="#E2E8F0"
					BorderThickness="1">
				<StackPanel Orientation="Horizontal"
							HorizontalAlignment="Center">
					<Button Style="{StaticResource PaginationButtonStyle}"
							Command="{Binding PhanTrangCommand}"
							CommandParameter="First"
							Margin="0,0,4,0">
						<materialDesign:PackIcon Kind="ChevronDoubleLeft"
												 Width="16"
												 Height="16"
												 Foreground="#A3AED0" />
					</Button>
					<Button Style="{StaticResource PaginationButtonStyle}"
							Command="{Binding PhanTrangCommand}"
							CommandParameter="Prev"
							Margin="0,0,8,0">
						<materialDesign:PackIcon Kind="ChevronLeft"
												 Width="16"
												 Height="16"
												 Foreground="#A3AED0" />
					</Button>
					<TextBlock Text="{Binding TrangHienTai, StringFormat='Trang {0}'}"
							   FontSize="13"
							   FontWeight="SemiBold"
							   Foreground="#4318FF"
							   VerticalAlignment="Center"
							   Margin="12,0" />
					<TextBlock Text="{Binding TongSoTrang, StringFormat='/ {0}'}"
							   FontSize="13"
							   Foreground="#A3AED0"
							   VerticalAlignment="Center"
							   Margin="0,0,12,0" />
					<Button Style="{StaticResource PaginationButtonStyle}"
							Command="{Binding PhanTrangCommand}"
							CommandParameter="Next"
							Margin="8,0,0,0">
						<materialDesign:PackIcon Kind="ChevronRight"
												 Width="16"
												 Height="16"
												 Foreground="#A3AED0" />
					</Button>
					<Button Style="{StaticResource PaginationButtonStyle}"
							Command="{Binding PhanTrangCommand}"
							CommandParameter="Last"
							Margin="4,0,0,0">
						<materialDesign:PackIcon Kind="ChevronDoubleRight"
												 Width="16"
												 Height="16"
												 Foreground="#A3AED0" />
					</Button>
				</StackPanel>
			</Border>

			<components:ReceiptPopupControl DataContext="{Binding PopupThuTienVM}" />
		</Grid>
	</Grid>
</UserControl>