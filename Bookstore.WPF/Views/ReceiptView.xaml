<UserControl x:Class="Bookstore.WPF.Views.ReceiptView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 xmlns:popup="clr-namespace:Bookstore.WPF.Views.Popup"
			 mc:Ignorable="d">

	<Grid>
		<Grid x:Name="MainReceipView"
			  Margin="{StaticResource MainViewMargin}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<components:PageHeaderControl Title="THU TIỀN"
										  HeaderIcon="ReceiptText"
										  AddTitle="THÊM"
										  AddIcon="Plus"
										  AddCommand="{Binding MoPopupThemCommand}"
										  AddCommandParameter="{Binding}" />

			<!-- FILTER -->
			<Border Grid.Row="1"
					Style="{StaticResource FilterCardStyle}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*" />
						<ColumnDefinition Width="1*" />
						<ColumnDefinition Width="1*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<components:FilterInputControl Grid.Column="0"
												   Margin="0,0,8,0"
												   IconKind="Magnify"
												   HintText="Tìm khách hàng..."
												   TextValue="{Binding SearchText}" />

					<components:FilterDatePickerControl Grid.Column="1"
														Margin="0,0,8,0"
														IconKind="CalendarStart"
														HintText="Từ ngày"
														SelectedDate="{Binding FromDate}" />

					<components:FilterDatePickerControl Grid.Column="2"
														Margin="0,0,8,0"
														IconKind="CalendarEnd"
														HintText="Đến ngày"
														SelectedDate="{Binding ToDate}" />

					<components:FilterActionPanel Grid.Column="3"
												  ClearCommand="{Binding XoaLocCommand}"
												  RefreshCommand="{Binding RefreshCommand}"
												  ShowRefreshButton="True" />
				</Grid>
			</Border>


			<!-- DATA GRID -->
			<Border Grid.Row="2"
					Style="{StaticResource DataGridCardStyle}">
				<DataGrid AutoGenerateColumns="False"
						  ItemsSource="{Binding DanhSachPhieuThu}"
						  SelectedItem="{Binding SelectedPhieuThu}"
						  Style="{StaticResource CleanDataGrid}">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Mã PT"
											Width="120"
											HeaderStyle="{StaticResource CenterHeaderStyle}"
											ElementStyle="{StaticResource CellCode}"
											SortMemberPath="MaPhieuThuTien">
							<DataGridTextColumn.Binding>
								<MultiBinding StringFormat="PT{0:ddMMyy}{1:D3}">
									<Binding Path="NgayTao" />
									<Binding Path="MaPhieuThuTien" />
								</MultiBinding>
							</DataGridTextColumn.Binding>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Ngày thu"
											Binding="{Binding NgayTao, StringFormat={}{0:dd/MM/yyyy}}"
											Width="120"
											HeaderStyle="{StaticResource CenterHeaderStyle}"
											ElementStyle="{StaticResource CellCenter}" />

						<DataGridTextColumn Header="Khách hàng"
											Binding="{Binding TenKhachHang}"
											Width="*"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellName}" />

						<DataGridTextColumn Header="Người thu"
											Binding="{Binding TenNguoiTao}"
											Width="150"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}" />

						<DataGridTextColumn Header="Lý do thu"
											Binding="{Binding LyDoThu}"
											Width="150"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}" />

						<DataGridTextColumn Header="Số tiền thu"
											Binding="{Binding SoTienThu, StringFormat={}{0:N0} đ}"
											Width="150"
											HeaderStyle="{StaticResource RightHeaderStyle}"
											ElementStyle="{StaticResource CellProfit}"/>

						<DataGridTemplateColumn Header="Thao tác"
												Width="150"
												HeaderStyle="{StaticResource CenterHeaderStyle}">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<components:DataGridActionPanel RowItem="{Binding}"
																	ShowView="{Binding DataContext.CanView, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	ShowEdit="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	ShowDelete="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	ViewCommand="{Binding DataContext.MoPopupSuaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	DeleteCommand="{Binding DataContext.XoaPhieuThuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</Border>


			<!-- FOOTER -->
			<components:PaginationControl Grid.Row="3"
										  CurrentPage="{Binding TrangHienTai}"
										  TotalPages="{Binding TongSoTrang}"
										  TotalRecords="{Binding TongBanGhi}"
										  PaginationCommand="{Binding PhanTrangCommand}" />
		</Grid>

		<popup:ReceiptPopup DataContext="{Binding PopupThuTienVM}" />
	</Grid>
</UserControl>