                                    <Grid Grid.Column="0" Width="53" Height="53" Margin="0,0,15,0">
                                        <Ellipse Fill="#F0F4FF" Margin="2,0,2,6"/>
                                        <Path Data="M4,18 V15 M10,18 V2 M16,18 V5" 
