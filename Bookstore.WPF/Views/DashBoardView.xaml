<UserControl x:Class="Bookstore.WPF.Views.DashboardView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 mc:Ignorable="d"
			 d:DesignHeight="1200"
			 d:DesignWidth="1600"
			 Unloaded="UserControl_Unloaded">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<components:PageHeaderControl Title="TRANG CHỦ"
									  HeaderIcon="ViewDashboard"
									  ShowAddButton="False" />

		<TabControl Grid.Row="1"
					Background="Transparent"
					BorderThickness="0">
			<TabItem Header="THỐNG KÊ KINH DOANH"
					 Style="{StaticResource CategoryTabItem}">
				<ScrollViewer VerticalScrollBarVisibility="Auto"
							  Margin="0 0 0 0">
					<StackPanel Margin="0,15,5,0">

						<Grid Margin="0,0,0,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"></ColumnDefinition>
								<ColumnDefinition Width="*"></ColumnDefinition>
								<ColumnDefinition Width="*"></ColumnDefinition>
								<ColumnDefinition Width="*"></ColumnDefinition>
							</Grid.ColumnDefinitions>
							<Border Style="{StaticResource DashboardCardStyle}"
									Margin="0,0,10,15"
									Grid.Column="0">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Border Width="45"
											Height="45"
											Background="#F4F7FE"
											CornerRadius="22.5">
										<materialDesign:PackIcon Kind="CurrencyUsd"
																 Foreground="#4318FF"
																 Width="24"
																 Height="24"
																 HorizontalAlignment="Center"
																 VerticalAlignment="Center" />
									</Border>
									<StackPanel Grid.Column="1"
												Margin="0,0,0,0">
										<StackPanel Grid.Column="1"
													Margin="15,0,0,0">
											<TextBlock Text="Doanh thu"
													   Foreground="#A3AED0"
													   FontSize="12"
													   FontWeight="Bold" />
											<StackPanel Orientation="Horizontal"
														Margin="0,5,0,0">
												<TextBlock Text="{Binding Sale, StringFormat='{}{0:#,0} đ'}"
														   Foreground="#2B3674"
														   FontSize="18"
														   FontWeight="Bold" />
												<materialDesign:PackIcon Kind="{Binding SaleChangeIcon}"
																		 Foreground="{Binding SaleChangeColor}"
																		 VerticalAlignment="Bottom"
																		 Margin="8,0,2,3"
																		 Width="18"
																		 Height="18" />
												<TextBlock Text="{Binding SaleChangeText}"
														   Foreground="{Binding SaleChangeColor}"
														   FontSize="13"
														   VerticalAlignment="Bottom"
														   FontWeight="Bold"
														   Margin="0,0,0,3" />
											</StackPanel>
										</StackPanel>
									</StackPanel>
								</Grid>
							</Border>

							<Border Style="{StaticResource DashboardCardStyle}"
									Margin="0,0,10,15"
									Grid.Column="1">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Border Width="45"
											Height="45"
											Background="#E2FFF3"
											CornerRadius="22.5">
										<materialDesign:PackIcon Kind="BarChart"
																 Foreground="#05CD99"
																 Width="24"
																 Height="24"
																 HorizontalAlignment="Center"
																 VerticalAlignment="Center" />
									</Border>
									<StackPanel Grid.Column="1"
												Margin="15,0,0,0">
										<TextBlock Text="Lợi nhuận"
												   Foreground="#A3AED0"
												   FontSize="12"
												   FontWeight="Bold" />
										<TextBlock Text="{Binding Profit, StringFormat='{}{0:#,0} đ'}"
												   Foreground="#2B3674"
												   FontSize="18"
												   FontWeight="Bold" />
									</StackPanel>
								</Grid>
							</Border>

							<Border Style="{StaticResource DashboardCardStyle}"
									Margin="0,0,10,15"
									Grid.Column="2">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Border Width="45"
											Height="45"
											Background="#E0E7FF"
											CornerRadius="22.5">
										<materialDesign:PackIcon Kind="UserPlus"
																 Foreground="#4318FF"
																 Width="24"
																 Height="24"
																 HorizontalAlignment="Center"
																 VerticalAlignment="Center" />
									</Border>
									<StackPanel Grid.Column="1"
												Margin="15,0,0,0">
										<TextBlock Text="Khách mới"
												   Foreground="#A3AED0"
												   FontSize="12"
												   FontWeight="Bold" />
										<TextBlock Text="{Binding CustNum}"
												   Foreground="#2B3674"
												   FontSize="18"
												   FontWeight="Bold" />
									</StackPanel>
								</Grid>
							</Border>

							<Border Style="{StaticResource DashboardCardStyle}"
									Margin="0,0,0,15"
									Grid.Column="3">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Border Width="45"
											Height="45"
											Background="#F4F7FE"
											CornerRadius="22.5">
										<materialDesign:PackIcon Kind="FileDocument"
																 Foreground="#4318FF"
																 Width="24"
																 Height="24"
																 HorizontalAlignment="Center"
																 VerticalAlignment="Center" />
									</Border>
									<StackPanel Grid.Column="1"
												Margin="15,0,0,0">
										<TextBlock Text="Đơn hàng"
												   Foreground="#A3AED0"
												   FontSize="12"
												   FontWeight="Bold" />
										<TextBlock Text="{Binding ReceiptNum}"
												   Foreground="#2B3674"
												   FontSize="18"
												   FontWeight="Bold" />
									</StackPanel>
								</Grid>
							</Border>
						</Grid>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="1.6*"></ColumnDefinition>
								<ColumnDefinition Width="*"></ColumnDefinition>
							</Grid.ColumnDefinitions>
							<Border Grid.Column="0"
									Style="{StaticResource DashboardCardStyle}"
									Margin="0,0,10,0"
									Height="360">
								<StackPanel>
									<TextBlock Text="XU HƯỚNG TĂNG TRƯỞNG DOANH THU"
											   FontSize="16"
											   FontWeight="Bold"
											   Foreground="#2B3674"
											   Margin="0,0,0,15" />
									<lvc:CartesianChart x:Name="ChartRevenue"
														Series="{Binding RevenueSeries}"
														XAxes="{Binding XAxes}"
														YAxes="{Binding YAxes}"
														Height="290"
														Margin="-10 0 -5 0" />
								</StackPanel>
							</Border>
							<Border Grid.Column="1"
									Style="{StaticResource DashboardCardStyle}"
									Height="360"
									Margin="0 10 0 15">
								<StackPanel>
									<TextBlock Text="TỶ TRỌNG DOANH THU THEO THỂ LOẠI"
											   FontSize="16"
											   FontWeight="Bold"
											   Foreground="#2B3674"
											   Margin="0,0,0,0" />
									<lvc:PieChart x:Name="ChartCategory"
												  Series="{Binding Data}"
												  Height="300"
												  LegendPosition="Bottom"
												  LegendTextSize="11" />
								</StackPanel>
							</Border>
						</Grid>

						<Grid Margin="0,0,0,10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="1.5*" />
							</Grid.ColumnDefinitions>
							<Border Style="{StaticResource DashboardCardStyle}"
									Height="400">
								<StackPanel>
									<TextBlock Text="SO SÁNH DOANH THU &amp; CHI PHÍ"
											   FontSize="16"
											   FontWeight="Bold"
											   Foreground="#2B3674"
											   Margin="0,0,0,0" />
									<lvc:CartesianChart x:Name="ChartComparison"
														Series="{Binding ComparisonSeries}"
														XAxes="{Binding XAxes}"
														YAxes="{Binding YAxes}"
														Height="350"
														LegendPosition="Right" />
								</StackPanel>
							</Border>
						</Grid>

						<Border Style="{StaticResource DashboardCardStyle}">
							<StackPanel>
								<TextBlock Text="SẢN PHẨM BÁN CHẠY NHẤT"
										   FontSize="16"
										   FontWeight="Bold"
										   Foreground="#4318FF"
										   Margin="0,0,0,25" />
								<ItemsControl ItemsSource="{Binding TopBooks}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<UniformGrid Columns="5" />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Grid x:Name="ItemContainer"
												  HorizontalAlignment="Center"
												  Background="Transparent"
												  ToolTipService.InitialShowDelay="100"
												  ToolTipService.ShowDuration="30000">
												<Grid.ToolTip>
													<ToolTip Background="Transparent"
															 BorderThickness="0"
															 HasDropShadow="False"
															 Placement="MousePoint"
															 VerticalOffset="18">

														<Border Width="280"
																Padding="16"
																Background="#FFFFFF"
																BorderBrush="#E2E8F0"
																BorderThickness="1"
																CornerRadius="18">

															<StackPanel>

																<!-- Header -->
																<StackPanel Margin="0,0,0,12">

																	<TextBlock Text="{Binding Title}"
																			   FontSize="18"
																			   FontWeight="SemiBold"
																			   Foreground="#1E293B"
																			   TextWrapping="Wrap" />

																	<Border CornerRadius="12"
																			Padding="10,5"
																			HorizontalAlignment="Left"
																			VerticalAlignment="Center">
																		<Border.Style>
																			<Style TargetType="Border">
																				<!-- Màu Nền Mặc định (Nếu thể loại không nằm trong danh sách dưới) -->
																				<Setter Property="Background"
																						Value="#F3F4F6" />

																				<Style.Triggers>
																					<!-- Công nghệ thông tin: Tone Xanh dương -->
																					<DataTrigger Binding="{Binding CategoryName}"
																								 Value="Công nghệ thông tin">
																						<Setter Property="Background"
																								Value="#DBEAFE" />
																					</DataTrigger>
																					<!-- Văn học nghệ thuật: Tone Hồng -->
																					<DataTrigger Binding="{Binding CategoryName}"
																								 Value="Văn học nghệ thuật">
																						<Setter Property="Background"
																								Value="#FCE7F3" />
																					</DataTrigger>
																					<!-- Kinh tế - Quản trị: Tone Xanh ngọc -->
																					<DataTrigger Binding="{Binding CategoryName}"
																								 Value="Kinh tế - Quản trị">
																						<Setter Property="Background"
																								Value="#D1FAE5" />
																					</DataTrigger>
																					<!-- Tâm lý - Kỹ năng sống: Tone Tím -->
																					<DataTrigger Binding="{Binding CategoryName}"
																								 Value="Tâm lý - Kỹ năng sống">
																						<Setter Property="Background"
																								Value="#EDE9FE" />
																					</DataTrigger>
																					<!-- Truyện tranh: Tone Cam/Vàng -->
																					<DataTrigger Binding="{Binding CategoryName}"
																								 Value="Truyện tranh">
																						<Setter Property="Background"
																								Value="#FEF3C7" />
																					</DataTrigger>
																					<!-- Thiếu nhi: Tone Xanh lá nhạt -->
																					<DataTrigger Binding="{Binding CategoryName}"
																								 Value="Thiếu nhi">
																						<Setter Property="Background"
																								Value="#DCFCE7" />
																					</DataTrigger>
																				</Style.Triggers>
																			</Style>
																		</Border.Style>

																		<!-- ĐỊNH DẠNG MÀU CHỮ BÊN TRONG -->
																		<TextBlock FontSize="12"
																				   FontWeight="SemiBold"
																				   HorizontalAlignment="Center">
																			<TextBlock.Style>
																				<Style TargetType="TextBlock">
																					<!-- Chữ Mặc định (Xám đậm) -->
																					<Setter Property="Foreground"
																							Value="#4B5563" />
																					<Setter Property="Text"
																							Value="{Binding CategoryName}" />
																					<Style.Triggers>
																						<!-- Công nghệ thông tin -->
																						<DataTrigger Binding="{Binding CategoryName}"
																									 Value="Công nghệ thông tin">
																							<Setter Property="Foreground"
																									Value="#1D4ED8" />
																						</DataTrigger>
																						<!-- Văn học nghệ thuật -->
																						<DataTrigger Binding="{Binding CategoryName}"
																									 Value="Văn học nghệ thuật">
																							<Setter Property="Foreground"
																									Value="#BE185D" />
																						</DataTrigger>
																						<!-- Kinh tế - Quản trị -->
																						<DataTrigger Binding="{Binding CategoryName}"
																									 Value="Kinh tế - Quản trị">
																							<Setter Property="Foreground"
																									Value="#047857" />
																						</DataTrigger>
																						<!-- Tâm lý - Kỹ năng sống -->
																						<DataTrigger Binding="{Binding CategoryName}"
																									 Value="Tâm lý - Kỹ năng sống">
																							<Setter Property="Foreground"
																									Value="#6D28D9" />
																						</DataTrigger>
																						<!-- Truyện tranh -->
																						<DataTrigger Binding="{Binding CategoryName}"
																									 Value="Truyện tranh">
																							<Setter Property="Foreground"
																									Value="#B45309" />
																						</DataTrigger>
																						<!-- Thiếu nhi -->
																						<DataTrigger Binding="{Binding CategoryName}"
																									 Value="Thiếu nhi">
																							<Setter Property="Foreground"
																									Value="#15803D" />
																						</DataTrigger>
																					</Style.Triggers>
																				</Style>
																			</TextBlock.Style>
																		</TextBlock>
																	</Border>
																</StackPanel>

																<!-- Divider -->
																<Border Height="1"
																		Margin="0,0,0,12"
																		Background="#F1F5F9" />

																<!-- Stats -->
																<Grid>
																	<Grid.ColumnDefinitions>
																		<ColumnDefinition />
																		<ColumnDefinition />
																	</Grid.ColumnDefinitions>

																	<!-- Giá -->
																	<Border Grid.Column="0"
																			Margin="0,0,6,0"
																			Padding="12"
																			Background="#F8FAFC"
																			CornerRadius="14">

																		<StackPanel>

																			<TextBlock Text="Giá niêm yết"
																					   FontSize="11"
																					   Foreground="#64748B" />

																			<TextBlock Margin="0,4,0,0"
																					   Text="{Binding Price, StringFormat={}{0:N0}₫}"
																					   FontSize="16"
																					   FontWeight="Bold"
																					   Foreground="#0F172A" />
																		</StackPanel>
																	</Border>

																	<!-- Đã bán -->
																	<Border Grid.Column="1"
																			Margin="6,0,0,0"
																			Padding="12"
																			Background="#F8FAFC"
																			CornerRadius="14">

																		<StackPanel>

																			<TextBlock Text="Đã bán"
																					   FontSize="11"
																					   Foreground="#64748B" />

																			<TextBlock Margin="0,4,0,0"
																					   Text="{Binding TotalSold}"
																					   FontSize="16"
																					   FontWeight="Bold"
																					   Foreground="#16A34A" />
																		</StackPanel>
																	</Border>
																</Grid>

															</StackPanel>
														</Border>
													</ToolTip>
												</Grid.ToolTip>
												<TextBlock Text="{Binding Rank}"
														   FontSize="95"
														   FontWeight="Black"
														   Foreground="#2B3674"
														   Opacity="0.08"
														   VerticalAlignment="Center"
														   HorizontalAlignment="Left"
														   Margin="-15,0,0,0" />

												<Border x:Name="BookBorder"
														Width="100"
														Height="145"
														CornerRadius="12"
														Margin="30,0,0,0"
														RenderTransformOrigin="0.5,0.5">

													<Border.RenderTransform>
														<ScaleTransform ScaleX="1"
																		ScaleY="1" />
													</Border.RenderTransform>
													<Border.Background>
														<ImageBrush ImageSource="{Binding BookImage}"
																	Stretch="UniformToFill" />
													</Border.Background>
												</Border>
											</Grid>

											<DataTemplate.Triggers>
												<Trigger Property="IsMouseOver"
														 Value="True"
														 SourceName="ItemContainer">
													<Setter TargetName="BookBorder"
															Property="Panel.ZIndex"
															Value="1" />
													<Trigger.EnterActions>
														<BeginStoryboard>
															<Storyboard>
																<DoubleAnimation Storyboard.TargetName="BookBorder"
																				 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
																				 To="1.25"
																				 Duration="0:0:0.2" />
																<DoubleAnimation Storyboard.TargetName="BookBorder"
																				 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
																				 To="1.25"
																				 Duration="0:0:0.2" />
															</Storyboard>
														</BeginStoryboard>
													</Trigger.EnterActions>
													<Trigger.ExitActions>
														<BeginStoryboard>
															<Storyboard>
																<DoubleAnimation Storyboard.TargetName="BookBorder"
																				 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
																				 To="1"
																				 Duration="0:0:0.2" />
																<DoubleAnimation Storyboard.TargetName="BookBorder"
																				 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
																				 To="1"
																				 Duration="0:0:0.2" />
															</Storyboard>
														</BeginStoryboard>
													</Trigger.ExitActions>
												</Trigger>
											</DataTemplate.Triggers>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>

						<Grid Margin="0,15,0,20">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="15" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<Border Grid.Column="0"
									Style="{StaticResource DashboardCardStyle}"
									Margin="0">
								<StackPanel>
									<TextBlock Text="TOP KHÁCH HÀNG VIP"
											   FontSize="14"
											   FontWeight="Bold"
											   Foreground="#2B3674"
											   Margin="0,0,0,10" />
									<DataGrid Style="{StaticResource CleanDataGrid}"
											  ItemsSource="{Binding TopCustomers}"
											  MaxHeight="250"
											  PreviewMouseWheel="DataGrid_PreviewMouseWheel">
										<DataGrid.Columns>
											<DataGridTextColumn Header="KHÁCH HÀNG"
																Binding="{Binding Name}"
																Width="*" />
											<DataGridTextColumn Header="ĐÃ MUA"
																Binding="{Binding TotalSpent, StringFormat='{}{0:#,0} đ'}"
																Width="100">
												<DataGridTextColumn.ElementStyle>
													<Style TargetType="TextBlock">
														<Setter Property="Foreground"
																Value="#10B981" />
														<Setter Property="FontWeight"
																Value="SemiBold" />
													</Style>
												</DataGridTextColumn.ElementStyle>
											</DataGridTextColumn>
										</DataGrid.Columns>
									</DataGrid>
								</StackPanel>
							</Border>

							<Border Grid.Column="2"
									Style="{StaticResource DashboardCardStyle}"
									Margin="0">
								<StackPanel>
									<TextBlock Text="DOANH SỐ NHÂN VIÊN"
											   FontSize="14"
											   FontWeight="Bold"
											   Foreground="#2B3674"
											   Margin="0,0,0,10" />
									<DataGrid Style="{StaticResource CleanDataGrid}"
											  ItemsSource="{Binding TopStaffs}"
											  MaxHeight="250"
											  PreviewMouseWheel="DataGrid_PreviewMouseWheel">
										<DataGrid.Columns>
											<DataGridTextColumn Header="NHÂN VIÊN"
																Binding="{Binding Name}"
																Width="*" />
											<DataGridTextColumn Header="DOANH SỐ"
																Binding="{Binding SalesAmount, StringFormat='{}{0:#,0} đ'}"
																Width="100" />
										</DataGrid.Columns>
									</DataGrid>
								</StackPanel>
							</Border>
						</Grid>
					</StackPanel>
				</ScrollViewer>
			</TabItem>
			<TabItem Header="TRẠNG THÁI VẬN HÀNH"
					 Style="{StaticResource CategoryTabItem}">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<Grid Margin="0,15,0,0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<Border Grid.Row="0"
								Grid.Column="0"
								Style="{StaticResource DashboardCardStyle}"
								Margin="0,0,10,15">
							<StackPanel>
								<StackPanel Orientation="Horizontal"
											Margin="0,0,0,10">
									<materialDesign:PackIcon Kind="CartOutline"
															 Foreground="#4318FF"
															 Width="20"
															 Height="20"
															 VerticalAlignment="Center"
															 Margin="0,0,8,0" />
									<TextBlock Text="CÁC ĐƠN HÀNG TRONG NGÀY"
											   FontSize="15"
											   FontWeight="Bold"
											   Foreground="#2B3674"
											   VerticalAlignment="Center" />
								</StackPanel>
								<DataGrid CanUserSortColumns="False"
										  AutoGenerateColumns="False"
										  Style="{StaticResource CleanDataGrid}"
										  ItemsSource="{Binding Items}"
										  SelectionMode="Single"
										  SelectionUnit="FullRow"
										  IsReadOnly="True"
										  HeadersVisibility="Column"
										  BorderThickness="0"
										  MinRowHeight="30"
										  FontSize="13"
										  AlternatingRowBackground="#F8FAFC"
										  RowBackground="White"
										  Foreground="#2B3674"
										  GridLinesVisibility="Horizontal"
										  HorizontalGridLinesBrush="#E2E8F0"
										  VerticalGridLinesBrush="Transparent"
										  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
										  ScrollViewer.VerticalScrollBarVisibility="Auto"
										  CanUserAddRows="False"
										  CanUserDeleteRows="False"
										  CanUserResizeColumns="False"
										  CanUserResizeRows="False"
										  CanUserReorderColumns="False"
										  VirtualizingStackPanel.IsVirtualizing="True"
										  VirtualizingStackPanel.VirtualizationMode="Recycling"
										  ScrollViewer.IsDeferredScrollingEnabled="True"
										  PreviewMouseWheel="DataGrid_PreviewMouseWheel">

									<DataGrid.Columns>
										<DataGridTextColumn Header="Mã HĐ"
															Binding="{Binding DisplayID}"
															Width="110"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
