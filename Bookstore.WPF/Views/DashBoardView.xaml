															Value="SemiBold" />
													<Setter Property="Margin"
															Value="10 0 10 0"></Setter>
												</Style>
											</DataGridTextColumn.ElementStyle>
										</DataGridTextColumn>
										<DataGridTextColumn Header="Khách hàng"
															Binding="{Binding CustomerName}"
															Width="*"
