                                                </DataGridTextColumn>

                                                <DataGridTemplateColumn Header="STATUS" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Ellipse Width="15" Height="15" Fill="{Binding StatusColor}" Margin="0,0,8,0"/>
                                                                <TextBlock Text="{Binding StatusText}" Foreground="#1B2559" FontWeight="Bold"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
