                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="3" Background="White" CornerRadius="20" Margin="20,0,0,0" Padding="15" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="53" Height="53" Margin="0,0,15,0">
                                        <Ellipse Margin="2,0,2,6">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush EndPoint="1,0" StartPoint="0,0" SpreadMethod="Reflect" MappingMode="RelativeToBoundingBox">
