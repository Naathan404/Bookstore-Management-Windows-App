<UserControl x:Class="Bookstore.WPF.Views.DashBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Bookstore.WPF.Views"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             xmlns:materialDesignColors="clr-namespace:MaterialDesignColors;assembly=MaterialDesignColors"
             xmlns:vm="clr-namespace:Bookstore.WPF.ViewModels"             
             d:DataContext="{d:DesignInstance Type=vm:DashBoardViewModel, IsDesignTimeCreatable=True}"             
             mc:Ignorable="d" 
             d:DesignHeight="1750" d:DesignWidth="1640"
             Background="#f4f7fe">

    <UserControl.Resources>
        <DropShadowEffect x:Key="CardShadowEffect" BlurRadius="20" ShadowDepth="0" Opacity="0.08" Color="#4318FF"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1" Color="#2D3748"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChartCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1" Color="#2D3748"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#F4F7FE"/>
            <Setter Property="Foreground" Value="#2B3674"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="15">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#422AFB"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="PrimaryPurple" Color="#422AFB"/>
        <SolidColorBrush x:Key="SearchBackground" Color="#F4F7FE"/>
        <SolidColorBrush x:Key="SearchTextDefault" Color="#8F9BBA"/>
        <SolidColorBrush x:Key="SearchTextActive" Color="#2B3674"/>

        <Style x:Key="ModernSearchInputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SearchBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource SearchTextDefault}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" 
                        Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        CornerRadius="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Path x:Name="searchIcon" 
                              Grid.Column="0"
                              Width="14" Height="14"
                              Margin="12,0,8,0"
                              Fill="{TemplateBinding Foreground}"
                              Stretch="Uniform"
                              Data="M15.5,14L11.8,10.3C12.5,9.2 13,7.9 13,6.5C13,2.9 10.1,0 6.5,0C2.9,0 0,2.9 0,6.5C0,10.1 2.9,13 6.5,13C7.9,13 9.2,12.5 10.3,11.8L14,15.5L15.5,14M6.5,2C9,2 11,4 11,6.5C11,9 9,11 6.5,11C4,11 2,9 2,6.5C2,4 4,2 6.5,2Z"
                              VerticalAlignment="Center"/>

                                <ScrollViewer x:Name="PART_ContentHost" 
                                      Grid.Column="1"
                                      Focusable="false" 
                                      HorizontalScrollBarVisibility="Hidden" 
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="Center"
                                      Margin="0,0,15,0"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryPurple}"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource SearchTextActive}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryPurple}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Ellipse Width="600" Height="600" 
         Fill="#4318FF" Opacity="0.03"
         VerticalAlignment="Top" HorizontalAlignment="Left"
         Margin="-200,-200,0,0"/>
        <Ellipse Width="500" Height="500" 
         Fill="#2B3674" Opacity="0.03"
         VerticalAlignment="Bottom" HorizontalAlignment="Right"
         Margin="0,0,-248,-200"/>
        <Ellipse Width="300" Height="300" 
         Fill="#4318FF" Opacity="0.04"
         VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="95"/>
                    <RowDefinition/>

                </Grid.RowDefinitions>

                <!-- Header Section -->
                <Border Grid.Row="0" 
        Margin="40,15,20,0" 
        Padding="20,15" 
        CornerRadius="15" 
        Background="White" 
        Effect="{StaticResource CardShadowEffect}"
        VerticalAlignment="Top">

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="75">
                        <!-- Icon: Đã chỉnh lại kích thước và căn giữa -->
                        <materialDesign:PackIcon Kind="Home" 
                                 Width="47" 
                                 Height="57"
                                 Foreground="#4318FF" 
                                 VerticalAlignment="Center"/>

                        <!-- Text: Xóa bỏ Width cứng và sửa lỗi FontSize -->
                        <TextBlock Text="TRANG CHỦ" 
                   FontSize="32" 
                   FontWeight="Bold"
                   Foreground="#2B3674"
                   FontFamily="/Resources/Roboto/Roboto-Bold.ttf#Roboto"
                   Margin="12,0,0,0"
                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="97"/>
                            <RowDefinition Height="300"/>
                            <RowDefinition Height="300"/>
                            <RowDefinition Height="500*"/>
                            <RowDefinition Height="500*"/>

                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="20,20,20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="248*"/>
                                <ColumnDefinition Width="248*"/>
                                <ColumnDefinition Width="248*"/>
                                <ColumnDefinition Width="248*"/>
                                <ColumnDefinition Width="248*"/>


                            </Grid.ColumnDefinitions>
                            <Border Background="White" 
                            CornerRadius="20" 
                            Margin="20,0,0,0" 
                            Padding="15"
                            VerticalAlignment="Center">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="53" Height="53" Margin="0,0,15,0">
                                        <Ellipse Fill="#F0F4FF" Margin="2,0,2,6"/>
                                        <Path Data="M4,18 V15 M10,18 V2 M16,18 V5" 
                                        Stroke="#4A00FF" 
                                         StrokeThickness="4" 
                                         StrokeStartLineCap="Round" 
                                        StrokeEndLineCap="Round"
                                        Stretch="Uniform" 
                                        Width="22" 
                                        Height="27"
                                        VerticalAlignment="Top" 
                                        HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock Text="Doanh thu" 
                       Foreground="#9AA1B2" 
                       FontSize="14" 
                       Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding Sale, StringFormat='{}{0:#,0} VND'}" 
                       Foreground="#283556" 
                       FontSize="15" 
                       FontWeight="Bold" Width="201"/>

                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Background="White" CornerRadius="20" Margin="20,0,0,0" Padding="15, 0, 0, 0" VerticalAlignment="Center" Height="76">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="53" Height="53" Margin="0,0,15,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="2"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Fill="#F0F4FF" Margin="2,0,0,6"/>
                                        <Path Data="M10,21 c-3.3,0 -6,-2.7 -6,-6 c0,-1.5 0.5,-2.8 1.4,-3.9 C5,10.6 4.9,10.1 5,9.5 c0.3,-1.5 1.7,-2.5 3.2,-2.2 c0.6,0.1 1.2,0.4 1.8,0.7 c1.3,-1.3 3.3,-1.3 4.6,0 c0.6,-0.3 1.2,-0.6 1.8,-0.7 c1.5,-0.3 2.9,0.7 3.2,2.2 c0.1,0.6 0,1.1 -0.4,1.6 c0.9,1.1 1.4,2.4 1.4,3.9 c0,3.3 -2.7,6 -6,6 H10 z M12,16 a1.5,1.5 0 1 0 0,-3 a1.5,1.5 0 0 0 0,3 z" 
      Fill="#4A00FF" 
      Stretch="Uniform" 
      Width="32" 
      Height="33" 
      VerticalAlignment="Center" 
      HorizontalAlignment="Center">
                                        </Path>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Lợi nhuận ngày"  Foreground="#9AA1B2" FontSize="14" Margin="0,0,0,2" Height="18"/>
                                        <TextBlock Text="{Binding Profit, StringFormat='{}{0:#,0} VND'}" Foreground="#283556" FontSize="15" FontWeight="Bold"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ProfitPercent, StringFormat='{}{0:+#,0;-#,0;0}%'}" Foreground="#05CD99" FontSize="12" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="so với tháng trước" Foreground="#9AA1B2" FontSize="12" Margin="3,0,0,0"/>
                                        </Grid>

                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Background="White" CornerRadius="20" Margin="20,0,0,0" Padding="15" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="53" Height="53" Margin="0,0,15,0">
                                        <Ellipse Fill="#F0F4FF" Margin="2,0,2,6"/>
                                        <Path Data="M3,6 a2,2 0 0 1 2,-2 h14 a2,2 0 0 1 2,2 v10 a2,2 0 0 1 -2,2 H5 a2,2 0 0 1 -2,-2 Z M11,8.5  v6 M10,9.5 h2 M10.5,13 c0,0.8 -0.7,1.5 -1.5,1.5 c-0.8,0 -1.5,-0.7 -1.5,-1.5 s0.7,-1.5 1.5,-1.5 c0.4,0 0.8,0.2 1.1,0.5" 
      Stroke="#4A00FF" 
      StrokeThickness="3" 
      StrokeStartLineCap="Round" 
      StrokeEndLineCap="Round" 
      StrokeLineJoin="Round"
      Stretch="Uniform" 
      Width="28" 
      HorizontalAlignment="Center" Margin="0,10,0,16"/>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Chi phí ngày" Foreground="#9AA1B2" FontSize="14" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding Expense, StringFormat='{}{0:#,0} VND'}" Foreground="#283556" FontSize="15" FontWeight="Bold"/>

                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="3" Background="White" CornerRadius="20" Margin="20,0,0,0" Padding="15" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="53" Height="53" Margin="0,0,15,0">
                                        <Ellipse Margin="2,0,2,6">
                                            <Ellipse.Fill>
                                                <LinearGradientBrush EndPoint="1,0" StartPoint="0,0" SpreadMethod="Reflect" MappingMode="RelativeToBoundingBox">
                                                    <GradientStop Color="#FF1C6AED" Offset="0"/>
                                                    <GradientStop Color="#FFA3E3F9" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Path Data="M12,12 c2.2,0 4,-1.8 4,-4 s-1.8,-4 -4,-4 s-4,1.8 -4,4 S9.8,12 12,12z 
                                        M12,14 c-4.4,0 -8,2.2 -8,5 v1 c0,0.6 0.4,1 1,1 h14 c0.6,0 1,-0.4 1,-1 v-1 C20,16.2 16.4,14 12,14z" 
                                        Fill="White" 
                                        Stretch="Uniform" 
                                        Width="23" 
                                        Height="27" 
                                        VerticalAlignment="Top" 
                                        HorizontalAlignment="Center" Margin="0,11,0,0">
                                        </Path>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Khách hàng mới" Foreground="#9AA1B2" FontSize="14" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="CustNumTxtBox" Text="{Binding CustNum, StringFormat='{}{0:#,0}'}" Foreground="#283556" FontSize="20" FontWeight="Bold" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Column="4" Background="White" CornerRadius="20" Margin="20,0,0,0" Padding="15" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="53" Height="53" Margin="0,0,15,0">
                                        <Ellipse Fill="#F0F4FF" Margin="2,0,2,6"/>
                                        <Path Data="M18,2 H6 c-1.1,0 -2,0.9 -2,2 v16 c0,1.1 0.9,2 2,2 h12 c1.1,0 2,-0.9 2,-2 V4 C20,2.9 19.1,2 18,2z 
           M7,7 h10 M7,11 h10 M7,15 h7" 
      Stroke="#4A00FF" 
      StrokeThickness="2.5" 
      StrokeStartLineCap="Round" 
      StrokeEndLineCap="Round" 
      StrokeLineJoin="Round"
      Stretch="Uniform" 
      Width="22" 
      Height="27" 
      VerticalAlignment="Top" 
      HorizontalAlignment="Center" RenderTransformOrigin="0.544,0.265" Margin="0,10,0,0">
                                        </Path>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Lượng hoá đơn hôm nay" Foreground="#9AA1B2" FontSize="14" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding ReceiptNum, StringFormat='{}{0:#,0}'}" Foreground="#283556" FontSize="20" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="1" Margin="20,20,20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" CornerRadius="20" Margin="20,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Chart 1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <Grid Grid.Column="1">


                                        <lvc:PieChart SeriesSource="{Binding Data}" Width="300" Height="250">
                                            <lvc:PieChart.SeriesTemplate>
                                                <DataTemplate>
                                                    <lvc:XamlPieSeries
                    SeriesName="{Binding Name}"
                    Values="{Binding Values}"/>
                                                </DataTemplate>
                                            </lvc:PieChart.SeriesTemplate>
                                            <lvc:PieChart.Title>
                                                <lvc:XamlDrawnLabelVisual
                Paint="#000"
                TextSize="25"
                Padding="15"/>
                                            </lvc:PieChart.Title>
                                        </lvc:PieChart>
                                    </Grid>
                                </Grid>

                            </Border>
                            <Border Grid.Column="1" Background="white" CornerRadius="20" Margin="20,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Chart 1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <Grid.DataContext>
                                            <vm:DashBoardViewModel/>
                                        </Grid.DataContext>


                                        <lvc:PieChart SeriesSource="{Binding Data}" Width="300" Height="250">
                                            <lvc:PieChart.SeriesTemplate>
                                                <DataTemplate>
                                                    <lvc:XamlPieSeries
                    SeriesName="{Binding Name}"
                    Values="{Binding Values}"/>
                                                </DataTemplate>
                                            </lvc:PieChart.SeriesTemplate>
                                            <lvc:PieChart.Title>
                                                <lvc:XamlDrawnLabelVisual
                Paint="#000"
                TextSize="25"
                Padding="15"/>
                                            </lvc:PieChart.Title>
                                        </lvc:PieChart>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        <Border Grid.Row="2" Background="White" Margin="40,20,20,0" CornerRadius="20">
                            <Grid Margin="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="TOP 5 BÁN CHẠY" FontSize="20" FontWeight="Bold" Foreground="#2B3674" Margin="10,0,0,15"/>

                                <!-- ItemsControl tự động tạo danh sách dựa trên dữ liệu -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding TopBooks}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="5"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Đặt tên cho Grid để dùng trong Trigger -->
                                            <Grid x:Name="ItemContainer" HorizontalAlignment="Center" Margin="5" Background="Transparent">
                                                <TextBlock Text="{Binding Rank}" 
                           FontSize="110" FontWeight="Black" 
                           Foreground="#2B3674" 
                           Opacity="0.4"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Margin="-15,0,0,0"/>

                                                <!-- Border chứa ảnh sách -->
                                                <Border x:Name="BookBorder" 
                        Width="110" Height="150" 
                        CornerRadius="12" Margin="30,0,0,0"
                        RenderTransformOrigin="0.5,0.5">
                                                    <!-- Gốc tọa độ ở giữa để phóng to đều -->
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </Border.RenderTransform>
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding BookImage}" Stretch="UniformToFill"/>
                                                    </Border.Background>
                                                </Border>
                                            </Grid>

                                            <DataTemplate.Triggers>
                                                <!-- Khi chuột di vào Grid ItemContainer -->
                                                <Trigger Property="IsMouseOver" Value="True" SourceName="ItemContainer">
                                                    <Setter TargetName="BookBorder" Property="Panel.ZIndex" Value="1"/>
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="BookBorder" 
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.2" Duration="0:0:0.2"/>
                                                                <DoubleAnimation Storyboard.TargetName="BookBorder" 
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.2" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="BookBorder" 
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.2"/>
                                                                <DoubleAnimation Storyboard.TargetName="BookBorder" 
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3" Margin="20,20,20,534">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" CornerRadius="20" Margin="20,0,0,0">
                                <Border Background="White" CornerRadius="20" Padding="20" Margin="0,0,0,-513">


                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <DockPanel Margin="0,0,0,20">
                                            <TextBlock Text="THÔNG TIN HÀNG NHẬP" FontSize="22" FontWeight="Bold" Foreground="#1B2559"/>
                                            <Button Content="..." HorizontalAlignment="Right" FontWeight="Bold" Width="40">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <!-- Thuộc tính mặc định -->
                                                        <Setter Property="Background" Value="#F4F7FE"/>
                                                        <Setter Property="Foreground" Value="#4318FF"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Setter Property="Padding" Value="10,5"/>

                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="5">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>

                                                                    <!-- Hiệu ứng khi tương tác -->
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#E0E5F2"/>
                                                                            <!-- Màu khi di chuột qua -->
                                                                        </Trigger>
                                                                        <Trigger Property="IsPressed" Value="True">
                                                                            <Setter Property="Background" Value="#D1D9E6"/>
                                                                            <!-- Màu khi nhấn -->
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DockPanel>

                                        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding InventoryItems}" 
                  AutoGenerateColumns="False" 
                  Background="Transparent" 
                  BorderThickness="0" 
                  CanUserAddRows="False"
                  GridLinesVisibility="None"
