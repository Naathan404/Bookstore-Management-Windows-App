						</Border>

						<Border Grid.Row="0"
								Grid.Column="1"
								Style="{StaticResource DashboardCardStyle}"
								Margin="0,0,0,15">
							<StackPanel>
								<StackPanel Orientation="Horizontal"
											Margin="0,0,0,10">
									<materialDesign:PackIcon Kind="PackageVariantClosed"
															 Foreground="#4318FF"
															 Width="20"
															 Height="20"
															 VerticalAlignment="Center"
															 Margin="0,0,8,0" />
									<TextBlock Text="CÁC NHẬP KHO TRONG NGÀY"
											   FontSize="15"
											   FontWeight="Bold"
											   Foreground="#2B3674"
											   VerticalAlignment="Center" />
								</StackPanel>
								<DataGrid CanUserSortColumns="False"
										  AutoGenerateColumns="False"
										  ItemsSource="{Binding ImportItems}"
										  SelectionMode="Single"
										  SelectionUnit="FullRow"
										  IsReadOnly="True"
										  HeadersVisibility="Column"
										  BorderThickness="0"
										  MinRowHeight="30"
										  FontSize="13"
										  AlternatingRowBackground="#F8FAFC"
										  RowBackground="White"
										  Foreground="#2B3674"
										  GridLinesVisibility="Horizontal"
										  HorizontalGridLinesBrush="#E2E8F0"
										  VerticalGridLinesBrush="Transparent"
										  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
										  ScrollViewer.VerticalScrollBarVisibility="Auto"
										  CanUserAddRows="False"
										  CanUserDeleteRows="False"
										  CanUserResizeColumns="False"
										  CanUserResizeRows="False"
										  CanUserReorderColumns="False"
										  VirtualizingStackPanel.IsVirtualizing="True"
										  VirtualizingStackPanel.VirtualizationMode="Recycling"
										  ScrollViewer.IsDeferredScrollingEnabled="True"
										  PreviewMouseWheel="DataGrid_PreviewMouseWheel">
									<DataGrid.Columns>
										<DataGridTextColumn Header="Mã PN"
															Binding="{Binding DisplayID}"
															Width="110"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
											<DataGridTextColumn.ElementStyle>
												<Style TargetType="TextBlock">
													<Setter Property="HorizontalAlignment"
															Value="Left" />
													<Setter Property="VerticalAlignment"
															Value="Center" />
													<Setter Property="FontWeight"
															Value="SemiBold" />
													<Setter Property="Margin"
															Value="10 0 10 0"></Setter>
												</Style>
											</DataGridTextColumn.ElementStyle>
										</DataGridTextColumn>
										<DataGridTextColumn Header="Nhà cung cấp"
															Binding="{Binding SupplierName}"
															Width="*"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
											<DataGridTextColumn.ElementStyle>
												<Style TargetType="TextBlock">
													<Setter Property="HorizontalAlignment"
															Value="Left" />
													<Setter Property="VerticalAlignment"
															Value="Center" />
													<Setter Property="FontWeight"
															Value="SemiBold" />
													<Setter Property="Margin"
															Value="10 0 10 0"></Setter>
													<Setter Property="TextWrapping"
															Value="Wrap"></Setter>
												</Style>
											</DataGridTextColumn.ElementStyle>
										</DataGridTextColumn>
										<DataGridTextColumn Header="SL nhập"
															Binding="{Binding TotalQuantity}"
															Width="80"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
											<DataGridTextColumn.ElementStyle>
												<Style TargetType="TextBlock">
													<Setter Property="HorizontalAlignment"
															Value="Center" />
													<Setter Property="VerticalAlignment"
															Value="Center" />
													<Setter Property="FontWeight"
															Value="SemiBold" />
													<Setter Property="Margin"
															Value="10 0 10 0"></Setter>
												</Style>
											</DataGridTextColumn.ElementStyle>
										</DataGridTextColumn>
										<DataGridTextColumn Header="Chi phí"
															Binding="{Binding Total}"
															Width="Auto"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
											<DataGridTextColumn.ElementStyle>
												<Style TargetType="TextBlock">
													<Setter Property="HorizontalAlignment"
															Value="Right" />
													<Setter Property="VerticalAlignment"
															Value="Center" />
													<Setter Property="FontWeight"
															Value="SemiBold" />
													<Setter Property="Margin"
															Value="10 0 10 0"></Setter>
												</Style>
											</DataGridTextColumn.ElementStyle>
										</DataGridTextColumn>
									</DataGrid.Columns>
								</DataGrid>
							</StackPanel>
						</Border>

						<Border Grid.Row="1"
								Grid.Column="0"
								Style="{StaticResource DashboardCardStyle}"
								Margin="0,0,10,0">
							<StackPanel>
								<StackPanel Orientation="Horizontal"
											Margin="0,0,0,10">
									<materialDesign:PackIcon Kind="CashMultiple"
															 Foreground="#05CD99"
															 Width="20"
															 Height="20"
															 VerticalAlignment="Center"
															 Margin="0,0,8,0" />
									<TextBlock Text="CÁC PHIẾU THU TIỀN TRONG NGÀY"
											   FontSize="15"
											   FontWeight="Bold"
											   Foreground="#2B3674"
											   VerticalAlignment="Center" />
								</StackPanel>

								<DataGrid CanUserSortColumns="False"
										  AutoGenerateColumns="False"
										  Style="{StaticResource CleanDataGrid}"
										  ItemsSource="{Binding PaymentReceipts}"
										  SelectionMode="Single"
										  SelectionUnit="FullRow"
										  IsReadOnly="True"
										  HeadersVisibility="Column"
										  BorderThickness="0"
										  MinRowHeight="30"
										  FontSize="13"
										  AlternatingRowBackground="#F8FAFC"
										  RowBackground="White"
										  Foreground="#2B3674"
										  GridLinesVisibility="Horizontal"
										  HorizontalGridLinesBrush="#E2E8F0"
										  VerticalGridLinesBrush="Transparent"
										  CanUserAddRows="False"
										  CanUserDeleteRows="False"
										  CanUserResizeColumns="False"
										  CanUserResizeRows="False"
										  CanUserReorderColumns="False"
										  VirtualizingStackPanel.IsVirtualizing="True"
										  VirtualizingStackPanel.VirtualizationMode="Recycling"
										  ScrollViewer.IsDeferredScrollingEnabled="True"
										  PreviewMouseWheel="DataGrid_PreviewMouseWheel">

									<DataGrid.Columns>
										<DataGridTextColumn Header="Mã PT"
															Binding="{Binding DisplayID}"
															Width="100"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
											<DataGridTextColumn.ElementStyle>
												<Style TargetType="TextBlock">
													<Setter Property="HorizontalAlignment"
															Value="Left" />
													<Setter Property="VerticalAlignment"
															Value="Center" />
													<Setter Property="FontWeight"
															Value="SemiBold" />
													<Setter Property="Margin"
															Value="10 0 10 0"></Setter>
												</Style>
											</DataGridTextColumn.ElementStyle>
										</DataGridTextColumn>
										<DataGridTextColumn Header="Khách hàng"
															Binding="{Binding CustomerName}"
															Width="*"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
											<DataGridTextColumn.ElementStyle>
												<Style TargetType="TextBlock">
													<Setter Property="HorizontalAlignment"
															Value="Left" />
													<Setter Property="VerticalAlignment"
															Value="Center" />
													<Setter Property="FontWeight"
															Value="SemiBold" />
													<Setter Property="Margin"
															Value="10 0 10 0"></Setter>
													<Setter Property="TextWrapping"
															Value="Wrap"></Setter>
												</Style>
											</DataGridTextColumn.ElementStyle>
										</DataGridTextColumn>

										<DataGridTextColumn Header="Lý do"
															Binding="{Binding Reason}"
															Width="100"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
											<DataGridTextColumn.ElementStyle>
												<Style TargetType="TextBlock">
													<Setter Property="HorizontalAlignment"
															Value="Left" />
													<Setter Property="VerticalAlignment"
															Value="Center" />
													<Setter Property="FontWeight"
															Value="SemiBold" />
													<Setter Property="Margin"
															Value="10 0 10 0"></Setter>
													<Setter Property="TextWrapping"
															Value="Wrap"></Setter>
												</Style>
											</DataGridTextColumn.ElementStyle>
										</DataGridTextColumn>
										<DataGridTextColumn Header="Số tiền"
															Binding="{Binding Amount, StringFormat='{}{0:#,0} đ'}"
															Width="100"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
											<DataGridTextColumn.ElementStyle>
												<Style TargetType="TextBlock">
													<Setter Property="HorizontalAlignment"
															Value="Right" />
													<Setter Property="VerticalAlignment"
															Value="Center" />
													<Setter Property="FontWeight"
															Value="SemiBold" />
													<Setter Property="Margin"
															Value="10 0 10 0"></Setter>
												</Style>
											</DataGridTextColumn.ElementStyle>
										</DataGridTextColumn>
									</DataGrid.Columns>
								</DataGrid>
							</StackPanel>
						</Border>

						<Border Grid.Row="1"
								Grid.Column="1"
								Style="{StaticResource DashboardCardStyle}"
								Margin="0">
							<StackPanel>
								<StackPanel Orientation="Horizontal"
											Margin="0,0,0,10">
									<materialDesign:PackIcon Kind="AlertCircleOutline"
															 Foreground="#EE5D50"
															 Width="20"
															 Height="20"
															 VerticalAlignment="Center"
															 Margin="0,0,8,0" />
									<TextBlock Text="CẢNH BÁO TỒN KHO"
											   FontSize="15"
											   FontWeight="Bold"
											   Foreground="#EE5D50"
											   VerticalAlignment="Center" />
								</StackPanel>
								<DataGrid CanUserSortColumns="False"
										  AutoGenerateColumns="False"
										  Style="{StaticResource CleanDataGrid}"
										  ItemsSource="{Binding StockWarnings}"
										  SelectionMode="Single"
										  SelectionUnit="FullRow"
										  IsReadOnly="True"
										  HeadersVisibility="Column"
										  BorderThickness="0"
										  MinRowHeight="30"
										  FontSize="13"
										  AlternatingRowBackground="#F8FAFC"
										  RowBackground="White"
										  Foreground="#2B3674"
										  GridLinesVisibility="Horizontal"
										  HorizontalGridLinesBrush="#E2E8F0"
										  VerticalGridLinesBrush="Transparent"
										  ScrollViewer.HorizontalScrollBarVisibility="Hidden"
										  ScrollViewer.VerticalScrollBarVisibility="Auto"
										  CanUserAddRows="False"
										  CanUserDeleteRows="False"
										  CanUserResizeColumns="False"
										  CanUserResizeRows="False"
										  CanUserReorderColumns="False"
										  VirtualizingStackPanel.IsVirtualizing="True"
										  VirtualizingStackPanel.VirtualizationMode="Recycling"
										  ScrollViewer.IsDeferredScrollingEnabled="True"
										  PreviewMouseWheel="DataGrid_PreviewMouseWheel">
									<DataGrid.Columns>
										<DataGridTextColumn Header="Tên sách"
															Binding="{Binding Name}"
															Width="*"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
											<DataGridTextColumn.ElementStyle>
												<Style TargetType="TextBlock">
													<Setter Property="HorizontalAlignment"
															Value="Left" />
													<Setter Property="VerticalAlignment"
															Value="Center" />
													<Setter Property="FontWeight"
															Value="SemiBold" />
													<Setter Property="Margin"
															Value="10 0 10 0"></Setter>
													<Setter Property="TextWrapping"
															Value="Wrap"></Setter>
												</Style>
											</DataGridTextColumn.ElementStyle>
										</DataGridTextColumn>
										<DataGridTextColumn Header="Tồn kho"
															Binding="{Binding RemainingQuantity}"
															Width="*"
															HeaderStyle="{StaticResource CenterHeaderStyle}">
											<DataGridTextColumn.ElementStyle>
												<Style TargetType="TextBlock">
													<Setter Property="HorizontalAlignment"
															Value="Left" />
													<Setter Property="VerticalAlignment"
															Value="Center" />
													<Setter Property="FontWeight"
															Value="SemiBold" />
													<Setter Property="Margin"
															Value="10 0 10 0"></Setter>
													<Setter Property="TextWrapping"
															Value="Wrap"></Setter>
													<Setter Property="Foreground"
															Value="#EE5D50" />
													<Setter Property="FontWeight"
															Value="Bold" />
													<Setter Property="HorizontalAlignment"
															Value="Center" />
												</Style>
											</DataGridTextColumn.ElementStyle>
										</DataGridTextColumn>

									</DataGrid.Columns>
								</DataGrid>
							</StackPanel>
						</Border>
					</Grid>
				</ScrollViewer>
			</TabItem>
		</TabControl>

		<Border Grid.Row="1"
				Background="#F4F7FE"
				Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="15,15,15,0">
					<UniformGrid Columns="4"
								 Margin="0,0,0,20">
						<Border Height="80"
								Style="{StaticResource SkeletonPulseStyle}"
								Margin="0,0,10,0" />
						<Border Height="80"
								Style="{StaticResource SkeletonPulseStyle}"
								Margin="0,0,10,0" />
						<Border Height="80"
								Style="{StaticResource SkeletonPulseStyle}"
								Margin="0,0,10,0" />
						<Border Height="80"
								Style="{StaticResource SkeletonPulseStyle}"
								Margin="0,0,0,0" />
					</UniformGrid>

					<Grid Margin="0,0,0,20">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="1.6*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Border Grid.Column="0"
								Height="360"
								Style="{StaticResource SkeletonPulseStyle}"
								Margin="0,0,10,0" />
						<Border Grid.Column="1"
								Height="360"
								Style="{StaticResource SkeletonPulseStyle}" />
					</Grid>

					<Border Height="400"
							Style="{StaticResource SkeletonPulseStyle}"
							Margin="0,0,0,20" />

					<UniformGrid Columns="5">
						<Border Height="180"
								Style="{StaticResource SkeletonPulseStyle}"
								Margin="5" />
						<Border Height="180"
								Style="{StaticResource SkeletonPulseStyle}"
								Margin="5" />
						<Border Height="180"
								Style="{StaticResource SkeletonPulseStyle}"
								Margin="5" />
						<Border Height="180"
								Style="{StaticResource SkeletonPulseStyle}"
								Margin="5" />
						<Border Height="180"
								Style="{StaticResource SkeletonPulseStyle}"
								Margin="5" />
					</UniformGrid>
				</StackPanel>
			</ScrollViewer>
		</Border>
	</Grid>
</UserControl>