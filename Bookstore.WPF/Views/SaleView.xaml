<UserControl x:Class="Bookstore.WPF.Views.SaleView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 mc:Ignorable="d">

	<Grid>
		<Grid Margin="{StaticResource MainViewMargin}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<components:PageHeaderControl Title="BÁN HÀNG"
										  HeaderIcon="Shopping"
										  ShowAddButton="False" />

			<!--2 CỘT SẢN PHẨM VÀ HÓA ĐƠN-->
			<Grid Grid.Row="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="1.5*" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<Grid Grid.Column="0"
					  Margin="0,0,8,0">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<Border x:Name="Filter"
							Grid.Row="0"
							Style="{StaticResource FilterCardStyle}">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="1.5*" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>


							<components:FilterInputControl Grid.Column="0"
														   Margin="0,0,8,0"
														   IconKind="Book"
														   HintText="Tìm kiếm sách..."
														   TextValue="{Binding SearchTextSach}" />

							<components:FilterComboBoxControl x:Name="KieuTimKiem"
															  Grid.Column="1"
															  Margin="0,0,8,0"
															  IconKind="QuestionMark"
															  HintText="Tìm theo"
															  ItemsSource="{Binding ListKieuTimKiem}"
															  SelectedItem="{Binding KieuTimKiemSach}" />

							<!--<components:FilterComboBoxControl x:Name="TheLoai"
															  Grid.Column="2"
															  Margin="0,0,8,0"
															  IconKind="Category"
															  HintText="Thể loại sách"
															  ItemsSource="{Binding DanhSachTheLoai}"
															  SelectedItem="{Binding TheLoaiDuocChon}"
															  DisplayMemberPath="TenTheLoai" />

							<components:FilterComboBoxControl x:Name="KhoangGia"
															  Grid.Column="3"
															  Margin="0,0,8,0"
															  IconKind="Cash"
															  HintText="Khoảng giá"
															  ItemsSource="{Binding DanhSachKhoangGia}"
															  SelectedItem="{Binding LocGiaSach}" />-->

							<components:FilterActionPanel Grid.Column="4"
														  ClearCommand="{Binding XoaBoLocCommand}"
														  RefreshCommand="{Binding RefreshCommand}"
														  ShowRefreshButton="True" />
						</Grid>
					</Border>

					<Border x:Name="ProductView"
							Grid.Row="1"
							Style="{StaticResource DataGridCardStyle}">
						<ScrollViewer VerticalScrollBarVisibility="Auto"
									  HorizontalScrollBarVisibility="Disabled">
							<ItemsControl ItemsSource="{Binding DanhSachSachHienThi}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal"
												   HorizontalAlignment="Center" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>

								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Margin="8"
												Style="{StaticResource DarkCardStyle}">

											<Grid Width="170"
												  Height="220">

												<Grid.RowDefinitions>
													<RowDefinition Height="145" />
													<RowDefinition Height="*" />
												</Grid.RowDefinitions>

												<Border Grid.Row="0"
														CornerRadius="12,12,0,0"
														ClipToBounds="True">
													<Image Source="{Binding HinhAnh}"
														   Stretch="UniformToFill"
														   RenderOptions.BitmapScalingMode="HighQuality" />
												</Border>

												<StackPanel Grid.Row="1"
															Margin="8">
													<TextBlock Text="{Binding TenSach}"
															   TextWrapping="Wrap"
															   FontSize="13"
															   MaxHeight="38"
															   TextTrimming="CharacterEllipsis"
															   FontWeight="Bold"
															   Foreground="#2B3674"
															   Margin="0,0,0,6" />

													<Grid>
														<TextBlock Text="{Binding DonGiaBan, StringFormat='{}{0:N0} đ'}"
																   FontWeight="Bold"
																   FontSize="14"
																   Foreground="{StaticResource DangerColor}"
																   Visibility="{Binding IsNormalPrice, Converter={StaticResource BoolToVis}}" />

														<StackPanel Visibility="{Binding HasPromotion, Converter={StaticResource BoolToVis}}">
															<TextBlock Text="{Binding PromotionPrice, StringFormat='{}{0:N0} đ'}"
																	   FontWeight="Bold"
																	   FontSize="14"
																	   Foreground="{StaticResource DangerColor}" />
															<TextBlock Text="{Binding DonGiaBan, StringFormat='{}{0:N0} đ'}"
																	   FontSize="12"
																	   Foreground="#A3AED0"
																	   TextDecorations="Strikethrough"
																	   Margin="0,2,0,0" />
														</StackPanel>

														<TextBlock Text="🎁 Quà tặng"
																   Foreground="{StaticResource SuccessColor}"
																   FontWeight="Bold"
																   FontSize="13"
																   Visibility="{Binding IsGift, Converter={StaticResource BoolToVis}}" />
													</Grid>
												</StackPanel>

												<Border Grid.RowSpan="2"
														Background="Transparent"
														Cursor="Hand">
													<Border.InputBindings>
														<MouseBinding MouseAction="LeftClick"
																	  Command="{Binding DataContext.XemChiTietSachCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	  CommandParameter="{Binding}" />
													</Border.InputBindings>
												</Border>

												<components:TickComponent HorizontalAlignment="Right"
																		  VerticalAlignment="Top"
																		  Margin="8"
																		  IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
																		  Command="{Binding DataContext.ChonSachCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																		  CommandParameter="{Binding}" />

											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</Border>

					<components:PaginationControl Grid.Row="2"
												  CurrentPage="{Binding TrangHienTai}"
												  TotalPages="{Binding TongSoTrang}"
												  TotalRecords="{Binding TongBanGhi}"
												  PaginationCommand="{Binding PhanTrangCommand}" />
					<!--TODO: Biding lại lệnh phân trang -->
				</Grid>

				<Grid Grid.Column="1">
					<Grid.RowDefinitions>
						<RowDefinition Height="200*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<Border Grid.Row="0"
							Style="{StaticResource DataGridCardStyle}"
							Margin="0,0,0,8">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<StackPanel x:Name="GioHangHienTai"
										Grid.Row="0"
										Orientation="Horizontal"
										Margin="0,0,0,12">
								<materialDesign:PackIcon Kind="ShoppingCartOutline"
														 Width="22"
														 Height="22"
														 Foreground="#4318FF"
														 VerticalAlignment="Center"
														 Margin="0,0,8,0" />
								<TextBlock Text="Giỏ Hàng Hiện Tại"
										   FontSize="16"
										   FontWeight="Bold"
										   Foreground="#2B3674"
										   VerticalAlignment="Center" />
								<Border Background="#F4F7FE"
										CornerRadius="8"
										Padding="6,2"
										Margin="8,0,0,0"
										VerticalAlignment="Center">
									<TextBlock Text="{Binding DanhSachGioHang.Count, StringFormat='{}{0}'}"
											   FontSize="11"
											   FontWeight="Bold"
											   Foreground="#4318FF" />
								</Border>
							</StackPanel>

							<ScrollViewer Grid.Row="1"
										  VerticalScrollBarVisibility="Hidden"
										  HorizontalScrollBarVisibility="Disabled">
								<ItemsControl ItemsSource="{Binding DanhSachGioHang}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Margin="0,0,0,8"
													Padding="10"
													Background="#F8FAFC"
													CornerRadius="12"
													BorderBrush="#E2E8F0"
													BorderThickness="1">
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="Auto" />
														<ColumnDefinition Width="Auto" />
													</Grid.ColumnDefinitions>

													<StackPanel Grid.Column="0"
																VerticalAlignment="Center"
																Margin="0,0,8,0">
														<TextBlock Text="{Binding TenSach}"
																   FontSize="13"
																   FontWeight="Bold"
																   Foreground="#2B3674"
																   TextTrimming="CharacterEllipsis" />
														<StackPanel Orientation="Horizontal"
																	VerticalAlignment="Center">
															<TextBlock Text="{Binding GiaBan, StringFormat='{}{0:N0} đ'}"
																	   FontSize="12"
																	   Foreground="#A3AED0"
																	   Margin="0,2,6,0"
																	   Visibility="{Binding IsNormalPrice, Converter={StaticResource BoolToVis}}" />
															<StackPanel Orientation="Vertical"
																		Visibility="{Binding IsPromotionApplied, Converter={StaticResource BoolToVis}}">
																<TextBlock Text="{Binding GiaBan, StringFormat='{}{0:N0} đ'}"
																		   FontSize="12"
																		   Foreground="#10B981"
																		   FontWeight="Bold" />
																<TextBlock Text="{Binding OriginalGiaBan, StringFormat='{}{0:N0} đ'}"
																		   FontSize="11"
																		   Foreground="#A3AED0"
																		   TextDecorations="Strikethrough" />
															</StackPanel>
															<TextBlock Text=" (HÀNG TẶNG)"
																	   Foreground="#10B981"
																	   FontSize="12"
																	   Visibility="{Binding IsGift, Converter={StaticResource BoolToVis}}" />
														</StackPanel>
													</StackPanel>

													<StackPanel Grid.Column="1"
																Orientation="Horizontal"
																VerticalAlignment="Center">
														<Button Style="{StaticResource MiniAddButtonStyle}"
																ToolTip="Giảm số lượng"
																Command="{Binding DataContext.GiamSoLuongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																CommandParameter="{Binding}">
															<materialDesign:PackIcon Kind="Minus"
																					 Width="16"
																					 Height="16" />
														</Button>

														<TextBlock Text="{Binding SoLuongMua}"
																   FontSize="14"
																   FontWeight="Bold"
																   Foreground="{StaticResource PrimaryDarkColor}"
																   Width="32"
																   TextAlignment="Center"
																   VerticalAlignment="Center" />

														<Button Style="{StaticResource MiniAddButtonStyle}"
																ToolTip="Tăng số lượng"
																Command="{Binding DataContext.TangSoLuongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																CommandParameter="{Binding}">
															<materialDesign:PackIcon Kind="Plus"
																					 Width="16"
																					 Height="16" />
														</Button>
													</StackPanel>

													<Button Grid.Column="2"
															Margin="12,0,0,0"
															Style="{StaticResource MiniDeleteButtonStyle}"
															ToolTip="Xóa khỏi giỏ hàng"
															Command="{Binding DataContext.XoaKhoiGioHangCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
															CommandParameter="{Binding}">
														<materialDesign:PackIcon Kind="DeleteOutline"
																				 Width="16"
																				 Height="16" />
													</Button>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</Grid>
					</Border>

					<Border Grid.Row="1"
							Style="{StaticResource DataGridCardStyle}">
						<StackPanel>

							<StackPanel x:Name="ThongTinThanhToan"
										Orientation="Horizontal"
										Margin="0,0,0,12">
								<materialDesign:PackIcon Kind="CashCheck"
														 Width="22"
														 Height="22"
														 Foreground="{StaticResource PrimaryColor}"
														 VerticalAlignment="Center"
														 Margin="0,0,8,0" />
								<TextBlock Text="Thông tin thanh toán"
										   FontSize="16"
										   FontWeight="Bold"
										   Foreground="#2B3674"
										   VerticalAlignment="Center" />
							</StackPanel>

							<Grid Margin="0,0,0,12">
								<TextBlock Text="Tổng tiền tạm tính:"
										   Foreground="{StaticResource PrimaryDarkColor}"
										   FontSize="13"
										   VerticalAlignment="Center" />
								<TextBlock Text="{Binding TamTinh, StringFormat='{}{0:N0} đ'}"
										   HorizontalAlignment="Right"
										   Foreground="#2B3674"
										   FontSize="14"
										   FontWeight="Bold" />
							</Grid>

							<Grid Margin="0,0,0,8">
								<components:FilterComboBoxControl x:Name="ChonUuDai"
																  IconKind="TagOutline"
																  HintText="Chọn ưu đãi áp dụng..."
																  ItemsSource="{Binding ListUuDai}"
																  SelectedItem="{Binding SelectedUuDai}" />
							</Grid>

							<ItemsControl ItemsSource="{Binding DanhSachUuDaiDaApDung}"
										  Margin="0,0,0,12">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Grid Margin="0,0,0,6">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>

											<TextBlock Grid.Column="0"
													   Text="{Binding TenUuDai}"
													   FontSize="13"
													   Foreground="#2B3674"
													   VerticalAlignment="Center"
													   TextWrapping="Wrap"
													   Margin="0,0,8,0" />

											<TextBlock Grid.Column="1"
													   Text="{Binding SoTienGiam, StringFormat='-{0:N0} đ'}"
													   FontSize="13"
													   FontWeight="SemiBold"
													   Foreground="#10B981"
													   VerticalAlignment="Center"
													   Margin="0,0,12,0" />

											<Button Grid.Column="2"
													Style="{StaticResource MiniDeleteButtonStyle}"
													ToolTip="Gỡ bỏ ưu đãi này"
													Command="{Binding DataContext.GopUuDaiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
													CommandParameter="{Binding}">
												<materialDesign:PackIcon Kind="Minus"
																		 Width="16"
																		 Height="16" />
											</Button>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<Border BorderBrush="#F4F7FE"
									BorderThickness="0,1,0,0"
									Margin="0,0,0,12" />

							<Grid Margin="0,0,0,16">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>

								<StackPanel Grid.Column="0"
											VerticalAlignment="Bottom">
									<TextBlock Text="Đã giảm:"
											   Foreground="{StaticResource PrimaryDarkColor}"
											   FontSize="12" />
									<TextBlock Text="{Binding GiamTien, StringFormat='-{0:N0} đ'}"
											   Foreground="{StaticResource DangerColor}"
											   FontSize="16"
											   FontWeight="Bold" />
								</StackPanel>

								<StackPanel Grid.Column="1"
											HorizontalAlignment="Right"
											VerticalAlignment="Bottom">
									<TextBlock Text="Tổng thanh toán:"
											   Foreground="{StaticResource PrimaryDarkColor}"
											   HorizontalAlignment="Right"
											   FontSize="13" />
									<TextBlock Text="{Binding TongTienThanhToan, StringFormat='{}{0:N0} VNĐ'}"
											   HorizontalAlignment="Right"
											   Foreground="{StaticResource PrimaryColor}"
											   FontSize="20"
											   FontWeight="Black" />
								</StackPanel>
							</Grid>

							<Button Style="{StaticResource MainGradientButton}"
									Command="{Binding MoPopupThanhToanCommand}">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon Kind="CreditCardOutline"
															 Width="18"
															 Height="18"
															 Margin="0,0,8,0" />
									<TextBlock Text="THANH TOÁN" />
								</StackPanel>
							</Button>

						</StackPanel>
					</Border>
				</Grid>
			</Grid>
		</Grid>

		<Grid Background="#80000000"
			  Visibility="{Binding IsBookDetailOpen, Converter={StaticResource BoolToVis}}"
			  VerticalAlignment="Stretch"
			  HorizontalAlignment="Stretch"
			  Panel.ZIndex="1000">
			<Border Background="#00000000"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch" />
			<Border Width="550"
					Padding="24"
					Background="White"
					CornerRadius="16"
					HorizontalAlignment="Center"
					VerticalAlignment="Center">
				<StackPanel>
					<Grid Margin="0,0,0,16">
						<TextBlock Text="CHI TIẾT SẢN PHẨM"
								   FontSize="18"
								   FontWeight="Bold"
								   Foreground="#2B3674" />
						<Button HorizontalAlignment="Right"
								Style="{StaticResource MaterialDesignFlatButton}"
								Foreground="Gray"
								Command="{Binding CloseDialogCommand}">
							<materialDesign:PackIcon Kind="Close" />
						</Button>
					</Grid>

					<Border CornerRadius="8"
							ClipToBounds="True"
							HorizontalAlignment="Center"
							Margin="0,0,0,16"
							Background="#F4F7FE"
							Width="160"
							Height="200">
						<Image Source="{Binding SachDuocChonXemChiTiet.HinhAnh}"
							   Stretch="UniformToFill"
							   RenderOptions.BitmapScalingMode="HighQuality" />
					</Border>

					<Grid Margin="0,0,0,8">
						<TextBlock Text="Tên sách:"
								   Foreground="#A3AED0" />
						<TextBlock Text="{Binding SachDuocChonXemChiTiet.TenSach}"
								   HorizontalAlignment="Right"
								   FontWeight="Bold"
								   Foreground="#2B3674" />
					</Grid>
					<Grid Margin="0,0,0,8">
						<TextBlock Text="Mã ISBN:"
								   Foreground="#A3AED0" />
						<TextBlock Text="{Binding SachDuocChonXemChiTiet.ISBN}"
								   HorizontalAlignment="Right"
								   Foreground="#2B3674" />
					</Grid>
					<Grid Margin="0,0,0,8">
						<TextBlock Text="Thể loại:"
								   Foreground="#A3AED0" />
						<TextBlock Text="{Binding SachDuocChonXemChiTiet.TheLoai}"
								   HorizontalAlignment="Right"
								   Foreground="#2B3674" />
					</Grid>
					<Grid Margin="0,0,0,16">
						<TextBlock Text="Giá bán:"
								   Foreground="#A3AED0" />
						<TextBlock Text="{Binding SachDuocChonXemChiTiet.DonGiaBan, StringFormat='{}{0:N0} đ'}"
								   HorizontalAlignment="Right"
								   Foreground="#EF4444"
								   FontWeight="Bold" />
					</Grid>

					<Button Content="Thêm vào giỏ hàng"
							Style="{StaticResource MaterialDesignRaisedButton}"
							Background="#4318FF"
							Command="{Binding ThemVaoGioHangTuPopupCommand}"
							CommandParameter="{Binding SachDuocChonXemChiTiet}" />
				</StackPanel>
			</Border>
		</Grid>

		<Grid Background="#80000000"
			  Visibility="{Binding IsConfirmingOrder, Converter={StaticResource BoolToVis}}"
			  VerticalAlignment="Stretch"
			  HorizontalAlignment="Stretch"
			  Panel.ZIndex="1001">
			<Border Background="#00000000"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch" />
			<Border Width="600"
					Padding="28"
					Background="White"
					CornerRadius="20"
					HorizontalAlignment="Center"
					VerticalAlignment="Center">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<Border Grid.Row="0"
							Margin="0,0,0,16"
							BorderBrush="#F4F7FE"
							BorderThickness="0,0,0,1">
						<StackPanel Orientation="Horizontal"
									Margin="0,0,0,10">
							<materialDesign:PackIcon Kind="PlaylistCheck"
													 Width="24"
													 Height="24"
													 Foreground="#4318FF"
													 VerticalAlignment="Center"
													 Margin="0,0,8,0" />
							<TextBlock Text="Xác Nhận Đơn Hàng &amp; Thanh Toán"
									   FontSize="18"
									   FontWeight="Bold"
									   Foreground="#2B3674"
									   VerticalAlignment="Center" />
						</StackPanel>
					</Border>

					<StackPanel Grid.Row="1"
								Margin="0,0,0,16">
						<Grid Margin="0,0,0,6">
							<TextBlock Text="Khách hàng:"
									   Foreground="#A3AED0"
									   FontSize="13" />
							<TextBlock Text="{Binding TenKhachHang}"
									   HorizontalAlignment="Right"
									   FontWeight="SemiBold"
									   Foreground="#2B3674"
									   FontSize="13" />
						</Grid>
						<Grid Margin="0,0,0,12">
							<TextBlock Text="Số điện thoại:"
									   Foreground="#A3AED0"
									   FontSize="13" />
							<TextBlock Text="{Binding SdtKhachHang}"
									   HorizontalAlignment="Right"
									   Foreground="#2B3674"
									   FontSize="13" />
						</Grid>

						<TextBlock Text="Danh sách sản phẩm mua:"
								   Foreground="#2B3674"
								   FontWeight="Bold"
								   Margin="0,4,0,6"
								   FontSize="13" />

						<Border Background="#F4F7FE"
								CornerRadius="8"
								Padding="12"
								MaxHeight="150">
							<ScrollViewer VerticalScrollBarVisibility="Auto">
								<ItemsControl ItemsSource="{Binding DanhSachGioHang}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Grid Margin="0,4">
												<TextBlock Text="{Binding TenSach}"
														   Foreground="#2B3674"
														   FontWeight="Medium"
														   Width="300"
														   HorizontalAlignment="Left"
														   TextTrimming="CharacterEllipsis" />
												<TextBlock Text="{Binding SoLuongMua, StringFormat='x{0}'}"
														   Foreground="#A3AED0"
														   HorizontalAlignment="Right"
														   Margin="0,0,100,0" />
												<TextBlock Text="{Binding ThanhTien, StringFormat='{}{0:N0} đ'}"
														   Foreground="#4318FF"
														   FontWeight="Bold"
														   HorizontalAlignment="Right" />
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</Border>
					</StackPanel>

					<Border Grid.Row="2"
							Background="#FFF9DB"
							CornerRadius="12"
							Padding="16"
							Margin="0,0,0,24"
							BorderBrush="#FFE066"
							BorderThickness="1">
						<StackPanel>
							<TextBlock Text="CHỌN PHƯƠNG THỨC THANH TOÁN:"
									   FontSize="13"
									   FontWeight="Bold"
									   Foreground="#F59E0B"
									   Margin="0,0,0,10" />
							<StackPanel Orientation="Horizontal"
										HorizontalAlignment="Center">
								<RadioButton Content="Tiền mặt"
											 IsChecked="{Binding IsThanhToanTienMat}"
											 Margin="0,0,32,0"
											 FontSize="14"
											 FontWeight="SemiBold"
											 Foreground="#2B3674" />
								<RadioButton Content="Chuyển khoản (Ví / Thẻ)"
											 IsChecked="{Binding IsThanhToanChuyenKhoan}"
											 FontSize="14"
											 FontWeight="SemiBold"
											 Foreground="#2B3674" />
							</StackPanel>

							<Border Margin="0,16,0,0"
									BorderBrush="#FFE066"
									BorderThickness="0,1,0,0"
									Padding="0,10,0,0">
								<Grid>
									<TextBlock Text="TỔNG TIỀN PHẢI THU:"
											   FontSize="14"
											   FontWeight="Bold"
											   VerticalAlignment="Center"
											   Foreground="#2B3674" />
									<TextBlock Text="{Binding TongTienThanhToan, StringFormat='{}{0:N0} VNĐ'}"
											   HorizontalAlignment="Right"
											   FontSize="22"
											   FontWeight="Black"
											   Foreground="#EF4444" />
								</Grid>
							</Border>
						</StackPanel>
					</Border>

					<StackPanel Grid.Row="3"
								Orientation="Horizontal"
								HorizontalAlignment="Right">
						<Button Content="HỦY BỎ"
								Style="{StaticResource MaterialDesignOutlinedButton}"
								Width="120"
								Height="40"
								Margin="0,0,12,0"
								Foreground="#707EAE"
								BorderBrush="#E2E8F0"
								Command="{Binding HuyBoGiaoDichCommand}" />
						<Button Content="XÁC NHẬN TẠO ĐƠN"
								Style="{StaticResource MaterialDesignRaisedButton}"
								Width="180"
								Height="40"
								Background="#05CD99"
								BorderThickness="0"
								Foreground="White"
								FontWeight="Bold"
								Command="{Binding XacNhanTaoDonCommand}" />
					</StackPanel>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</UserControl>