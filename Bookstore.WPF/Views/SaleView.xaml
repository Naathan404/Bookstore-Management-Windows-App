<UserControl x:Class="Bookstore.WPF.Views.SaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Bookstore.WPF.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/XAMLRes/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="BackgroundColor" Color="#F4F7FE"/>
            <DropShadowEffect x:Key="CardShadowEffect" BlurRadius="20" ShadowDepth="0" Opacity="0.08" Color="#4318FF"/>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style x:Key="PaginationButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#2B3674"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundColor}">
        <materialDesign:DialogHost Identifier="RootDialog" CloseOnClickAway="True">

            <materialDesign:DialogHost.DialogContent>
                <Border Width="600" Padding="24" Background="White" CornerRadius="24" Effect="{StaticResource CardShadowEffect}">
                    <Grid DataContext="{Binding SachDuocChonXemChiTiet}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="BookOpenPageVariant" Width="24" Height="24" Foreground="#4318FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Thông Tin Chi Tiết Sách" FontSize="20" FontWeight="Bold" Foreground="#2B3674" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Style="{StaticResource MaterialDesignFlatButton}" 
                                Content="Đóng" 
                                Foreground="#EF4444"
                                Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" CornerRadius="12" ClipToBounds="True" Height="240" Background="#F1F5F9" VerticalAlignment="Top">
                                <Image Source="{Binding HinhAnh}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                <TextBlock Text="{Binding TenSach}" FontSize="18" FontWeight="Bold" Foreground="#2B3674" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Mã ISBN:" Foreground="#A3AED0" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Isbn}" Foreground="#2B3674" FontSize="14" FontWeight="SemiBold"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Thể loại:" Foreground="#A3AED0" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TenTheLoai}" Foreground="#4318FF" FontSize="14" FontWeight="SemiBold"/>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Số lượng tồn:" Foreground="#A3AED0" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SoLuongTon, StringFormat='{}{0} quyển'}" Foreground="#05CD99" FontSize="14" FontWeight="SemiBold"/>
                                </Grid>

                                <Border Background="#F4F7FE" CornerRadius="12" Padding="16,12" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Giá bán hiện tại:" Foreground="#A3AED0" FontSize="12"/>
                                        <TextBlock Text="{Binding GiaBan, StringFormat='{}{0:N0} VNĐ'}" FontSize="24" FontWeight="Black" Foreground="#2B3674"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                                    Content="Đóng lại" 
                                    Width="120" Margin="0,0,12,0"
                                    BorderBrush="#A3AED0" Foreground="#707EAE"
                                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"/>

                            <Button Style="{StaticResource MaterialDesignFlatMidBgButton}" 
                                    Content="Thêm vào giỏ" 
                                    Width="150" Background="#4318FF" BorderBrush="Transparent"
                                    Command="{Binding DataContext.ThemVaoGioHangTuPopupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CartPlus" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="Bold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </Button.ContentTemplate>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </materialDesign:DialogHost.DialogContent>

            <Grid>
                <Ellipse Width="600" Height="600" Fill="#4318FF" Opacity="0.03" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="-200,-200,0,0"/>
                <Ellipse Width="500" Height="500" Fill="#2B3674" Opacity="0.03" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,-150,-150"/>

                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="90"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Margin="0,0,0,16" Padding="24,16" CornerRadius="20" Background="White" Effect="{StaticResource CardShadowEffect}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <materialDesign:PackIcon Kind="Shopping" Width="32" Height="32" Foreground="#4318FF" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="THÔNG TIN BÁN HÀNG" FontSize="26" FontWeight="Bold" Foreground="#2B3674" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1050"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,16,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Margin="0,0,0,16" Padding="20,16" CornerRadius="20" Background="White" Effect="{StaticResource CardShadowEffect}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Margin="0,0,16,0">
                                        <TextBox x:Name="txtTimKiem"
                                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                 materialDesign:HintAssist.Hint="Tìm kiếm sách..."
                                                 FontSize="14" Foreground="#2B3674"
                                                 TextChanged="txtTimKiem_TextChanged"/>
                                        <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="#A3AED0"
                                                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ComboBox x:Name="cboKieuTimKiem" Width="130" Height="48"
                                                 materialDesign:HintAssist.Hint="Tìm theo"
                                                 Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                                 FontSize="13" Foreground="#2B3674" Margin="0,0,12,0"
                                                 SelectionChanged="cboKieuTimKiem_SelectionChanged">
                                            <ComboBoxItem Content="Tên sách" IsSelected="True"/>
                                            <ComboBoxItem Content="Mã ISBN"/>
                                            <ComboBoxItem Content="Tác giả"/>
                                        </ComboBox>

                                        <ComboBox Width="140" Height="48"
                                                 materialDesign:HintAssist.Hint="Thể loại sách"
                                                 Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                                 FontSize="13" Foreground="#2B3674" Margin="0,0,12,0"
                                                 ItemsSource="{Binding DanhSachTheLoai}"
                                                 SelectedItem="{Binding TheLoaiDuocChon, Mode=TwoWay}"
                                                 DisplayMemberPath="TenTheLoai">
                                        </ComboBox>

                                        <ComboBox x:Name="cboLocGia" Width="130" Height="48"
                                                 materialDesign:HintAssist.Hint="Khoảng giá"
                                                 Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                                 FontSize="13" Foreground="#2B3674" Margin="0,0,12,0"
                                                 SelectionChanged="cboLocGia_SelectionChanged">
                                            <ComboBoxItem Content="Tất cả" IsSelected="True"/>
                                            <ComboBoxItem Content="Dưới 50.000 đ"/>
                                            <ComboBoxItem Content="50.000 - 150.000 đ"/>
                                            <ComboBoxItem Content="150.000 - 300.000 đ"/>
                                            <ComboBoxItem Content="Trên 300.000 đ"/>
                                        </ComboBox>

                                        <Border Background="#F4F7FE" CornerRadius="10" Padding="12,10" Margin="4,0,4,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Tổng:" Foreground="#A3AED0" FontSize="12" Margin="0,0,6,0"/>
                                                <TextBlock x:Name="txtTongBanGhi" Text="{Binding TongSoSach}" FontWeight="Bold" FontSize="14" Foreground="#4318FF"/>
                                            </StackPanel>
                                        </Border>

                                        <Button x:Name="btnXoaLoc" Width="42" Height="42"
                                                 Style="{StaticResource MaterialDesignIconForegroundButton}"
                                                 Foreground="#EF4444" ToolTip="Xóa bộ lọc"
                                                 Click="btnXoaLoc_Click" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="FilterRemove" Width="22" Height="22"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Margin="0,0,0,16" Padding="20" CornerRadius="20" Background="White" Effect="{StaticResource CardShadowEffect}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding DanhSachSachHienThi}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" VerticalAlignment="Top"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Padding="0" Margin="8" Background="Transparent" BorderBrush="Transparent" Style="{StaticResource MaterialDesignFlatButton}"
                                                        Command="{Binding DataContext.XemChiTietSachCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">

                                                    <Border Padding="12" CornerRadius="12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" HorizontalAlignment="Stretch">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="140"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                                                <Border CornerRadius="8" ClipToBounds="True" Background="#E2E8F0">
                                                                    <Image Source="{Binding HinhAnh}" Stretch="UniformToFill" 
                                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                </Border>
                                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                          Style="{StaticResource MaterialDesignSecondaryCheckBox}"
                                                                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                                                                    <CheckBox.Resources>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="CornerRadius" Value="100"/>
                                                                        </Style>
                                                                    </CheckBox.Resources>
                                                                </CheckBox>
                                                            </Grid>

                                                            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                                                <TextBlock Text="{Binding TenSach}" FontSize="15" FontWeight="Bold" Foreground="#2B3674" 
                                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="44" HorizontalAlignment="Left"/>
                                                                <Border Background="#4318FF" Opacity="0.08" Height="1" Margin="0,6,0,6"/>
                                                                <Grid>
                                                                    <TextBlock Text="{Binding TenTheLoai}" FontSize="11" FontWeight="SemiBold" Foreground="#4318FF"/>
                                                                    <TextBlock Text="{Binding Isbn}" FontSize="11" Foreground="#A3AED0" HorizontalAlignment="Right"/>
                                                                </Grid>
                                                            </StackPanel>

                                                            <Grid Grid.Row="2" Margin="0,4,0,0">
                                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding GiaBan, StringFormat='{}{0:N0} đ'}" FontSize="16" FontWeight="Heavy" Foreground="#2B3674"/>
                                                                    <TextBlock Text="{Binding SoLuongTon, StringFormat='Kho: {0}'}" FontSize="11" Foreground="#05CD99" FontWeight="Medium"/>
                                                                </StackPanel>

                                                                <Button HorizontalAlignment="Right" Width="36" Height="36" Padding="0"
                                                                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                                                                        Background="#2B3674" BorderBrush="Transparent" Foreground="White"
                                                                        Command="{Binding DataContext.ThemVaoGioHangCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"/>
                                                                </Button>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <Border Grid.Row="2" Padding="12,8" CornerRadius="12" Background="White" Effect="{StaticResource CardShadowEffect}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource PaginationButtonStyle}" Command="{Binding FirstPageCommand}" Margin="0,0,4,0">
                                        <materialDesign:PackIcon Kind="ChevronDoubleLeft" Width="16" Height="16" Foreground="#A3AED0"/>
                                    </Button>
                                    <Button Style="{StaticResource PaginationButtonStyle}" Command="{Binding PrevPageCommand}" Margin="0,0,8,0">
                                        <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16" Foreground="#A3AED0"/>
                                    </Button>

                                    <ItemsControl ItemsSource="{Binding PageNumbers}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding}" Margin="0,0,4,0" Style="{StaticResource PaginationButtonStyle}"
                                                        Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button Style="{StaticResource PaginationButtonStyle}" Command="{Binding NextPageCommand}" Margin="8,0,0,0">
                                        <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" Foreground="#A3AED0"/>
                                    </Button>
                                    <Button Style="{StaticResource PaginationButtonStyle}" Command="{Binding LastPageCommand}" Margin="4,0,0,0">
                                        <materialDesign:PackIcon Kind="ChevronDoubleRight" Width="16" Height="16" Foreground="#A3AED0"/>
                                    </Button>

                                    <TextBlock Text="{Binding CurrentPage, StringFormat='Trang {0}'}" FontSize="12" Foreground="#A3AED0" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Margin="0,0,0,16" Padding="20" CornerRadius="20" Background="White" Effect="{StaticResource CardShadowEffect}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="302*"/>
                                        <ColumnDefinition Width="177*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16" Grid.ColumnSpan="2">
                                        <materialDesign:PackIcon Kind="ShoppingCartOutline" Width="22" Height="22" Foreground="#4318FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Giỏ Hàng Hiện Tại" FontSize="16" FontWeight="Bold" Foreground="#2B3674" VerticalAlignment="Center"/>
                                        <Border Background="#F4F7FE" CornerRadius="8" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DanhSachGioHang.Count, StringFormat='{}{0} món'}" FontSize="11" FontWeight="Bold" Foreground="#4318FF"/>
                                        </Border>
                                    </StackPanel>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.ColumnSpan="2">
                                        <ItemsControl ItemsSource="{Binding DanhSachGioHang}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,12" Padding="10" Background="#F8FAFC" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Width="180" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding TenSach}" FontSize="13" FontWeight="Bold" Foreground="#2B3674" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding GiaBan, StringFormat='{}{0:N0} đ'}" FontSize="12" Foreground="#A3AED0" Margin="0,2,0,0"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Button Width="26" Height="26" Padding="0" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#CBD5E1" ToolTip="Giảm số lượng"
                                                                        Command="{Binding DataContext.GiamSoLuongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                                    <materialDesign:PackIcon Kind="Minus" Width="12" Height="12" Foreground="#707EAE"/>
                                                                </Button>

                                                                <TextBlock Text="{Binding SoLuongMua}" FontSize="14" FontWeight="Bold" Foreground="#2B3674" Width="30" TextAlignment="Center" VerticalAlignment="Center"/>

                                                                <Button Width="26" Height="26" Padding="0" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#CBD5E1" ToolTip="Tăng số lượng"
                                                                        Command="{Binding DataContext.TangSoLuongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                                    <materialDesign:PackIcon Kind="Plus" Width="12" Height="12" Foreground="#707EAE"/>
                                                                </Button>
                                                            </StackPanel>

                                                            <Button Grid.Column="2" Width="32" Height="32" Padding="0" Style="{StaticResource MaterialDesignIconForegroundButton}" Foreground="#EF4444"
                                                                    Command="{Binding DataContext.XoaKhoiGioHangCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Padding="20" CornerRadius="20" Background="White" Effect="{StaticResource CardShadowEffect}">
                                <StackPanel>
                                    <TextBlock Text="Thông tin hóa đơn" FontSize="15" FontWeight="Bold" Foreground="#2B3674" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,10">
                                        <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                 materialDesign:HintAssist.Hint="Số điện thoại khách hàng"
                                                 Text="{Binding SdtKhachHang, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="13" Foreground="#2B3674"/>
                                        <materialDesign:PackIcon Kind="Phone" Width="18" Height="18" Foreground="#A3AED0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <TextBox Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                 materialDesign:HintAssist.Hint="Tên khách hàng"
                                                 Text="{Binding TenKhachHang}" IsEnabled="False"
                                                 FontSize="13" Foreground="#2B3674"/>
                                        <materialDesign:PackIcon Kind="Account" Width="18" Height="18" Foreground="#A3AED0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    </Grid>

                                    <Separator Background="#F4F7FE" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Tạm tính:" Foreground="#A3AED0" FontSize="13"/>
                                        <TextBlock Text="{Binding TamTinh, StringFormat='{}{0:N0} đ'}" HorizontalAlignment="Right" Foreground="#2B3674" FontSize="13" FontWeight="SemiBold"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Giảm giá (%):" Foreground="#A3AED0" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBox Width="50" HorizontalAlignment="Right" TextAlignment="Right"
                                                 Text="{Binding PhanTramGiam, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0}'}" 
                                                 FontSize="13" Foreground="#EF4444" FontWeight="Bold" Margin="0,0,0,-4"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,16">
                                        <TextBlock Text="Tổng thanh toán:" Foreground="#2B3674" FontSize="14" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TongTienThanhToan, StringFormat='{}{0:N0} VNĐ'}" HorizontalAlignment="Right" Foreground="#4318FF" FontSize="20" FontWeight="Black"/>
                                    </Grid>

                                    <Border Background="#2196F3" CornerRadius="5">
                                        <Button Content="Thanh toán" 
            Background="Transparent" 
            BorderThickness="0" 
            Foreground="White"
            Padding="10,5"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                    </Grid>
                </Grid>
            </Grid>
        </materialDesign:DialogHost>
    </Grid>
</UserControl>