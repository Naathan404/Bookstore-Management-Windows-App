<UserControl x:Class="Bookstore.WPF.Views.SaleView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 xmlns:popup="clr-namespace:Bookstore.WPF.Views.Popup"
			 mc:Ignorable="d">
	<UserControl.Resources>
		<Style x:Key="CardHeader"
			   TargetType="TextBlock">
			<Setter Property="FontSize"
					Value="16" />
			<Setter Property="FontWeight"
					Value="Bold" />
			<Setter Property="Foreground"
					Value="{StaticResource PrimaryDarkColor}" />
			<Setter Property="VerticalAlignment"
					Value="Center" />
		</Style>
	</UserControl.Resources>

	<Grid>

		<Grid Margin="{StaticResource MainViewMargin}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<components:PageHeaderControl Title="BÁN HÀNG"
										  HeaderIcon="Shopping"
										  ShowAddButton="False" />

			<!--2 CỘT SẢN PHẨM VÀ HÓA ĐƠN-->
			<Grid Grid.Row="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="1.5*" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<Grid x:Name="ProductSearch"
					  Grid.Column="0"
					  Margin="0,0,8,0">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<Border x:Name="Filter"
							Grid.Row="0"
							Style="{StaticResource FilterCardStyle}">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="1.5*" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<components:FilterInputControl Grid.Column="0"
														   Margin="0,0,8,0"
														   IconKind="Book"
														   HintText="Tìm kiếm sách..."
														   TextValue="{Binding SearchKeyword}" />

							<components:FilterComboBoxControl x:Name="KieuTimKiem"
															  Grid.Column="1"
															  Margin="0,0,8,0"
															  IconKind="FormatListBulleted"
															  HintText="Tìm theo"
															  ItemsSource="{Binding ListKieuTimKiem}"
															  SelectedItem="{Binding KieuTimKiemSach}" />

							<components:FilterActionPanel Grid.Column="2"
														  ClearCommand="{Binding XoaBoLocCommand}"
														  RefreshCommand="{Binding RefreshCommand}"
														  ShowRefreshButton="True" />
						</Grid>
					</Border>

					<Border x:Name="ProductView"
							Grid.Row="1"
							Style="{StaticResource DataGridCardStyle}">
						<ScrollViewer VerticalScrollBarVisibility="Auto"
									  HorizontalScrollBarVisibility="Disabled">

							<ItemsControl ItemsSource="{Binding DisplayBooks}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal"
												   HorizontalAlignment="Center" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>

								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Margin="8"
												Style="{StaticResource DarkCardStyle}">
											<Grid Width="170"
												  Height="220">
												<Grid.RowDefinitions>
													<RowDefinition Height="145" />
													<RowDefinition Height="*" />
												</Grid.RowDefinitions>

												<Border Grid.Row="0"
														CornerRadius="15,15,0,0"
														Cursor="Hand">

													<Border.Background>
														<ImageBrush ImageSource="{Binding BookData.HinhAnh}"
																	Stretch="UniformToFill" />
													</Border.Background>

													<Border.InputBindings>
														<MouseBinding MouseAction="LeftClick"
																	  Command="{Binding DataContext.XemChiTietSachCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																	  CommandParameter="{Binding}" />
													</Border.InputBindings>
												</Border>

												<StackPanel Grid.Row="1"
															Margin="10,8,10,8">
													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="*" />
															<ColumnDefinition Width="Auto" />
														</Grid.ColumnDefinitions>

														<TextBlock Grid.Column="0"
																   Text="{Binding BookData.TenSach}"
																   TextWrapping="Wrap"
																   FontSize="13"
																   MaxHeight="38"
																   TextTrimming="CharacterEllipsis"
																   FontWeight="Bold"
																   Foreground="#2B3674"
																   VerticalAlignment="Center" />

														<components:TickComponent Grid.Column="1"
																				  VerticalAlignment="Top"
																				  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
																				  Command="{Binding DataContext.ChonSachCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																				  CommandParameter="{Binding}" />
													</Grid>

													<Grid>
														<TextBlock Text="{Binding BookData.DonGiaBan, StringFormat='{}{0:N0} đ'}"
																   FontWeight="Bold"
																   FontSize="14"
																   Foreground="{StaticResource DangerColor}"
																   Visibility="{Binding IsNormalPrice, Converter={StaticResource BoolToVis}}" />

														<StackPanel Visibility="{Binding HasPromotion, Converter={StaticResource BoolToVis}}">
															<TextBlock Text="{Binding PromotionPrice, StringFormat='{}{0:N0} đ'}"
																	   FontWeight="Bold"
																	   FontSize="14"
																	   Foreground="{StaticResource DangerColor}" />
															<TextBlock Text="{Binding BookData.DonGiaBan, StringFormat='{}{0:N0} đ'}"
																	   FontSize="12"
																	   Foreground="#A3AED0"
																	   TextDecorations="Strikethrough"
																	   Margin="0,2,0,0" />
														</StackPanel>

														<TextBlock Text="🎁 Quà tặng"
																   Foreground="{StaticResource SuccessColor}"
																   FontWeight="Bold"
																   FontSize="13"
																   Visibility="{Binding IsGift, Converter={StaticResource BoolToVis}}" />
													</Grid>
												</StackPanel>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</Border>

					<components:PaginationControl Grid.Row="2"
												  CurrentPage="{Binding TrangHienTai}"
												  TotalPages="{Binding TongSoTrang}"
												  TotalRecords="{Binding TongBanGhi}"
												  PaginationCommand="{Binding PhanTrangCommand}" />
				</Grid>

				<Grid Grid.Column="1"
					  Margin="0,0,8,0">
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!-- ================= THẺ 1: GIỎ HÀNG ================= -->
					<Border x:Name="Cart"
							Grid.Row="0"
							Style="{StaticResource DataGridCardStyle}"
							Margin="0,0,0,8">
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
								<RowDefinition Height="Auto" />
								<!-- Dòng mới chứa Tạm tính & Số lượng -->
							</Grid.RowDefinitions>

							<!-- Header Giỏ hàng -->
							<StackPanel x:Name="GioHangHienTai"
										Grid.Row="0"
										Orientation="Horizontal"
										Margin="0,0,0,12">
								<materialDesign:PackIcon Kind="ShoppingCartOutline"
														 Width="22"
														 Height="22"
														 Foreground="#4318FF"
														 VerticalAlignment="Center"
														 Margin="0,0,8,0" />
								<TextBlock Text="Giỏ Hàng"
										   Style="{StaticResource CardHeader}" />
							</StackPanel>

							<!-- Danh sách sản phẩm -->
							<ScrollViewer Grid.Row="1"
										  VerticalScrollBarVisibility="Auto"
										  HorizontalScrollBarVisibility="Disabled">
								<ItemsControl ItemsSource="{Binding CartItems}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border Margin="0,0,0,8"
													Padding="10"
													Background="#F8FAFC"
													CornerRadius="12"
													BorderBrush="#E2E8F0"
													BorderThickness="1">
												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="Auto" />
														<ColumnDefinition Width="Auto" />
													</Grid.ColumnDefinitions>

													<StackPanel Grid.Column="0"
																VerticalAlignment="Center"
																Margin="0,0,8,0">
														<TextBlock Text="{Binding TenSach}"
																   FontSize="13"
																   FontWeight="Bold"
																   Foreground="#2B3674"
																   TextTrimming="CharacterEllipsis" />
														<StackPanel Orientation="Horizontal"
																	VerticalAlignment="Center">
															<TextBlock Text="{Binding GiaBan, StringFormat='{}{0:N0} đ'}"
																	   FontSize="12"
																	   Foreground="#A3AED0"
																	   Margin="0,2,6,0"
																	   Visibility="{Binding IsNormalPrice, Converter={StaticResource BoolToVis}}" />
															<StackPanel Orientation="Vertical"
																		Visibility="{Binding IsPromotionApplied, Converter={StaticResource BoolToVis}}">
																<TextBlock Text="{Binding GiaBan, StringFormat='{}{0:N0} đ'}"
																		   FontSize="12"
																		   Foreground="#10B981"
																		   FontWeight="Bold" />
																<TextBlock Text="{Binding OriginalGiaBan, StringFormat='{}{0:N0} đ'}"
																		   FontSize="11"
																		   Foreground="#A3AED0"
																		   TextDecorations="Strikethrough" />
															</StackPanel>
															<TextBlock Text=" (HÀNG TẶNG)"
																	   Foreground="#10B981"
																	   FontSize="12"
																	   Visibility="{Binding IsGift, Converter={StaticResource BoolToVis}}" />
														</StackPanel>
													</StackPanel>

													<StackPanel x:Name="SoLuong"
																Grid.Column="1"
																Orientation="Horizontal"
																VerticalAlignment="Top">
														<Button x:Name="btnMinus"
																Style="{StaticResource MiniAddButtonStyle}"
																Width="20"
																Height="20"
																ToolTip="Giảm số lượng"
																Command="{Binding DataContext.GiamSoLuongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																CommandParameter="{Binding}">
															<materialDesign:PackIcon Kind="Minus"
																					 Width="16"
																					 Height="16" />
														</Button>
														<TextBox Text="{Binding SoLuongMua, UpdateSourceTrigger=PropertyChanged}"
																 FontWeight="Medium"
																 Foreground="{StaticResource PrimaryDarkColor}"
																 Width="24"
																 TextAlignment="Center"
																 VerticalAlignment="Center"
																 BorderThickness="0"
																 Background="Transparent"
																 SelectionBrush="{StaticResource TextLightColor}"
																 materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" />
														<Button x:Name="btnPlus"
																Style="{StaticResource MiniAddButtonStyle}"
																Width="20"
																Height="20"
																ToolTip="Tăng số lượng"
																Command="{Binding DataContext.TangSoLuongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
																CommandParameter="{Binding}">
															<materialDesign:PackIcon Kind="Plus"
																					 Width="16"
																					 Height="16" />
														</Button>
													</StackPanel>
												</Grid>
											</Border>
											<DataTemplate.Triggers>
												<DataTrigger Binding="{Binding IsGift}"
															 Value="True">
													<Setter TargetName="btnMinus"
															Property="IsEnabled"
															Value="False" />
													<Setter TargetName="btnPlus"
															Property="IsEnabled"
															Value="False" />
												</DataTrigger>
											</DataTemplate.Triggers>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>

							<!-- TỔNG KẾT ĐÁY GIỎ HÀNG -->
							<Border Grid.Row="2"
									Margin="0,8,0,0"
									Padding="0,12,0,0"
									BorderBrush="#E2E8F0"
									BorderThickness="0,1,0,0">

								<StackPanel Orientation="Vertical">

									<Grid Margin="0,0,0,8">
										<TextBlock Text="Số sản phẩm:"
												   FontSize="14"
												   Foreground="{StaticResource TextLightColor}"
												   HorizontalAlignment="Left"
												   VerticalAlignment="Center" />
										<TextBlock Text="{Binding SoSanPham}"
												   FontSize="14"
												   FontWeight="Bold"
												   Foreground="{StaticResource PrimaryColor}"
												   HorizontalAlignment="Right"
												   VerticalAlignment="Center" />
									</Grid>

									<Grid>
										<TextBlock Text="Tạm tính:"
												   FontSize="14"
												   Foreground="{StaticResource TextLightColor}"
												   HorizontalAlignment="Left"
												   VerticalAlignment="Center" />
										<TextBlock Text="{Binding TamTinh, StringFormat='{}{0:N0} đ'}"
												   FontSize="14"
												   FontWeight="Bold"
												   Foreground="{StaticResource WarningColor}"
												   HorizontalAlignment="Right"
												   VerticalAlignment="Center" />
									</Grid>

								</StackPanel>
							</Border>
						</Grid>
					</Border>

					<!-- ================= THẺ 2: KHÁCH HÀNG ================= -->
					<Border x:Name="Customer"
							Grid.Row="1"
							Style="{StaticResource DataGridCardStyle}"
							Margin="0">
						<StackPanel>
							<!-- Header Khách Hàng -->
							<StackPanel Orientation="Horizontal"
										Margin="0,0,0,12">
								<materialDesign:PackIcon Kind="AccountOutline"
														 Width="22"
														 Height="22"
														 Foreground="{StaticResource PrimaryColor}"
														 VerticalAlignment="Center"
														 Margin="0,0,8,0" />
								<TextBlock Text="Thông tin khách hàng"
										   Style="{StaticResource CardHeader}" />
							</StackPanel>

							<!-- Lựa chọn Khách vãng lai -->
							<components:TickComponent Text="Khách vãng lai"
													  IsChecked="{Binding IsKhachVangLai, Mode=TwoWay}"
													  Foreground="#2B3674"
													  Margin="-4,0,0,0" />

							<!-- FORM NHẬP THÔNG TIN (Sẽ tự động ẩn đi nếu là Khách vãng lai) -->
							<StackPanel>
								<StackPanel.Style>
									<Style TargetType="StackPanel">
										<Setter Property="Visibility"
												Value="Visible" />
										<Style.Triggers>
											<DataTrigger Binding="{Binding IsKhachVangLai}"
														 Value="True">
												<Setter Property="Visibility"
														Value="Collapsed" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</StackPanel.Style>

								<!-- Dòng 1: Tên khách hàng & Nút Tìm -->
								<Grid Margin="0,12,0,12">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>

									<components:FormInputControl Grid.Column="0"
																 Title="Số điện thoại"
																 HintText="Nhập số điện thoại..."
																 IconKind="Phone"
																 IsRequired="True"
																 TextValue="{Binding SdtKhachHang, UpdateSourceTrigger=PropertyChanged}"
																 State="{Binding SdtState}"
																 HelperText="{Binding SdtHelperText}"
																 Margin="0,0,8,-8" />

									<Button Grid.Column="1"
											Style="{StaticResource OutlineButtonStyle}"
											Width="42"
											Height="42"
											Margin="0,0,0,12"
											VerticalAlignment="Bottom"
											ToolTip="Tìm khách hàng theo SĐT"
											Command="{Binding TimKhachHangTheoSdtCommand}">
										<materialDesign:PackIcon Kind="Magnify"
																 Width="20"
																 Height="20" />
									</Button>
								</Grid>

								<components:FormComboBoxControl Title="Tên khách hàng"
																HintText="Chưa có thông tin khách hàng..."
																IconKind="Person"
																ItemsSource="{Binding DanhSachKhachHang}"
																SelectedItem="{Binding KhachHangDuocChon, Mode=TwoWay}"
																DisplayMemberPath="TenKhachHang"
																IsEditable="False"
																Margin="0,0,0,-20" />
							</StackPanel>
						</StackPanel>
					</Border>
				</Grid>

				<Border x:Name="Invoice"
						Grid.Column="2"
						Margin="0"
						Style="{StaticResource DataGridCardStyle}">

					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<StackPanel Grid.Row="0">
							<StackPanel x:Name="ThongTinThanhToan"
										Orientation="Horizontal"
										Margin="0,0,0,12">
								<materialDesign:PackIcon Kind="CashCheck"
														 Width="22"
														 Height="22"
														 Foreground="{StaticResource PrimaryColor}"
														 VerticalAlignment="Center"
														 Margin="0,0,8,0" />
								<TextBlock Text="Thông tin thanh toán"
										   Style="{StaticResource CardHeader}" />
							</StackPanel>

							<Grid Margin="0,0,0,0">
								<components:FormComboBoxControl x:Name="ChonUuDai"
																Title="Chọn ưu đãi áp dụng"
																IconKind="TagApprove"
																HintText="Ưu đãi khả dụng..."
																ItemsSource="{Binding PromotionList}"
																SelectedItem="{Binding SelectedUuDai}"
																DisplayMemberPath="TenChuongTrinh"
																IsEditable="False"
																State="{Binding UuDaiState}"
																HelperText="{Binding UuDaiHelperText}"
																IsReadOnly="{Binding IsUuDaiReadOnly}" />
							</Grid>
						</StackPanel>

						<ScrollViewer Grid.Row="1"
									  VerticalScrollBarVisibility="Hidden"
									  HorizontalScrollBarVisibility="Disabled"
									  Margin="0,0,0,12">
							<ItemsControl ItemsSource="{Binding AppliedPromotionList}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Margin="0,8,0,0"
												Padding="12"
												Style="{StaticResource CardStyle}">
											<Grid>
												<Grid.RowDefinitions>
													<RowDefinition Height="*" />
													<RowDefinition Height="24" />
												</Grid.RowDefinitions>

												<Grid>
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*" />
														<ColumnDefinition Width="Auto" />
														<ColumnDefinition Width="Auto" />
													</Grid.ColumnDefinitions>

													<TextBlock Grid.Column="0"
															   Text="{Binding Code}"
															   FontSize="13"
															   FontWeight="Bold"
															   Foreground="{StaticResource PrimaryColor}"
															   VerticalAlignment="Center"
															   TextWrapping="Wrap"
															   Margin="0,0,8,0" />

													<TextBlock Grid.Column="1"
															   Text="{Binding MucGiamDisplay}"
															   FontSize="13"
															   FontWeight="Bold"
															   Foreground="#10B981"
															   VerticalAlignment="Center"
															   Margin="0,0,12,0" />

													<Button Grid.Column="2"
															Style="{StaticResource MiniDeleteButtonStyle}"
															Width="20"
															Height="20"
															ToolTip="Gỡ bỏ ưu đãi này"
															Command="{Binding DataContext.XoaUuDaiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
															CommandParameter="{Binding}">
														<materialDesign:PackIcon Kind="Close"
																				 Width="12"
																				 Height="12" />
													</Button>
												</Grid>
												<TextBlock Grid.Row="1"
														   Text="{Binding TenChuongTrinh}"
														   FontSize="13"
														   VerticalAlignment="Center"
														   Margin="0,8,12,0" />
											</Grid>

										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>

						<StackPanel Grid.Row="2">
							<Border BorderBrush="#E2E8F0"
									BorderThickness="0,1,0,0"
									Margin="0,0,0,16"
									Padding="0,16,0,0">
								<StackPanel Orientation="Vertical">

									<Grid Margin="0,0,0,8">
										<TextBlock Text="Tổng khuyến mãi:"
												   Foreground="{StaticResource TextLightColor}"
												   FontSize="14"
												   HorizontalAlignment="Left"
												   VerticalAlignment="Center" />
										<TextBlock Text="{Binding GiamTien, StringFormat='- {0:N0} đ'}"
												   Foreground="{StaticResource SuccessColor}"
												   FontSize="14"
												   FontWeight="Bold"
												   HorizontalAlignment="Right"
												   VerticalAlignment="Center" />
									</Grid>

									<Grid>
										<TextBlock Text="Thành tiền:"
												   Foreground="{StaticResource PrimaryDarkColor}"
												   FontSize="14"
												   FontWeight="Bold"
												   HorizontalAlignment="Left"
												   VerticalAlignment="Center" />
										<TextBlock Text="{Binding TongTienThanhToan, StringFormat='{}{0:N0} đ'}"
												   Foreground="{StaticResource DangerColor}"
												   FontSize="18"
												   FontWeight="UltraBold"
												   HorizontalAlignment="Right"
												   VerticalAlignment="Center" />
									</Grid>

								</StackPanel>
							</Border>

							<Button Style="{StaticResource MainGradientButton}"
									IsEnabled="{Binding IsThanhToanEnabled}"
									Command="{Binding MoPopupThanhToanCommand}"
									Height="42"
									FontSize="14">
								<TextBlock Text="THANH TOÁN"
										   FontWeight="Medium"
										   VerticalAlignment="Center" />
							</Button>
						</StackPanel>

					</Grid>
				</Border>
			</Grid>
		</Grid>

		<popup:PaymentConfirmPopup DataContext="{Binding PaymentConfirmPopupViewModel}" />

		<popup:BookDetailPopup DataContext="{Binding BookDetailPopupVM}" />

		<popup:InvoiceDetailPopup DataContext="{Binding InvoiceDetailPopupVM}" />
	</Grid>
</UserControl>