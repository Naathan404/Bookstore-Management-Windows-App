<UserControl x:Class="Bookstore.WPF.Views.InvoiceView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 mc:Ignorable="d"
			 Background="#F4F7FE"
			 HorizontalAlignment="Stretch"
			 VerticalAlignment="Stretch">

	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis" />

		<Style x:Key="PageButtonStyle"
			   TargetType="Button">
			<Setter Property="Width"
					Value="38" />
			<Setter Property="Height"
					Value="38" />
			<Setter Property="FontSize"
					Value="14" />
			<Setter Property="FontWeight"
					Value="SemiBold" />
			<Setter Property="Foreground"
					Value="#2B3674" />
			<Setter Property="Background"
					Value="Transparent" />
			<Setter Property="BorderThickness"
					Value="0" />
			<Setter Property="Cursor"
					Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="border"
								Background="{TemplateBinding Background}"
								CornerRadius="10">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver"
									 Value="True">
								<Setter TargetName="border"
										Property="Background"
										Value="#E0E7FF" />
								<Setter Property="Foreground"
										Value="#4318FF" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="FilterBorderStyle"
			   TargetType="Border">
			<Setter Property="CornerRadius"
					Value="16" />
			<Setter Property="Background"
					Value="White" />
			<Setter Property="BorderBrush"
					Value="#E2E8F0" />
			<Setter Property="BorderThickness"
					Value="1" />
			<Setter Property="Height"
					Value="42" />
		</Style>
	</UserControl.Resources>

	<Grid Background="#F4F7FE">
		<Grid Margin="5">
			<Grid.RowDefinitions>
				<RowDefinition Height="90" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Border Grid.Row="0"
					Margin="0,0,0,12"
					Padding="20"
					CornerRadius="16"
					Background="White"
					BorderBrush="#E2E8F0"
					BorderThickness="1">
				<Grid>
					<StackPanel Orientation="Horizontal"
								VerticalAlignment="Center">
						<materialDesign:PackIcon Kind="Invoice"
												 Width="28"
												 Height="28"
												 Foreground="#4318FF"
												 VerticalAlignment="Center"
												 Margin="0,0,10,0" />
						<TextBlock Text="LỊCH SỬ HÓA ĐƠN"
								   FontSize="24"
								   FontWeight="Bold"
								   Foreground="#2B3674"
								   VerticalAlignment="Center" />
					</StackPanel>
				</Grid>
			</Border>

			<Border Grid.Row="1"
					Margin="0,0,0,12"
					Padding="20"
					CornerRadius="16"
					Background="White"
					BorderBrush="#E2E8F0"
					BorderThickness="1">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*" />
						<ColumnDefinition Width="1.5*" />
						<ColumnDefinition Width="1.5*" />
						<ColumnDefinition Width="120" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<Border Grid.Column="0"
							Style="{StaticResource FilterBorderStyle}"
							Margin="0,0,8,0">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="36" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<materialDesign:PackIcon Kind="Magnify"
													 Width="18"
													 Height="18"
													 Foreground="#A3AED0"
													 VerticalAlignment="Center"
													 HorizontalAlignment="Center" />
							<TextBox Grid.Column="1"
									 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
									 Margin="0 0 5 0"
									 Background="Transparent"
									 BorderThickness="0"
									 VerticalAlignment="Center"
									 HorizontalAlignment="Stretch"
									 FontSize="13"
									 Foreground="#2B3674"
									 materialDesign:HintAssist.Hint="Tìm kiếm khách hàng hoặc người tạo..." />
						</Grid>
					</Border>

					<Border Grid.Column="1"
							Style="{StaticResource FilterBorderStyle}"
							Margin="0,0,8,0">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="36" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<materialDesign:PackIcon Kind="CalendarStart"
													 Width="18"
													 Height="18"
													 Foreground="#A3AED0"
													 VerticalAlignment="Center"
													 HorizontalAlignment="Center" />
							<DatePicker Grid.Column="1"
										SelectedDate="{Binding FromDate, UpdateSourceTrigger=PropertyChanged}"
										Margin="0 0 5 0"
										Background="Transparent"
										BorderThickness="0"
										VerticalAlignment="Center"
										HorizontalAlignment="Stretch"
										FontSize="13"
										Foreground="#2B3674"
										materialDesign:HintAssist.Hint="Từ ngày" />
						</Grid>
					</Border>

					<Border Grid.Column="2"
							Style="{StaticResource FilterBorderStyle}"
							Margin="0,0,8,0">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="36" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<materialDesign:PackIcon Kind="CalendarEnd"
													 Width="18"
													 Height="18"
													 Foreground="#A3AED0"
													 VerticalAlignment="Center"
													 HorizontalAlignment="Center" />
							<DatePicker Grid.Column="1"
										SelectedDate="{Binding ToDate, UpdateSourceTrigger=PropertyChanged}"
										Margin="0 0 5 0"
										Background="Transparent"
										BorderThickness="0"
										VerticalAlignment="Center"
										HorizontalAlignment="Stretch"
										FontSize="13"
										Foreground="#2B3674"
										materialDesign:HintAssist.Hint="Đến ngày" />
						</Grid>
					</Border>

					<Border Grid.Column="3"
							Background="#F4F7FE"
							CornerRadius="10"
							Padding="15,0"
							Margin="0,0,10,0">
						<StackPanel Orientation="Horizontal"
									VerticalAlignment="Center">
							<TextBlock Text="Tổng:"
									   Foreground="#A3AED0"
									   FontSize="12"
									   VerticalAlignment="Center" />
							<TextBlock Text="{Binding TongBanGhi}"
									   FontWeight="Bold"
									   Foreground="#4318FF"
									   FontSize="15"
									   Margin="8,0,0,0"
									   VerticalAlignment="Center" />
						</StackPanel>
					</Border>

					<Button Grid.Column="4"
							Width="42"
							Height="42"
							ToolTip="Xóa tất cả bộ lọc"
							Command="{Binding XoaLocCommand}"
							Background="#FEE2E2"
							BorderThickness="0"
							Cursor="Hand">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border Background="{TemplateBinding Background}"
										CornerRadius="10">
									<materialDesign:PackIcon Kind="FilterOff"
															 Width="20"
															 Height="20"
															 Foreground="#EF4444"
															 HorizontalAlignment="Center"
															 VerticalAlignment="Center" />
								</Border>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</Grid>
			</Border>

			<Border Grid.Row="2"
					CornerRadius="20"
					Background="White"
					BorderBrush="#E2E8F0"
					BorderThickness="1"
					Padding="20">
				<DataGrid AutoGenerateColumns="False"
						  ItemsSource="{Binding DanhSachHoaDon}"
						  IsReadOnly="True"
						  HeadersVisibility="Column"
						  BorderThickness="0"
						  MinRowHeight="52"
						  FontSize="13"
						  AlternatingRowBackground="#F8FAFC"
						  RowBackground="White"
						  Foreground="#2B3674"
						  GridLinesVisibility="Horizontal"
						  HorizontalGridLinesBrush="#E2E8F0"
						  VerticalGridLinesBrush="Transparent"
						  CanUserAddRows="False"
						  CanUserDeleteRows="False"
						  CanUserResizeColumns="False"
						  CanUserResizeRows="False"
						  CanUserReorderColumns="False">

					<DataGrid.Resources>
						<Style TargetType="DataGridColumnHeader">
							<Setter Property="Background"
									Value="#F8FAFC" />
							<Setter Property="Foreground"
									Value="#2B3674" />
							<Setter Property="FontWeight"
									Value="SemiBold" />
							<Setter Property="FontSize"
									Value="13" />
							<Setter Property="Height"
									Value="44" />
							<Setter Property="BorderBrush"
									Value="#E2E8F0" />
							<Setter Property="BorderThickness"
									Value="0,0,0,2" />
							<Setter Property="VerticalContentAlignment"
									Value="Center" />
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="DataGridColumnHeader">
										<Border Background="{TemplateBinding Background}"
												BorderBrush="{TemplateBinding BorderBrush}"
												BorderThickness="{TemplateBinding BorderThickness}">
											<ContentPresenter VerticalAlignment="Center"
															  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
															  Margin="12,0" />
										</Border>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
						<Style TargetType="DataGridCell">
							<Setter Property="VerticalContentAlignment"
									Value="Center" />
							<Setter Property="HorizontalContentAlignment"
									Value="Stretch" />
							<Setter Property="BorderThickness"
									Value="0" />
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="DataGridCell">
										<Border Background="{TemplateBinding Background}">
											<ContentPresenter VerticalAlignment="Center"
															  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
										</Border>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</DataGrid.Resources>

					<DataGrid.Columns>
						<DataGridTextColumn Header="Mã HĐ"
											Width="1.2*"
											SortMemberPath="MaHoaDon">
							<DataGridTextColumn.Binding>
								<MultiBinding StringFormat="HD{0:ddMMyy}{1:D3}">
									<Binding Path="NgayTao" />
									<Binding Path="MaHoaDon" />
								</MultiBinding>
							</DataGridTextColumn.Binding>
							<DataGridTextColumn.HeaderStyle>
								<Style TargetType="DataGridColumnHeader"
									   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
									<Setter Property="HorizontalContentAlignment"
											Value="Center" />
								</Style>
							</DataGridTextColumn.HeaderStyle>
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="HorizontalAlignment"
											Value="Center" />
									<Setter Property="VerticalAlignment"
											Value="Center" />
									<Setter Property="Foreground"
											Value="#4318FF" />
									<Setter Property="FontWeight"
											Value="Bold" />
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Ngày lập"
											Binding="{Binding NgayTao, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
											Width="1.5*">
							<DataGridTextColumn.HeaderStyle>
								<Style TargetType="DataGridColumnHeader"
									   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
									<Setter Property="HorizontalContentAlignment"
											Value="Center" />
								</Style>
							</DataGridTextColumn.HeaderStyle>
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="HorizontalAlignment"
											Value="Center" />
									<Setter Property="VerticalAlignment"
											Value="Center" />
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Khách hàng"
											Binding="{Binding TenKhachHang}"
											Width="2*">
							<DataGridTextColumn.HeaderStyle>
								<Style TargetType="DataGridColumnHeader"
									   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
									<Setter Property="HorizontalContentAlignment"
											Value="Left" />
								</Style>
							</DataGridTextColumn.HeaderStyle>
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="HorizontalAlignment"
											Value="Left" />
									<Setter Property="VerticalAlignment"
											Value="Center" />
									<Setter Property="Margin"
											Value="12,0" />
									<Setter Property="FontWeight"
											Value="SemiBold" />
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Nhân viên lập"
											Binding="{Binding TenNguoiTao}"
											Width="1.5*">
							<DataGridTextColumn.HeaderStyle>
								<Style TargetType="DataGridColumnHeader"
									   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
									<Setter Property="HorizontalContentAlignment"
											Value="Left" />
								</Style>
							</DataGridTextColumn.HeaderStyle>
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="HorizontalAlignment"
											Value="Left" />
									<Setter Property="VerticalAlignment"
											Value="Center" />
									<Setter Property="Margin"
											Value="12,0" />
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Tổng tiền"
											Binding="{Binding TongTien, StringFormat={}{0:N0} đ}"
											Width="1.3*">
							<DataGridTextColumn.HeaderStyle>
								<Style TargetType="DataGridColumnHeader"
									   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
									<Setter Property="HorizontalContentAlignment"
											Value="Right" />
								</Style>
							</DataGridTextColumn.HeaderStyle>
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="HorizontalAlignment"
											Value="Right" />
									<Setter Property="VerticalAlignment"
											Value="Center" />
									<Setter Property="Margin"
											Value="12,0" />
									<Setter Property="FontWeight"
											Value="Bold" />
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Khách trả"
											Binding="{Binding SoTienTra, StringFormat={}{0:N0} đ}"
											Width="1.3*">
							<DataGridTextColumn.HeaderStyle>
								<Style TargetType="DataGridColumnHeader"
									   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
									<Setter Property="HorizontalContentAlignment"
											Value="Right" />
								</Style>
							</DataGridTextColumn.HeaderStyle>
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="HorizontalAlignment"
											Value="Right" />
									<Setter Property="VerticalAlignment"
											Value="Center" />
									<Setter Property="Margin"
											Value="12,0" />
									<Setter Property="Foreground"
											Value="#10B981" />
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Còn nợ"
											Binding="{Binding ConLai, StringFormat={}{0:N0} đ}"
											Width="1.3*">
							<DataGridTextColumn.HeaderStyle>
								<Style TargetType="DataGridColumnHeader"
									   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
									<Setter Property="HorizontalContentAlignment"
											Value="Right" />
								</Style>
							</DataGridTextColumn.HeaderStyle>
							<DataGridTextColumn.ElementStyle>
								<Style TargetType="TextBlock">
									<Setter Property="HorizontalAlignment"
											Value="Right" />
									<Setter Property="VerticalAlignment"
											Value="Center" />
									<Setter Property="Margin"
											Value="12,0" />
									<Setter Property="FontWeight"
											Value="SemiBold" />
									<Setter Property="Foreground"
											Value="#EF4444" />
								</Style>
							</DataGridTextColumn.ElementStyle>
						</DataGridTextColumn>

						<DataGridTemplateColumn Header="Thao tác"
												Width="80">
							<DataGridTemplateColumn.HeaderStyle>
								<Style TargetType="DataGridColumnHeader"
									   BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
									<Setter Property="HorizontalContentAlignment"
											Value="Center" />
								</Style>
							</DataGridTemplateColumn.HeaderStyle>
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal"
												HorizontalAlignment="Center"
												VerticalAlignment="Center">
										<Button Width="32"
												Height="32"
												Background="#EEF2FF"
												BorderThickness="0"
												Cursor="Hand"
												ToolTip="Xem chi tiết"
												Command="{Binding DataContext.XemChiTietCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
												CommandParameter="{Binding}">
											<Button.Template>
												<ControlTemplate TargetType="Button">
													<Border Background="{TemplateBinding Background}"
															CornerRadius="6">
														<materialDesign:PackIcon Kind="Eye"
																				 Width="15"
																				 Height="15"
																				 Foreground="#4318FF"
																				 HorizontalAlignment="Center"
																				 VerticalAlignment="Center" />
													</Border>
												</ControlTemplate>
											</Button.Template>
										</Button>
									</StackPanel>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</Border>

			<Border Grid.Row="3"
					Margin="0,12,0,0"
					Padding="12,8"
					CornerRadius="12"
					Background="White"
					BorderBrush="#E2E8F0"
					BorderThickness="1">
				<StackPanel Orientation="Horizontal"
							HorizontalAlignment="Center">
					<Button Style="{StaticResource PageButtonStyle}"
							Command="{Binding PhanTrangCommand}"
							CommandParameter="First"
							Margin="0,0,4,0">
						<materialDesign:PackIcon Kind="ChevronDoubleLeft"
												 Width="16"
												 Height="16"
												 Foreground="#A3AED0" />
					</Button>
					<Button Style="{StaticResource PageButtonStyle}"
							Command="{Binding PhanTrangCommand}"
							CommandParameter="Prev"
							Margin="0,0,8,0">
						<materialDesign:PackIcon Kind="ChevronLeft"
												 Width="16"
												 Height="16"
												 Foreground="#A3AED0" />
					</Button>
					<TextBlock Text="{Binding TrangHienTai, StringFormat='Trang {0}'}"
							   FontSize="13"
							   FontWeight="SemiBold"
							   Foreground="#4318FF"
							   VerticalAlignment="Center"
							   Margin="12,0" />
					<TextBlock Text="{Binding TongSoTrang, StringFormat='/ {0}'}"
							   FontSize="13"
							   Foreground="#A3AED0"
							   VerticalAlignment="Center"
							   Margin="0,0,12,0" />
					<Button Style="{StaticResource PageButtonStyle}"
							Command="{Binding PhanTrangCommand}"
							CommandParameter="Next"
							Margin="8,0,0,0">
						<materialDesign:PackIcon Kind="ChevronRight"
												 Width="16"
												 Height="16"
												 Foreground="#A3AED0" />
					</Button>
					<Button Style="{StaticResource PageButtonStyle}"
							Command="{Binding PhanTrangCommand}"
							CommandParameter="Last"
							Margin="4,0,0,0">
						<materialDesign:PackIcon Kind="ChevronDoubleRight"
												 Width="16"
												 Height="16"
												 Foreground="#A3AED0" />
					</Button>
				</StackPanel>
			</Border>
		</Grid>
	</Grid>
</UserControl>