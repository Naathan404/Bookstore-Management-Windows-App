<UserControl x:Class="Bookstore.WPF.Views.InvoiceView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:components="clr-namespace:Bookstore.WPF.Views.Components"
			 xmlns:popup="clr-namespace:Bookstore.WPF.Views.Popup"
			 mc:Ignorable="d">

	<Grid>
		<Grid x:Name="MainInvoiceView"
			  Margin="{StaticResource MainViewMargin}">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<components:PageHeaderControl Title="HÓA ĐƠN"
										  HeaderIcon="Invoice"
										  ShowAddButton="True"
										  AddTitle="THÊM"
										  AddIcon="Plus" />

			<Border x:Name="Filter"
					Grid.Row="1"
					Style="{StaticResource FilterCardStyle}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*" />
						<ColumnDefinition Width="1*" />
						<ColumnDefinition Width="1*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>

					<components:FilterInputControl Grid.Column="0"
												   Margin="0,0,8,0"
												   IconKind="Magnify"
												   HintText="Tìm kiếm khách hàng hoặc người tạo..."
												   TextValue="{Binding SearchText}" />

					<components:FilterDatePickerControl Grid.Column="1"
														Margin="0,0,8,0"
														IconKind="CalendarStart"
														HintText="Từ ngày"
														SelectedDate="{Binding FromDate}" />

					<components:FilterDatePickerControl Grid.Column="2"
														Margin="0,0,8,0"
														IconKind="CalendarEnd"
														HintText="Đến ngày"
														SelectedDate="{Binding ToDate}" />

					<components:FilterActionPanel Grid.Column="3"
												  ClearCommand="{Binding XoaLocCommand}"
												  RefreshCommand="{Binding RefreshCommand}"
												  ShowRefreshButton="True" />

				</Grid>
			</Border>

			<Border x:Name="DataGrid"
					Grid.Row="2"
					Style="{StaticResource DataGridCardStyle}">
				<DataGrid ItemsSource="{Binding DanhSachHoaDon}"
						  Style="{StaticResource CleanDataGrid}">
					<DataGrid.Columns>
						<DataGridTextColumn Header="Mã HD"
											Width="120"
											HeaderStyle="{StaticResource CenterHeaderStyle}"
											ElementStyle="{StaticResource CellCode}"
											SortMemberPath="MaHoaDon">
							<DataGridTextColumn.Binding>
								<MultiBinding StringFormat="HD{0:ddMMyy}{1:D3}">
									<Binding Path="NgayTao" />
									<Binding Path="MaHoaDon" />
								</MultiBinding>
							</DataGridTextColumn.Binding>
						</DataGridTextColumn>

						<DataGridTextColumn Header="Ngày lập"
											Binding="{Binding NgayTao, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}"
											Width="150" />

						<DataGridTextColumn Header="Khách hàng"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellName}"
											Binding="{Binding TenKhachHang}"
											Width="200" />

						<DataGridTextColumn Header="Nhân viên lập"
											HeaderStyle="{StaticResource LeftHeaderStyle}"
											ElementStyle="{StaticResource CellLeft}"
											Binding="{Binding TenNguoiTao}"
											Width="150" />

						<DataGridTextColumn Header="Tổng tiền"
											Binding="{Binding TongTien, StringFormat={}{0:N0} đ}"
											HeaderStyle="{StaticResource RightHeaderStyle}"
											ElementStyle="{StaticResource CellMoney}"
											Width="*" />

						<DataGridTextColumn Header="Khách trả"
											Binding="{Binding SoTienTra, StringFormat={}{0:N0} đ}"
											HeaderStyle="{StaticResource RightHeaderStyle}"
											ElementStyle="{StaticResource CellProfit}"
											Width="*" />

						<DataGridTextColumn Header="Còn nợ"
											Binding="{Binding ConLai, StringFormat={}{0:N0} đ}"
											HeaderStyle="{StaticResource RightHeaderStyle}"
											ElementStyle="{StaticResource CellDebt}"
											Width="*" />

						<DataGridTemplateColumn Header="Thao tác"
												HeaderStyle="{StaticResource CenterHeaderStyle}"
												Width="80">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<components:DataGridActionPanel RowItem="{Binding}"
																	ShowEdit="True"
																	EditCommand="{Binding DataContext.XemChiTietCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</Border>

			<components:PaginationControl Grid.Row="3"
										  CurrentPage="{Binding TrangHienTai}"
										  TotalPages="{Binding TongSoTrang}"
										  TotalRecords="{Binding TongBanGhi}"
										  PaginationCommand="{Binding PhanTrangCommand}" />

		</Grid>
		
		<popup:InvoiceDetailPopup DataContext="{Binding InvoiceDetailPopupVM}" />
	</Grid>
</UserControl>