<UserControl x:Class="Bookstore.WPF.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="250" Background="White">

    <UserControl.Resources>
        <!-- STYLE CHUẨN CHO NÚT MENU (RADIO BUTTON) -->
        <Style TargetType="RadioButton" x:Key="NavButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A3AED0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}">
                            <Grid>
                                <!-- Vạch tím highlight -->
                                <Border x:Name="ActiveIndicator" Width="4" Background="#4318FF" 
                                        HorizontalAlignment="Right" CornerRadius="2,0,0,2" Visibility="Hidden"/>
                                <!-- -->
                                <ContentPresenter VerticalAlignment="Center" Margin="30,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#4318FF"/>
                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F4F7FE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Menu -->
            <RowDefinition Height="100"/>
            <!-- Logout -->
        </Grid.RowDefinitions>

        <!-- header -->
        <TextBlock Grid.Row="0" Text="{Binding HomeTabName}" 
                   Foreground="#2B3674" FontSize="22" FontWeight="Black" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- menu -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <StackPanel>

                <!-- 1. DASHBOARD -->
                <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="NavMenu"
                             Visibility="{Binding IsDashboardVisible}"
                             Command="{Binding ShowDashboardCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ViewDashboard" Width="22" Height="22" Margin="0,0,15,0"/>
                        <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <!-- 2. BÁN HÀNG -->
                <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="NavMenu"
                             Visibility="{Binding IsSaleVisible}"
                             Command="{Binding ShowBanHangCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CashRegister" Width="22" Height="22" Margin="0,0,15,0"/>
                        <TextBlock Text="Bán hàng" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <!-- 3. TRA CỨU SÁCH -->
                <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="NavMenu"
                             Visibility="{Binding IsProductVisible}"
                             Command="{Binding ShowTraCuuSachCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="BookSearch" Width="22" Height="22" Margin="0,0,15,0"/>
                        <TextBlock Text="Tra cứu sách" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <!-- 4. KHÁCH HÀNG -->
                <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="NavMenu"
                             Visibility="{Binding IsCustomerVisible}"
                             Command="{Binding ShowKhachHangCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountGroup" Width="22" Height="22" Margin="0,0,15,0"/>
                        <TextBlock Text="Khách hàng" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <!-- 5. NHẬP KHO -->
                <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="NavMenu"
                             Visibility="{Binding IsImportVisible}"
                             Command="{Binding ShowNhapKhoCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Warehouse" Width="22" Height="22" Margin="0,0,15,0"/>
                        <TextBlock Text="Nhập kho" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <!-- 6. NHÀ CUNG CẤP -->
                <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="NavMenu"
                             Visibility="{Binding IsSupplierVisible}"
                             Command="{Binding ShowNhaCungCapCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TruckDelivery" Width="22" Height="22" Margin="0,0,15,0"/>
                        <TextBlock Text="Nhà cung cấp" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <!-- 7. ƯU ĐÃI -->
                <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="NavMenu" 
                             Visibility="{Binding IsPromotionVisible}"
                             Command="{Binding ShowUuDaiCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TicketPercent" Width="22" Height="22" Margin="0,0,15,0"/>
                        <TextBlock Text="Ưu đãi" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <!-- 8. BÁO CÁO -->
                <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="NavMenu"
                             Visibility="{Binding IsReportVisible}"
                             Command="{Binding ShowBaoCaoCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ChartBar" Width="22" Height="22" Margin="0,0,15,0"/>
                        <TextBlock Text="Báo cáo" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <!-- 9. TÀI KHOẢN -->
                <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="NavMenu"
                             Visibility="{Binding IsAccountVisible}"
                             Command="{Binding ShowTaiKhoanCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldAccount" Width="22" Height="22" Margin="0,0,15,0"/>
                        <TextBlock Text="Tài khoản" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>

                <!-- 10. PHÂN QUYỀN (VÀ CÀI ĐẶT TÀI KHOẢN) -->
                <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="NavMenu"
                             Visibility="{Binding IsSettingVisible}"
                             Command="{Binding ShowCaiDatCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Cog" Width="22" Height="22" Margin="0,0,15,0"/>
                        <TextBlock Text="Cài đặt" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </ScrollViewer>

        <!-- footer -->
        <Button Grid.Row="2" Content="Đăng xuất" Command="{Binding LogoutCommand}"
                Height="45" Width="180" FontSize="15" FontWeight="Bold" 
                Background="#6344FF" BorderBrush="#6344FF" Foreground="White" 
                materialDesign:ButtonAssist.CornerRadius="20">
            <Button.Effect>
                <DropShadowEffect BlurRadius="10" Color="#6344FF" Opacity="0.3" ShadowDepth="3"/>
            </Button.Effect>
        </Button>
    </Grid>
</UserControl>