<UserControl x:Class="Bookstore.WPF.Views.SidebarView"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 Background="{StaticResource PrimaryDarkColor}">

	<UserControl.Style>
		<Style TargetType="UserControl">
			<Setter Property="Width"
					Value="250" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsCollapsed}"
							 Value="True">
					<Setter Property="Width"
							Value="80" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</UserControl.Style>

	<UserControl.Resources>
		<Style TargetType="RadioButton"
			   x:Key="NavButtonStyle">
			<Setter Property="Background"
					Value="Transparent" />
			<Setter Property="Foreground"
					Value="#A3AED0" />
			<Setter Property="FontSize"
					Value="15" />
			<Setter Property="FontWeight"
					Value="SemiBold" />
			<Setter Property="Height"
					Value="50" />
			<Setter Property="Margin"
					Value="10,5" />
			<Setter Property="Cursor"
					Value="Hand" />
			<Setter Property="FocusVisualStyle"
					Value="{x:Null}" />

			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<Grid x:Name="MainGrid"
							  Background="Transparent"
							  RenderTransformOrigin="0.5,0.5">
							<Border x:Name="HoverBorder"
									Background="Transparent"
									CornerRadius="12" />

							<Border x:Name="ActiveIndicator"
									Width="4"
									Height="24"
									Background="White"
									HorizontalAlignment="Right"
									CornerRadius="2"
									Margin="0,0,10,0"
									Opacity="0">
								<Border.Effect>
									<DropShadowEffect BlurRadius="8"
													  ShadowDepth="0"
													  Color="White"
													  Opacity="0.4" />
								</Border.Effect>
							</Border>

							<ContentPresenter x:Name="Content"
											  VerticalAlignment="Center"
											  Margin="20,0,0,0"
											  TextElement.Foreground="{TemplateBinding Foreground}" />
						</Grid>

						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver"
									 Value="True">
								<Setter Property="Foreground"
										Value="#E2E8F0" />
							</Trigger>

							<Trigger Property="IsChecked"
									 Value="True">
								<Setter Property="Foreground"
										Value="White" />
								<Setter TargetName="HoverBorder"
										Property="Background"
										Value="#0FFFFFFF" />
								<Setter TargetName="ActiveIndicator"
										Property="Opacity"
										Value="1" />
							</Trigger>

							<DataTrigger Binding="{Binding IsCollapsed}"
										 Value="True">
								<Setter TargetName="Content"
										Property="Margin"
										Value="0" />
								<Setter TargetName="Content"
										Property="HorizontalAlignment"
										Value="Center" />
							</DataTrigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="100" />
			<RowDefinition Height="*" />
			<RowDefinition Height="70" />
		</Grid.RowDefinitions>

		<Grid Grid.Row="0">
			<TextBlock Text="{Binding HomeTabName}"
					   Foreground="{StaticResource BackgroundColor}"
					   FontSize="18"
					   FontWeight="Bold"
					   TextTrimming="CharacterEllipsis"
					   HorizontalAlignment="Stretch"
					   VerticalAlignment="Center"
					   Margin="20,0,50,0">
				<TextBlock.Style>
					<Style TargetType="TextBlock">
						<Setter Property="Visibility"
								Value="Visible" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsCollapsed}"
										 Value="True">
								<Setter Property="Visibility"
										Value="Collapsed" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>
			</TextBlock>

			<Button Command="{Binding ToggleSidebarCommand}"
					CommandParameter="{Binding}"
					Foreground="{StaticResource BackgroundColor}"
					Cursor="Hand"
					Width="40"
					Height="40">

				<Button.Template>
					<ControlTemplate TargetType="Button">
						<Border Background="Transparent">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center" />
						</Border>
					</ControlTemplate>
				</Button.Template>

				<Button.Style>
					<Style TargetType="Button">
						<Setter Property="HorizontalAlignment"
								Value="Right" />
						<Setter Property="Margin"
								Value="0,0,6,0" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding IsCollapsed}"
										 Value="True">
								<Setter Property="HorizontalAlignment"
										Value="Center" />
								<Setter Property="Margin"
										Value="0" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Button.Style>

				<materialDesign:PackIcon Width="26"
										 Height="26">
					<materialDesign:PackIcon.Style>
						<Style TargetType="materialDesign:PackIcon"
							   BasedOn="{StaticResource {x:Type materialDesign:PackIcon}}">
							<Setter Property="Kind"
									Value="MenuOpen" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsCollapsed}"
											 Value="True">
									<Setter Property="Kind"
											Value="Menu" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</materialDesign:PackIcon.Style>
				</materialDesign:PackIcon>
			</Button>
		</Grid>

		<ScrollViewer Grid.Row="1"
					  VerticalScrollBarVisibility="Hidden">

			<ScrollViewer.Resources>
				<Style TargetType="TextBlock">
					<Setter Property="VerticalAlignment"
							Value="Center" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding IsCollapsed}"
									 Value="True">
							<Setter Property="Visibility"
									Value="Collapsed" />
						</DataTrigger>
					</Style.Triggers>
				</Style>

				<Style TargetType="materialDesign:PackIcon">
					<Setter Property="Width"
							Value="22" />
					<Setter Property="Height"
							Value="22" />
					<Setter Property="Margin"
							Value="0,0,15,0" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding IsCollapsed}"
									 Value="True">
							<Setter Property="Margin"
									Value="0" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</ScrollViewer.Resources>

			<StackPanel>
				<RadioButton Style="{StaticResource NavButtonStyle}"
							 GroupName="NavMenu"
							 Visibility="{Binding IsDashboardVisible}"
							 IsChecked="{Binding IsDashboardChecked}"
							 Command="{Binding ShowDashboardCommand}"
							 CommandParameter="Dashboard">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon Kind="ViewDashboard" />
						<TextBlock Text="Dashboard" />
					</StackPanel>
				</RadioButton>

				<RadioButton Style="{StaticResource NavButtonStyle}"
							 GroupName="NavMenu"
							 Visibility="{Binding IsSaleVisible}"
							 IsChecked="{Binding IsSaleChecked}"
							 Command="{Binding ShowBanHangCommand}"
							 CommandParameter="Sale">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon Kind="CashRegister" />
						<TextBlock Text="Bán hàng" />
					</StackPanel>
				</RadioButton>

				<RadioButton Style="{StaticResource NavButtonStyle}"
							 GroupName="NavMenu"
							 Visibility="{Binding IsInvoiceVisible}"
							 IsChecked="{Binding IsInvoiceChecked}"
							 Command="{Binding ShowHoaDonCommand}"
							 CommandParameter="Sale">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon Kind="Invoice" />
						<TextBlock Text="Hóa đơn" />
					</StackPanel>
				</RadioButton>

				<RadioButton Style="{StaticResource NavButtonStyle}"
							 GroupName="NavMenu"
							 Visibility="{Binding IsProductVisible}"
							 IsChecked="{Binding IsProductChecked}"
							 Command="{Binding ShowTraCuuSachCommand}"
							 CommandParameter="Product">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon Kind="BookSearch" />
						<TextBlock Text="Tra cứu sách" />
					</StackPanel>
				</RadioButton>

				<RadioButton Style="{StaticResource NavButtonStyle}"
							 GroupName="NavMenu"
							 Visibility="{Binding IsCustomerVisible}"
							 IsChecked="{Binding IsCustomerChecked}"
							 Command="{Binding ShowKhachHangCommand}"
							 CommandParameter="Customer">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon Kind="AccountGroup" />
						<TextBlock Text="Khách hàng" />
					</StackPanel>
				</RadioButton>

				<RadioButton Style="{StaticResource NavButtonStyle}"
							 GroupName="NavMenu"
							 Visibility="{Binding IsReceiptVisible}"
							 IsChecked="{Binding IsReceiptChecked}"
							 Command="{Binding ShowPhieuThuCommand}"
							 CommandParameter="Receipt">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon Kind="ReceiptText" />
						<TextBlock Text="Phiếu thu" />
					</StackPanel>
				</RadioButton>

				<RadioButton Style="{StaticResource NavButtonStyle}"
							 GroupName="NavMenu"
							 Visibility="{Binding IsImportVisible}"
							 IsChecked="{Binding IsImportChecked}"
							 Command="{Binding ShowNhapKhoCommand}"
							 CommandParameter="Import">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon Kind="Warehouse" />
						<TextBlock Text="Nhập kho" />
					</StackPanel>
				</RadioButton>

				<RadioButton Style="{StaticResource NavButtonStyle}"
							 GroupName="NavMenu"
							 Visibility="{Binding IsSupplierVisible}"
							 IsChecked="{Binding IsSupplierChecked}"
							 Command="{Binding ShowNhaCungCapCommand}"
							 CommandParameter="Supplier">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon Kind="TruckDelivery" />
						<TextBlock Text="Nhà cung cấp" />
					</StackPanel>
				</RadioButton>

				<RadioButton Style="{StaticResource NavButtonStyle}"
							 GroupName="NavMenu"
							 Visibility="{Binding IsPromotionVisible}"
							 IsChecked="{Binding IsPromtionChecked}"
							 Command="{Binding ShowUuDaiCommand}"
							 CommandParameter="Promotion">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon Kind="TicketPercent" />
						<TextBlock Text="Ưu đãi" />
					</StackPanel>
				</RadioButton>

				<RadioButton Style="{StaticResource NavButtonStyle}"
							 GroupName="NavMenu"
							 Visibility="{Binding IsCategoryVisible}"
							 IsChecked="{Binding IsCategoryChecked}"
							 Command="{Binding ShowDanhMucCommand}"
							 CommandParameter="Category">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon Kind="CategoryPlus" />
						<TextBlock Text="Danh mục" />
					</StackPanel>
				</RadioButton>

				<RadioButton Style="{StaticResource NavButtonStyle}"
							 GroupName="NavMenu"
							 Visibility="{Binding IsReportVisible}"
							 IsChecked="{Binding IsReportChecked}"
							 Command="{Binding ShowBaoCaoCommand}"
							 CommandParameter="Report">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon Kind="ChartAreaspline" />
						<TextBlock Text="Báo cáo" />
					</StackPanel>
				</RadioButton>

				<RadioButton Style="{StaticResource NavButtonStyle}"
							 GroupName="NavMenu"
							 Visibility="{Binding IsAccountVisible}"
							 IsChecked="{Binding IsAccountChecked}"
							 Command="{Binding ShowTaiKhoanCommand}"
							 CommandParameter="Account">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon Kind="ShieldAccount" />
						<TextBlock Text="Tài khoản" />
					</StackPanel>
				</RadioButton>

				<RadioButton Style="{StaticResource NavButtonStyle}"
							 GroupName="NavMenu"
							 Visibility="{Binding IsSettingVisible}"
							 IsChecked="{Binding IsSettingChecked}"
							 Command="{Binding ShowCaiDatCommand}"
							 CommandParameter="{Binding}">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon Kind="Cog" />
						<TextBlock Text="Cài đặt" />
					</StackPanel>
				</RadioButton>
			</StackPanel>
		</ScrollViewer>

		<Button Grid.Row="2"
				Command="{Binding LogoutCommand}"
				CommandParameter="{Binding}"
				Height="45"
				Cursor="Hand">
			<Button.Style>
				<Style TargetType="Button">
					<Setter Property="Width"
							Value="180" />
					<Setter Property="Background"
							Value="#0FFFFFFF" />
					<Setter Property="Foreground"
							Value="#A3AED0" />
					<Setter Property="FontSize"
							Value="15" />
					<Setter Property="FontWeight"
							Value="SemiBold" />
					<Setter Property="FocusVisualStyle"
							Value="{x:Null}" />

					<Setter Property="Template">
						<Setter.Value>
							<ControlTemplate TargetType="Button">
								<Border x:Name="border"
										Background="{TemplateBinding Background}"
										BorderBrush="#1AFFFFFF"
										BorderThickness="1"
										CornerRadius="12">
									<StackPanel Orientation="Horizontal"
												HorizontalAlignment="Center"
												VerticalAlignment="Center">
										<materialDesign:PackIcon x:Name="icon"
																 Kind="Logout"
																 Width="20"
																 Height="20"
																 Margin="0,0,10,0"
																 VerticalAlignment="Center" />
										<TextBlock x:Name="txt"
												   Text="Đăng xuất"
												   VerticalAlignment="Center" />
									</StackPanel>
								</Border>

								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver"
											 Value="True">
										<Setter TargetName="border"
												Property="Background"
												Value="#1AFF4D4F" />
										<Setter TargetName="border"
												Property="BorderBrush"
												Value="#FF4D4F" />
										<Setter Property="Foreground"
												Value="#FF4D4F" />
									</Trigger>
									<Trigger Property="IsPressed"
											 Value="True">
										<Setter TargetName="border"
												Property="Background"
												Value="#33FF4D4F" />
										<Setter Property="Foreground"
												Value="#FF4D4F" />
									</Trigger>

									<DataTrigger Binding="{Binding IsCollapsed}"
												 Value="True">
										<Setter Property="Width"
												Value="50" />
										<Setter TargetName="txt"
												Property="Visibility"
												Value="Collapsed" />
										<Setter TargetName="icon"
												Property="Margin"
												Value="0" />
									</DataTrigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</Button.Style>
		</Button>
	</Grid>
</UserControl>