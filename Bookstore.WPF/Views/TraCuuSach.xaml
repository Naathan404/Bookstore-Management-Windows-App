<UserControl x:Class="Bookstore.WPF.Views.TraCuuSach"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Background="#F4F7FE"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <!-- Màu sắc theo yêu cầu -->
        <SolidColorBrush x:Key="PrimaryDarkColor" Color="#2B3674"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#4318FF"/>
        <SolidColorBrush x:Key="TextLightColor" Color="#A3AED0"/>
        <SolidColorBrush x:Key="TextLightPurpleColor" Color="#E3DAFF"/>
        <SolidColorBrush x:Key="BackgroundColor" Color="#F4F7FE"/>
        <SolidColorBrush x:Key="WhiteColor" Color="White"/>

        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="GradientPrimaryBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4318FF" Offset="0"/>
            <GradientStop Color="#2B3674" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GradientButtonBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4318FF" Offset="0"/>
            <GradientStop Color="#5B3CFF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GradientCardBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F4F7FE" Offset="1"/>
        </LinearGradientBrush>

        <!-- Shadow Effects -->
        <DropShadowEffect x:Key="CardShadowEffect" BlurRadius="20" ShadowDepth="0" Opacity="0.08" Color="#4318FF"/>
        <DropShadowEffect x:Key="ButtonShadowEffect" BlurRadius="10" ShadowDepth="2" Opacity="0.25" Color="#4318FF"/>

        <!-- Status Colors -->
        <SolidColorBrush x:Key="StatusAvailableColor" Color="#10B981"/>
        <SolidColorBrush x:Key="StatusOutOfStockColor" Color="#EF4444"/>
        <SolidColorBrush x:Key="StatusBorrowedColor" Color="#F59E0B"/>

        <!-- Custom Styles -->
        <Style x:Key="MainGradientButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource ButtonShadowEffect}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource GradientButtonBrush}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#4318FF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"
                                BorderBrush="#4318FF"
                                BorderThickness="1.5"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F4F7FE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PaginationButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2B3674"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F4F7FE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActivePaginationButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource GradientButtonBrush}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="50"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundColor}">
        <!-- Decorative Circles với màu #4318FF -->
        <Ellipse Width="600" Height="600" 
                 Fill="#4318FF" Opacity="0.03"
                 VerticalAlignment="Top" HorizontalAlignment="Left"
                 Margin="-200,-200,0,0"/>
        <Ellipse Width="500" Height="500" 
                 Fill="#2B3674" Opacity="0.03"
                 VerticalAlignment="Bottom" HorizontalAlignment="Right"
                 Margin="0,0,-150,-150"/>
        <Ellipse Width="300" Height="300" 
                 Fill="#4318FF" Opacity="0.04"
                 VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Section -->
                <Border Grid.Row="0" 
                        Margin="0,0,0,24" 
                        Padding="28"
                        CornerRadius="20"
                        Background="White"
                        Effect="{StaticResource CardShadowEffect}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BookSearch" 
                                                     Width="36" 
                                                     Height="36"
                                                     Foreground="#4318FF"
                                                     Margin="0,0,12,0"/>
                            <TextBlock Text="TRA CỨU SÁCH" 
                                       FontSize="32" 
                                       FontWeight="Bold"
                                       Foreground="#2B3674"
                                       FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Search Filters Section -->
                <Border Grid.Row="1" 
                        Margin="0,0,0,24" 
                        Padding="28"
                        CornerRadius="20"
                        Background="White"
                        Effect="{StaticResource CardShadowEffect}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <materialDesign:PackIcon Kind="FilterVariant" 
                                                     Width="24" 
                                                     Height="24"
                                                     Foreground="#4318FF"
                                                     Margin="0,0,12,0"/>
                            <TextBlock Text="Bộ lọc tìm kiếm" 
                                       FontSize="18" 
                                       FontWeight="SemiBold"
                                       Foreground="#2B3674"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Filter Grid -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 1 -->
                            <!-- Tên sách -->
                            <Border Grid.Row="0" Grid.Column="0" 
            Style="{StaticResource FilterBorderStyle}"
            Margin="0,0,16,16">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Book" 
                                     Width="18" 
                                     Height="18"
                                     Foreground="#A3AED0"
                                     Margin="12,0,8,0"/>
                                    <TextBox x:Name="txtTenSach" 
                     TextChanged="txtTenSach_TextChanged"
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalAlignment="Center"
                     FontSize="14"
                     Foreground="#2B3674"
                     materialDesign:HintAssist.Hint="Tên sách..."
                     Width="Auto"/>
                                </StackPanel>
                            </Border>

                            <!-- Tác giả -->
                            <Border Grid.Row="0" Grid.Column="1" 
            Style="{StaticResource FilterBorderStyle}"
            Margin="0,0,16,16">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Account" 
                                     Width="18" 
                                     Height="18"
                                     Foreground="#A3AED0"
                                     Margin="12,0,8,0"/>
                                    <TextBox x:Name="txtTacGia" 
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalAlignment="Center"
                     FontSize="14"
                     Foreground="#2B3674"
                     materialDesign:HintAssist.Hint="Tác giả..."
                     Width="Auto"/>
                                </StackPanel>
                            </Border>

                            <!-- Thể loại -->
                            <Border Grid.Row="0" Grid.Column="2" 
            Style="{StaticResource FilterBorderStyle}"
            Margin="0,0,16,16">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Tag" 
                                     Width="18" 
                                     Height="18"
                                     Foreground="#A3AED0"
                                     Margin="12,0,8,0"/>
                                    <ComboBox x:Name="cboTheLoai" 
                      Background="Transparent"
                      BorderThickness="0"
                      VerticalAlignment="Center"
                      FontSize="14"
                      Foreground="#2B3674"
                      materialDesign:HintAssist.Hint="Chọn thể loại"
                      Width="Auto"/>
                                </StackPanel>
                            </Border>

                            <!-- Row 2 -->
                            <!-- Giá niêm yết (khoảng) -->
                            <Border Grid.Row="1" Grid.Column="0" 
            Style="{StaticResource FilterBorderStyle}"
            Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CurrencyUsd" 
                                     Width="18" 
                                     Height="18"
                                     Foreground="#A3AED0"
                                     Margin="12,0,8,0"/>
                                    <TextBox x:Name="txtGiaNiemYet" 
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalAlignment="Center"
                     FontSize="14"
                     Foreground="#2B3674"
                     materialDesign:HintAssist.Hint="Giá niêm yết..."
                     Width="Auto"/>
                                </StackPanel>
                            </Border>

                            <!-- Đơn giá bán (khoảng) -->
                            <Border Grid.Row="1" Grid.Column="1" 
            Style="{StaticResource FilterBorderStyle}"
            Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Cash" 
                                     Width="18" 
                                     Height="18"
                                     Foreground="#A3AED0"
                                     Margin="12,0,8,0"/>
                                    <TextBox x:Name="txtDonGiaBan" 
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalAlignment="Center"
                     FontSize="14"
                     Foreground="#2B3674"
                     materialDesign:HintAssist.Hint="Đơn giá bán..."
                     Width="Auto"/>
                                </StackPanel>
                            </Border>

                            <!-- Số lượng tồn kho (khoảng) -->
                            <Border Grid.Row="1" Grid.Column="2" 
            Style="{StaticResource FilterBorderStyle}"
            Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="PackageVariant" 
                                     Width="18" 
                                     Height="18"
                                     Foreground="#A3AED0"
                                     Margin="12,0,8,0"/>
                                    <TextBox x:Name="txtSoLuongTon" 
                     Background="Transparent"
                     BorderThickness="0"
                     VerticalAlignment="Center"
                     FontSize="14"
                     Foreground="#2B3674"
                     materialDesign:HintAssist.Hint="Số lượng tồn..."
                     Width="Auto"/>
                                </StackPanel>
                            </Border>

                            <!-- Nút TÌM KIẾM -->
                            <StackPanel Grid.Row="1" Grid.Column="3" VerticalAlignment="Bottom">
                                <Button x:Name="btnTimKiem" 
                Style="{StaticResource MainGradientButton}"
                Width="130"
                Click="btnTimKiem_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Magnify" 
                                         Width="18" 
                                         Height="18"
                                         Foreground="White"
                                         Margin="0,0,8,0"/>
                                        <TextBlock Text="TÌM KIẾM"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                            <Button x:Name="btnNhapLai" 
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Width="110"
                                    Margin="0,0,12,0"
                                    Click="btnNhapLai_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh" 
                                                             Width="16" 
                                                             Height="16"
                                                             Foreground="#4318FF"
                                                             Margin="0,0,8,0"/>
                                    <TextBlock Text="NHẬP LẠI"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnXuatExcel" 
                                    Style="{StaticResource OutlineButtonStyle}"
                                    Width="130"
                                    Click="btnXuatExcel_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileExcel" 
                                                             Width="16" 
                                                             Height="16"
                                                             Foreground="#4318FF"
                                                             Margin="0,0,8,0"/>
                                    <TextBlock Text="XUẤT EXCEL"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Results Count -->
                <Border Grid.Row="2"
                        Margin="0,0,0,16"
                        Padding="20,14"
                        CornerRadius="12"
                        Background="White"
                        Effect="{StaticResource CardShadowEffect}">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Database" 
                                                     Width="18" 
                                                     Height="18"
                                                     Foreground="#4318FF"
                                                     Margin="0,0,8,0"/>
                            <TextBlock x:Name="txtKetQua" 
                                       Text="✨ Hiển thị 0 kết quả" 
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="#A3AED0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <materialDesign:PackIcon Kind="Update" 
                                                     Width="16" 
                                                     Height="16"
                                                     Foreground="#4318FF"
                                                     Margin="0,0,8,0"/>
                            <TextBlock Text="Cập nhật lần cuối: hôm nay"
                                       FontSize="12"
                                       Foreground="#A3AED0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- DANH SÁCH SÁCH -->
                <Border Grid.Row="3"
                        CornerRadius="20"
                        Background="White"
                        Effect="{StaticResource CardShadowEffect}"
                        Padding="20,16,20,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <materialDesign:PackIcon Kind="FormatListBulleted" 
                                                     Width="24" 
                                                     Height="24"
                                                     Foreground="#4318FF"
                                                     Margin="0,0,12,0"/>
                            <TextBlock Text="DANH SÁCH SÁCH" 
                                       FontSize="18" 
                                       FontWeight="SemiBold"
                                       Foreground="#2B3674"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <DataGrid x:Name="dgSach"
                                  AutoGenerateColumns="False"
                                  SelectionMode="Single"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  RowHeight="60"
                                  FontSize="13"
                                  AlternatingRowBackground="#F4F7FE"
                                  RowBackground="White"
                                  Foreground="#2B3674"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F4F7FE"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">

                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" 
                                                 Color="#4318FF"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" 
                                                 Color="#4318FF"/>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F4F7FE"/>
                                    <Setter Property="Foreground" Value="#2B3674"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Height" Value="50"/>
                                    <Setter Property="BorderBrush" Value="#F4F7FE"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <!-- 1. STT -->
                                <DataGridTextColumn Header="STT" 
                                                    Binding="{Binding STT}" 
                                                    Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 2. Tên sách -->
                                <DataGridTextColumn Header="Tên sách" 
                                                    Binding="{Binding TenSach}" 
                                                    Width="220"/>

                                <!-- 3. Tác giả -->
                                <DataGridTextColumn Header="Tác giả" 
                                                    Binding="{Binding TacGia}" 
                                                    Width="160"/>

                                <!-- 4. Thể loại -->
                                <DataGridTextColumn Header="Thể loại" 
                                                    Binding="{Binding TheLoai}" 
                                                    Width="130"/>

                                <!-- 5. Mô tả -->
                                <DataGridTextColumn Header="Mô tả" 
                                                    Binding="{Binding MoTa}" 
                                                    Width="280">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="MaxHeight" Value="50"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 6. Tồn kho -->
                                <DataGridTextColumn Header="Tồn kho" 
                                                    Binding="{Binding SoLuongTonKho}" 
                                                    Width="85">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 7. Tổng số đã bán -->
                                <DataGridTextColumn Header="Tổng số đã bán" 
                                                    Binding="{Binding TongDaBan}" 
                                                    Width="110">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 8. Giá niêm yết -->
                                <DataGridTextColumn Header="Giá niêm yết" 
                                                    Binding="{Binding GiaNiemYet, StringFormat={}{0:N0} VNĐ}" 
                                                    Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- 9. Đơn giá bán -->
                                <DataGridTextColumn Header="Đơn giá bán" 
                                                    Binding="{Binding DonGiaBan, StringFormat={}{0:N0} VNĐ}" 
                                                    Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Foreground" Value="#4318FF"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Pagination -->
                <Border Grid.Row="4" 
                        Margin="0,24,0,0"
                        Padding="16,12"
                        CornerRadius="12"
                        Background="White"
                        Effect="{StaticResource CardShadowEffect}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource PaginationButtonStyle}" Margin="0,0,4,0">
                            <materialDesign:PackIcon Kind="ChevronDoubleLeft" Width="18" Height="18" Foreground="#A3AED0"/>
                        </Button>
                        <Button Style="{StaticResource PaginationButtonStyle}" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18" Foreground="#A3AED0"/>
                        </Button>

                        <Button Style="{StaticResource ActivePaginationButtonStyle}" Margin="0,0,4,0">
                            <TextBlock Text="1"/>
                        </Button>

                        <Button Style="{StaticResource PaginationButtonStyle}" Margin="0,0,4,0">
                            <TextBlock Text="2"/>
                        </Button>

                        <Button Style="{StaticResource PaginationButtonStyle}" Margin="0,0,4,0">
                            <TextBlock Text="3"/>
                        </Button>

                        <Button Style="{StaticResource PaginationButtonStyle}" Margin="0,0,4,0">
                            <TextBlock Text="4"/>
                        </Button>

                        <Button Style="{StaticResource PaginationButtonStyle}" Margin="0,0,4,0">
                            <TextBlock Text="5"/>
                        </Button>

                        <Button Style="{StaticResource PaginationButtonStyle}" Margin="8,0,0,0">
                            <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18" Foreground="#A3AED0"/>
                        </Button>
                        <Button Style="{StaticResource PaginationButtonStyle}" Margin="4,0,0,0">
                            <materialDesign:PackIcon Kind="ChevronDoubleRight" Width="18" Height="18" Foreground="#A3AED0"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Footer -->
                <Border Grid.Row="5" Margin="0,32,0,16" Padding="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="© 2024 Bookstore Management. All rights reserved." 
                                   Foreground="#A3AED0" 
                                   FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>