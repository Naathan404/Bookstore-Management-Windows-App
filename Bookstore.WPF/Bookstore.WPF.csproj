    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.1-ci1292" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />
    <PackageReference Include="NuGet.Packaging" Version="6.11.2" />
