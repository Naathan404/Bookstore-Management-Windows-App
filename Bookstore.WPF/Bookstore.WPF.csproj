  <ItemGroup>
    <None Remove="Resources\Images\Login\bg0.png" />
    <None Remove="Resources\Images\Login\bg1_1.png" />
    <None Remove="Resources\Images\Login\bg1_2.png" />
    <None Remove="Resources\Images\Login\bg1_3.png" />
